#version 460
#extension GL_GOOGLE_include_directive : require
// vkclean -- PARTICLE FOG (#1003): RESOLVE the accumulator into the atlases. Push x = mode:
//   0 COARSE  one invocation per coarse voxel of every brick (PF_NC^3 per slot): the big
//             kernels' density (tint, sigma) -> uCoarseW, the flow (mass-weighted velocity)
//             -> uVelW.xyz (w, the sky optical depth, is the light pass's)
//   1 FINE    one invocation per fine voxel (PF_N^3 per slot): fine + the coarse level
//             (trilinear, through the sampler) -> uDensW (tint, sigma), sigma clamped at
//             pf.misc.w (only a runaway emitter ever reaches it); and the slot's DENSITY STATS
//             (sum sigma, sum sigma^2: a workgroup reduction, one atomic pair per group) into
//             the floor buffer -- the march's erosion normalises by their ratio, the density-
//             weighted mean density, so a thin system and a thick one both get a core and edges
// Dispatch: (edge / 4, edge / 4, edge / 4 x bricks) groups of 4^3; voxels past the brick's
// dims are left alone (never read: every read clamps to the brick's own voxel centres).
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#define PF_SAMPLERS
#define PF_FLOOR
#include "clean_pfog_common.glsl"

layout(set = PF_SET, binding = 7, rgba16f) writeonly uniform image3D uDensW;
layout(set = PF_SET, binding = 8, rgba16f) writeonly uniform image3D uCoarseW;
layout(set = PF_SET, binding = 9, rgba16f) writeonly uniform image3D uVelW;

layout(push_constant) uniform PfPush { uvec4 q; } pp;

shared vec2 sStat[64];

void main()
{
    const bool fine = pp.q.x == 1u;
    const uint edge = fine ? PF_N : PF_NC;
    const uint per = edge / 4u;
    const uint b = gl_WorkGroupID.z / per;
    if (b >= uint(pf.counts.x + 0.5)) return;
    const PfBrick br = pf.bricks[b];
    const uvec3 v = uvec3(gl_GlobalInvocationID.xy, gl_GlobalInvocationID.z - b * edge);
    const uint base = uint(br.dims_slot.w + 0.5) * PF_SLOT_WORDS;
    if (!fine)
    {
        if (any(greaterThanEqual(v, pfDimsC(br)))) return;
        const uint vol = PF_NC * PF_NC * PF_NC;
        const uint idx = (v.z * PF_NC + v.y) * PF_NC + v.x;
        const uint cb = base + PF_COARSE_BASE;
        const float s = float(ac[cb + idx]);
        vec4 d = vec4(0.0);
        if (s > 0.0)
            d = vec4(vec3(float(ac[cb + vol + idx]), float(ac[cb + 2u * vol + idx]), float(ac[cb + 3u * vol + idx])) / s,
                     s / PF_FIX);
        const float w = float(ac[cb + 7u * vol + idx]);
        vec3 vel = vec3(0.0);
        if (w > 0.0)
            vel = vec3(float(int(ac[cb + 4u * vol + idx])), float(int(ac[cb + 5u * vol + idx])),
                       float(int(ac[cb + 6u * vol + idx]))) / w;
        const ivec3 at = ivec3(br.atlas.xyz * 0.5) + ivec3(v);
        imageStore(uCoarseW, at, d);
        imageStore(uVelW, at, vec4(clamp(vel, vec3(-32.0), vec3(32.0)), 0.0));
        return;
    }
    // (no early return from here: the stats reduction needs the whole group)
    const bool inside = all(lessThan(v, pfDims(br)));
    vec4 o = vec4(0.0);
    if (inside)
    {
        const uint vol = PF_N * PF_N * PF_N;
        const uint idx = (v.z * PF_N + v.y) * PF_N + v.x;
        const float sf = float(ac[base + idx]) / PF_FIX;
        vec3 tf = vec3(0.0);
        if (sf > 0.0)
            tf = vec3(float(ac[base + vol + idx]), float(ac[base + 2u * vol + idx]), float(ac[base + 3u * vol + idx]))
               / (sf * PF_FIX);
        // The coarse level at this voxel's centre.
        const vec3 P = br.org_vox.xyz + (vec3(v) + 0.5) * br.org_vox.w;
        const vec4 cd = textureLod(uCoarse, pfUvwC(br, P), 0.0);
        const float s = sf + max(cd.a, 0.0);
        if (s > 1e-5)
            o = vec4(clamp((tf * sf + cd.rgb * max(cd.a, 0.0)) / s, vec3(0.0), vec3(1.0)), min(s, max(pf.misc.w, 1.0)));
        imageStore(uDensW, ivec3(br.atlas.xyz) + ivec3(v), o);
    }
    // density stats (sigma clamped at 16: the sums stay inside 32 bits for a full brick)
    const uint t = gl_LocalInvocationIndex;
    const float sc = min(o.a, 16.0);
    sStat[t] = vec2(sc, sc * sc);
    barrier();
    for (uint k = 32u; k > 0u; k >>= 1u)
    {
        if (t < k) sStat[t] += sStat[t + k];
        barrier();
    }
    if (t == 0u && sStat[0].x > 0.0)
    {
        const uint fb = uint(br.dims_slot.w + 0.5) * PF_FLOOR_WORDS;
        atomicAdd(fl[fb + 4u], uint(sStat[0].x * PF_STAT1 + 0.5));
        atomicAdd(fl[fb + 5u], uint(sStat[0].y * PF_STAT2 + 0.5));
    }
}
