#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
// vkclean -- CLUSTER LOD mesh-shader tier: MESH stage (#745, OWNER: 1b).
//
// One 64-invocation workgroup per selected cluster (task payload slot gl_WorkGroupID.x): one
// vertex per invocation (<= kMaxClusterVerts = 64), two triangles per invocation (<= 128).
// Vertices are pulled from the page pool words and run clean_cluster_draw_common.glsl's
// clusterVertex -- the same per-vertex work as the MDI tiers' VS -- so every tier writes the
// same G-buffer. Outputs: the locations the G-buffer fragment shaders read.
// DEPTH-ONLY (-DCLEAN_DEPTH_ONLY -DCLEAN_DEPTH_MASK, RenderVKDepthOnlyVS; as clean_draw.vert's
// cluster tiers): gl_Position + the alpha test's locations 0 / 1 / 3 / 4 only.
layout(local_size_x = 64) in;
layout(triangles, max_vertices = 64, max_primitives = 128) out;

#include "clean_cluster_draw_common.glsl"

struct ClTaskPayload { uint sel[CL_TASK_CLUSTERS]; };
taskPayloadSharedEXT ClTaskPayload tp;

#if !defined(CLEAN_DEPTH_ONLY) || defined(CLEAN_DEPTH_MASK)
layout(location = 0) flat out uint v_material_id[];
layout(location = 1) invariant out vec2 v_uv[];   // (invariant: as the VS tiers)
layout(location = 3) flat out vec4 v_tint[];
layout(location = 4) flat out uint v_flags[];
layout(location = 16) invariant out vec4 v_rez[];       // <GMDX> rez effects: none on the cluster path
layout(location = 17) invariant flat out vec4 v_rez_box[];        // <GMDX>
#endif
// (declaration order as before the slim variants: the full variant's module is unchanged)
#ifdef CLEAN_VS_NORMAL_FRAME
layout(location = 2)      out vec3 v_world_normal[];
#endif
#ifdef CLEAN_VS_WORLD_POS
layout(location = 5)      out vec3 v_world_pos[];
#endif
#ifdef CLEAN_VS_NORMAL_FRAME
layout(location = 7)      out vec4 v_world_tangent[];
layout(location = 8)      out vec2 v_uv_raw[];
#endif
#ifndef CLEAN_DEPTH_ONLY
layout(location = 9) flat out uint v_terrain_rec[];
layout(location = 11) flat out uint v_cel[];
layout(location = 15)      out vec4 v_wx_rest[];   // #901 rest-pose accumulation: the skinned vertex's bind-space position (ClVOut.rest)
#endif
#ifdef CLEAN_VS_PREV_POS
layout(location = 10)      out vec3 v_prev_world_pos[];   // motion pre-pass (#749)
#endif
// #749: the pre-pass and G-buffer pipelines must produce bit-identical depth (as the VS tiers).
out gl_MeshPerVertexEXT { invariant vec4 gl_Position; } gl_MeshVerticesEXT[];

void main()
{
    const uint sel = tp.sel[min(gl_WorkGroupID.x, CL_TASK_CLUSTERS - 1u)];
    const ClSelected cs = cl_sel[sel];
    const uint slot = clRefSlot(cs.cluster_ref);
    const ClRecord rec = clLoadRecord(slot, clRefIndex(cs.cluster_ref));
    const uint vc = min(clRecVertCount(rec), CL_MAX_CLUSTER_VERTS);
    const uint tc = vc == 0u ? 0u : min(clRecTriCount(rec), CL_MAX_CLUSTER_TRIS);
    SetMeshOutputsEXT(vc, tc);
    const uint t = gl_LocalInvocationIndex;
    if (t < vc)
    {
        const uint first = clFirstVertex(slot, rec);
        vec3 position;
        vec2 texcoord0;
        vec3 normal;
        vec4 tangent;
        clPoolVertex(first, first + t, position, texcoord0, normal, tangent);
        const ClVOut o = clusterVertex(sel, t, position, texcoord0, normal, tangent);
        gl_MeshVerticesEXT[t].gl_Position = o.pos;
#if !defined(CLEAN_DEPTH_ONLY) || defined(CLEAN_DEPTH_MASK)
        v_material_id[t]   = o.material_id;
        v_uv[t]            = o.uv;
        v_tint[t]          = o.tint;
        v_flags[t]         = o.flags;
        v_rez[t]           = vec4(0.0);   // <GMDX>
        v_rez_box[t]       = vec4(0.0);   // <GMDX>
#endif
#ifdef CLEAN_VS_NORMAL_FRAME
        v_world_normal[t]  = o.world_normal;
#endif
#ifdef CLEAN_VS_WORLD_POS
        v_world_pos[t]     = o.world_pos;
#endif
#ifdef CLEAN_VS_NORMAL_FRAME
        v_world_tangent[t] = o.world_tangent;
        v_uv_raw[t]        = o.uv_raw;
#endif
#ifndef CLEAN_DEPTH_ONLY
        v_terrain_rec[t]   = o.terrain_rec;
        v_cel[t]           = o.cel;
        v_wx_rest[t]       = o.rest;
#endif
#ifdef CLEAN_VS_PREV_POS
        v_prev_world_pos[t] = o.prev_world_pos;
#endif
    }
    for (uint k = t; k < tc; k += 64u)
    {
        const uint last = vc - 1u;
        gl_PrimitiveTriangleIndicesEXT[k] = uvec3(min(clLocalIndex(slot, rec, 3u * k), last),
                                                  min(clLocalIndex(slot, rec, 3u * k + 1u), last),
                                                  min(clLocalIndex(slot, rec, 3u * k + 2u), last));
    }
}
