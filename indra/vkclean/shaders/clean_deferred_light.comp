// pure visibility).
vec3 emTriRadiance(EmTri t, vec3 P, vec3 Rd)
{
    if (t.tex == EM_NO_TEX) return t.L;
    const vec3 n = cross(t.e1, t.e2);
    const float nl = length(n);   // (2 x the world area)
    if (!(nl > 1e-12)) return t.L;
    const vec3 nu = n / nl;
