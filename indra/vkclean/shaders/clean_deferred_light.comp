                const ivec2 o = q - px;
                if (abs(o.x) <= 1 && abs(o.y) <= 1) continue;   // (the 3 x 3 has it)
                vec4 rt; float g;
                if (!rtrTap(q, px, P, Ng, vz, rt, g)) continue;
                const float d2 = float(o.x * o.x + o.y * o.y);
                const bool hit = rt.a > 0.0;
                const float wb = g * exp(-d2 / (2.0 * sB * sB)) * rtrHitDistW(rt.a, tMean);
                if (hit) { hB += wb * rt.rgb; qB += wb * rt.rgb * rt.rgb; } else mB += wb;
