    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
    const vec3 P = deferPosition(px);
    const vec3 cam = pc.u_cam_time.xyz;
    const vec3 V = normalize(cam - P);
    const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
    const float vz = max(dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 1e-3);
    const float camd = length(P - cam);
    // LOBE FILTER (rtrLobeOn: a header word, uniform): the specular-AA spread of this receiver
    // (rtrNormalSpread's shading normal variance) and the direction weight's lobe.
    float aa = 0.0;
    const bool lobe = rtrLobeOn();
    if (lobe)
    {
        aa = rtrAlphaAA(rtrNormalSpread(px, P, s.N, s.Ng, camd).y);
        g_rtr_R = reflect(-V, dot(s.N, V) < 0.0 ? -s.N : s.N);
    }
    // DENSITY GRADIENT: this pixel's ray lattice (its own density after this frame's budget scale,
    // pass 11's); L >= 4 adds the lattice taps below and widens the filter to the ray spacing.
    const int L = rtrGradOn() ? rtrLattice(rtrRhoEff(rtrRho(m.w), rtrGradScaleNow())) : 1;
    const float sL = L >= 4 ? 0.6 * float(L) : 0.0;
    const ivec2 lbase = (px / L) * L;   // (px >= 0: the aligned cell holding px)
    CLK_MARK(GBUF);
    const vec2 k = unpackHalf2x16(m.z);
    const vec3 xS = dsUnpackRGB9E5(m.x), xE = dsUnpackRGB9E5(m.y);
    const vec3 envS = k.x > 0.0 ? xS / k.x : vec3(0.0);
    const vec3 envE = k.y > 0.0 ? xE / k.y : vec3(0.0);
    const bool halfRefl = (g_draw_push.flags & DEFER_FLAG_REFL_HALF) != 0u;
    // The spec word is glossy (PBR / legacy glossenv) but for a legacy env face under half-res
    // reflections, whose SHARP env sits in uReflSpec (pass 5).
    const bool specSharp = s.model == SURF_LEGACY && halfRefl && s.env > 0.0;
    const float rough = s.model == SURF_PBR ? s.rough : (specSharp ? 0.0 : 1.0 - s.gloss);
