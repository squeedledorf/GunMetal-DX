                    emTopInsert(s_lgT[l * REGIR_EM_SLOTS_MAX + k], s_lgS[l * REGIR_EM_SLOTS_MAX + k], R, par, gN, gS, gT);
            }
            for (uint k = 0u; k < REGIR_EM_SLOTS_MAX; ++k) { s_gTopS[k] = gS[k]; s_gTopT[k] = gT[k]; }
            s_gM = gM;
            s_gW = gW;
