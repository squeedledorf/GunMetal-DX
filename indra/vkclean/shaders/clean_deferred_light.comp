#if DEFER_RT_DBG
// RenderVKDebugView 28 (#859): the RT reflection RAY DENSITY per pixel, replacing the combine's
// output on frames that trace (DEFER_FLAG_RT_MARK; the host sets rtt_param3.x bit 1 under the
// view and keeps the feature split off, so the combine shades every pixel):
//   not a candidate this frame (its tile unlisted, or its mark 0): dark grey (the scene's
//     luminance x 0.08, for orientation);
//   candidate: a heat ramp of its ray density after the budget scale (rtrRhoEff), log2 from
//     RenderVKRTReflectionsDensityMin (blue) through cyan, green, yellow to the floor's full
//     density (red: 1 at RenderVKRTReflectionsScale 0, else 1/4; denser, e.g. the sharp blocks of
//     floor 1, stays red); the level path (gradient off): red;
//   bright where the pixel cast a ray this frame, dimmed (x 0.35) where the resolve fills it from
//     neighbouring rays.
bool rtrDebugOn() { return (g_draw_push.flags & DEFER_FLAG_RT_MARK) != 0u && (rtt_param3.x & 2u) != 0u; }
vec3 rtrHeat(float t)
{
    t = clamp(t, 0.0, 1.0);
    return vec3(clamp(4.0 * t - 2.0, 0.0, 1.0), clamp(min(4.0 * t, 4.0 - 4.0 * t), 0.0, 1.0), clamp(2.0 - 4.0 * t, 0.0, 1.0));
}
vec3 rtrDebugColor(ivec2 px, vec3 color)
{
    const vec3 dark = vec3(dot(max(color, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722)) * 0.08);
    const uint tilesX = (g_draw_push.width + 7u) / 8u;
    if (rtt_words[uint(px.y >> 3) * tilesX + uint(px.x >> 3)] == 0u) return dark;   // (unlisted: stale mark)
    const uvec4 m = imageLoad(uReflRtMark, px);
    if (m.z == 0u) return dark;
    float t = 1.0;
    if (rtrGradOn())
    {
        const uint floorL = min(rtt_param.w & 0xFFu, RTR_LEVELS - 1u);
        const float rfull = floorL == 0u ? 1.0 : 0.25;
        const float rmin = clamp(uintBitsToFloat(rtt_param2.y), 1.0 / 256.0, rfull * 0.5);
        const float rho = rtrRhoEff(rtrRho(m.w), rtrGradScaleNow());
        t = log2(max(rho, 1.0 / 256.0) / rmin) / log2(rfull / rmin);
    }
    const bool traced = imageLoad(uRtTrace, px).a >= 0.0;
    return rtrHeat(t) * (traced ? 1.0 : 0.35);
}
#endif

#if DEFER_OUT
// THE lit output of a pixel: linear HDR colour + the glow contribution (LL extracts
// glow from the display image: display-encoded colour x the face's glow factor). One
// function on purpose -- the merge point for any other glow packing (e.g. HDR alpha).
// <SS:Skoomastream> The glow target holds the glow AMOUNT only (LL writes the factor into
// screen alpha); the extracts (clean_glow.comp, clean_bloom.frag) take the colour from the
// composited scene, so alpha drawn over this pixel tints its glow as in LL.
void writeLitOutput(ivec2 px, vec3 color, float glow)
{
    color = lgFinite(color, LG_OUT);
#if DEFER_RT_DBG
    if (rtrDebugOn()) { color = rtrDebugColor(px, color); glow = 0.0; }
#endif
    if (!(glow >= 0.0 && glow <= LG_MAX_VALUE)) glow = 0.0;   // (NaN fails both)
    imageStore(uHdrOut, px, vec4(color, 1.0));
    imageStore(uGlowOut, px, vec4(vec3(glow), 1.0));
}
// </SS:Skoomastream>
#endif

#if DEFER_LIT
// The staging copy (#815; lightStaged() only, after the barrier that made s_tileMask final):
// lane lid <-> light lid; s_lightProj was zeroed before an earlier barrier. Ends with the
// barrier that publishes the copy to every pixel's walk.
void stageTileLights(uint lid)
{
    const uint w = lid >> 5u, bit = 1u << (lid & 31u);
    if ((s_tileMask[w] & bit) != 0u)
    {
        s_lightPos[lid] = lights[lid].pos_radius;
        s_lightCol[lid] = lights[lid].color_falloff;
        if (!(lights[lid].proj_origin.w < 0.5)) atomicOr(s_lightProj[w], bit);
    }
    barrier();
}
#endif

#if DEFER_GRID_BUILD
// ---- LIGHT GRID BUILD (RenderVKLightCulling 1; see the header): one 16 px tile per workgroup of
// the lit kernels' dispatch -> the tile's light mask in uLightGrid. Lean (no shading code):
// the occupancy the lighting kernel cannot have hides the light records' load latency.
//
// DEPTH BINS (2.5D): GRID_ZBINS log2-spaced bins over the tile's slack depth range; each
// surface pixel sets its bin, each light (already through tileLightTest, unchanged) is kept
// only if its slack depth interval covers a set bin. gridZBin is monotone non-decreasing in
// z (log2 of a max, a clamp, a truncation), so lo <= vz <= hi puts vz's bin inside
// [bin(lo), bin(hi)]; the slack (1 cm + 0.1 % of the reach) covers the lit kernels'
// re-computation of the same vz (identical code: equal, or a few ulps apart).
#define GRID_ZBINS 32u
shared uint s_zbins;
uint gridZBin(float z, float lo, float base, float scale)
{
    return uint(clamp((log2(max(z, lo)) - base) * scale, 0.0, float(GRID_ZBINS - 1u)));
}
// TILE CLASSIFY (CLEAN_DEFER_PASS 9 / 10, the feature split's #827; see FEATURE SPLIT in the header):
// the same build, then the tile's verdict for the LOCAL pass -- light mask non-empty -> its
// index appended to the tile list. Under DEFER_FLAG_LIGHT_FROXEL (LOCAL walks the froxel cells,
// not the grid) no mask is built: a tile is listed when any of its surface pixels' cells
// (froxelCellBase of the pixel's own P: the cell LOCAL walks for it) holds a light. LOSSLESS: a
// tile left out has, for every surface pixel, an empty light set (grid: the mask is a superset
// of the lights reaching each pixel; froxel: the pixel's cell is), so LOCAL would add an exact 0.
//
// gridTileBuild: the whole tile build from each lane's (surface?, P) -- the lit kernels' own
// deferHasSurface / deferPosition (g_frag_xy set: froxelCellBase reads it). Called by EVERY lane
// of the workgroup in uniform control flow (barriers + subgroup reductions inside): passes 6 / 9
// as their body, pass 10 (#831) as the shadow kernel's prologue. Leaves the tile state dead.
void gridTileBuild(uint lid, bool surf, vec3 P)
{
#if DEFER_CLASSIFY
    const bool froxel = (g_draw_push.flags & DEFER_FLAG_LIGHT_FROXEL) != 0u;   // (push constant: uniform)
#else
    const bool froxel = false;
#endif
    if (lid < TILE_LIGHT_WORDS) s_tileMask[lid] = 0u;
    if (lid == 0u) { s_zmin = floatBitsToUint(3.0e38); s_zmax = 0u; s_zbins = 0u; }
    barrier();

    // The tile's surface depths: the lit kernels' own (deferHasSurface, deferPosition, vz).
    float vz = 0.0;
    bool cellLit = false;
    if (surf)
    {
#if DEFER_CLASSIFY
        if (froxel)
        {
            // (this pixel's own cell, all its words)
            const uint cb = froxelCellBase(P);
            uint cellBits = 0u;
            [[unroll]] for (uint w = 0u; w < TILE_LIGHT_WORDS; ++w) cellBits |= light_froxel[cb + w];
            cellLit = cellBits != 0u;
        }
        else
#endif
        {
            // (> 0: a -0.0 would win the uint atomicMax and empty the tile's depth range)
            vz = max(dot(P - pc.u_cam_time.xyz, linfo.cam_fwd.xyz), 1e-4);
        }
    }
    // SUBGROUP REDUCTIONS (#831; see the header): out of the divergent branch above, every lane
    // contributing (the identity where it has no surface), one shared atomic per subgroup. The
    // guards are reduced values (subgroup-uniform), so each subgroup elects once. (Basic +
    // arithmetic ops only -- the device baseline; no vote extension.)
    if (froxel)   // (s_tileMask[0] doubles as the tile's flag)
    {
        if (subgroupOr(cellLit ? 1u : 0u) != 0u && subgroupElect()) atomicOr(s_tileMask[0], 1u);
    }
    else
    {
        // (vz >= 1e-4 > 0: its float bits order as the floats do, and are never 0 -- so zhi != 0
        // iff a lane of the subgroup has a surface)
        const uint zlo = subgroupMin(surf ? floatBitsToUint(vz) : 0xFFFFFFFFu);
        const uint zhi = subgroupMax(surf ? floatBitsToUint(vz) : 0u);
        if (zhi != 0u && subgroupElect())
        {
            atomicMin(s_zmin, zlo);
            atomicMax(s_zmax, zhi);
        }
    }
    barrier();
    if (!froxel)   // (uniform: the barriers inside stay legal)
    {
        const float z0 = uintBitsToFloat(s_zmin), z1 = uintBitsToFloat(s_zmax);
        // A little slack on the depth range (reconstruction / interpolation differences).
        const float zs0 = z0 * 0.999 - 0.01, zs1 = z1 * 1.001 + 0.01;
        // Bins over [blo, zs1] (blo > 0 for the log2; zs1 > blo: zs1 > 0.01 and zs1 > zs0).
        const float blo = max(zs0, 1e-3);
        const float bbase = log2(blo);
        const float bscale = float(GRID_ZBINS) / max(log2(zs1) - bbase, 1e-6);
        const uint zbin = subgroupOr(surf ? 1u << gridZBin(vz, blo, bbase, bscale) : 0u);   // (#831)
        if (zbin != 0u && subgroupElect()) atomicOr(s_zbins, zbin);
        barrier();
        CLK_MARK(TILE_DEPTH);

        // ---- the tile's light mask: the in-kernel test, AND the depth bins ----
        const uint count = min(uint(linfo.cam_pos.w), TILE_LIGHT_WORDS * 32u);
        if (count > 0u && z1 >= z0)
        {
            vec3 rays[4], planes[4];
            tileFrustum(rays, planes);
            const uint bins = s_zbins;
            const vec3 fwd = linfo.cam_fwd.xyz;
            for (uint i = lid; i < count; i += TILE * TILE)
            {
                if (!tileLightTest(i, rays, planes, zs0, zs1, fwd)) continue;
                const vec4 pr = lights[i].pos_radius;
                const float cz = dot(pr.xyz - pc.u_cam_time.xyz, fwd);
                const float r = pr.w;
                // (a non-finite record skips the bin test: kept, as the old path keeps it -- it adds
                // 0 per pixel either way, but its lit-guard trips stay counted the same)
                if (abs(cz) + r < 1e30)
                {
                    const float sl = 0.01 + 0.001 * (abs(cz) + r);
                    const uint b0 = gridZBin(cz - r - sl, blo, bbase, bscale);
                    const uint b1 = gridZBin(cz + r + sl, blo, bbase, bscale);
                    const uint run = (b1 >= GRID_ZBINS - 1u ? 0xFFFFFFFFu : ((2u << b1) - 1u)) & ~((1u << b0) - 1u);
                    if ((run & bins) == 0u) continue;
                }
                atomicOr(s_tileMask[i >> 5u], 1u << (i & 31u));
            }
        }
        barrier();
    }
    CLK_MARK(TILE_LIGHTS);
    if (!froxel && lid < TILE_LIGHT_WORDS) light_grid[deferTileIndex() * TILE_LIGHT_WORDS + lid] = s_tileMask[lid];
#if DEFER_CLASSIFY
    if (lid == 0u)
    {
        uint tileBits = 0u;
        [[unroll]] for (uint w = 0u; w < TILE_LIGHT_WORDS; ++w) tileBits |= s_tileMask[w];
        if (tileBits != 0u) tl_tiles[atomicAdd(tl_args[0], 1u)] = deferTileIndex();
    }
#endif
    CLK_MARK(STORE);
}
#endif

#if DEFER_RT_TRACE || CLEAN_DEFER_PASS == 13
// ---- RT REFLECTION helpers (#859; see HYBRID RT REFLECTIONS in the header) ----
// Roughness threshold byte (bits 24-31 of the flags; the reflect passes' DEFER_FLAG_RT_MARK byte).
float rtrRoughThr() { return float(g_draw_push.flags >> 24u) * (1.0 / 255.0); }
// The splice's fade over the top quarter of the threshold.
float rtrFade(float rough) { const float thr = rtrRoughThr(); return 1.0 - smoothstep(0.75 * thr, thr, rough); }
// The receiver distance fade (camd: camera -> receiver, m) over the last 20 % of the receiver gate
// (RenderVKRTReflectionsMaxRecvDist): 0 at the gate itself, so the gate shows no ring.
float rtrDistFade(float camd, float maxd) { return 1.0 - smoothstep(0.8 * maxd, maxd, camd); }
// Eye-relative view direction through render position spx (the depth-independent ray).
vec3 rtrViewDir(vec2 spx)
{
    const vec2 ndc = spx / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, 0.5, 1.0);
    return normalize(h.xyz / h.w);
}
// The camera's angle per render pixel (rad).
float rtrPixelAngle(vec2 spx) { return length(rtrViewDir(spx + vec2(1.0, 0.0)) - rtrViewDir(spx)); }
// World position of render pixel px (its centre) from the pre-pass depth (deferPosition without
// g_frag_xy: any pixel).
vec3 rtrPositionAt(ivec2 px)
{
    const float d = texelFetch(uDepthG, px, 0).r;
    const vec2 ndc = (vec2(px) + 0.5) / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, d, 1.0);
    return pc.u_cam_time.xyz + h.xyz / h.w;
}
#endif

#if DEFER_RT_TRACE
#define RTR_BLEND_LAYERS 4        // alpha-blend layers composited over a reflection hit
#define RTR_FWD_MIN_ALPHA 0.1     // pass 14: the front-most blend layer that counts as a reflector

// HARDWARE BACK-FACE CULLING of the reflection rays (RenderVKRTReflectionsHWCull, rtrOpts bit 5).
// rtrClosest skips single-sided back faces (the raster's cull): a candidate (non-opaque) one in
// the shader (rtCandidateFront), a committed opaque one by re-tracing past it -- up to 3 full
// traversals. With this bit the ray also asks the hardware to cull them in traversal: no
// candidate, no re-trace. It reaches ONLY the TLAS instances WITHOUT
// VK_GEOMETRY_INSTANCE_TRIANGLE_FACING_CULL_DISABLE_BIT_KHR (clean_rt_instances.comp geomFlags /
// rigCullFlags), and those are single-sided by construction (flag 256 clear; never water,
// terrain or alpha-blend): single-sided static alpha-mask leaves (FACING_LEAF) and single-sided
// rigged meshes / worn attachments, own avatar's too (FACING_RIG). Every other instance -- static
// opaque walls and floors, terrain, water, alpha-blend, double-sided materials -- stays
// CULL_DISABLE because the SUN / MOON SHADOW rays need them two-sided (they cull the opposite
// facing, rtFolShadowFlags): the flag is a no-op on them and the shader's rule (above) still
// decides, unchanged. So the hardware culls exactly the faces the shader would have skipped.
// FACING CONVENTION (clean_rt_common.glsl FOLIAGE LIGHT TRANSMISSION): hardware front <=> the
// raster's front (CCW seen from the ray origin) for every instance -- mirrored transforms carry
// FLIP_FACING -- so the reflection ray (a camera-like ray) culls BACK faces. The facing-flip debug
// toggle (RenderVKRTFoliageFacingFlip, frame info foliage_rt bit 2) inverts it, as it inverts the
// shadow rays' and the foliage transmission ray's.
uint rtrReflCullFlags()
{
    if ((rtrOpts() & 32u) == 0u) return gl_RayFlagsNoneEXT;
    const bool flip = (uint(ssr.foliage_rt.x + 0.5) & 4u) != 0u;
    return flip ? gl_RayFlagsCullFrontFacingTrianglesEXT : gl_RayFlagsCullBackFacingTrianglesEXT;
}
// TRACE COST (#859 perf; pass 11 flushes them into rtt_cost while the host asks: rtrOpts bit 7).
// Per invocation = one reflection ray. RTR_COST_* are the header words.
uint  g_rc_trav  = 0u;     // ray-query traversals of the closest-hit walk (segments + back-face re-traces)
uint  g_rc_retr  = 0u;     // back-face re-traces (rtrClosest's k loop past its first pass)
uint  g_rc_cand  = 0u;     // non-opaque candidates the closest-hit walk processed in the shader
uint  g_rc_flags = 0u;     // RC_* below
float g_rc_hitd  = -1.0;   // the opaque hit's distance (m), -1 = a miss
float g_rc_segd  = 0.0;    // the size-class segment boundary (m), 0 = one segment
float g_rc_rho   = -1.0;   // the ray's density (the gradient), -1 = level mode
// AVATAR ALPHA-MASK candidates (rigged / worn / own avatar, cutoff > 0) of the closest-hit walk:
// alpha-tested in the shader, rejected (alpha below the cutoff at the test LOD), and accepted only
// thanks to the coverage scale (rt_mask_boost: the raster's maskTestAlpha rule).
uint  g_rc_amtest = 0u;
uint  g_rc_amrej  = 0u;
uint  g_rc_amresc = 0u;
// (#87 GI, GI_F_BACK_STOP) the closest-hit walk STOPS at a single-sided back face instead of re-tracing
// past it (g_rc_back: the returned hit is such a face) -- a GI ray whose first surface is a back face
// started inside geometry / slipped into a seam: it must see that surface's dark inside, not escape.
// The stop's window on the back face's DEPTH behind its plane from the origin (GI: every depth): (#87 x
// #859) the reflection rays stop only within RTR_BACK_STOP_NEAR .. RTR_BACK_STOP_FAR (rtrTraceRefl),
// and past the window resume with g_rc_back_rfl (their hardware culling: a back face out there no
// longer matters).
bool  g_rc_back_stop = false;
bool  g_rc_back = false;
vec2  g_rc_back_win = vec2(0.0, 1e30);
uint  g_rc_back_rfl = gl_RayFlagsNoneEXT;
#define RC_RETRACED  1u    // re-traced past a single-sided back face at least once
#define RC_BUDGET    2u    // a walk hit RT_CANDIDATE_BUDGET
#define RC_SEGMENTED 4u    // traced in size-class segments
#define RC_SEG2      8u    // the far segment ran (the near one missed)
#define RC_HIT1      16u   // the hit came from the near segment
#define RC_HIT2      32u   // ... from the far segment
#define RTR_COST_HIST      0    // 6 bins of the opaque hit distance: 0-2, 2-4, 4-8, 8-16, 16-32, 32+ m
#define RTR_COST_MISS      6    // rays without an opaque hit
#define RTR_COST_TRAV      7    // closest-hit traversals
#define RTR_COST_RETR      8    // back-face re-traces
#define RTR_COST_RETRACED  9    // rays re-traced at least once
#define RTR_COST_CAND      10   // non-opaque candidates processed
#define RTR_COST_BUDGET    11   // rays that hit the candidate budget
#define RTR_COST_SEGMENTED 12   // rays traced in segments
#define RTR_COST_SEG2      13   // rays whose far segment ran
#define RTR_COST_HIT1      14   // hits from the near segment
#define RTR_COST_HIT2      15   // hits from the far segment
#define RTR_COST_SEGD      16   // sum of the segment boundary (dm, segmented rays)
#define RTR_COST_RHO       17   // 4 bands of the cast rays' density: >= 1/2, [1/8, 1/2), [1/32, 1/8), < 1/32
#define RTR_COST_RHOSUM    21   // sum of the cast rays' density x 256
#define RTR_COST_AMTEST    22   // avatar alpha-mask candidates alpha-tested (closest-hit walk)
#define RTR_COST_AMREJ     23   // ... of them rejected (alpha below the cutoff); rescued: rtt_amresc
// Closest hit for a reflection / camera ray over `mask` (rflags: extra ray flags -- the reflection
// rays' back-face culling, RenderVKRTReflectionsHWCull): alpha-mask holes tested in the
// candidates at the material cutoff (blend candidates -- pass 14's camera ray -- at blendMin),
// single-sided back faces skipped (the raster's cull: opaque instances commit without a
// candidate test, so a back face there re-traces past it; clean_probe_rt.comp's rules).
RtHit rtrClosest(vec3 o, vec3 d, float tmin, float tmax, uint mask, float blendMin, uint rflags)
{
    RtHit h;
    h.hit = false;
    g_rc_back = false;
    for (int k = 0; k < 3; ++k)
    {
        // (Xid 109) a back face committed within max(dist x 1e-5, 1e-4) of tmax steps the re-trace's
        // tmin PAST tmax -- an invalid ray query (tmin <= tmax is required; undefined otherwise, a
        // non-terminating traversal on NVIDIA). Nothing is left on the interval: a miss. And a ray
        // the caller built from non-finite inputs (rtRaySane): a miss.
        if (!(tmin < tmax)) return h;
        if (!rtRaySane(o, tmin, d, tmax)) return h;
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, uTLAS, rflags, mask, o, tmin, d, tmax);
        ++g_rc_trav;
        uint n_cand = 0u;
        while (rayQueryProceedEXT(rq))
        {
            if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
            if (++n_cand > RT_CANDIDATE_BUDGET)
            {   // over budget (G-7): the nearest hit committed so far stands
                g_rc_flags |= RC_BUDGET;
                rayQueryTerminateEXT(rq);
                break;
            }
            const uint id   = rtHitInstance(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false)),
                                            uint(rayQueryGetIntersectionGeometryIndexEXT(rq, false)));
            const uint prim = RT_HIT_PRIM(rq, false, id);
            const vec2 bc   = rayQueryGetIntersectionBarycentricsEXT(rq, false);
            const float t   = rayQueryGetIntersectionTEXT(rq, false);
            const mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, false);
            const uint fl = rtIdIn(id) ? rt_instances[id].flags : 256u;   // (#874 guard)
            if ((fl & (256u | 2048u)) == 0u && !rtCandidateFront(id, prim, d, o2w)) continue;
            float cutoff; bool blend; vec3 col;
            const float a = rtCandidateAlphaCol(id, prim, bc, t, d, o2w, cutoff, blend, col);
            bool keep = a >= (blend ? blendMin : cutoff);
            // RenderVKRTReflectionsMaskTest 3 (A/B): every alpha-mask candidate solid -- whatever
            // still does not show never reaches the alpha test (class / culling / geometry).
            if (!blend && rtrMaskMode() == 3u) keep = true;
            if ((rtrOpts() & 128u) != 0u && !blend && cutoff > 0.0
                && ((fl & (512u | 8192u)) != 0u || (rtIdIn(id) && (rt_geom[id].z & 0x80000000u) != 0u)))
            {   // (trace-cost counters: an avatar's alpha-mask candidate)
                ++g_rc_amtest;
                if (a < cutoff) ++g_rc_amrej;
                else if (a / rt_mask_boost < cutoff) ++g_rc_amresc;
            }
            if (keep) rayQueryConfirmIntersectionEXT(rq);
        }
        g_rc_cand += min(n_cand, RT_CANDIDATE_BUDGET);
        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT)
            return h;   // miss
        h.hit = true;
        h.dist = rayQueryGetIntersectionTEXT(rq, true);
        h.instance = rtHitInstance(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)),
                                   uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true)));
        if (!rtIdIn(h.instance)) { h.hit = false; return h; }   // (#874 guard: a bad id is a miss)
        h.prim = RT_HIT_PRIM(rq, true, h.instance);
        h.bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        h.front = rayQueryGetIntersectionFrontFaceEXT(rq, true);
        h.o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
        const uint fl = rt_instances[h.instance].flags;
        if ((fl & (256u | 2048u)) != 0u || rtCandidateFront(h.instance, h.prim, d, h.o2w)) return h;
        // (GI_F_BACK_STOP) a back face stops the walk -- except TERRAIN (instance flag 32): the
        // raster's terrain LOD and the ray-traced heightfield differ by centimetres to decimetres on
        // hills, so receivers just below the traced terrain see its underside first; stopping there
        // painted dark patches over the ground (moving with the TAA jitter). Terrain re-traces past
        // it as before: a heightfield is no wall a leak can slip through.
        if (g_rc_back_stop && (fl & 32u) == 0u)
        {
            // the window is on the DEPTH behind the face's plane (dist x |d . n|), not the distance along
            // the ray: angle-invariant -- a grazing exit through a face microns away stays microns deep,
            // a grazing walk through a 1 m wall stays 1 m deep
            float depth = h.dist;
            if (g_rc_back_win.x > 0.0 || g_rc_back_win.y < 1e29)
            {
                vec3 p0, p1, p2;
                rtTriPositions(h.instance, h.prim, p0, p1, p2);
                const mat3 M = mat3(h.o2w);
                const vec3 c = cross(M * (p1 - p0), M * (p2 - p0));
                const float cl = length(c);
                if (cl > 0.0) depth = h.dist * abs(dot(d, c)) / cl;
            }
            if (depth >= g_rc_back_win.x && depth <= g_rc_back_win.y) { g_rc_back = true; return h; }
            if (depth > g_rc_back_win.y) rflags = g_rc_back_rfl;
        }
        tmin = h.dist + max(h.dist * 1e-5, 1e-4);
        h.hit = false;
        if (k < 2) { ++g_rc_retr; g_rc_flags |= RC_RETRACED; }
    }
    return h;
}

// SIZE-CLASS SEGMENTS (#859 perf; RenderVKRTReflectionsSizeClasses, rtrOpts bit 6; push rtr2):
// the small static opaque class (clean_rt_common.glsl SIZE CLASS: world bounds below rtr2.x)
// leaves a reflection ray past the distance D where it is below rtr2.y REFLECTED PIXELS -- the
// ray cone's footprint rt_cone_width0 + t x rt_cone_spread (the reflected pixel at distance t,
// the one the hit's texture LOD and the resolve's spatial filter already blur over: 1 render
// pixel x the ray's pixel scale, spreading with the pixel angle + the receiver's roughness)
// reaches rtr2.x / rtr2.y there. So a sharp mirror (the cone spreads by the pixel angle alone)
// keeps every small object out to hundreds of metres, a rough floor drops them a few metres
// out. rtr2.y = 0: the fixed distance rtr2.z. Returns tmax when the ray is one segment.
float rtrSmallDist(float tmax)
{
    if ((rtrOpts() & 64u) == 0u || !(g_draw_push.rtr2.x > 0.0)) return tmax;   // (push: uniform)
    float D = g_draw_push.rtr2.z;
    if (g_draw_push.rtr2.y > 0.0)
        D = (g_draw_push.rtr2.x / g_draw_push.rtr2.y - rt_cone_width0) / max(rt_cone_spread, 1e-6);
    return clamp(D, 0.0, tmax);
}
// A candidate's instance is in the small class's size bound (the pass A rule -- the diagonal of
// its local box through the hit transform's axis scales below rtr2.x); rigged never. The blend
// layers apply it in the shader past rtrSmallDist (alpha-blend has no size-class bit: its
// candidates are skipped before their texture fetch and shading instead).
bool rtrInstSmall(uint id, mat4x3 o2w)
{
    const float S = g_draw_push.rtr2.x;
    if (!(S > 0.0) || !rtIdIn(id) || (rt_geom[id].z & 0x80000000u) != 0u) return false;
    // (worn rigid attachments -- other avatars' and the own avatar's -- never: pass A's rule,
    // maskClassSized, classes only static unworn instances; a pair of glasses or a lash card is
    // well under the bound and must not drop out of a reflection of its wearer's face)
    if ((rt_instances[id].flags & (512u | 8192u)) != 0u) return false;
    const vec3 e = abs(rt_instances[id].aabb_max.xyz - rt_instances[id].aabb_min.xyz)
                 * vec3(length(o2w[0]), length(o2w[1]), length(o2w[2]));
    return dot(e, e) < S * S;
}

// The RTR_BLEND_LAYERS nearest alpha-blend surfaces on [0, tmax] of a reflection ray, composited
// front to back over `behind` (the opaque hit's colour, or the env). Every blend candidate is a
// layer (no confirm: the query visits them all, in no order; the nearest are kept by insertion),
// shaded cheaply: texel x factor x tint (rtCandidateAlphaCol, at its cone LOD) lit by the
// receiver's ambient + the sun / moon at |N.L| of the layer's triangle (unshadowed), fullbright
// unlit; alpha = texel alpha x factor x tint. Returns the composite; `layers` = how many.
// smallD: past it, candidates of small instances are skipped (rtrSmallDist / rtrInstSmall).
vec3 rtrBlendLayers(vec3 o, vec3 d, float tmax, vec3 behind, vec3 sunlit, vec3 amblit, float smallD, out uint layers)
{
    float lt[RTR_BLEND_LAYERS];
    vec4  lc[RTR_BLEND_LAYERS];   // (rgb = the layer's unlit colour, a = its alpha)
    vec4  ln[RTR_BLEND_LAYERS];   // (xyz = its unit triangle normal, w = |N.L|; w < 0 = fullbright)
    [[unroll]] for (int j = 0; j < RTR_BLEND_LAYERS; ++j) { lt[j] = 3.0e38; lc[j] = vec4(0.0); ln[j] = vec4(0.0); }
    const vec3 L = atmosLightDir();
    float tmin = 0.0;
    if (!rtRaySane(o, tmin, d, tmax)) { layers = 0u; return behind; }   // (Xid 109: an invalid ray -- no layers)
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTLAS, gl_RayFlagsNoneEXT, RT_MASK_BLEND, o, tmin, d, tmax);
    uint n_cand = 0u;
    while (rayQueryProceedEXT(rq))
    {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        if (++n_cand > RT_CANDIDATE_BUDGET) { rayQueryTerminateEXT(rq); break; }
        float t         = rayQueryGetIntersectionTEXT(rq, false);
        // Past the farthest of a FULL list: it could never be kept -- no fetch, no shading.
        if (t >= lt[RTR_BLEND_LAYERS - 1]) continue;
        const uint id   = rtHitInstance(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false)),
                                        uint(rayQueryGetIntersectionGeometryIndexEXT(rq, false)));
        const uint prim = RT_HIT_PRIM(rq, false, id);
        const vec2 bc   = rayQueryGetIntersectionBarycentricsEXT(rq, false);
        const mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, false);
        const uint fl = rtIdIn(id) ? rt_instances[id].flags : 256u;   // (#874 guard)
        if ((fl & 256u) == 0u && !rtCandidateFront(id, prim, d, o2w)) continue;
        if (t > smallD && rtrInstSmall(id, o2w)) continue;   // (size-class segments: sub-footprint here)
        float cutoff; bool blend; vec3 col;
        const float a = clamp(rtCandidateAlphaCol(id, prim, bc, t, d, o2w, cutoff, blend, col), 0.0, 1.0);
        RT_SHADE_STAT(3, 1u);
        if (a <= 1.0 / 255.0) continue;
        // (lit after the walk -- only the kept layers: the GI frames' shadow ray is per layer)
        vec4 nw = vec4(0.0, 0.0, 1.0, -1.0);   // fullbright
        if ((fl & 4096u) == 0u)
        {
            vec3 p0, p1, p2;
            rtTriPositions(id, prim, p0, p1, p2);
            const mat3 M = mat3(o2w);
            const vec3 n = cross(M * (p1 - p0), M * (p2 - p0));
            const float nn = dot(n, n);
            const vec3 nu = nn > 1e-30 ? n * inversesqrt(nn) : vec3(0.0, 0.0, 1.0);
            nw = vec4(nu, nn > 1e-30 ? abs(dot(nu, L)) : 0.0);
        }
        vec4 c = vec4(col, a);
        const float t0 = t;
        // insertion into the ascending list (the farthest drops off the end)
        [[unroll]] for (int j = 0; j < RTR_BLEND_LAYERS; ++j)
        {
            if (t < lt[j])
            {
                const float tt = lt[j]; const vec4 tc = lc[j]; const vec4 tn = ln[j];
                lt[j] = t; lc[j] = c; ln[j] = nw;
                t = tt; c = tc; nw = tn;
            }
        }
        // This candidate became the farthest layer of a full list: commit it, so traversal culls
        // every node beyond its distance (nothing past the farthest kept layer can enter the list;
        // committing a nearer insertion would cull layers that still belong). The committed hit is
        // never read: the layers are the result.
        if (lt[RTR_BLEND_LAYERS - 1] == t0) rayQueryConfirmIntersectionEXT(rq);
    }
    // (#87 x #859) GI FRAMES (RenderVKRTReflectionsHitOcclusion): the layers were lit by the
    // RECEIVER's sky ambient + the sun UNSHADOWED -- an alpha-blend panel inside a sealed room came
    // back sky / sun-lit in every reflection of it. Now: the sun / moon through one shadow ray from the
    // layer (every world blocker, alpha-tested; the layer's own face excluded by the lift), the ambient
    // from the radiance cache at the layer where it has a cell, else per RenderVKGIHitAmbient (0 / 3:
    // none; 1 / 2: the receiver's sky ambient, as before).
    bool giLayers = false;
    uint gamb = 0u;
#if CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 14
    giLayers = giFrameOn() && (gi.cfg.x & GI_F_ON) != 0u && (rtrOpts() & 1024u) != 0u;
    if (giLayers) gamb = uint(gi.prm.w + 0.5);
#endif
    layers = 0u;
    vec3 sum = vec3(0.0);
    float T = 1.0;
    [[unroll]] for (int j = 0; j < RTR_BLEND_LAYERS; ++j)
    {
        if (lt[j] < 1.0e38)
        {
            vec3 lit;
            if (ln[j].w < 0.0) lit = lc[j].rgb * atmosHdrScale();   // fullbright
            else if (!giLayers) lit = lc[j].rgb * (amblit + sunlit * ln[j].w);
            else
            {
#if CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 14
                const vec3 Pl = o + d * lt[j];
                const vec3 nv = dot(ln[j].xyz, d) > 0.0 ? -ln[j].xyz : ln[j].xyz;   // (toward the ray)
                vec3 lamb = (gamb == GI_HIT_AMB_PROBES || gamb == GI_HIT_AMB_CACHE) ? amblit : vec3(0.0);
                if (gamb >= GI_HIT_AMB_CACHE && giCacheSlots() != 0u)
                {
                    float edge;
                    vec3 E;
                    if (giCacheRead(giCacheFind(giCellKey(Pl, nv, pc.u_cam_time.xyz, edge)), E))
                    {
                        E = max(E, vec3(0.0)) * max(gi.prm.x, 0.0);
                        lamb = atmosClassic() ? atmosLinearToSrgb(E) : E;
                    }
                }
                float sv = 0.0;
                if (ln[j].w > 1e-3 && max(max(sunlit.r, sunlit.g), sunlit.b) > 1e-4)
                {
                    const vec3 ns = dot(ln[j].xyz, L) < 0.0 ? -ln[j].xyz : ln[j].xyz;   // (the lit side)
                    sv = traceShadowRay(offsetRayOrigin(Pl + ns * 0.01, ns), L, 0.0, RTR_OCC_FAR, RT_MASK_WORLD_BLOCK);
                }
                lit = lc[j].rgb * (lamb + sunlit * (ln[j].w * sv));
#else
                lit = lc[j].rgb * (amblit + sunlit * ln[j].w);
#endif
            }
            sum += T * lc[j].a * lit;
            T *= 1.0 - lc[j].a;
            ++layers;
        }
    }
    return sum + T * behind;
}

// One reflection ray from o along R (receiver P: the haze start), up to tmax: the closest hit
// (every class but blend) shaded by clean_rt_shade.glsl's main-view path, then (blend) the blend
// layers in front of it. env: what stands where nothing is hit (the blend layers composite over
// it). Returns the radiance; tHit = the hit distance (tmax when only blend layers were met),
// 0 = nothing met (the env stands as it is). The caller sets the ray cone (rt_cone_*).
// (#860 RT mirrors) TLAS classes the closest-hit walk leaves out: a hero mirror without its
// Dynamic flag shows no avatars (RT_MASK_RIGGED | RT_MASK_ATTACH), as the planar capture draws
// none. 0 (every other kernel): unchanged.
uint g_rtr_mask_drop = 0u;
// (#87 x #859) REFLECTION BACK-FACE STOP (RenderVKRTReflectionsBackFaceStop, rtrOpts bit 14; passes
// 11 / 14): a reflection ray whose first surface is a SINGLE-SIDED OPAQUE BACK FACE between
// RTR_BACK_STOP_NEAR and RTR_BACK_STOP_FAR deep (the origin's distance behind the face's plane --
// angle-invariant, unlike the distance along the ray) started INSIDE a solid -- it stops there and returns
// black (the solid's inside), instead of re-tracing past it (or culling it in hardware) and walking
// out through the solid's far side. The leak it closes: a receiver at a CONCAVE CONTACT EDGE (two box
// prims meeting at a room's corner) is rebuilt from depth a hair (microns: rtReceiverOrigin lifts
// by the depth error only, along its OWN face's normal) behind the NEIGHBOURING prim's face. Its R,
// kept above its own face only, may head into that neighbour: the neighbour's inner face is behind
// the origin, its outer face is a back face -- skipped -- so the ray left the sealed room, hit the
// terrain / the world outside, and that hit's occlusion ray (rtrHitEnv) truly escaped to the sky:
// lit lines along every corner seam of the owner's gold cube, which SSR then spread over the walls.
//   * NEAR (1 mm): a receiver a hair inside its own / a neighbour prim whose R heads into the room
//     leaves through that prim's face microns deep (however grazing R is) -- a back face it must pass
//     (re-trace, as before).
//   * FAR (2 m, wall-thickness scale: a grazing R through a 1 m wall is still 1 m deep): single-sided
//     faces seen from behind are ordinary geometry (one-sided planes and meshes, hollow cuts) that
//     the raster culls; one more than FAR behind the receiver is passed as before (and the walk
//     resumes the hardware culling: one extra traversal at most). One nearer still turns black.
//   * only committed OPAQUE single-sided faces stop it: alpha-mask / blend candidates' back faces are
//     skipped in the candidate loop (foliage, alpha cards unchanged), double-sided faces (flag 256)
//     and terrain / water (2048) are front faces from either side.
// The walk must SEE the back faces it stops at: no hardware culling over [0, FAR] while it is on.
#define RTR_BACK_STOP_NEAR 1.0e-3
#define RTR_BACK_STOP_FAR  2.0
bool g_rtr_back = false;   // (the debug view: the reflection ray stopped at a back face)
vec3 rtrTraceRefl(vec3 o, vec3 R, float tmax, vec3 P, vec3 env, bool blend, out float tHit)
{
    rt_anim_time = pc.u_cam_time.w;   // (draw time: texture animation, water waves)
    tHit = 0.0;
    g_rtr_occ = -1.0;
    g_rtr_occ_far = false;
    g_rtr_occ_bent = false;
    g_rtr_occ_layers = false;
    g_rtr_back = false;
    vec3 col = env;
    // SIZE-CLASS SEGMENTS (rtrSmallDist): [0, D] over every class, then -- only after a miss there --
    // [D, tmax] without the small static opaque class. One segment when D reaches tmax.
    const uint rmask = RT_MASK_ALL & ~RT_MASK_BLEND & ~g_rtr_mask_drop;
#if (CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 14) && !DEFER_GI_TRACE
    const bool backStop = (rtrOpts() & 16384u) != 0u;   // (push constant: uniform)
#else
    const bool backStop = false;
#endif
    const uint rfl = backStop ? gl_RayFlagsNoneEXT : rtrReflCullFlags();
    g_rc_back_stop = backStop;
    g_rc_back_win  = vec2(RTR_BACK_STOP_NEAR, RTR_BACK_STOP_FAR);
    g_rc_back_rfl  = rtrReflCullFlags();
    const float smallD = rtrSmallDist(tmax);
    RtHit h;
    h.hit = false;
    if (smallD < tmax)
    {
        g_rc_flags |= RC_SEGMENTED;
        g_rc_segd = smallD;
        if (smallD > 1e-3)
        {
            h = rtrClosest(o, R, 0.0, smallD, rmask, RT_BLEND_CUTOFF, rfl);
            if (h.hit) g_rc_flags |= RC_HIT1;
        }
        if (!h.hit)
        {
            g_rc_flags |= RC_SEG2;
            h = rtrClosest(o, R, smallD, tmax, rmask & ~RT_MASK_SMALL, RT_BLEND_CUTOFF, rfl);
            if (h.hit) g_rc_flags |= RC_HIT2;
        }
    }
    else h = rtrClosest(o, R, 0.0, tmax, rmask, RT_BLEND_CUTOFF, rfl);
    g_rtr_back = backStop && h.hit && g_rc_back;
    g_rc_back_stop = false;
    g_rc_back_win  = vec2(0.0, 1e30);
    g_rc_back_rfl  = gl_RayFlagsNoneEXT;
    // The alpha-mask test cone (rtrMaskCone) is the reflection ray's own: the hit's sun / projector
    // shadow rays (rtShadeHit) keep their footprint rule (rt_cone_* = the hit's, no coverage scale).
    rt_mask_width0 = -1.0; rt_mask_lod_bias = 0.0; rt_mask_lod_max = 64.0; rt_mask_cov_k = 0.0;
    g_rc_hitd = h.hit ? h.dist : -1.0;
    if (g_rtr_back)
    {
        // the ray started inside a solid (REFLECTION BACK-FACE STOP above): its inside -- no light,
        // never shaded (its lit side faces away); a hit, so the receiver splices it, not the env
        g_rtr_occ = 0.0;
        g_rts_terms = vec4(0.0);
        col = vec3(0.0);
        tHit = h.dist;
    }
    else if (h.hit)
    {
        RT_SHADE_STAT(4, 1u);
        RtSurface hs = rtSurfaceEval(h, R);
        float hd = h.dist;
        rtWeatherAtHit(hs, R, hd);   // #970: the lying snow in front of the hit, else the weather coat on it
        // (after the weather: the snow surface's normal when the march found snow; turned toward the
        //  side the ray arrived from)
        g_rtr_hit_ng = dot(hs.Ng, R) > 0.0 ? -hs.Ng : hs.Ng;
        g_rtr_occ = -1.0;
        // Seen from the receiver: haze over receiver -> hit (the camera -> receiver part is the
        // receiver's own, applied to the whole pixel downstream).
        vec3 c = rtShadeHit(hs, P, 0u, pc.u_cam_time.w).rgb;
        if (any(isnan(c)) || any(isinf(c))) { lgNote(LG_SSR); c = vec3(0.0); }
        col = clamp(c, vec3(0.0), vec3(LG_MAX_VALUE));
        tHit = hd;
    }
    CLK_MARK(SSR);   // (the trace + hit shading)
    if (blend)
    {
        vec3 sunlit, amblit, additive, atten;
        atmosLightTerms(P - pc.u_cam_time.xyz, vec3(0.0, 0.0, 1.0), sunlit, amblit, additive, atten);
        uint layers;
        col = rtrBlendLayers(o, R, h.hit ? tHit : tmax, col, sunlit, amblit, smallD, layers);   // (#970: tHit -- the lying snow may stand in front of the hit)
        if (layers > 0u && tHit <= 0.0) tHit = tmax;
        CLK_MARK(SHADE);
#if CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 14
        if ((rtrOpts() & 2048u) != 0u && layers > 0u) g_rtr_occ_layers = true;
#endif
    }
#if CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 14
    // HIT OCCLUSION DEBUG VIEW (RenderVKRTReflectionsHitOccDebug, rtrOpts bit 11): the reflection
    // shows what its hit's environment came from, instead of its colour (the receiver's F0 still
    // tints it): GREEN = the occlusion ray escaped to the open sky (a true miss: probes / sky along R),
    // RED = blocked (cache / 0), CYAN = blocked, but only past the reflection length (what the first
    // version wrongly counted as an escape),
    // orange between = partly (alpha-blend transmittance), + YELLOW mixed in = R grazed / crossed the
    // hit's geometric plane and was bent back onto the arrival side before tracing, WHITE = a hit without one (GI / the setting off, water,
    // fullbright), BLUE = the reflection ray itself hit nothing (the receiver's env stands);
    // + MAGENTA mixed in = alpha-blend layers composited in front, GREY = the reflection ray started
    // inside a solid and stopped at its back face (RenderVKRTReflectionsBackFaceStop: black in the
    // normal view). Pixels in their normal colours were
    // not ray traced (SSR / probe / outside the RT roughness range).
    if ((rtrOpts() & 2048u) != 0u)
    {
        vec3 dc;
        if (!h.hit) dc = vec3(0.1, 0.2, 2.0);
        else if (g_rtr_back) dc = vec3(0.6);
        else if (g_rtr_occ < 0.0) dc = vec3(2.0);
        else
        {
            dc = mix(g_rtr_occ_far ? vec3(0.0, 1.6, 2.0) : vec3(2.0, 0.0, 0.0), vec3(0.0, 2.0, 0.0), g_rtr_occ);
            if (g_rtr_occ_bent) dc = mix(dc, vec3(2.0, 2.0, 0.0), 0.4);   // (R bent onto the arrival side)
        }
        if (g_rtr_occ_layers) dc = mix(dc, vec3(2.0, 0.0, 2.0), 0.5);
        col = dc;
        if (tHit <= 0.0) tHit = tmax;   // (a miss spliced too, so it shows)
    }
    // HIT TERMS DEBUG VIEW (RenderVKRTReflectionsHitTermsDebug, rtrOpts bit 12): where a reflection
    // hit's light comes from, as shares of its total -- RED the ambient / irradiance term (the GI
    // cache / probes / sky ambient per RenderVKGIHitAmbient), GREEN the environment (specular / shiny)
    // term, BLUE the haze in-scatter between the receiver and the hit, WHITE the local lights +
    // emission; full strength whatever the total. BLACK: a hit with no light.
    // Pixels in their normal colours were not ray traced.
    if ((rtrOpts() & 4096u) != 0u && h.hit)
    {
        const vec4 t = g_rts_terms;
        const float tot = t.x + t.y + t.z + t.w;
        const vec3 share = tot > 1e-6 ? (vec3(t.x, t.y, t.w) + vec3(t.z)) / tot : vec3(0.0);
        col = share * 4.0;   // (full strength: the receiver's F0 still tints it)
        if (tHit <= 0.0) tHit = tmax;
    }
#endif
    return col;
}

// ALPHA-MASK TEST of the reflection rays (RenderVKRTReflectionsMaskTest, rtrOpts bits 8-9;
// clean_rt_common.glsl rt_mask_*). The colour cone (rt_cone_*) carries the ray density's scale
// and the receiver's roughness; a binary cut-out test at that LOD erased thin alpha-mask features
// the main view keeps (an owner's eyebrows in a mirror: Bakes on Mesh, plain alpha mips). Modes:
//   0 (default) RASTER PARITY: the test's cone = the plain pixel footprint (width0 + spread x t,
//     no density scale, no roughness), the raster's material mip bias (taaLodBias) and its
//     per-mip coverage scale (maskTestAlpha, RenderVKAlphaMipCoverage). One fetch, as before.
//   1 LEGACY: the colour cone's LOD, no coverage scale (the old rule; A/B).
//   2 MIP 0: the test at the finest mip (A/B: is it the LOD?).
//   3 OFF: every alpha-mask candidate solid (rtrClosest; A/B: does it reach the test at all?).
void rtrMaskCone(float width0, float spread)
{
    const uint mm = rtrMaskMode();
    rt_mask_width0   = (mm == 1u) ? -1.0 : width0;
    rt_mask_spread   = spread;
    rt_mask_lod_bias = (mm == 0u) ? taaLodBias(0u) : 0.0;
    rt_mask_lod_max  = (mm == 2u) ? 0.0 : 64.0;
    rt_mask_cov_k    = (mm == 0u) ? maskCoverageK() : 0.0;
}

// A G-buffer receiver's ray: the mirror direction of its shading normal, kept above the
// geometric surface (a normal map can tilt it under the facet), from the depth-rebuilt point.
// Sets the ray cone: the pixel's footprint at the receiver (x `scale` render pixels), spreading by
// the pixel angle (a planar mirror) plus a little per roughness (the hit's textures blur with the
// lobe), at the raster sampler's anisotropy.
void rtrReceiverRay(SurfaceLit s, vec3 P, vec3 V, vec3 Ng, float rough, float scale, out vec3 o, out vec3 R)
{
    R = reflect(-V, dot(s.N, V) < 0.0 ? -s.N : s.N);
    const float rn = dot(R, Ng);
    if (rn < 0.02) R = normalize(R + Ng * (0.02 - rn));
    const float camd = length(P - pc.u_cam_time.xyz);
    o = rtReceiverOrigin(P, Ng, camd, 0.0);   // (depth-rebuilt receiver: its error)
    const float pa1 = rtrPixelAngle(g_frag_xy);
    const float pa = pa1 * scale;
    rt_cone_width0 = camd * pa;
    rt_cone_spread = pa + 0.25 * rough;
    rt_cone_aniso  = max(g_draw_push.rtr.w, 1.0);
    rtrMaskCone(camd * pa1, pa1);   // (the alpha-mask test: one render pixel's footprint)
}
#endif

#if DEFER_SHADOW
// ---- SHADOW: the pixel's shadowed projectors (the combine's localLight reads them) ----
// The cluster's leading SHADOWED run (clean_lights.comp lists shadowed projectors first;
// clusterShadowedLen), in list order, as the RT mask pass picks its traced projectors;
// gated with localLight's own tests up to its visibility call (range, attenuation, the
// light cutoff fade, projected frustum, N.L > 0 -- a superset of where it evaluates the
// visibility, so every projector it would shadow gets a slot while 4 fit). The visibility
// is the uber kernel's own (projectorVisibility: the atlas PCF, or the RT mask's slots
// through its depth-aware upsample). OVERFLOW (the RT mask's rule, clean_lights_common.glsl
// THE REST SLOT): past 4 projectors slot 3 becomes the REST slot -- every further projector's
// visibility (each resolved as above) folded into one ratio weighted by its unshadowed light
// at the pixel (gobo x attenuation, deferProjRestW); the combine gives it to any shadowed
// projector it finds in no slot. Lights 254 / 255 (the ids are 8-bit, 255 = REST) always join
// the REST. Before, a 5th+ overlapping shadowed projector was lit UNSHADOWED here.
// The unshadowed light of projector li at P (the REST ratio's weight): localLight's dlit x
// attenuation x cutoff fade -- 0 where it is gated off.
vec3 deferProjRestW(uint li, vec3 P)
{
    const Light L = lights[li];
    const vec3 lv = L.pos_radius.xyz - P;
    const float dist = length(lv);
    if (!(dist < L.pos_radius.w)) return vec3(0.0);
    float atten = legacyAtten(dist / L.pos_radius.w, L.color_falloff.w);
    if (atten <= 0.0) return vec3(0.0);
    atten *= lightCutoffFade(atten, L.color_falloff.rgb);
    vec4 ptc = L.proj_mat * vec4(P, 1.0);
    if (!(ptc.w > 0.0)) return vec3(0.0);
    ptc.xyz /= ptc.w;
    return max(projDiffuse(L, -dot(lv, L.proj_axis.xyz), clamp(ptc.xy, 0.0, 1.0)) * atten, vec3(0.0));
}
uvec4 deferResolveProjectors(SurfaceLit s, vec3 P)
{
    uvec4 o = uvec4(0u);
    const uint count = uint(linfo.cam_pos.w);
    if (count == 0u) return o;
    const uint c = mainClusterFrag(P);
    const uint n = clusterShadowedLen(cluster_count[c]);
    RtMaskTaps taps;              // RT-mask upsample taps, built on the first ray-traced projector
    bool tapsOk = false;
    uint k = 0u;
    vec3 restN = vec3(0.0), restD = vec3(0.0);   // the REST ratio's shadowed / unshadowed light
    bool rest = false;
    [[dont_unroll]] for (uint i = 0u; i < n; ++i)   // (cluster run: a run-time trip count)
    {
        const uint li = cluster_index[c * CLUSTER_CAP + i];
        if (li >= count) continue;
        const vec4 pr = lights[li].pos_radius;
        const vec3 lv = pr.xyz - P;
        const float d2 = dot(lv, lv);
        if (d2 >= pr.w * pr.w) continue;
        const Light L = lights[li];
        if (L.proj_origin.w < 0.5 || L.tex.z == 0u) continue;
        if (pshadow[L.tex.z - 1u].params.w < 0.5) continue;
        // (#85 phase 2) the stochastic sampler carries its shadowed light: no slot, no lookup
        if ((g_draw_push.flags & DEFER_FLAG_PSTOCH) != 0u && projStochEligible(L)) continue;
        const float dist = sqrt(d2);
        if (dist >= L.pos_radius.w) continue;
        const float atten = legacyAtten(dist / L.pos_radius.w, L.color_falloff.w);
        if (atten <= 0.0 || lightCutoffFade(atten, L.color_falloff.rgb) <= 0.0) continue;
        vec4 ptc = L.proj_mat * vec4(P, 1.0);
        if (ptc.z < 0.0) continue;
        ptc.xyz /= ptc.w;
        if (ptc.z <= 0.0 || ptc.x <= 0.0 || ptc.x >= 1.0 || ptc.y <= 0.0 || ptc.y >= 1.0) continue;
        if (dot(s.N, normalize(L.proj_origin.xyz - P)) <= 0.0) continue;
        const vec3 v = clamp(dsFiniteNote(vec4(projectorVisibility(L, li, P, s.N, taps, tapsOk), 0.0)).rgb,
                             vec3(0.0), vec3(1.0));
        // its own slot while one is free (slot 3 stays the REST's once the REST is open), else
        // the REST; lights 254 / 255 cannot be named in 8 bits (255 = REST): always the REST
        const bool big = li >= PROJ_DEFER_REST_ID - 1u;
        if (big || k >= (rest ? 3u : 4u))
        {
            if (k == 4u)
            {
                // slot 3's projector moves into the REST (its byte-encoded, sqrt visibility)
                const uint l3 = ((o.x >> 24u) & 0xFFu) - 1u;
                const vec3 v3 = vec3(float((o.y >> 24u) & 0xFFu), float((o.z >> 24u) & 0xFFu), float((o.w >> 24u) & 0xFFu)) / 255.0;
                const vec3 w3 = deferProjRestW(l3, P);
                restN += w3 * v3 * v3;
                restD += w3;
                o &= uvec4(0x00FFFFFFu);
                k = 3u;
            }
            const vec3 w = deferProjRestW(li, P);
            restN += w * v;
            restD += w;
            rest = true;
            continue;
        }
        const uvec3 e = uvec3(sqrt(v) * 255.0 + 0.5);
        // x: the ids, y / z / w: the R / G / B byte planes (uVisProj layers 0..3), byte k = slot k
        o.x |= (li + 1u) << (k * 8u);
        o.y |= e.r << (k * 8u);
        o.z |= e.g << (k * 8u);
        o.w |= e.b << (k * 8u);
        ++k;
    }
    if (rest)
    {
        // THE REST SLOT (k <= 3 here): per channel, the luminance ratio where the rest barely has
        // that channel; no light in it at all (gated to 0 everywhere): 0, never the old 1
        const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
        const float dl = dot(restD, lw);
        const float rl = dl > 1e-8 ? clamp(dot(restN, lw) / dl, 0.0, 1.0) : 0.0;
        vec3 rv;
        for (int ch = 0; ch < 3; ++ch) rv[ch] = restD[ch] > 1e-3 * dl ? clamp(restN[ch] / restD[ch], 0.0, 1.0) : rl;
        const uvec3 e = uvec3(sqrt(rv) * 255.0 + 0.5);
        o.x |= PROJ_DEFER_REST_ID << (k * 8u);
        o.y |= e.r << (k * 8u);
        o.z |= e.g << (k * 8u);
        o.w |= e.b << (k * 8u);
    }
    return o;
}

void DEFER_MAIN()
{
#if CLEAN_DEFER_PASS == 10
    // (#831) SHADOW + CLASSIFY: the tile build first, by every lane (barriers inside), on this
    // pixel's own G2 surface test and P -- which the shadow body below then reuses.
    const uint lid = gl_LocalInvocationIndex;
