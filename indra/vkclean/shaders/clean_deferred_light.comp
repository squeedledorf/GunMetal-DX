                // revealed this texel, or a thin strand's texel had none) -- extra neighbour taps at a
                // SMALL radius (<= 3 texels: along a strand, beside a silhouette, where the wide taps
                // above rarely land on the same surface), so the texel does not restart from M = 1.
                // Also at RenderVKGI 2. Bounded: up to 8 taps, only on such texels; still one
                // visibility ray for the pick.
                const uint extra = min(uint(gi.prm4.z + 0.5), 8u);
                if (keptT == 0u && extra > 0u)
                {
                    const float rad2 = min(max(gi.prm2.z, 1.0), 3.0);
                    [[dont_unroll]] for (uint t = 0u; t < extra; ++t)
                    {
                        const float a = 6.2831853 * giRand(rng);
                        const float rr = rad2 * sqrt(max(giRand(rng), 0.1));
                        const ivec2 q = qt + ivec2(round(vec2(cos(a), sin(a)) * rr));
                        if (q == qt) continue;
                        const float dz = dot(grad, vec2(q - qt));
                        const float ws = giTap(q, D, pl, pw + dz, max(0.05 * pw, 0.05) + 0.25 * abs(dz), P, N, mcap, yt,
                                               pt, Mt, tc);
                        if (ws > 0.0)
                        {
                            wsum += ws; Msum += Mt; ++keptS; wAll += ws;
                            if (tc == 2u) wChg += ws;
                            if (giRand(rng) * wsum < ws) { y = yt; py = pt; src = 2u; yChg = tc; }
                        }
                    }
                }
