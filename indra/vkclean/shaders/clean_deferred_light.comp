// ---- (GI-2 / GI-3) RESERVOIRS (clean_gi_common.glsl): 2 uvec4 per texel and parity ----
uint giResIndex(ivec2 q, ivec2 D, uint layer) { return 2u * (layer * uint(D.x * D.y) + uint(q.y * D.x + q.x)); }
void giResStore(ivec2 q, ivec2 D, uint layer, GiSample y, float W, float M)
{
    const uint i = giResIndex(q, D, layer);
    gi_res[i] = uvec4(floatBitsToUint(y.xs), floatBitsToUint(max(W, 0.0)));
    gi_res[i + 1u] = uvec4(giPackN(y.ns), packHalf2x16(clamp(y.L.rg, vec2(0.0), vec2(60000.0))),
                           packHalf2x16(vec2(clamp(y.L.b, 0.0, 60000.0), clamp(M, 0.0, 60000.0))),
                           packHalf2x16(vec2(clamp(y.dist, 0.0, 60000.0), clamp(y.cosv, 0.0, 1.0))));
}
// (GI_F_LIGHT_CHG, #980) One changed-light record's unshadowed diffuse light at X (Nx: the hit's
// geometric normal, facing the receiver) -- the hit shading's range / attenuation (clean_rt_shade.glsl
// rtHitLocalLights; albedo 1, a projector untextured: an upper bound of what it adds to the stored
// radiance, legacy and PBR alike). reach: the walk's own reach test (range, attenuation; the caller
// tests a projector's frustum).
vec3 giChgLight(vec4 pr, vec4 cf, vec3 X, vec3 Nx, bool proj, vec3 apex, float amb, out bool reach)
{
    reach = false;
    const vec3 lv = pr.xyz - X;
    const float d2 = dot(lv, lv);
    if (!(d2 < pr.w * pr.w)) return vec3(0.0);
    const float d = sqrt(d2);
    const float at = legacyAtten(d / pr.w, cf.w);
    if (at <= 0.0) return vec3(0.0);
    reach = true;
    const vec3 la = proj ? apex - X : lv;
    const vec3 l = la * inversesqrt(max(dot(la, la), 1e-8));
    float nl = clamp(dot(Nx, l) + 0.1, 0.0, 1.0);   // (+0.1: a normal map leans the shading normal over)
    if (proj && amb > 0.0) nl = max(nl, min(amb, 1.0));   // (a projector's ambiance lights its back / sides)
    return max(cf.rgb, vec3(0.0)) * (at * nl);
}
// (GI_F_LIGHT_CHG) The lights that changed (the host's chg mask) at a stored sample point X (normal Nx,
// stored radiance Ls): 0 = none reaches it, 1 = one reaches it but too weakly to matter, 2 = SIGNIFICANT
// -- the radiance stored for X was shaded under their OLD records: re-shade it. Significant (#980,
// RenderVKGIReshadeThreshold, prm5.x): the changed lights' light there, per channel the larger of the
// OLD record's (chg_prev: a light that switched off, or moved / swept away, lit it then) and the new
// one's (a light that came on), summed, is at least the threshold x the stored luminance. The SHARE,
// not the change: a slow colour fade changes little per flag but must still repaint the points it
// dominates. 0 = the old rule (any reach is significant). Cheap: no ray, ~a dozen ALU per changed light,
// stops at the first significant sum; the walk is uniform (the header's bits, the same lights for every
// lane).
uint giChangedSig(vec3 X, vec3 Nx, vec3 Ls)
{
    const uint count = min(uint(linfo.cam_pos.w), 256u);
    const float thr = gi.prm5.x;
    const uint nPrev = min(uint(gi.prm5.y + 0.5), GI_CHG_PREV_MAX);
    const float lim = thr * max(giLum(Ls), 1e-3);
    vec3 acc = vec3(0.0);
    bool reached = false;
    uint k = 0u;   // (this light's chg_prev record: the k-th set bit)
    [[dont_unroll]] for (uint w = 0u; w < 8u; ++w)
    {
        uint bits = gi.chg[w >> 2u][w & 3u];
        [[dont_unroll]] while (bits != 0u)
        {
            const int b = findLSB(bits);
            bits &= bits - 1u;
            const uint li = w * 32u + uint(b);
            if (li >= count) return reached ? 1u : 0u;
            const uint kk = k++;
            const vec4 pr = lights[li].pos_radius;
            const vec4 cf = lights[li].color_falloff;
            const bool proj = lights[li].proj_origin.w >= 0.5;
            const float amb = proj ? lights[li].proj_params.w : 0.0;
            bool inF = true;
            if (proj && !(amb > 0.0))
            {
                // a projector without ambiance lights only inside its frustum (the walk's test; with
                // ambiance its back / side receivers are lit too: range only)
                vec4 ptc = lights[li].proj_mat * vec4(X, 1.0);
                inF = ptc.z >= 0.0;
                ptc.xyz /= ptc.w;
                inF = inF && !(ptc.z <= 0.0 || ptc.x <= 0.0 || ptc.x >= 1.0 || ptc.y <= 0.0 || ptc.y >= 1.0);
            }
            bool rN = false;
            const vec3 E = inF ? giChgLight(pr, cf, X, Nx, proj, lights[li].proj_origin.xyz, amb, rN) : vec3(0.0);
            rN = rN && inF;
            if (thr <= 0.0)
            {
                if (rN) return 2u;   // (the old rule: the new record reaches X)
                continue;
            }
            if (kk >= nPrev)
            {
                if (rN) return 2u;   // (no old record: significant wherever it reaches)
                continue;
            }
            // the OLD record (moved: its frustum unknown -- range only, apex ~ its old centre)
            vec4 opr = gi.chg_prev[2u * kk];
            const bool moved = opr.w < 0.0;
            opr.w = abs(opr.w);
            bool rO = false;
            const vec3 Eo = (inF || moved)
                          ? giChgLight(opr, gi.chg_prev[2u * kk + 1u], X, Nx, proj,
                                       moved ? opr.xyz : lights[li].proj_origin.xyz, amb, rO)
                          : vec3(0.0);
            rO = rO && (inF || moved);
            reached = reached || rN || rO;
            acc += max(E, Eo);
            if (giLum(acc) >= lim) return 2u;
        }
    }
    return reached ? 1u : 0u;
}
// giCacheAdd, SUBGROUP-AGGREGATED: the lanes adding to the same cell (an 8 x 4 texel block mostly
// shares one) sum their fixed-point values first and one lane does the 4 atomics -- 4 atomics per
// receiver on a few hot addresses serialised in L2 before. Integer sums: the accumulator ends
// bit-identical. Correct under any convergence: each lane's value is in exactly one dynamic
// instance's subgroupAdd, and that instance's elected lane adds it once.
void giCacheAddWave(uint s, vec3 E)
{
    const uvec4 q = uvec4(giCacheQ(E), 1u);
    [[dont_unroll]] for (;;)
    {
        if (s == subgroupBroadcastFirst(s))
        {
            const uvec4 t = subgroupAdd(q);
            if (subgroupElect())
            {
                const uint a = 2u * giCacheSlots() + s;
                atomicAdd(gi_data[a].x, t.x);
                atomicAdd(gi_data[a].y, t.y);
                atomicAdd(gi_data[a].z, t.z);
                atomicAdd(gi_data[a].w, t.w);
            }
            break;
        }
    }
}
// The smallest receiver cosine a reservoir candidate may have (RenderVKGIReuseCosMin). A candidate's
// contribution weight W ~ 1 / (its target) carries the cosine of the receiver that took it: a
// grazing fresh ray (cos 1e-4) alone stored W = pi / 1e-4, and a neighbour that sees the same point
// head-on re-weighs it by ITS cosine -- thousands of times the fresh sample's weight: a firefly the
// spatial reuse then hands on. Below this cosine a direction is no candidate (bias: the cosine-
// weighted share below it, cos_min^2 -- 0.25 % at 0.05).
float giCosMin() { return gi.prm4.x > 0.0 ? gi.prm4.x : 1e-4; }
// One of last frame's reservoirs (texel q of layer pl) RECONNECTED to this receiver (P, shading
// normal N): on this surface (expected view depth zExp +- ztol, normal within ~25 deg), its sample
// in front of P (receiver cosine >= giCosMin), re-weighted by the solid-angle Jacobian of the move
// (a sky sample: 1). Returns its resampling weight p(y) W M J (0 = rejected); y = the sample as seen
// from HERE (distance, cos at x_s). chg (GI_F_LIGHT_CHG, giChangedSig): 2 = lights that changed are
// significant at its point -- its stored radiance is stale; the candidate still competes with its
// stored target (any target with support gives a valid contribution weight W) and, if it is the one
// picked, the caller RE-SHADES its point with this frame's lights; 1 = one reaches it, too weakly to
// matter (kept as stored).
float giTap(ivec2 q, ivec2 D, uint pl, float zExp, float ztol, vec3 P, vec3 N, float mcap,
            out GiSample y, out float py, out float Mq, out uint chg)
{
    y = GiSample(vec3(0.0), vec3(0.0), vec3(0.0), 0.0, 0.0);
    py = 0.0; Mq = 0.0; chg = 0u;
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, D))) return 0.0;
    const uvec4 g = imageLoad(uGiGeom, ivec3(q, int(pl)));
    const float zq = uintBitsToFloat(g.x);
    if (!(zq > 0.0) || !(abs(zq - zExp) <= ztol)) return 0.0;
    if (dot(pdnUnpackN(g.y), N) < 0.9) return 0.0;
    const uint i = giResIndex(q, D, pl);
    const uvec4 r0 = gi_res[i], r1 = gi_res[i + 1u];
    const float W = uintBitsToFloat(r0.w);
    if (!(W > 0.0) || !(W < 3.0e38)) return 0.0;
    y.xs = uintBitsToFloat(r0.xyz);
    y.ns = giUnpackN(r1.x);
    const vec2 lrg = unpackHalf2x16(r1.y), lbm = unpackHalf2x16(r1.z), dc = unpackHalf2x16(r1.w);
    y.L = vec3(lrg, lbm.x);
    const float M = min(lbm.y, mcap);
    if (!(M > 0.0) || any(isnan(y.L))) return 0.0;
    const vec3 v = y.xs - P;
    const float d2 = dot(v, v);
    if (!(d2 > 1e-8)) return 0.0;
    const float dn = sqrt(d2);
    const vec3 w = v / dn;
    const float cr = dot(N, w);
    if (!(cr >= giCosMin())) return 0.0;
    float J = 1.0;
    const bool sky = !(dc.x > 0.0);
    y.dist = sky ? 0.0 : dn;
    y.cosv = sky ? 1.0 : abs(dot(y.ns, w));
    if (!sky)
    {
        // |cos phi_now| / |cos phi_then| x |x_s - x_then|^2 / |x_s - x_now|^2 (Ouyang et al. 2021 eq. 11)
        J = (y.cosv / max(dc.y, 1e-3)) * (dc.x * dc.x) / d2;
        if (!(J > 0.2) || !(J < 5.0)) return 0.0;   // (a move the sample cannot stand for: a large J
                                                    //  amplifies one sample into a firefly)
    }
    py = giLum(y.L) * cr;
    if (!(py > 0.0)) return 0.0;
    Mq = M;
    const float wt = py * W * M * J;
    if (!(wt < 3.0e38)) return 0.0;
    chg = (!sky && (gi.cfg.x & GI_F_LIGHT_CHG) != 0u) ? giChangedSig(y.xs, y.ns, y.L) : 0u;
    return wt;
}

void DEFER_MAIN()
{
    const ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 D = ivec2(g_draw_push.rtr2.xy + 0.5);
    if (any(greaterThanEqual(m, D))) return;
    const uint frame = uint(g_draw_push.rtr2.z + 0.5);
    const int par = int(uint(g_draw_push.rtr2.w + 0.5) & 1u);
    const vec2 R2 = vec2(float(g_draw_push.width), float(g_draw_push.height));
    const vec2 r = R2 / vec2(D);
    const vec2 J = (ssr.taa_params.w > 0.5 && D.x < int(g_draw_push.width)) ? ssr.taa_jitter.xy : vec2(0.0);
    const ivec2 rp = clamp(ivec2((vec2(m) + 0.5 + J) * r), ivec2(0), ivec2(R2) - 1);
    g_frag_xy = vec2(rp) + 0.5;
    const vec4 g2 = texelFetch(uG2, rp, 0);
    bool surf = deferHasSurface(g2);
    float glow;
    bool noFade;
    SurfaceLit s;
    if (surf)
    {
        s = deferSurface(rp, g2, glow, noFade);
        surf = s.model != SURF_FULLBRIGHT;
    }
    if (!surf)
    {
        imageStore(uGiIn, ivec3(m, 0), vec4(0.0));
        imageStore(uGiIn, ivec3(m, 1), vec4(0.0));
        imageStore(uGiGeom, ivec3(m, par), uvec4(floatBitsToUint(-1.0), 0u, 0u, 0u));
        imageStore(uGiMot, m, uvec4(0u));
        return;
    }
    const vec3 P = deferPosition(rp);
    const vec3 cam = pc.u_cam_time.xyz;
    const vec3 V = normalize(cam - P);
    const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
    vec3 N = dot(s.N, V) < 0.0 ? -s.N : s.N;
    const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    const float camd = length(P - cam);

    // ---- GI-1: the fresh sample (one cosine-weighted ray) ----
    uint seed = giPcg(uint(m.x) * 1973u + uint(m.y) * 9277u + frame * 26699u);
    const vec2 u = fract(vec2(giRand(seed), giRand(seed)) + float(frame & 0xFFFFu) * vec2(0.7548776662, 0.5698402910));
    vec3 d = giCosDir(N, u);
    const float dn = dot(d, Ng);
    if (dn < 0.02) d = normalize(d + Ng * (0.02 - dn));   // (above the facet: a normal map leans N under it)
    // the hit's texture LOD: the receiver's pixel footprint, spreading as a diffuse lobe
    const float pa = rtrPixelAngle(g_frag_xy) * r.x;
    // THE ORIGIN'S LIFT: P is rebuilt from a reduced-resolution, jittered depth sample, so it lies
    // up to about half a GI texel's footprint off the true surface along the view ray -- growing with
    // the distance and, on a slanted surface, with 1 / cos (the depth slope). The depth-precision lift
    // alone (rtReceiverOrigin: camd x 2^-21) left far / grazing receivers just INSIDE their own
    // ray-traced surface: the back-face stop (GI_F_BACK_STOP) darkened them in jitter-moving patches.
    // Lifted by half the footprint over the facet's cosine (capped at 4x).
    const float lift = 0.5 * camd * pa / max(abs(dot(Ng, V)), 0.25);
    const vec3 o = rtReceiverOrigin(P, Ng, camd, lift);
    rt_cone_width0 = camd * pa;
    rt_cone_spread = pa + 0.5;
    rt_cone_aniso = max(g_draw_push.rtr.w, 1.0);
    rtrMaskCone(camd * pa, pa);
    vec3 xs = P, ns = N;
    bool hit = false;
    float hdist = 0.0;
    // (RenderVKGITraceEvery: 1 texel in 2 / 4 traces this frame -- a checkerboard / a 2 x 2 rotation;
    //  the others take their reservoirs' reuse only, or hold the denoiser's history)
    const uint everyLog = (gi.cfg.x >> GI_EVERY_SHIFT) & 3u;
    bool traced = true;
    if (everyLog == 1u) traced = ((uint(m.x) + uint(m.y) + frame) & 1u) == 0u;
    else if (everyLog >= 2u) traced = ((uint(m.x) & 1u) + 2u * (uint(m.y) & 1u)) == (frame & 3u);
    vec3 L = vec3(0.0);
    bool freshBack = false;   // (debug view 9: the FRESH ray stopped at a back face)
    vec3 S = vec3(0.0);
    // the guides' depth gradient (also the spatial taps' plane)
    const int stp = max(int(r.x + 0.5), 1);
    const vec2 grad = vec2(giGrad(rp, ivec2(stp, 0), vz), giGrad(rp, ivec2(0, stp), vz));
    // ---- (GI-2 / GI-3) RESERVOIR REUSE ----
    const uint gf = gi.cfg.x;
    bool noInfo = !traced && (gf & GI_F_RES) == 0u;   // (an untraced texel without reservoirs)
    uint src = 0u;          // 0 fresh, 1 temporal, 2 spatial (debug view 5)
    float Mout = 1.0;
    uint keptT = 0u, keptS = 0u, visRej = 0u, chgRej = 0u;   // (chgRej: picks RE-SHADED for a changed light)
    uint chgSkip = 0u;   // (#980: a pick a changed light reaches, too weakly to re-shade)
    // (GI_F_LIGHT_CHG) the candidates' weight whose sample point changed lights are SIGNIFICANT at
    // (giChangedSig 2; #980: an insignificant reach keeps the full history), of all the candidates'
    // weight: the share the GI denoiser's moving-light history cap reads (MOT w)
    float wChg = 0.0, wAll = 0.0;
    bool wClamped = false;   // (debug view 8: the firefly clamp scaled the stored W)
    bool reuseTried = false;   // (debug view 9: the reuse looked for candidates)
    // the reservoir across the trace loop: the fresh sample y0, the pick y (target py), its weight
    GiSample y0 = GiSample(vec3(0.0), vec3(0.0), vec3(0.0), 0.0, 0.0), y = y0;
    float py = 0.0, p0 = 0.0, q0 = 1.0, c0 = 1e-4, W = 0.0, Msum = 0.0;
    bool visOk = true;     // (the picked reused sample is visible from this receiver)
    bool rsWant = false;   // (GI_F_LIGHT_CHG: the pick is re-shaded by the loop's second pass)
    vec3 rsDir = d;
    float rsDl = 0.0, rsTol = 0.0;
    // THE TRACE LOOP: pass 0 the fresh ray + the reservoir reuse, pass 1 the RE-SHADE of the picked
    // reused sample (only the lanes that want one). ONE giTrace call site: the hit shading (material,
    // weather, the sun / light shadow rays, the cache / probes) is inlined once -- the re-shade's own
    // call site doubled the kernel (2.8 MB of SPIR-V against 1.5) and ran the re-shading lanes through
    // a second copy of all of it. Never unrolled (that would be the second copy again).
    [[dont_unroll]] for (uint pass = 0u; pass < 2u; ++pass)
    {
        vec3 Lt = vec3(0.0), xt = P, nt = N;
        bool ht = false;
        float tt = 0.0;
        if (pass != 0u || traced)
            Lt = giTrace(o, pass == 0u ? d : rsDir, pass == 0u ? max(g_draw_push.rtr.x, 1.0) : rsDl + rsTol, P,
                         xt, nt, ht, tt);
        if (pass != 0u)
        {
            // (GI_F_LIGHT_CHG) RE-SHADE: a changed light reaches the picked point, so its stored
            // radiance is the old colour. One closest-hit ray toward it doubles as the visibility
            // ray: the surface found within the tolerance of the point is shaded with THIS frame's
            // lights (giTrace: the fresh hit's shading + source clamp) and replaces the stored L --
            // reuse kept (its W is a contribution weight: valid for the current radiance), colour
            // current. Anything nearer blocks it; nothing there (the surface moved / vanished)
            // rejects it as well.
            visOk = false;
            if (ht && tt >= rsDl - rsTol)
            {
                // (RenderVKGIReshadeGain) W was resampled for the OLD radiance: a point whose light
                // went from dim to bright is multiplied by L_new / L_old -- the edge sparkles under
                // club lights. Brighter re-shades are capped at the gain (the light-change history
                // cap lets the fresh samples catch up); dimmer ones pass as they are.
                const float gmax = gi.prm4.y;
                const float ln = giLum(Lt), lo = giLum(y.L);
                y.L = (gmax > 0.0 && ln > gmax * lo) ? Lt * (gmax * lo / max(ln, 1e-8)) : Lt;
                visOk = true;
                ++chgRej;
            }
            break;
        }
        L = Lt; xs = xt; ns = nt; hit = ht; hdist = tt;
        freshBack = traced && g_gi_back;
        // the estimate: L x cos / pi x (1 / (cos / pi)) = L (the cosine-weighted mean incoming radiance)
        S = L;
        if ((gf & GI_F_RES) == 0u) break;
        y0.xs = xs; y0.ns = ns; y0.L = L;
        y0.dist = hit ? hdist : 0.0;
        y0.cosv = hit ? abs(dot(ns, -d)) : 1.0;
        // (giCosMin: a grazing fresh direction is no candidate -- its W = pi / cos would be stored and
        //  re-weighed head-on by the neighbours: the firefly seeds of the spatial reuse)
        const float c0raw = dot(N, d);
        const bool c0ok = c0raw >= giCosMin();
        c0 = max(c0raw, 1e-4);
        p0 = (traced && c0ok) ? giLum(L) * c0 : 0.0;
        q0 = c0 * (1.0 / 3.14159265);
        float wsum = p0 / q0;   // (the fresh candidate: p / q, M 1; an untraced texel: none, M 0)
        Msum = traced ? 1.0 : 0.0;
        y = y0;
        py = p0;
        const bool chgOn = (gf & GI_F_LIGHT_CHG) != 0u;
        uint yChg = 0u;   // (the picked reused sample's giChangedSig)
        wAll = wsum;
        if (chgOn && hit && wsum > 0.0 && giChangedSig(xs, ns, L) == 2u) wChg = wsum;
        const bool reuse = (gf & GI_F_TEMPORAL) != 0u && (gf & GI_F_RES_PREV) != 0u && ssr.taa_params.z < 0.5;
        if (reuse)
        {
            const float mcap = max(gi.prm2.x, 1.0);
            uint rng = giPcg(uint(m.x) * 7919u + uint(m.y) * 104729u + frame * 15485863u);
            float pw;
            const vec2 dS = giPrevDelta(P, m, vec2(D), pw);
            const ivec2 qt = ivec2(floor(vec2(m) + dS + 0.5));
            const uint pl = uint(par) ^ 1u;
            GiSample yt;
            float pt, Mt;
            uint tc;
            if (pw > 0.0)
            {
                reuseTried = true;
                float wt = giTap(qt, D, pl, pw, max(0.04 * pw, 0.03), P, N, mcap, yt, pt, Mt, tc);
                if (!(wt > 0.0) && (gf & GI_F_REPROJ_SEARCH) != 0u)
                {
                    // (GI_F_REPROJ_SEARCH) REPROJECTION SEARCH: the nearest texel is not this surface
                    // (sub-texel motion across a thin strand / a silhouette at the GI extent): the
                    // best-matching texel of the 3 x 3 around the reprojected point -- its depth against
                    // this surface's plane carried there (pw + the gradient over the offset), normal
                    // within ~25 deg -- is the temporal candidate (giTap's own tests at that plane depth)
                    const vec2 hc = vec2(m) + dS;
                    float best = 1.0, bz = 0.0, btol = 0.0;
                    ivec2 bq = ivec2(-1);
                    [[dont_unroll]] for (int k = 0; k < 9; ++k)
                    {
                        const ivec2 q = qt + ivec2(k % 3 - 1, k / 3 - 1);
                        if (q == qt || any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, D))) continue;
                        const uvec4 gq = imageLoad(uGiGeom, ivec3(q, int(pl)));
                        const float zq = uintBitsToFloat(gq.x);
                        if (!(zq > 0.0) || dot(pdnUnpackN(gq.y), N) < 0.9) continue;
                        const float dz = dot(grad, vec2(q) - hc);
                        const float tq = max(0.04 * pw, 0.03) + 0.5 * abs(dz);
                        const float e = abs(zq - (pw + dz)) / tq;
                        if (e < best) { best = e; bq = q; bz = pw + dz; btol = tq; }
                    }
                    if (bq.x >= 0) wt = giTap(bq, D, pl, bz, btol, P, N, mcap, yt, pt, Mt, tc);
                }
                if (wt > 0.0)
                {
                    wsum += wt; Msum += Mt; ++keptT; wAll += wt;
                    if (tc == 2u) wChg += wt;
                    if (giRand(rng) * wsum < wt) { y = yt; py = pt; src = 1u; yChg = tc; }
                }
                if ((gf & GI_F_SPATIAL) != 0u)
                {
                    const uint taps = uint(gi.prm2.y + 0.5);
                    const float rad = max(gi.prm2.z, 1.0);
                    [[dont_unroll]] for (uint t = 0u; t < min(taps, 6u); ++t)
                    {
                        const float a = 6.2831853 * giRand(rng);
                        const float rr = rad * sqrt(max(giRand(rng), 0.02));
                        const ivec2 q = qt + ivec2(round(vec2(cos(a), sin(a)) * rr));
                        if (q == qt) continue;
                        const float dz = dot(grad, vec2(q - qt));
                        const float ws = giTap(q, D, pl, pw + dz, max(0.05 * pw, 0.05) + 0.25 * abs(dz), P, N, mcap, yt,
                                               pt, Mt, tc);
                        if (ws > 0.0)
                        {
                            wsum += ws; Msum += Mt; ++keptS; wAll += ws;
                            if (tc == 2u) wChg += ws;
                            if (giRand(rng) * wsum < ws) { y = yt; py = pt; src = 2u; yChg = tc; }
