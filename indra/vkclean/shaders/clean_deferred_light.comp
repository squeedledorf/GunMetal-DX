    vec4 l0 = vec4(S, noInfo ? -1.0 : 1.0);
    const uint dbg = gi.cfg.w;
    // ---- (GI-4) THE RADIANCE CACHE: this receiver's estimate into its world cell ----
    uint cInserts = 0u, cFull = 0u;
    vec3 cacheDbg = vec3(1.0, 0.0, 0.0);
    if ((gf & GI_F_CACHE_FILL) != 0u && giCacheSlots() != 0u && !noInfo)
    {
        float edge;
        const uint key = giCellKey(P, N, cam, edge);
        bool ins;
        const uint slot = giCacheFindOrInsert(key, giCellCentre(P, edge), edge, ins);
        if (slot != 0xFFFFFFFFu)
        {
            if (dbg == GI_DBG_CACHE)
            {
                vec3 E;
                cacheDbg = giCacheRead(slot, E) ? E : vec3(1.0, 1.0, 0.0);
            }
            giCacheAddWave(slot, S);
            if (ins) ++cInserts;
        }
        else ++cFull;
    }
    if (dbg == GI_DBG_CACHE) l0.rgb = cacheDbg;
    if (dbg == GI_DBG_RES)
        l0.rgb = (src == 0u ? vec3(1.0, 0.0, 0.0) : (src == 1u ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.3, 1.0)))
               * (0.2 + 0.8 * clamp(Mout / max(gi.prm2.x, 1.0), 0.0, 1.0));
    if (dbg == GI_DBG_CHG)
        l0.rgb = vec3(chgShare, chgRej != 0u ? 1.0 : (chgSkip != 0u ? 0.3 : 0.0), wClamped ? 1.0 : 0.0);
    if (dbg == GI_DBG_OUTLIER)   // (a header word: uniform -- the subgroup sums see every surface lane)
    {
