        float glow;
        bool noFade;
        const SurfaceLit s = deferSurface(px, g2, glow, noFade);
        const uint rank = dsHalfRank(s, dsSharpKind(s, deferPosition(px)));
        if (rank < best) { best = rank; rep = k; }
    }
    if (best >= 3u)   // sky / cleared / fullbright only: nothing any lit pixel may use
    {
        CLK_MARK(GBUF);
        imageStore(uReflHalf, hp, uvec4(0u));
        CLK_MARK(STORE);
        return;
    }
    CLK_SURF();
    const ivec2 px = hp * 2 + ivec2(rep & 1, rep >> 1);
    g_frag_xy = vec2(px) + 0.5;
    const vec4 g2 = texelFetch(uG2, px, 0);
    const vec3 P = deferPosition(px);
