#if DEFER_SHADOW_MERGE && !defined(CLEAN_SHADOW_CORE)
// The sun / moon visibility x tint of the receiver at render px rp (P, its visible-side geometric
// FACET normal: pdnFacetNormal), and the penumbra radius (denoiser texels, -1 = no caster met) +
// the moving-caster bit. sw: the host's weak-sun weight (0: no ray, lit). texPerPx: denoiser
// texels per render px. The mask's trace step by step (clean_rt_shadow_mask.comp main).
vec3 pdnSunTrace(SurfaceLit s, ivec2 rp, vec3 P, vec3 Ng, float vz, uint frame, float sw, float texPerPx,
                 bool onPlane, out float srad, out bool dyn)
{
    srad = -1.0;
    dyn = false;
    const vec3 L = atmosLightDir();
    if (!(sw > 0.0) || !specSunOn() || litDbg(LDBG_NO_SUN_SHADOW) || ssr.shadow_params.w < 1.5
        || vz >= ssr.shadow_clip.w || !pdnSunWant(s, L))
        return vec3(1.0);
    const bool away = !surfaceSunWant(s, L);   // (PDN_OPT_SUN_AWAY: filter support only -- one ray)
    const vec3 cam = pc.u_cam_time.xyz;
    const float time = pc.u_cam_time.w;
    const vec2 cpx = vec2(rp) + 0.5;
    const float d = texelFetch(uDepthG, rp, 0).r;
    // world size of one render pixel at this depth (penumbra widths -> texels)
    const float pxw = max(length(pdnWorldAt(cpx + vec2(1.0, 0.0), d) - P), 1e-6);
    // the view-slope origin offset (RenderVKRTShadowSlopeBias; rtr2.y = the footprint fraction)
    const vec3 Vc = P - cam;
    const float vcl = length(Vc);
    const float recv_ofs = vcl > 1e-4 ? g_draw_push.rtr2.y * pxw * length(cross(Ng, Vc / vcl)) : 0.0;
    // #841 FOOTPRINT JITTER (no TAA / FSR): the sun origin slides over the texel's footprint along
    // the receiver's plane, where the render pixel under the offset point lies on the same plane.
    vec3 sun_foot = vec3(0.0);
    if (ssr.taa_params.w < 0.5 && onPlane)   // (the mask: both tangents on the facet)
    {
        const uint hk = (frame & 15u) + 1u;
        const vec2 o = (vec2(pdnHalton(hk, 2u), pdnHalton(hk, 3u)) - 0.5) / texPerPx;
        const ivec2 mx = ivec2(int(g_draw_push.width), int(g_draw_push.height)) - 1;
        const ivec2 q = clamp(ivec2(floor(cpx + o)), ivec2(0), mx);
        const float camd = length(P - cam);
        bool on = true;
        if (q != rp)
        {
            const float dq = texelFetch(uDepthG, q, 0).r;
            on = dq > 0.0 && abs(dot(pdnWorldAt(vec2(q) + 0.5, dq) - P, Ng)) <= 0.1 * pxw + 1e-4 * camd;
        }
        if (on)
        {
            // the offset view ray against the receiver's plane
            const vec3 dir = normalize(pdnWorldAt(cpx + o, d) - cam);
            const float dn = dot(dir, Ng);
            if (abs(dn) > 1e-3)
            {
                const vec3 f = cam + dir * (dot(P - cam, Ng) / dn) - P;
                if (dot(f, f) < 4.0 * pxw * pxw * (1.0 + dot(o, o))) sun_foot = f;
            }
        }
    }
    // #211 smooth-terrain re-anchor (the sun origin only)
    const float terr_t = pdnTerrainSnapOn() ? pdnTerrainExit(P, cam, Ng) : -1.0;
    const vec3 Psun = (terr_t > 0.0 ? P + normalize(cam - P) * terr_t : P) + sun_foot;
    const float cl_lift = pdnClusterRigLift(P, cam);
    // SHADOW TERMINATOR (#664): the triangle under the pixel (pre-pass target, else the probe).
    const float ngl = dot(Ng, L);
    vec3 tlift = vec3(0.0), tns = vec3(0.0), tng = vec3(0.0);
    const bool term = rtTerminatorOn() && rtTerminatorBand(ngl)
                   && rtTerminatorCached(P, cam, Ng, RT_TERM_MASK_COS, rp, tlift, tns, tng);
    const vec3 Nsun = term ? tng : Ng;
    const float nsl = term ? max(dot(tns, L), dot(tng, L)) : ngl;
    vec3 sun;
    if (nsl > -0.25)
    {
        const float fade = clamp((vz - ssr.shadow_clip.w * 0.8) / max(ssr.shadow_clip.w * 0.2, 1e-3), 0.0, 1.0);
        const bool opaque_only = ssr.taa_scale.z > 0.0 && vcl > ssr.taa_scale.z;
        rtSelfBegin(P);
        rt_noise_shift = fract(float(frame) * vec2(0.7548776662, 0.5698402910));
        rt_vis_hint = -1.0;
        rt_block_t = 1e30;
        rt_block_dyn = false;
        rt_term_on = term; rt_term_lift = tlift; rt_term_ns = tns;
        rt_cl_lift = (dot(Nsun, L) > 0.0 || (term && dot(tlift, tlift) > 0.0)) ? cl_lift + recv_ofs : 0.0;
        sun = mix(sunShadowRayCore(Psun, Nsun, L, cam, time, cpx, opaque_only,
                                   ((pdnOpts() & PDN_OPT_SUN_ONE) != 0u || away) ? 1u : 16u), vec3(1.0), fade);
        rt_term_on = false;
        rt_cl_lift = 0.0;
        dyn = rt_block_dyn;
        if (rt_block_t < 1e29) srad = rt_block_t * tan(ssr.sun_rt.x) / max(nsl, 0.15) / pxw * texPerPx;
    }
    else { sun = vec3(0.0); srad = 0.0; }
    // weak sun / moon (the host's weight, a ramp over the threshold band): fade toward lit
    return mix(vec3(1.0), clamp(sun, vec3(0.0), vec3(1.0)), clamp(sw, 0.0, 1.0));
}
