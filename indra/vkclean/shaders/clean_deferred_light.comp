// ---- RT RESOLVE (#859; see HYBRID RT REFLECTIONS in the header): one 8x8 workgroup per listed tile ----
// 12 taps in the unit disc (radius >= 0.35: the 3 x 3 covers the centre).
const vec2 kRtrDisc[12] = vec2[12](
    vec2( 0.41,  0.18), vec2(-0.22,  0.46), vec2(-0.52, -0.12), vec2( 0.10, -0.58),
    vec2( 0.72,  0.47), vec2(-0.30,  0.88), vec2(-0.86,  0.30), vec2(-0.69, -0.62),
    vec2( 0.05, -0.97), vec2( 0.66, -0.66), vec2( 0.97, -0.08), vec2( 0.38,  0.84));
// Tile listed this frame (its marks / traces are this frame's).
bool rtrTileListed(ivec2 q)
{
    const uint tilesX = (g_draw_push.width + 7u) / 8u;
    return rtt_words[uint(q.y >> 3) * tilesX + uint(q.x >> 3)] != 0u;
}
// LOBE FILTER (RenderVKRTReflectionsLobeFilter, rtrLobeOn; DEFER_MAIN sets these per pixel): the
// receiver's own reflection direction and 1 / sigma^2 of the direction weight (0: the filter off).
vec3  g_rtr_R = vec3(0.0, 0.0, 1.0);
float g_rtr_dirK = 0.0;
// A traced sample of pixel q usable for this receiver (P, Ng toward the camera, view depth vz):
// traced this frame, on the same plane (geometric normal within ~25 deg, plane distance within
// 1 % of the depth + 2 cm). g = its geometry weight.
// LOBE FILTER on: the normal gate widens to ~75 deg (the plane test stays) and the weight is the
// REFLECTION DIRECTION similarity instead -- q's own mirror direction (its shading normal, its view
// ray) against this pixel's, exp(-theta^2 / (2 sigma^2)) with sigma the receiver's lobe (its GGX
// alpha + the specular-AA spread: the directions its own footprint covers). A neighbour on a
// curved or normal-mapped receiver is a sample of THIS pixel's reflection only as far as its
// direction lies inside that lobe: before it a 25 deg normal gate either took a neighbour whose
// reflection pointed elsewhere at full weight or (beyond it) nothing at all.
bool rtrTap(ivec2 q, ivec2 self, vec3 P, vec3 Ng, float vz, out vec4 rt, out float g)
{
    rt = vec4(0.0);
    g = 0.0;
    if (any(lessThan(q, ivec2(0))) || q.x >= int(g_draw_push.width) || q.y >= int(g_draw_push.height)) return false;
    if (!rtrTileListed(q)) return false;
    rt = imageLoad(uRtTrace, q);
    if (!(rt.a >= 0.0)) return false;
    if (q == self) { g = 1.0; return true; }
    const vec4 g1 = texelFetch(uG1, q, 0);
    const float nd = abs(dot(gbOctDecode(g1.zw), Ng));
    const bool lobe = g_rtr_dirK > 0.0;
    if (nd < (lobe ? 0.25 : 0.9)) return false;
    const vec3 Pq = rtrPositionAt(q);
    const float dz = abs(dot(Ng, Pq - P)) / (0.01 * vz + 0.02);
    if (dz >= 1.0) return false;
    if (lobe)
    {
        const vec3 Vq = normalize(pc.u_cam_time.xyz - Pq);
        vec3 nq = gbOctDecode(g1.xy);
        if (dot(nq, Vq) < 0.0) nq = -nq;
        const float x = max(1.0 - dot(reflect(-Vq, nq), g_rtr_R), 0.0);   // (~ theta^2 / 2)
        g = (1.0 - dz) * exp(-x * g_rtr_dirK);
        return g > 1e-3;
    }
    g = (1.0 - dz) * (nd - 0.9) * 10.0;
    return g > 0.0;
}
// The glossy filter's hit-distance similarity: a neighbour's hit far nearer / farther than this
// pixel's mean reflected distance is another object (a near silhouette must not smear into the far
// background behind it); misses keep their weight (they take this pixel's env).
float rtrHitDistW(float t, float tMean)
{
    if (!(t > 0.0) || !(tMean > 0.0)) return 1.0;
    const float x = (t - tMean) / (0.35 * tMean);
    return exp(-x * x);
}
// DENSITY GRADIENT: the spacing L of the ray lattice a pixel at density rho_eff can count on --
// the smallest power of two with 1 / L^2 <= rho_eff: every lattice pixel of that spacing ranks
// below rho_eff x 256 (rtrRank), so on a surface of that density every aligned L x L cell holds a
// ray (1 / sqrt(rho) pixels apart). 1 .. 16.
// TEMPORAL (RenderVKRTReflectionsTemporal, rtt_opts4 bit 1: on AND the history is allocated): the
// resolved RT radiance of each candidate pixel, accumulated over frames. The rays are mirror rays,
// but SPARSE (the density lattice) and taken at jittered pixel centres: on a receiver whose
// reflection varies fast across the screen every frame reconstructs a slightly different image,
// which read as noise (and DLSS / the TAA, reprojecting by the SURFACE's motion, cannot hold a
// reflection that moves with its VIRTUAL IMAGE). Per pixel (rtrTemporal):
//   * the history texel: the VIRTUAL IMAGE's previous pixel (the point the reflection appears to
//     come from: the view ray continued past the receiver by the mean hit distance; a miss: 1 km),
//     accepted when the previous frame's receiver there lay on THIS receiver's plane (its stored
//     view depth against the plane's, through the previous camera); else (or first, on curved /
//     bumpy / rough receivers, where a virtual image is not one point) the SURFACE's previous
//     pixel, accepted on its view depth. No match, a history reset (teleport / camera cut:
//     frame info taa_params.z): this frame alone;
//   * clamped to this frame's neighbourhood -- the glossy gather's mean +- 1.25 sigma (its second
//     moment), widened to include this pixel's own result -- then blended, 20 % new (~5 frames);
//   * -> the history layer of this frame's parity (rgb, a = the receiver's view depth; 0 = none).
// Layers ping-pong with the tile list header's parity (rtt_param.w bit 8).
layout(set = 3, binding = 24, rgba16f) uniform image2DArray uRtHist;
#define RTR_TEMPORAL_ALPHA 0.2
bool rtrTemporalOn() { return (rtt_opts4 & 2u) != 0u; }   // (a header word: uniform)
// The previous frame's pixel holding camera-relative point Xr (X - cam_origin), pw its previous
// view depth; false off screen / behind the previous camera.
bool rtrPrevPx(vec3 Xr, out ivec2 hp, out float pw)
{
    const vec4 c = ssr.taa_prev_vp * vec4(Xr, 1.0);
    pw = c.w;
    hp = ivec2(-1);
    if (!(c.w > 1e-4)) return false;
    const vec2 puv = c.xy / c.w * 0.5 + 0.5;
    if (!(all(greaterThanEqual(puv, vec2(0.0))) && all(lessThan(puv, vec2(1.0))))) return false;
    hp = ivec2(puv * vec2(float(g_draw_push.width), float(g_draw_push.height)));
    return true;
}
// res: this frame's result; mu / sigma: the neighbourhood's mean / deviation; P, Ng (toward the
// camera), V: the receiver; tRefl: the mean hit distance (0: a miss); vz its view depth now;
// surfaceFirst: skip the virtual image. Writes this frame's history texel; returns the blend.
vec3 rtrTemporal(ivec2 px, vec3 res, vec3 mu, vec3 sigma, vec3 P, vec3 Ng, vec3 V, float tRefl, float vz,
                 bool surfaceFirst)
{
    const uint par = (rtt_param.w >> 8) & 1u;
    vec3 outc = res;
    if (ssr.taa_params.z < 0.5)
    {
        const vec3 Pr = P - ssr.cam_origin.xyz;
        vec4 h = vec4(0.0);
        bool ok = false;
        ivec2 hp;
        float pw;
        if (!surfaceFirst && rtrPrevPx(Pr - V * (tRefl > 0.0 ? tRefl : 1000.0), hp, pw))
        {
            // the receiver plane under that previous pixel: where the previous camera's ray through
            // it meets the plane, and that point's previous view depth
            const mat4 iM = inverse(ssr.taa_prev_vp);
            const vec2 ndc = (vec2(hp) + 0.5) / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
            vec4 a = iM * vec4(ndc, 1.0, 1.0), b = iM * vec4(ndc, 0.5, 1.0);
            a.xyz /= a.w;
            b.xyz /= b.w;
            const vec3 dl = b.xyz - a.xyz;
            const float den = dot(Ng, dl);
            if (abs(den) > 1e-6 * length(dl))
            {
                const vec3 Q = a.xyz + dl * (dot(Ng, Pr - a.xyz) / den);
                const float ew = (ssr.taa_prev_vp * vec4(Q, 1.0)).w;
                h = imageLoad(uRtHist, ivec3(hp, int(par ^ 1u)));
                ok = ew > 1e-3 && h.a > 0.01 && abs(h.a - ew) < 0.02 * ew + 0.05;
            }
        }
        if (!ok && rtrPrevPx(Pr, hp, pw))
        {
            h = imageLoad(uRtHist, ivec3(hp, int(par ^ 1u)));
            ok = h.a > 0.01 && abs(h.a - pw) < 0.02 * pw + 0.05;
        }
        if (ok && all(lessThan(abs(h.rgb), vec3(60000.0))))
        {
            const vec3 lo = min(mu, res) - sigma, hi = max(mu, res) + sigma;
            outc = mix(clamp(h.rgb, lo, hi), res, RTR_TEMPORAL_ALPHA);
        }
    }
    imageStore(uRtHist, ivec3(px, int(par)), vec4(outc, vz));
    return outc;
}
int rtrLattice(float rhoEff)
{
    const float inv = inversesqrt(max(rhoEff, 1.0 / 256.0));
    int L = 1;
    for (int k = 0; k < 4 && float(L) < inv - 1e-3; ++k) L *= 2;
    return L;
}
void DEFER_MAIN()
{
    const uint tilesX = (g_draw_push.width + 7u) / 8u;
    const uint entry = rttEntry();
    if (entry == 0xFFFFFFFFu) return;   // (the last row's tail: the whole workgroup)
    const uint tile = rtt_words[rtt_args[3] + entry];
    const ivec2 px = ivec2(uvec2(tile % tilesX, tile / tilesX) * 8u + gl_LocalInvocationID.xy);
    if (px.x >= int(g_draw_push.width) || px.y >= int(g_draw_push.height)) return;
    g_frag_xy = vec2(px) + 0.5;
    const uvec4 m = imageLoad(uReflRtMark, px);
    if (m.z == 0u) return;
