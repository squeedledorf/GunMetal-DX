#if DEFER_TILED
// ---- TILE LIGHT TEST (the lit kernels' in-kernel path and the light grid build) ----
// Eye-relative point on the view ray through screen position `spx` (render px).
vec3 tileRay(vec2 spx)
{
    const vec2 ndc = spx / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, 0.5, 1.0);
    return h.xyz / h.w;
}

// Can light li reach any surface of this tile? rays[4]: the tile's corner rays (eye-
// relative, around the rectangle), planes[4]: inward side-plane normals, [z0, z1]: the
// tile's surface view-depth range, fwd: the view direction.
bool tileLightTest(uint li, vec3 rays[4], vec3 planes[4], float z0, float z1, vec3 fwd)
{
    const vec4 pr = lights[li].pos_radius;
    const vec3 c = pr.xyz - pc.u_cam_time.xyz;
    const float r = pr.w;
    const float cz = dot(c, fwd);
    if (cz + r < z0 || cz - r > z1) return false;
    bool out_side = false;   // (no early return: the unrolled loop keeps rays / planes in registers)
    [[unroll]] for (int k = 0; k < 4; ++k)
        out_side = out_side || dot(planes[k], c) < -r;
    if (out_side) return false;
    if (lights[li].proj_origin.w < 0.5) return true;
    // Projector: reject when all 8 section corners violate the same frustum half-space
    // (the per-pixel test's x / w and y / w in (0, 1), z >= 0).
    const mat4 pm = lights[li].proj_mat;
    bool ox0 = true, ox1 = true, oy0 = true, oy1 = true, oz = true;   // all corners outside: x<0, x>w, y<0, y>w, z<0
    [[unroll]] for (int k = 0; k < 8; ++k)
    {
        const vec3 ray = rays[k & 3];
        const float z = (k < 4) ? z0 : z1;
        const vec3 C = pc.u_cam_time.xyz + ray * (z / max(dot(ray, fwd), 1e-6));
        const vec4 t = pm * vec4(C, 1.0);
        ox0 = ox0 && t.x < 0.0;  ox1 = ox1 && t.x > t.w;
        oy0 = oy0 && t.y < 0.0;  oy1 = oy1 && t.y > t.w;
        oz  = oz  && t.z < 0.0;
    }
    return !(ox0 || ox1 || oy0 || oy1 || oz);
}

// This workgroup's tile frustum for tileLightTest: corner rays + inward side planes.
void tileFrustum(out vec3 rays[4], out vec3 planes[4])
{
    const vec2 t0 = vec2(gl_WorkGroupID.xy * TILE);
    const vec2 t1 = min(t0 + vec2(TILE), vec2(float(g_draw_push.width), float(g_draw_push.height)));
    rays[0] = tileRay(vec2(t0.x, t0.y));
    rays[1] = tileRay(vec2(t1.x, t0.y));
    rays[2] = tileRay(vec2(t1.x, t1.y));
    rays[3] = tileRay(vec2(t0.x, t1.y));
    const vec3 rc = tileRay((t0 + t1) * 0.5);
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        vec3 n = cross(rays[k], rays[(k + 1) & 3]);
        if (dot(n, rc) < 0.0) n = -n;
        planes[k] = n * inversesqrt(max(dot(n, n), 1e-30));
    }
}

// CLUSTER SCAN (lit guard stats, LLCleanRendererVK::readLitGuardStats): the workgroups
// stride over the main grid's light + probe clusters -- one cluster per workgroup step,
// its list entries one per lane -- and count lists that overflowed their cap (the largest
// candidate count), clusters whose SHADOWED projectors alone overflowed (those beyond the
// cap are lit unshadowed: clean_lights.comp), and list entries past this frame's light /
// probe counts. Words (binding 20): 4 + 6 light clusters over cap, + 7 max light
// candidates, + 8 shadowed-projector overflow clusters, + 9 light entries past the light
// count, + 10 probe clusters over cap, + 11 max probe candidates, + 12 probe entries past
// the probe count. ~3.5k clusters x (64 + 24) reads per frame spread over every tile.
// (Split: the combine runs it -- the same 16x16 grid; under the light grid the build does; the
// feature split (#831): pass 9 under DEFER_FLAG_SCAN_ONLY, a small grid on sampled frames -- any
// workgroup count works, the loop strides by it.)
void lgClusterScan(uint lid)
{
    const uint nwg = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
    const uint wg  = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint lcount = min(uint(linfo.cam_pos.w), TILE_LIGHT_WORDS * 32u);
    const uint pcount = uint(phdr.info.x);
    const bool probesOn = phdr.info.w > 0.5 && pcount > 0u;
    for (uint cl = wg; cl < CLUSTER_COUNT; cl += nwg)
    {
        const uint raw = cluster_count[cl];
        if (lid < clusterLen(raw) && cluster_index[cl * CLUSTER_CAP + lid] >= lcount)
            atomicAdd(lg_words[LG_WORD0 + 9u], 1u);
        const uint praw = probesOn ? probe_count[cl] : 0u;
        const uint pn = min(praw & 0xFFFFu, PROBE_CLUSTER_CAP);
        if (lid < pn && probe_index[cl * PROBE_CLUSTER_CAP + lid] >= pcount)
            atomicAdd(lg_words[LG_WORD0 + 12u], 1u);
        if (lid == 0u)
        {
            const uint tot = clusterCandidates(raw);
            if (tot > CLUSTER_CAP)
            {
                atomicAdd(lg_words[LG_WORD0 + 6u], 1u);
                atomicMax(lg_words[LG_WORD0 + 7u], tot);
            }
            if (clusterShadowedOverflow(raw)) atomicAdd(lg_words[LG_WORD0 + 8u], 1u);
            const uint ptot = praw >> 16;
            if (ptot > PROBE_CLUSTER_CAP)
            {
                atomicAdd(lg_words[LG_WORD0 + 10u], 1u);
                atomicMax(lg_words[LG_WORD0 + 11u], ptot);
            }
        }
    }
}

