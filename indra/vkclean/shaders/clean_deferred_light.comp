shared float s_smpW[REGIR_EM_SLOTS_MAX];
void emLongCells()
{
    const uint lid = gl_LocalInvocationIndex;
    if (!emListsOn() || !emLongOn()) return;   // (uniform: header words)
    const uint nLong = min(rg_cells[REGIR_EM_LONG_BASE].x, REGIR_EM_NCELLS);
    const uint nRec = emCount();
    const uint par = emParity();
    const uint R = emSlots();
    const uint nWG = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
    [[dont_unroll]] for (uint c = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x; c < nLong; c += nWG)
    {
        const uint cell = emLongGet(c);
        if (!emCellInUse(cell)) continue;   // (uniform: one cell per workgroup; #1006 an overlay cell too)
        vec3 lo, hi;
        emCellBoxAny(cell, lo, hi);
        const uvec2 lc = rg_cells[emLCellWord(cell)];
        const uint lst = rg_cells[emLBlkWord(cell >> 6u)].y + lc.y;
        uint ln = min(lc.x & 0xFFFFu, lc.x >> 16u);
        ln = lst < REGIR_EM_PAIR_CAP ? min(ln, REGIR_EM_PAIR_CAP - lst) : 0u;
        // ---- walk 1 (lane l: pairs l, l + 64, ...): this lane's M, W and R strongest ----
        float W = 0.0;
        uint M = 0u, nTop = 0u;
        uint topS[REGIR_EM_SLOTS_MAX];
        float topT[REGIR_EM_SLOTS_MAX];
        [[unroll]] for (uint k = 0u; k < REGIR_EM_SLOTS_MAX; ++k) { topS[k] = 0u; topT[k] = 0.0; }
        [[dont_unroll]] for (uint i = lid; i < ln; i += 64u)
        {
            const uint sl = emPairGet(lst + i);
            if (sl >= nRec) continue;
            vec4 cr, pl, la;
            emTriCompact(emLoad(par, sl), cr, pl, la);
            const float t = emCellTarget(cr, pl, la, lo, hi);
            if (!(t > 0.0)) continue;
            W += t; ++M;
            emTopInsert(t, sl, R, par, nTop, topS, topT);
        }
        barrier();   // (the previous cell's shared reads are done)
        s_lgN[lid] = nTop;
        for (uint k = 0u; k < nTop; ++k) { s_lgT[lid * REGIR_EM_SLOTS_MAX + k] = topT[k]; s_lgS[lid * REGIR_EM_SLOTS_MAX + k] = topS[k]; }
        s_lgW[lid] = W;
        s_lgM[lid] = M;
        barrier();
        if (lid == 0u)
        {   // the cell's R strongest from the lanes' (EXACT TOP: the ranking does not depend on which lane
            // met which pair), M and W summed in lane order
            uint gN = 0u, gM = 0u;
            float gW = 0.0;
            uint gS[REGIR_EM_SLOTS_MAX];
            float gT[REGIR_EM_SLOTS_MAX];
            [[unroll]] for (uint k = 0u; k < REGIR_EM_SLOTS_MAX; ++k) { gS[k] = 0u; gT[k] = 0.0; }
            for (uint l = 0u; l < 64u; ++l)
            {
                gM += s_lgM[l];
                gW += s_lgW[l];
                const uint n = s_lgN[l];
