    }
    // (TEMPORAL on, nothing spliced or accumulated here: no history for this pixel)
    if (temporal) imageStore(uRtHist, ivec3(px, int((rtt_param.w >> 8) & 1u)), vec4(0.0));
    if (remS < 1.0 || remE < 1.0)
        imageStore(uReflRtMark, px, uvec4(dsPackRGB9E5(xS * clamp(remS, 0.0, 1.0)),
                                          dsPackRGB9E5(xE * clamp(remE, 0.0, 1.0)), m.z, m.w));
    CLK_MARK(STORE);
}

