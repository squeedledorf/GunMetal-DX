        // k S = f(y) (k W) -- the reservoir stores k W, so what neighbours / next frame resample is
        // what this texel showed (before, the clamp touched S only: the unclamped W was stored and
        // handed on by the spatial reuse -- a firefly re-seeded every frame)
        const float clampR = gi.prm2.w;
        if (clampR > 0.0)
        {
            const float l = giLum(S);
            if (l > clampR) { const float k = clampR / l; S *= k; W *= k; wClamped = true; }
        }
        if (noInfo) giResStore(m, D, uint(par), y0, 0.0, 0.0);   // (W 0: nothing for the neighbours)
