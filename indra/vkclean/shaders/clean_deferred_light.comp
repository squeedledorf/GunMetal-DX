    CLK_MARK(SUNVIS);
    imageStore(uVisSun, px, sqrt(clamp(dsFiniteNote(vec4(tint, vis)), vec4(0.0), vec4(1.0))));
    if (visOut)
    {
        uint d = 0u;
        if (s.model != SURF_FULLBRIGHT)
        {
            const float vz = max(dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 1e-3);
            const uvec2 q = uvec2(clamp(gbOctEncode(s.Ng) * 0.5 + 0.5, vec2(0.0), vec2(1.0)) * 255.0 + 0.5);
            d = (packHalf2x16(vec2(sunWant ? vz : -vz, 0.0)) & 0xFFFFu) | (q.x << 16) | (q.y << 24);
        }
        imageStore(uVisDepth, px, uvec4(d));
    }
    CLK_MARK(STORE);
    if ((g_draw_push.flags & DEFER_FLAG_PROJ) != 0u)
    {
        const uvec4 o = s.model == SURF_FULLBRIGHT ? uvec4(0u) : deferResolveProjectors(s, P);
        CLK_MARK(PROJ);
