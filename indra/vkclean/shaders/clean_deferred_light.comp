#include "clean_sun_cert.glsl"
#endif

// ---- (#91) EMITTING TRIANGLES as light samples (clean_regir.glsl EMISSIVE LIGHTS): record slot es of this
//      build ----
// The RIS target: the triangle's average luminance x its unshadowed form factor at (P, N) -- > 0 exactly
// where its term is (no texture fetch: the term's texel only changes the colour).
float rsEmTarget(uint es, vec3 P, vec3 N)
{
    if (es >= emCount()) return 0.0;
    const EmTri t = emLoad(emParity(), es);
    vec3 Rd;
    return t.lum * emTriFF(t, P, N, Rd);
}
// The pick's terms (projDirectTerms' role): diffuse only -- diffuseColor x L(P) x FF, the lit kernels'
// term exactly (deferEmitterLight).
bool rsEmTerms(uint es, vec3 P, vec3 N, vec3 diffuseColor, out vec3 dt)
{
    dt = vec3(0.0);
    if (es >= emCount()) return false;
    const EmTri t = emLoad(emParity(), es);
    vec3 Rd;
    const float F = emTriFF(t, P, N, Rd);
    if (!(F > 0.0)) return false;
    dt = diffuseColor * emTriRadiance(t, P, Rd) * F;
    return max(max(dt.r, dt.g), dt.b) > 0.0;
}
// The pick's light sample: ONE point of the triangle's part above P's horizon, uniform in its solid angle
// (emTriSample) -- so the ratio's visibility is the visible share of the light as P sees it. Hard ray
// (radius 0: the per-frame point is the soft shadow), stopping just short of the point (SH_SPHERE's
// nearClip: the emitter never shadows itself).
// xi: three [0, 1) numbers -- the caller's per-texel R3 sequence over the frames, so a texel's penumbra
// converges instead of churning.
void rsEmSample(uint es, vec3 P, vec3 N, vec3 xi, out ShadowSample S)
{
    const EmTri t = emLoad(emParity(), es);
    const vec3 T = emTriSample(t, P, N, xi);
    S.pos = T;
    S.radius = 0.0;
    S.axis = vec3(0.0);
    S.nearClip = clamp(0.002 * length(T - P), 0.005, 0.05);
    S.bias = rg.rs_params.w;
    S.flags = SH_POSITIONAL | SH_SPHERE | (rtSplitOn() ? SH_SPLIT : 0u);
    S.tmax = 0.0;
    S.nRays = 1u;
    S.noise = vec2(0.0);
}

// ---- (#869 Phase 5b / 5c) ReSTIR DI RESERVOIR REUSE (Bitterli et al. 2020; the 1/M combine) ----
// Each texel keeps a reservoir {light y, its contribution weight W, its confidence M in frames} in
// rs_res (this frame's GEOM parity). Next frame a texel on the same surface resamples ITS fresh
// candidates' reservoir together with
//   * TEMPORAL (5b, RS_F_TEMPORAL): last frame's reservoir at its reprojected texel, and
//   * SPATIAL (5c, RS_F_SPATIAL): last frame's reservoirs of rs_cfg2.y neighbours of that texel
//     (radius rs_cfg2.z, the same surface: depth plane + normal) -- spatiotemporal reuse from the
//     previous frame's buffer: one pass, no extra dispatch and no split of the merged kernel,
// each weighed with the CURRENT target p(y) at THIS texel (a club light that moved or recoloured
// is weighed as it is now; one switched off has p = 0 and drops out this frame: light-off
// anti-lag 0 frames), M capped at rs_cfg2.x frames, and the temporal one faded out by the
// light-set change the denoiser cuts its history on (the cell's target sum vs last frame's W:
// a light switched ON gets the fresh candidates' full say at once). Light indices follow the
// per-frame re-sort through the host's remap (rsRemap). ONE visibility ray for the final sample
// (the generic core); the ratio estimator's num / den are that sample's, as before.
#define RS_RES_ON   1u   // push rtr2.w: the reservoir buffer is bound at this extent (write this parity)
#define RS_RES_PREV 2u   //   ... and last frame's parity holds this extent's reservoirs
uint rsResFlags() { return uint(max(g_draw_push.rtr2.w, 0.0) + 0.5); }
uint rsResIndex(ivec2 q, ivec2 D, uint layer) { return layer * uint(D.x * D.y) + uint(q.y * D.x + q.x); }
uvec2 rsResPack(uint li, float M, float W)
{
    const uint y = li < 0xFFFFu ? li : 0xFFFFu;
    return uvec2(y | (packHalf2x16(vec2(clamp(M, 0.0, 60000.0), 0.0)) << 16u), floatBitsToUint(max(W, 0.0)));
}
// One of last frame's reservoirs (texel q of layer pl) as a candidate here: on this surface
// (expected view depth zExp +- ztol, normal within ~25 deg), its light remapped, in this frame's
// light set and lit at P now. Returns its resampling weight p(y) W M (0 = rejected); y / py / Mq
// its light, target here and (capped, faded) confidence. wRef >= 0: the light-set change rule.
// (#869 SPLIT) spLi: this texel's split lights -- a reservoir holding one of them is rejected (the rest
// leaves them out of its candidates, its numerator and its denominator: re-injected here, a reused
// pick would hand the split light's visibility to the rest again).
float rsTap(ivec2 q, ivec2 D, uint pl, float zExp, float ztol, vec3 P, vec3 N, float wRef, float mcap, uint count,
            uvec4 spLi, uint ocCull, out uint y, out float py, out float Mq)
{
    y = 0xFFFFFFFFu; py = 0.0; Mq = 0.0;
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, D))) return 0.0;
    const uvec4 g = imageLoad(uPdnGeom, ivec3(q, int(pl)));
    const float zq = uintBitsToFloat(g.x);
    if (!(zq > 0.0) || !(abs(zq - zExp) <= ztol)) return 0.0;
    if (dot(pdnUnpackN(g.y), N) < 0.9) return 0.0;
    const uvec2 r = rs_res[rsResIndex(q, D, pl)];
    const uint lp = r.x & 0xFFFFu;
    if (lp == 0xFFFFu) return 0.0;
    // (#91) an EMITTING TRIANGLE key: last build's record (the other parity) -> its (instance, triangle)
    // -> this build's slot (emRemap; gone / dropped / out of this frame's subset / emitters off: rejected)
    const bool em = lp >= REGIR_EM_KEY;
    uint li = 0xFFFFFFFFu;
    if (em)
    {
        if (!emLitOn()) return 0.0;
        const uint ns = emRemap(lp - REGIR_EM_KEY);
        if (ns == REGIR_EM_NONE) return 0.0;
        li = REGIR_EM_KEY + ns;
    }
    else
    {
        li = rsRemap(lp);
        if (li >= count || !rsInSet(li) || pdnSplitHas(spLi, li) || occCulled(ocCull, li)) return 0.0;   // (#869: the rest only)
    }
    const float W = uintBitsToFloat(r.y);
    if (!(W > 0.0) || !(W < 3.0e38)) return 0.0;
    float M = min(unpackHalf2x16(r.x >> 16u).x, mcap);
    if (wRef >= 0.0)
    {
        const float Wq = pdnMetaW(g.w);
        const float c = float(rg.rs_cfg2.w) * 0.001;
        if (c > 0.0) M *= 1.0 - smoothstep(c, 2.0 * c, abs(wRef - Wq) / max(max(wRef, Wq), 1e-4));
    }
    if (!(M > 0.0)) return 0.0;
    float p0;
    const float p = em ? rsEmTarget(li - REGIR_EM_KEY, P, N) : pdnTargetGoboL(li, P, N, true, p0);
    if (!(p > 0.0)) return 0.0;
    y = li; py = p; Mq = M;
    const float w = p * W * M;
    return w < 3.0e38 ? w : 0.0;
}
// The ReSTIR debug view's colour of light li (a stable hue per index).
vec3 rsHue(uint li)
{
    const float h = fract(float(li) * 0.61803399);
    return clamp(abs(fract(vec3(h) + vec3(0.0, 2.0, 1.0) / 3.0) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
}

// ---- (#869) THE SPLIT: PER-LIGHT VISIBILITY OF THE DOMINANT LIGHTS (clean_pdn_common.glsl SPLIT
//      CHANNEL; push rtr3.z bits 0-2 K = RenderVKProjStochasticSplitK, bit 3 last frame's split ids
//      are valid at this extent) ----
// A light the lit kernels shade with the stochastic ratio at a P (grid: P is inside the light grid
// on a ReSTIR frame) -- localLight's rule exactly (projStochEligible, or deferRsStoch's extended
// set), minus a taken-over light (both sides leave it out): only such a light may be split, so the
// split set is a subset of the lighting set and the rest is the lighting set minus it.
bool pdnSplitEligible(uint li, bool grid)
{
    if (rsFrameOn() && emTaken(li)) return false;
    const uint rec = lights[li].tex.z;
    if (rec != 0u)
    {
        const vec4 sp = pshadow[rec - 1u].params;
        if (!(sp.w < 0.5) && sp.z > 1.5) return true;   // (projStochEligible)
    }
    return grid && rsFrameOn() && rsInSet(li) && !rsRecordLight(li);
}
// The hysteresis an incumbent (split at this point last frame) gets in the ranking: two lights of
// near-equal strength never swap slots frame to frame -- a challenger must be this much stronger.
#define PDN_SPLIT_HYST 1.5
// THE SELECTION: the K strongest eligible lights at (P, N) by the GOBO-FREE unshadowed target
// (pdnTargetL: range, attenuation, the cutoff fade, the frustum, N.L -- no texture): smooth in
// space, so a projector's whole footprint splits it, stripes and all (a gobo-weighted rank would
// drop it in its dark stripes and hand those to the rest). Over a DETERMINISTIC list -- the pixel
// cluster's (<= CLUSTER_CAP, every frame the same; the shadowed run alone off the grid, where
// only the records are stochastic), never the RIS window (a random start: the rank would flicker)
// -- x PDN_SPLIT_HYST for last frame's ids at the reprojected texel, ties to the lower id.
// li: the lights (0xFFFFFFFF empty), id: their split ids (0 empty); returns the count.
// (#869 OCCLUSION CULL) ocCell: P's patch (OCC_NONE: none / culling nothing) -- a culled light is never
// split (it is out of the lighting set here); among the culled lights that reach P (target > 0) one is
// picked uniformly as this texel's PROBE candidate (probe; 0xFFFFFFFF none; nProbe: how many there
// were). K = 0: the walk only picks the probe.
uint pdnSplitSelect(vec3 P, vec3 N, uint K, bool grid, uvec2 prevIds, uint ocCell, inout uint seed,
                    out uvec4 li, out uvec4 id, out uint probe, out float nProbe)
{
    li = uvec4(0xFFFFFFFFu);
    id = uvec4(0u);
    probe = 0xFFFFFFFFu;
    nProbe = 0.0;
    vec4 sc = vec4(0.0);
    uint ns = 0u;
    const uint count = uint(linfo.cam_pos.w);
    const uint c = mainClusterFrag(P);
    const uint raw = cluster_count[c];
    const uint n = grid ? clusterLen(raw) : clusterShadowedLen(raw);
    [[dont_unroll]] for (uint i = 0u; i < n; ++i)
    {
        const uint l = cluster_index[c * CLUSTER_CAP + i];
        if (l >= count) continue;
        const uint d = lights[l].tex.w & 0xFFFFu;
        if (d == 0u || !pdnSplitEligible(l, grid)) continue;
        float s = pdnTargetL(l, P, N, true);
        if (!(s > 0.0) || !(s < 3.0e38)) continue;
        if (occCulled(ocCell, l))
        {   // (culled here: a probe candidate, never split)
            nProbe += 1.0;
            if (pdnRand(seed) * nProbe < 1.0) probe = l;
            continue;
        }
        if (K == 0u) continue;
        if (pdnSplitFind(prevIds, d) >= 0) s *= PDN_SPLIT_HYST;
        // its rank: the entries ahead of it (sorted: a prefix)
        uint r = 0u;
        [[unroll]] for (uint k = 0u; k < PDN_SPLIT_MAX; ++k)
            if (k < ns && (sc[k] > s || (sc[k] == s && id[k] < d))) ++r;
        if (r >= K) continue;
        [[unroll]] for (uint k = PDN_SPLIT_MAX - 1u; k > 0u; --k)
            if (k > r && k < K) { sc[k] = sc[k - 1u]; li[k] = li[k - 1u]; id[k] = id[k - 1u]; }
        sc[r] = s; li[r] = l; id[r] = d;
        ns = min(ns + 1u, K);
    }
    return ns;
}

// ---- (#869 OCCLUSION CULL) pass 15's notes into the cache (the block above DEFER_MAIN's helpers) ----
void occOr(uint w, uint v)
{
    if ((w & 1u) == 0u) atomicOr(rg_cells[w >> 1u].x, v);
    else                atomicOr(rg_cells[w >> 1u].y, v);
}
// The patch for tag, claimed if absent (a free slot of its chain); OCC_NONE: the chain is full.
uint occClaim(uint tag, uint slot0)
{
    const uint f = occFind(tag, slot0);
    if (f != OCC_NONE) return f;
    for (uint j = 0u; j < OCC_PROBES; ++j)
    {
        const uint c = (slot0 + j) & (OCC_CELLS - 1u);
        const uint old = atomicCompSwap(rg_cells[occBase(c)].x, 0u, tag);
        if (old == 0u || old == tag) return c;
    }
    return OCC_NONE;
}
// One traced ray toward light li from P's patch: blocked -> its B bit (claiming the patch), visible -> its
// V bit where it has a count (none: nothing to re-admit). One atomicOr at most, skipped when the bit is
// already set (most of a patch's texels agree). refused: the chain was full (stats).
void occNote(uint tag, uint slot0, inout uint cell, uint li, bool visible, inout uint refused)
{
    if (li >= 256u) return;
    if (cell == OCC_NONE)
    {
        if (visible) return;
        cell = occClaim(tag, slot0);
        if (cell == OCC_NONE) { ++refused; return; }
    }
    if (visible && occCount(cell, li) == 0u) return;
    const uint w = occWord(cell, (visible ? OCC_W_V : OCC_W_B) + (li >> 5u));
    const uint bit = 1u << (li & 31u);
    if ((occLoad(w) & bit) == 0u) occOr(w, bit);
}

void DEFER_MAIN()
{
    const ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 D = ivec2(g_draw_push.rtr.xy + 0.5);
    if (any(greaterThanEqual(m, D))) return;
    const uint ctl = uint(g_draw_push.rtr.w + 0.5);
    const uint K = clamp(ctl & 3u, 1u, 2u);
    const int par = int((ctl >> 4u) & 1u);
    const uint frame = uint(g_draw_push.rtr.z + 0.5);
    const uint opts = pdnOpts();
    const vec2 R2 = vec2(float(g_draw_push.width), float(g_draw_push.height));
    const vec2 r = R2 / vec2(D);   // render px per denoiser texel
    const vec2 J = (ssr.taa_params.w > 0.5 && D.x < int(g_draw_push.width)) ? ssr.taa_jitter.xy : vec2(0.0);
    const ivec2 rp = clamp(ivec2((vec2(m) + 0.5 + J) * r), ivec2(0), ivec2(R2) - 1);
    g_frag_xy = vec2(rp) + 0.5;
    CLK_INV();
    const vec4 g2 = texelFetch(uG2, rp, 0);
    bool surf = deferHasSurface(g2);
    float glow;
    bool noFade;
    SurfaceLit s;
    if (surf)
    {
        s = deferSurface(rp, g2, glow, noFade);
        surf = s.model != SURF_FULLBRIGHT;
    }
    if (!surf)
    {
        imageStore(uPdnIn, ivec3(m, 0), vec4(0.0));
        imageStore(uPdnIn, ivec3(m, 1), vec4(0.0));
#if DEFER_SHADOW_MERGE
        if ((opts & PDN_OPT_SUN_SKIP) == 0u)
            imageStore(uPdnIn, ivec3(m, 2), vec4(1.0, 1.0, 1.0, -1.0));   // (sun: lit, no caster)
#endif
        imageStore(uPdnGeom, ivec3(m, par), uvec4(floatBitsToUint(-1.0), 0u, 0u, 0u));
        imageStore(uPdnMot, m, uvec4(0u));
        if (imageSize(uPdnGeom).z >= PDN_SPLIT_GEOM_LAYERS)   // (#869: no split light here)
            imageStore(uPdnGeom, ivec3(m, PDN_SPLIT_GEOM_PAR + par), uvec4(0u));
        return;
    }
    CLK_SURF();
    const vec3 P = deferPosition(rp);
    const vec3 V = normalize(pc.u_cam_time.xyz - P);
    const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
    const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    // The LOCAL pass's own localLights inputs (lightSurface's common tail).
    s.cel = s.cel && specCelOn();
    g_cel = s.cel;
    const bool pbr = s.model == SURF_PBR;
    LegacySpec ls = legacySpecNone();
    float metal = 0.0, rough = 1.0;
    if (pbr) { metal = s.metal; rough = s.rough; }
    else { ls.spec = s.spec; ls.gloss = s.gloss; ls.env = s.env; }
    const vec3 base = s.albedo;
    const vec3 diffuseColor  = base * (1.0 - 0.04) * (1.0 - metal);
    const vec3 specularColor = mix(vec3(0.04), base, metal);
    const float specRough = pbr ? rough : clamp(1.0 - ls.gloss, 0.0, 1.0);   // (dsSpecRough)
    CLK_MARK(GBUF);

    // ---- THE RECEIVER (light-independent, once per texel): position, visible-side normal,
    //      pixel footprint, view-slope offset; the self-shadow owner, the noise phase ----
    const vec3 cam = pc.u_cam_time.xyz;
    const float time = pc.u_cam_time.w;
    const float dR = texelFetch(uDepthG, rp, 0).r;
    ShadowRecv Rv;
    // the FACET normal (pdnFacetNormal: the mask's receiver normal, not the G-buffer's smooth
    // vertex normal) -- every light's receiver rules (shadowRecvLight: the terminator band /
    // probe, the facing measure from the probe's smooth normal) are the mask's on it
    bool ngOnPlane;
    const vec3 Nf = pdnFacetNormal(rp, P, cam, Ng, ngOnPlane);
    Rv.P = P; Rv.Ng = Nf; Rv.cam = cam; Rv.rp = rp;
    Rv.pxw = max(length(pdnWorldAt(vec2(rp) + 0.5 + vec2(1.0, 0.0), dR) - P), 1e-6);
    {
        const vec3 Vc = P - cam;
        const float vcl = length(Vc);
        Rv.slope = vcl > 1e-4 ? g_draw_push.rtr2.y * Rv.pxw * length(cross(Nf, Vc / vcl)) : 0.0;
    }
    rtSelfBegin(P);
    rt_noise_shift = fract(float(frame) * vec2(0.7548776662, 0.5698402910));
    rt_vis_hint = -1.0;
    const bool gate = (opts & PDN_OPT_FACING) != 0u;
    const bool infoFix = (opts & PDN_OPT_BLEED) != 0u;

    // RATIO ESTIMATOR (Heitz et al. 2018): the same picks estimate the SHADOWED (num) and the
    // UNSHADOWED (den) projector light with the same weights; their per-channel ratio is the
    // pixel's visibility -- what the denoiser filters. No candidate: visibility 1.
    vec3 numD = vec3(0.0), denD = vec3(0.0), numS = vec3(0.0), denS = vec3(0.0);
    float Wsum = 0.0, W0 = 0.0, nCand = 0.0, hitSum = 0.0, hitW = 0.0;
    const uint count = uint(linfo.cam_pos.w);
    const bool projOn = count > 0u && !litDbg(LDBG_NO_LOCAL);
    // (#869) THE SPLIT (pdnSplitSelect above; clean_pdn_common.glsl SPLIT CHANNEL): this texel's K
    // strongest lights each get their own sample below (one ray, their own visibility); the RATIO
    // ESTIMATOR that follows -- candidates, reused reservoirs, the dense evaluation, num and den --
    // runs over the REST (every check pdnSplitHas). The images without the split layers: K = 0.
    const bool spLayers = imageSize(uPdnGeom).z >= PDN_SPLIT_GEOM_LAYERS;   // (uniform)
    const uint spK = spLayers && projOn ? min(g_draw_push.rtr3.z & 7u, PDN_SPLIT_MAX) : 0u;
    uvec4 spLi = uvec4(0xFFFFFFFFu), spId = uvec4(0u);
    uint spN = 0u;
    vec4 spV = vec4(-1.0);   // the samples' visibility (< 0: no information)
    bvec4 spMv = bvec4(false);
    // (#869 OCCLUSION CULL, the block above DEFER_MAIN's helpers) P's cell and its culled list (fixed for
    // the frame: the resolve ran before this pass); this texel's notes go to the same cell
    const bool ocOn = projOn && occFrameOn();   // (uniform)
    uint ocTag = 0u, ocSlot0 = 0u, ocCell = OCC_NONE;
    uint ocCull = OCC_NONE;   // (the patch while it culls anything: the tests' handle)
    uint ocRefused = 0u;
    if (ocOn)
    {
        ocTag = occKey(P, s.N, ocSlot0);
        ocCell = occFind(ocTag, ocSlot0);
        if (occAny(ocCell)) ocCull = ocCell;
    }
    uint ocProbe = 0xFFFFFFFFu;
    // (the probe pick: a uniform reservoir over every culled light that reaches P -- the split walk's
    //  cluster list, then the grid window's slots: the cluster list is capped at CLUSTER_CAP, and with a
    //  hundred projectors a culled light may only be met in the grid, the list that culled it)
    uint pseed = pdnPcg(uint(m.x) * 6833u + uint(m.y) * 2909u + frame * 4241u + 5u);
    float nProbe = 0.0;
    if (spK > 0u || ocCull != OCC_NONE)
    {
        // last frame's split ids at the reprojected texel (the hysteresis)
        uvec2 prevIds = uvec2(0u);
        if ((g_draw_push.rtr3.z & 8u) != 0u)
        {
            float ppw;
            const vec2 pd = pdnPrevDelta(P, m, vec2(D), ppw);
            const ivec2 pq = ivec2(floor(vec2(m) + pd + 0.5));
            if (ppw > 0.0 && all(greaterThanEqual(pq, ivec2(0))) && all(lessThan(pq, D)))
                prevIds = imageLoad(uPdnGeom, ivec3(pq, PDN_SPLIT_GEOM_PAR + (par ^ 1))).xy;
        }
        const bool spGrid = rsFrameOn() && regirCell(P) != REGIR_NO_CELL;
        spN = pdnSplitSelect(P, s.N, spK, spGrid, prevIds, ocCull, pseed, spLi, spId, ocProbe, nProbe);
    }
    // (#869) THE MOVING-LIGHT RULE (clean_regir.glsl RS_MOVE_*): Wmov = the candidates' target of
    // lights that moved since last frame (their share of Wsum: MOT w, the denoiser's history cap)
    const bool mvOn = rsFrameOn() && rsMoveOn();   // (uniform)
    float Wmov = 0.0;
    // (#869 rsFlick) Wflk = the candidates' weight of lights whose RADIANCE changed this frame
    // (without moving), wMax the largest single candidate weight: the flickering-light rule
    float Wflk = 0.0, wMax = 0.0;
    // the K reservoirs' picks, and the first two candidates in cluster order with their run
    // index (the exact mode's list: no second pdnTarget pass) -- named scalars, no arrays
    uint pick0 = 0xFFFFFFFFu, pick1 = 0xFFFFFFFFu;
    float pp0 = 0.0, pp1 = 0.0;
    uint ex0 = 0xFFFFFFFFu, ex1 = 0xFFFFFFFFu, exi0 = 0u, exi1 = 0u;
    // (#869 Phase 5a) ReSTIR DI CANDIDATES (RenderVKReSTIRDI; the frame info's rsFrameOn): at a P
    // inside the light grid the candidates are its cell's population-1 slots (clean_regir.glsl) --
    // every light of pass 15's set that can reach the cell has q > 0 there, so the candidate set
    // still equals the lighting set; past the grid, the cluster walk below (the records only: the
    // lit kernels give the extended set the ratio only inside the grid, deferRsStoch).
    //   * an EXACT cell (its whole list fits the slots) with every slot taken: the cluster walk's
    //     exact RIS on a tighter list (<= K candidates at P: no noise at all);
    //   * else RIS over a window of the slots (rs_cfg.y of them, a random start; 0 = all):
    //     w = p(x) x (1 / q(x)) / window, the pick's weight W / p as before -- unbiased.
    //   * the denoiser's light-set reference W0 = the cell's target sum (deterministic: it moves
    //     only when the cell's lights change -- never with the window's noise).
    bool exactOk = true;
    uint rsCell = REGIR_NO_CELL;
    // (#869 RS_MOVE_LIGHTS) the window this texel's grid candidates came from (the dense evaluation
    // below re-reads its slots): cell word, start slot, slots, window length, the window's scale
    uint dCw = 0u, dStart = 0u, dSlots = 0u, dWin = 0u;
    float dScale = 0.0;
    // (#91) EMITTERS (clean_regir.glsl EMISSIVE LIGHTS): the cell's population-2 emitters join the same
    // candidate stream (keys REGIR_EM_KEY + slot); pickE / ppE / WsumE: an emitter-only reservoir over
    // the same candidates (the dense evaluation's emitter stratum), nEm their count
    const bool emOn = rsFrameOn() && emLitOn() && !litDbg(LDBG_NO_LOCAL);   // (uniform)
    uint pickE = 0xFFFFFFFFu, nEm = 0u, emRays = 0u;
    float ppE = 0.0, WsumE = 0.0;
    if ((projOn || emOn) && rsFrameOn()) rsCell = regirCell(P);
    if (rsCell != REGIR_NO_CELL)
    {
        rt_fix_max = rg.rs_params.y;
        const uint cw = rsCellWord(rsCell);
        const uvec2 h = rg_cells[cw];
        const uint Mc = h.x & REGIR_COUNT_MASK;
        const bool cellExact = (h.x & REGIR_CELL_EXACT) != 0u;
        const uint nSlots = cellExact ? min(Mc, rsSlots()) : rsSlots();
        if (Mc > 0u && nSlots > 0u)
        {
            uint seed = pdnPcg(uint(m.x) * 1973u + uint(m.y) * 9277u + frame * 26699u);
            const uint want = rg.rs_cfg.y;
            const uint nWin = want == 0u ? nSlots : min(want, nSlots);
            const uint start = nWin < nSlots ? min(uint(pdnRand(seed) * float(nSlots)), nSlots - 1u) : 0u;
            const float scale = (cellExact ? float(nSlots) : 1.0) / float(nWin);
            exactOk = cellExact && nWin == nSlots;
            dCw = cw; dStart = start; dSlots = nSlots; dWin = nWin; dScale = scale;
            W0 = uintBitsToFloat(h.y);
            [[dont_unroll]] for (uint i = 0u; i < nWin; ++i)
            {
                const uint j = rsWinSlot(start, i, nWin, nSlots);   // (RS_F_STRIDE: evenly spaced)
                const uvec2 sl = rg_cells[cw + 1u + j];
                const uint li = sl.x;
                if (li >= count || pdnSplitHas(spLi, li)) continue;   // (#869: the rest only)
                if (occCulled(ocCull, li))
                {   // (#869 OCCLUSION CULL) culled here: out of the rest -- a probe candidate if it reaches P
                    if (pdnTargetL(li, P, s.N, true) > 0.0)
                    {
                        nProbe += 1.0;
                        if (pdnRand(pseed) * nProbe < 1.0) ocProbe = li;
                    }
                    continue;
                }
                float p0;
                const float p = pdnTargetGoboL(li, P, s.N, true, p0);
                if (!(p > 0.0)) continue;
                const float w = p * uintBitsToFloat(sl.y) * scale;
                if (!(w > 0.0) || !(w < 3.0e38)) continue;
                Wsum += w;
                if (mvOn && rsMoved(li)) Wmov += w;
                if (mvOn && rsFlick(li)) Wflk += w;
                wMax = max(wMax, w);
                nCand += 1.0;
                if (nCand == 1.0) { ex0 = li; exi0 = j; }
                else if (nCand == 2.0) { ex1 = li; exi1 = j; }
                for (uint k = 0u; k < K; ++k)
                    if (pdnRand(seed) * Wsum < w)
                    {
                        if (k == 0u) { pick0 = li; pp0 = p; }
                        else         { pick1 = li; pp1 = p; }
                    }
            }
            if (!(W0 > 0.0)) W0 = Wsum;   // (a degenerate header: never 0 with candidates)
            if ((rg.rs_cfg.z & RS_F_WCUT) == 0u) W0 = 1.0;   // (no light-set cut: see RS_F_WCUT)
        }
        // (#91) THE CELL'S EMITTING TRIANGLES (population 2): every filled slot (<= R_e <= 8: no window),
        // weight p x the slot's 1 / q -- 1 in an exact cell and for its strongest triangles, the stratified
        // rest's W_rest / (p_cell R_s) -- in the SAME streaming reservoirs as the lights (one RIS over lights
        // + triangles: unbiased for both, the lit kernels add exactly this cell's slots), + the
        // emitter-only reservoir. (#1006 WEAK OVERLAY, clean_regir.glsl) at a point of level 0 the overlay cell
        // holding P adds the weak emitters' slots (level 0's cell never lists them; the two sets are disjoint)
        if (emOn)
        {
            const uint ovCell = (rsCell < REGIR_CELLS_PER_LEVEL && emOvLive()) ? emOvCell(P) : REGIR_NO_CELL;
            uint seed = pdnPcg(uint(m.x) * 4513u + uint(m.y) * 7411u + frame * 30011u);
            [[dont_unroll]] for (uint ec = 0u; ec < 2u; ++ec)
            {
                const uint eCell = ec == 0u ? rsCell : ovCell;
                if (eCell == REGIR_NO_CELL) break;
                const uint ecw = emCellWord(eCell);
                const uvec2 eh = rg_cells[ecw];
                const uint ne = min(eh.x & REGIR_COUNT_MASK, REGIR_EM_SLOTS_MAX);
                if (ne > 0u)
                {
                    const bool eEx = (eh.x & REGIR_CELL_EXACT) != 0u;
                    if (!eEx) exactOk = false;
                    const uint ecnt = emCount();
                    [[dont_unroll]] for (uint j = 0u; j < ne; ++j)
                    {
                        const uvec2 sl = rg_cells[ecw + 1u + j];
                        if (sl.x >= ecnt) continue;
                        const float p = rsEmTarget(sl.x, P, s.N);
                        if (!(p > 0.0)) continue;
                        const float w = p * uintBitsToFloat(sl.y);
                        if (!(w > 0.0) || !(w < 3.0e38)) continue;
                        const uint li = REGIR_EM_KEY + sl.x;
                        Wsum += w;
                        wMax = max(wMax, w);
                        nCand += 1.0;
                        ++nEm;
                        if (nCand == 1.0) { ex0 = li; exi0 = 32u + ec * 8u + j; }
                        else if (nCand == 2.0) { ex1 = li; exi1 = 32u + ec * 8u + j; }
                        for (uint k = 0u; k < K; ++k)
                            if (pdnRand(seed) * Wsum < w)
                            {
                                if (k == 0u) { pick0 = li; pp0 = p; }
                                else         { pick1 = li; pp1 = p; }
                            }
                        WsumE += w;
                        if (pdnRand(seed) * WsumE < w) { pickE = li; ppE = p; }
                    }
                    if ((rg.rs_cfg.z & RS_F_WCUT) != 0u) W0 += uintBitsToFloat(eh.y);
                }
            }
            // the denoiser's light-set reference: > 0 with any candidate (nCand > 0 <=> W > 0)
            if (nEm > 0u && !(W0 > 0.0)) W0 = (rg.rs_cfg.z & RS_F_WCUT) != 0u ? Wsum : 1.0;
        }
        CLK_MARK(LOCAL);
    }
    else if (projOn)
    {
        const uint c = mainClusterFrag(P);
        const uint n = clusterShadowedLen(cluster_count[c]);
        uint seed = pdnPcg(uint(m.x) * 1973u + uint(m.y) * 9277u + frame * 26699u);
        // ---- pass 1: the targets (pdnTargetGobo: ALU + record loads + the gobo texel, no BRDF),
        //      K streaming reservoirs ----
        [[dont_unroll]] for (uint i = 0u; i < n; ++i)
        {
            const uint li = cluster_index[c * CLUSTER_CAP + i];
            if (li >= count || pdnSplitHas(spLi, li) || occCulled(ocCull, li)) continue;   // (#869: the rest only)
            float p0;
            const float p = pdnTargetGobo(li, P, s.N, p0);
            if (!(p > 0.0)) continue;
            Wsum += p;
            if (mvOn && rsMoved(li)) Wmov += p;
            if (mvOn && rsFlick(li)) Wflk += p;
            wMax = max(wMax, p);
            W0 += p0;
            nCand += 1.0;
            if (nCand == 1.0) { ex0 = li; exi0 = i; }
            else if (nCand == 2.0) { ex1 = li; exi1 = i; }
            for (uint k = 0u; k < K; ++k)
                if (pdnRand(seed) * Wsum < p)
                {
                    if (k == 0u) { pick0 = li; pp0 = p; }
                    else         { pick1 = li; pp1 = p; }
                }
        }
        CLK_MARK(LOCAL);
    }
    // (#869) the moved lights' share of this texel's unshadowed target (before the reuse below
    // replaces Wsum with the reused sample's weight): MOT w, the denoiser's moving-light history cap
    const float fMoveL = (Wmov > 0.0 && Wsum > 0.0) ? clamp(Wmov / Wsum, 0.0, 1.0) : 0.0;
    // (#869 rsFlick) THE FLICKERING-LIGHT SHARE: how much of the ratio's light mix can shift when the
    // flickering lights' radiance changes -- min(their share, the share NOT held by the strongest
    // single candidate): 0 for a lone light (a one-light ratio is its visibility, whatever its
    // intensity), 0 where a flickering light is negligible or utterly dominant, 0.5 for a fire
    // beside an equal lamp or two equal fires. x2: such a texel takes the full moving-light history
    // cap (clean_dn_temporal.comp kMv = 2 MOT w) -- a 50 / 50 mix keeps RenderVKReSTIRMoveHistory
    // frames, a 80 / 20 one ~10. The flickering light's shadow did not move: its rays stay one
    // (RS_MOVE_RAYS is for rsMoved lights only).
    const float fFlk = (Wflk > 0.0 && Wsum > 0.0)
                     ? clamp(2.0 * min(Wflk / Wsum, 1.0 - wMax / Wsum), 0.0, 1.0) : 0.0;
    // the share the denoiser's moving-light rule and the dense evaluation read (MOT w)
    const float fMove = max(fMoveL, fFlk);
    // ---- pass 2: the SAMPLE LIST through the one core -- sample 0 the sun / moon (merged), then
    //      the projector evaluations: every candidate when they all fit (exact: no noise), else
    //      the K picks weighted W / (K p) ----
    if (rsFrameOn())   // (stats, clean_regir.glsl RS_STATS: one atomic per subgroup; a uniform test)
    {
        const uint gT = subgroupAdd(rsCell != REGIR_NO_CELL ? 1u : 0u);
        const uint wT = subgroupAdd(rsCell == REGIR_NO_CELL && projOn ? 1u : 0u);
        if (subgroupElect())
        {
            if (gT != 0u) atomicAdd(rg.rs_stat[3], gT);
            if (wT != 0u) atomicAdd(rg.rs_stat[4], wT);
        }
    }
    // the guides' depth gradient (also the spatial taps' plane)
    const int stp = max(int(r.x + 0.5), 1);
    const vec2 grad = vec2(pdnGrad(rp, ivec2(stp, 0), vz), pdnGrad(rp, ivec2(0, stp), vz));
    // ---- (#869 Phase 5b / 5c) RESERVOIR REUSE (rsTap above): this frame's candidates' reservoir
    //      (the K = 1 stream's pick, W = Wsum / p, M = 1) + last frame's at the reprojected texel +
    //      its neighbours'; the final sample replaces the pick (weight W, one ray). Written for every
    //      texel with a surface (the cluster walk's too: in-grid neighbours may reuse a record).
    const uint rsf = rsResFlags();
    const bool rsResOn = rsFrameOn() && (rsf & RS_RES_ON) != 0u;   // (uniform)
    uint rsY = 0xFFFFFFFFu;
    float rsM = 0.0;
    bool reused = false;
    if (rsResOn)
    {
        float py = pp0;
        rsY = (pick0 != 0xFFFFFFFFu && pp0 > 0.0) ? pick0 : 0xFFFFFFFFu;
        float wsumC = rsY != 0xFFFFFFFFu ? Wsum : 0.0;   // p(y0) W0 M0 = p Wsum / p x 1
        float Msum = 1.0;
        uint keptT = 0u, keptS = 0u;
        const bool canReuse = rsCell != REGIR_NO_CELL && (rsf & RS_RES_PREV) != 0u && ssr.taa_params.z < 0.5
                           && (rg.rs_cfg.z & RS_F_TEMPORAL) != 0u && !(exactOk && nCand <= float(K));
        if (canReuse)
        {
            const float mcap = float(max(rg.rs_cfg2.x, 1u));
            uint rng = pdnPcg(uint(m.x) * 7919u + uint(m.y) * 104729u + frame * 15485863u);
            float pw;
            const vec2 dS = pdnPrevDelta(P, m, vec2(D), pw);
            const ivec2 qt = ivec2(floor(vec2(m) + dS + 0.5));
            const uint pl = uint(par) ^ 1u;
            uint ly; float lp, lM;
            if (pw > 0.0)
            {
                // TEMPORAL (5b)
                const float wt = rsTap(qt, D, pl, pw, max(0.04 * pw, 0.03), P, s.N, min(W0, 60000.0), mcap, count, spLi,
                                       ocCull, ly, lp, lM);
                if (wt > 0.0)
                {
                    wsumC += wt; Msum += lM; ++keptT;
                    if (pdnRand(rng) * wsumC < wt) { rsY = ly; py = lp; }
                }
                // SPATIAL (5c): last frame's neighbours of the reprojected texel, on this plane
                if ((rg.rs_cfg.z & RS_F_SPATIAL) != 0u)
                {
                    const uint taps = min(rg.rs_cfg2.y, 5u);
                    const float rad = float(max(rg.rs_cfg2.z, 1u));
                    [[dont_unroll]] for (uint t = 0u; t < taps; ++t)
                    {
                        const float a = 6.2831853 * pdnRand(rng);
                        const float rr = rad * sqrt(max(pdnRand(rng), 0.02));
                        const ivec2 q = qt + ivec2(round(vec2(cos(a), sin(a)) * rr));
                        if (q == qt) continue;
                        const float dz = dot(grad, vec2(q - qt));
                        const float ws = rsTap(q, D, pl, pw + dz, max(0.05 * pw, 0.05) + 0.25 * abs(dz), P, s.N, -1.0, mcap,
                                               count, spLi, ocCull, ly, lp, lM);
                        if (ws > 0.0)
                        {
                            wsumC += ws; Msum += lM; ++keptS;
                            if (pdnRand(rng) * wsumC < ws) { rsY = ly; py = lp; }
                        }
                    }
                }
            }
        }
        float rsW = (rsY != 0xFFFFFFFFu && py > 0.0 && wsumC > 0.0) ? wsumC / (py * Msum) : 0.0;
        if (!(rsW > 0.0) || !(rsW < 3.0e38)) { rsY = 0xFFFFFFFFu; rsW = 0.0; }
        rsM = min(Msum, float(max(rg.rs_cfg2.x, 1u)));
        if (canReuse && rsY != 0xFFFFFFFFu && keptT + keptS > 0u)
        {
            reused = true;
            pick0 = rsY; pp0 = py;
            Wsum = rsW * py;   // (the evaluation's weight Wsum / (1 x p) = W)
            nCand = max(nCand, 1.0);
        }
        rs_res[rsResIndex(m, D, uint(par))] = rsResPack(rsY, rsM, rsW);
        // stats (clean_regir.glsl RS_STATS 5-7; rsResOn is uniform: every surface lane is here)
        const uint sM = subgroupAdd(uint(rsM + 0.5));
        const uint sT = subgroupAdd(keptT);
        const uint sS = subgroupAdd(keptS);
        if (subgroupElect())
        {
            if (sM != 0u) atomicAdd(rg.rs_stat[5], sM);
            if (sT != 0u) atomicAdd(rg.rs_stat[6], sT);
            if (sS != 0u) atomicAdd(rg.rs_stat[7], sS);
        }
    }
    // (#869 RS_MOVE_LIGHTS) DENSE EVALUATION where lights that MOVED light the texel (fMove >= 5 %):
    // one RIS pick (or a reused reservoir's) is a binary visibility of ONE light per texel, and the
    // spatial reuse hands the same pick to a ~rs_cfg2.z-texel neighbourhood -- with the moving
    // light's history cut short, that correlated one-light noise is what the a-trous smears into
    // crawling low-frequency blotches ("water"). Here the texel instead evaluates c = min(cap,
    // window) of its window's candidate slots, each with a shadow ray, at its RIS-free weight
    // u = q-weight x scale x window / c (a random contiguous sub-window of the random window:
    // unbiased for num and den alike) -- the ratio becomes the target-weighted mean visibility of c
    // lights, not one light's 0 / 1. The reservoir is still written (above); the evaluation does not
    // use it (no spatially shared pick). Cost: up to c rays instead of 1 on these texels only (a
    // candidate without light at P -- projDirectTerms 0 -- traces nothing).
    uint dC = 0u, dOff = 0u;
    if (mvOn && dWin > 0u && fMove >= 0.05)
    {
        dC = min(rsMoveLights(), dWin);
        if (dC != 0u) reused = false;
        // the sub-window's random start INSIDE the window (cyclic over its dWin slots): every
        // window slot is evaluated with probability c / window -- also in an exact cell, whose
        // window always starts at slot 0 (a fixed first-c subset would drop the others)
        if (dC < dWin)
        {
            uint ds = pdnPcg(uint(m.x) * 3571u + uint(m.y) * 6007u + frame * 7919u + 17u);
            dOff = min(uint(pdnRand(ds) * float(dWin)), dWin - 1u);
        }
    }
    const uint Ke = reused ? 1u : K;   // (a reused reservoir: ONE final sample)
    const bool exact = exactOk && nCand <= float(K) && !reused;
    if (exact) dC = 0u;   // (every candidate is evaluated already: no noise to remove)
    const bool dense = dC != 0u;
    // (#91) dense: + the emitter stratum's one pick (the dense window covers the lights only)
    const uint nProj = !(projOn || nEm > 0u) ? 0u
                     : (dense ? dC + (pickE != 0xFFFFFFFFu ? 1u : 0u) : (exact ? uint(nCand) : Ke));
#if DEFER_SHADOW_MERGE
    const uint s0 = 1u;
    const float sw = g_draw_push.rtr2.x;
    const float texPerPx = float(D.x) / R2.x;
    vec3 sunOut = vec3(1.0);
    float srad = -1.0;
    bool sdyn = false;
#else
    const uint s0 = 0u;
#endif
    // (#869 SPLIT) + the split lights' samples, last: one each, their own visibility (spV)
    // (#869 OCCLUSION CULL) + the probe, last: detection only (occNote), never in an estimate
    // the probe, with probability clamp(n / 8, 1/8, 1) for n culled lights reaching P: a patch culling a
    // hundred projectors probes from every texel every frame (each light re-tested every few frames)
    if (ocProbe != 0xFFFFFFFFu && pdnRand(pseed) >= clamp(nProbe * 0.125, 0.125, 1.0)) ocProbe = 0xFFFFFFFFu;
    const uint nOcP = ocProbe != 0xFFFFFFFFu ? 1u : 0u;
    [[dont_unroll]] for (uint si = 0u; si < s0 + nProj + spN + nOcP; ++si)
    {
        ShadowSample S;
        vec3 Pin = P;
        // projector bookkeeping
        float wgt = 1.0, pd = 0.0;
        vec3 dt = vec3(0.0), st = vec3(0.0);
        int spT = -1;   // (#869) the split slot this sample is (-1: the rest's)
        bool ocP = false;            // (#869) the occlusion probe
        uint sLi = 0xFFFFFFFFu;      // (#869) the light this sample traces (the occlusion notes)
#if DEFER_SHADOW_MERGE
        float sfade = 0.0;
        const bool isSun = si == 0u;
        SxcTexel sxc = sxcNone();
        if (isSun)
        {
            // (#771) SUN EXPOSURE CERTIFICATE: a certified cell writes a fully blocked sample's
            // value and traces nothing (no ray, no terrain re-anchor, no terminator / rig probe)
            {
                const vec3 Lsx = atmosLightDir();
                float fx;
                // (PDN_OPT_SUN_AWAY: a shading-away texel is filter support only -- no certificate
                // lookup, skip or certification from it)
                if (surfaceSunWant(s, Lsx) && pdnSunGate(s, vz, sw, Lsx, fx))
                {
                    sxc = sxcSunPre(P, Nf, Lsx, dot(Nf, Lsx), Rv.pxw, fx, sw, m, frame, texPerPx);
                    if (sxc.cls == SXC_C_SKIP)
                    {
                        sunOut = sxcDebug(sxc, sxc.out_, vec3(0.0));
                        srad = sxc.srad;
                        sdyn = false;
                        continue;
                    }
                }
            }
            const bool sunAway = !surfaceSunWant(s, atmosLightDir());   // (PDN_OPT_SUN_AWAY: one ray)
            if (!pdnSunSample(s, Rv, dR, vz, frame, sw, texPerPx, (opts & PDN_OPT_SUN_ONE) != 0u || sunAway, ngOnPlane,
                              S, Pin, sfade))
            {
                sunOut = vec3(1.0); srad = -1.0;
                continue;
            }
        }
        else
#endif
        {
            const uint j = si - s0;
            uint li, ni;
            if (j >= nProj + spN)
            {   // (#869 OCCLUSION CULL) the PROBE: a culled light that reaches P, one ray
                ocP = true;
                li = ocProbe;
                ni = 72u;
            }
            else if (j >= nProj)
            {   // (#869) a SPLIT light: weight 1, its own noise phase
                spT = int(j - nProj);
                li = spLi[spT];
                ni = 64u + uint(spT);
                if (mvOn) spMv[spT] = rsMoved(li);
            }
            else if (dense && j >= dC)
            {   // (#91) the emitter stratum: its own RIS pick over the cell's emitters, W_E / p
                li = pickE;
                wgt = ppE > 0.0 ? WsumE / ppE : 0.0;
                if (!(wgt > 0.0) || !(wgt < 3.0e38)) continue;
                ni = j;
            }
            else if (dense)
            {
                // (RS_F_STRIDE) the sub-window's c positions evenly spaced over the window's, and
                // the window's over the cell's slots: c DIFFERENT stretches of the stratified CDF.
                // (Contiguous, a cell whose fire holds 10 of 16 slots evaluated the fire 4 times --
                // four rays of ONE light, the binary one-light ratio the dense evaluation exists to
                // replace: blotches under a flickering fire beside other lights.)
                const uint k = rsWinSlot(dOff, j, dC, dWin);
                const uint jj = rsWinSlot(dStart, k, dWin, dSlots);
                const uvec2 sl = rg_cells[dCw + 1u + jj];
                li = sl.x;
                if (li >= count || emTaken(li)) continue;   // (#91: a taken-over light has no light here)
                if (pdnSplitHas(spLi, li) || occCulled(ocCull, li)) continue;   // (#869: split: its own sample; culled: none)
                wgt = uintBitsToFloat(sl.y) * dScale * float(dWin) / float(dC);
                if (!(wgt > 0.0) || !(wgt < 3.0e38)) continue;
                ni = jj;
            }
            else if (exact) { li = j == 0u ? ex0 : ex1; ni = j == 0u ? exi0 : exi1; }
            else
            {
                li = j == 0u ? pick0 : pick1;
                const float pp = j == 0u ? pp0 : pp1;
                if (li == 0xFFFFFFFFu || !(pp > 0.0)) continue;
                wgt = Wsum / (float(Ke) * pp);
                ni = j;
            }
            if (li == 0xFFFFFFFFu) continue;
            if (li >= REGIR_EM_KEY)
            {   // (#91) an EMITTING TRIANGLE: its diffuse term, one ray to a point of its part above the
                // horizon (uniform in solid angle)
                if (!rsEmTerms(li - REGIR_EM_KEY, P, s.N, diffuseColor, dt)) continue;
                st = vec3(0.0); pd = 0.0;
                // the triangle point: a per-texel random offset + the R3 sequence over the frames (stratified
                // in time: the denoiser's history integrates the penumbra instead of white noise)
                uint es = pdnPcg(uint(m.x) * 2731u + uint(m.y) * 6151u + ni * 977u);
                const vec3 off = vec3(pdnRand(es), pdnRand(es), pdnRand(es));
                const vec3 xi = fract(off + float(frame & 0xFFFFu) * vec3(0.8191725134, 0.6710436067, 0.5497004779));
                rsEmSample(li - REGIR_EM_KEY, P, s.N, xi, S);
                ++emRays;
            }
            else
            {
            if (!projDirectTerms(li, P, s.N, V, pbr, base, diffuseColor, specularColor, rough, ls, false, dt, st, pd))
                continue;
            if (max(max(dt.r, dt.g), dt.b) + max(max(st.r, st.g), st.b) <= 0.0) continue;   // (a black gobo texel: no ray)
            sLi = li;
            pdnProjSample(li, vec2(m) + 0.5 + vec2(17.0, 59.0) * float(ni), S);
            // (#869) a MOVED light's sample: its shadow history is cut short by the denoiser, so the
            // disc takes RS_MOVE_RAYS rays (outermost first, the adaptive early-outs inside) instead
            // of one -- only these texels pay. (A hard light's rays would all coincide: one.) The
            // history cap reads the candidates' share (fMove), not this pick: a reused pick that
            // differs from the neighbours' would cut the history texel by texel.
            // (Dense evaluation: one ray per light -- its information is the other lights, and a
            // RenderVKReSTIRPointRadius disc of a few cm has almost no penumbra to resolve.)
            if (mvOn && (!dense || spT >= 0) && S.radius > 0.0 && rsMoved(li)) S.nRays = max(rsMoveRays(), 1u);
            }
        }
        // ---- the receiver rules for this light (ONE call site: the terminator probe, its escape
        //      check and the rig probe inline once): the #664 lift, the #747 rig lift + slope offset,
        //      the facet the origin leaves, the facing measure ----
        vec3 Nin;
        const float nsl = shadowRecvLight(Rv, (S.flags & SH_POSITIONAL) != 0u ? normalize(S.pos - P) : S.pos, Nin);
        // turned away beyond normal-map slack: its own surface shadows it -- no ray. The sun always
        // (the lit FS's N.L gate, penumbra 0); a projector with PDN_OPT_FACING (the mask's gate:
        // the ray's origin would be pushed through a single-plane wall)
        bool trace = true;
#if DEFER_SHADOW_MERGE
        if (isSun && !(nsl > -0.25))
        {
            shadowRecvLightEnd();
            sunOut = mix(vec3(1.0), vec3(0.0), clamp(sw, 0.0, 1.0));
            srad = 0.0;
            continue;
        }
#endif
        if ((S.flags & SH_POSITIONAL) != 0u && gate && nsl < -0.25) trace = false;
        rt_block_t = 1e30;
#if DEFER_SHADOW_MERGE
        rt_block_dyn = false;
#endif
        const vec3 vis = trace ? shadowSampleVis(S, Pin, Nin, cam, time) : vec3(0.0);   // THE core call
#if DEFER_SHADOW_MERGE
        if (isSun) sxcSunPost(sxc, vis, Pin, Nin, cam, S.bias, frame);   // (#771: revocation + certification rays)
#endif
        shadowRecvLightEnd();
#if DEFER_SHADOW_MERGE
        if (isSun)
        {
            const vec3 sun = mix(vis, vec3(1.0), sfade);
            sdyn = rt_block_dyn;
            if (rt_block_t < 1e29) srad = rt_block_t * tan(ssr.sun_rt.x) / max(nsl, 0.15) / Rv.pxw * texPerPx;
            // weak sun / moon (the host's weight, a ramp over the threshold band): fade toward lit
            sunOut = mix(vec3(1.0), clamp(sun, vec3(0.0), vec3(1.0)), clamp(sw, 0.0, 1.0));
            sunOut = sxcDebug(sxc, sunOut, vis);   // (RenderVKSunCertDebug)
            continue;
        }
#endif
        // (#869 OCCLUSION CULL) every light ray is evidence for P's cell: blocked -> B, visible -> V
        if (ocOn && sLi != 0xFFFFFFFFu) occNote(ocTag, ocSlot0, ocCell, sLi,
                                              max(max(vis.r, vis.g), vis.b) > OCC_VIS_MIN,   // (any channel: tinted glass passes light)
                                              ocRefused);
        if (ocP) continue;   // (the probe: detection only)
        if (spT >= 0)
        {   // (#869) a split light: ITS visibility, light-weighted over its own terms (one ray: the
            // same for its diffuse and specular share; mono), never the rest's num / den
            const vec3 cc = dt + st;
            const float cl = pdnLum(cc);
            spV[spT] = cl > 1e-8 ? clamp(pdnLum(cc * vis) / cl, 0.0, 1.0) : -1.0;
            continue;
        }
        numD += dt * vis * wgt; denD += dt * wgt;
        numS += st * vis * wgt; denS += st * wgt;
        const float hl = pdnLum(st) * wgt + 1e-6;
        hitSum += pd * hl;
        hitW += hl;
    }
    CLK_MARK(PROJ);
    if (ocOn)   // (#869 OCCLUSION CULL stats: probes fired, patch claims refused; ocOn is uniform)
    {
        const uint sP = subgroupAdd(nOcP), sR = subgroupAdd(ocRefused);
        if (subgroupElect()) { occStatAdd(9u, sP); occStatAdd(10u, sR); }
    }
    if (emOn)   // (#91 stats: one atomic per subgroup; emOn is uniform)
    {
        const uint sE = subgroupAdd(nEm > 0u ? 1u : 0u), sR = subgroupAdd(emRays);
        if (subgroupElect())
        {
            if (sE != 0u) atomicAdd(rg.rs_em_stat[2], sE);
            if (sR != 0u) atomicAdd(rg.rs_em_stat[3], sR);
        }
    }
    const float hitDist = hitW > 0.0 ? hitSum / hitW : 0.0;
    // layer 0 a: the candidate count (> 0 informative; pdnInfoA) -- with a reused reservoir
    // 1000 + its M (#85: the denoiser's converged-texel rule, clean_dn_temporal.comp DN_RS_M)
    float a0 = pdnInfoA(nCand, denD, infoFix);
    // (#91) not for a reused EMITTER: its sample is a new point on a (possibly metres-wide) triangle every
    // frame -- a binary visibility across the whole penumbra, not a converged value (full a-trous there)
    if (reused && a0 > 0.0 && pick0 < REGIR_EM_KEY) a0 = 1000.0 + rsM;
    vec3 l0 = pdnRatio(numD, denD);
    if ((opts & PDN_OPT_DBG_RS) != 0u)   // (RenderVKDenoiseDebug 7: the ReSTIR view)
    {
        const uint yl = rsResOn ? rsY : (pp0 > 0.0 ? pick0 : 0xFFFFFFFFu);
        const float mf = rsResOn ? clamp(rsM / float(max(rg.rs_cfg2.x, 1u)), 0.0, 1.0) : 1.0;
        // (#91) an EMITTING TRIANGLE pick: amber (its slot changes every build: no stable hue)
        l0 = rsCell == REGIR_NO_CELL ? vec3(0.25) : (yl == 0xFFFFFFFFu ? vec3(0.3, 0.0, 0.0)
                                                       : (yl >= REGIR_EM_KEY ? vec3(1.0, 0.55, 0.1) : rsHue(yl))
                                                         * (0.2 + 0.8 * mf));
        // (#869 RS_MOVE_ON) texels lit by a light that MOVED this frame: white diagonal stripes,
        // their brightness the moved lights' share (fMove: what the denoiser's history cap reads)
        if (fMove > 0.0 && ((m.x + m.y) & 7) < 2) l0 = vec3(fMove);
        a0 = 1.0;
    }
    imageStore(uPdnIn, ivec3(m, 0), vec4(l0, a0));
    imageStore(uPdnIn, ivec3(m, 1), vec4(pdnRatio(numS, denS), pdnInfoSpecA(hitDist, nCand, denS, infoFix)));
#if DEFER_SHADOW_MERGE
    if ((opts & PDN_OPT_SUN_SKIP) == 0u) imageStore(uPdnIn, ivec3(m, 2), vec4(sunOut, pdnSunEncA(srad, sdyn)));
    CLK_MARK(SUNVIS);
#endif
    // ---- guides ---- (grad: above)
    imageStore(uPdnGeom, ivec3(m, par), uvec4(floatBitsToUint(vz), pdnPackNR(s.N, specRough), packHalf2x16(grad),
                                             pdnPackMeta(0.0, 0.0, 0u, W0)));   // (W: the gobo-free light-set reference)
    // (#869 SPLIT) the split lights' ids + this frame's samples (clean_pdn_common.glsl SPLIT CHANNEL;
    // the temporal pass replaces z / w with their histories)
    if (spLayers)
    {
        uvec4 rw = uvec4(0u);
        [[unroll]] for (uint k = 0u; k < PDN_SPLIT_MAX; ++k)
            if (k < spN) rw[k] = pdnSplitRawPack(spV[k], spV[k] >= 0.0, spMv[k]);
        imageStore(uPdnGeom, ivec3(m, PDN_SPLIT_GEOM_PAR + par), uvec4(pdnSplitPack4(spId), pdnSplitPack4(rw)));
    }
    float pw, pwv;
    const vec2 dS = pdnPrevDelta(P, m, vec2(D), pw);
    vec2 dV = dS;
    if (hitDist > 0.0) dV = pdnPrevDelta(P + normalize(P - pc.u_cam_time.xyz) * hitDist, m, vec2(D), pwv);
    // (w: the moved lights' share x 255, clean_dn_temporal.comp's moving-light rule; 0 = none)
    imageStore(uPdnMot, m, uvec4(packHalf2x16(dS), packHalf2x16(dV), floatBitsToUint(pw),
                                 uint(clamp(fMove, 0.0, 1.0) * 255.0 + 0.5)));
    CLK_MARK(STORE);
}
#endif   // CLEAN_SHADOW_CORE

#elif DEFER_GRID_BUILD
// ---- LIGHT GRID BUILD (6) / TILE CLASSIFY (9): gridTileBuild above as the whole kernel ----
void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
#if CLEAN_DEFER_PASS == 9
    // (#831) The lit-guard cluster scan: its own small dispatch on the host's sampled frames.
    if ((g_draw_push.flags & DEFER_FLAG_SCAN_ONLY) != 0u)   // (push constant: uniform)
