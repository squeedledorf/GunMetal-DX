            float run = 0.0;
            for (uint l = 0u; l < 64u; ++l) { s_lgOff[l] = run; run += s_lgW[l]; }
            for (uint k = 0u; k < REGIR_EM_SLOTS_MAX; ++k) { s_smpS[k] = REGIR_EM_NONE; s_smpW[k] = 0.0; }
        }
        barrier();
        // ---- walk 2 (only with a rest): this lane's share of the aggregate and the samples it owns (the
        //      positions (r + xi) strat in [off, off + Wl): each sample is one lane's) ----
        const uint base = emCellWord(cell);
        const vec3 ccell = 0.5 * (lo + hi);
        const float off = s_lgOff[lid];
        uint r = 0u, rEnd = 0u;
        for (uint q = 0u; q < Rs; ++q)
        {
            const float tq = (float(q) + xi) * strat;
            if (tq < off) ++r;
            if (tq < off + Wl) ++rEnd;
        }
        vec3 aggV = vec3(0.0), aggC = vec3(0.0);
        float aggS = 0.0, cum = off, lastT = 0.0;
        uint lastS = REGIR_EM_NONE;
        [[dont_unroll]] for (uint i = lid; i < ln && rest; i += 64u)
        {
            const uint sl = emPairGet(lst + i);
            if (sl >= nRec) continue;
            const EmTri tr = emLoad(par, sl);
            vec4 cr, pl, la;
            emTriCompact(tr, cr, pl, la);
            const float t = emCellTarget(cr, pl, la, lo, hi);
            if (!(t > 0.0)) continue;
            bool top = false;
            for (uint q = 0u; q < Kt; ++q) top = top || s_gTopS[q] == sl;
            if (top) continue;
            const vec3 Fv = emTriVecFF(tr, ccell);
            const float fl = length(Fv);
            if (fl > 0.0 && fl < 3.0e38) { aggV += Fv; aggC += tr.Lavg * fl; aggS += fl; }
            cum += t;
            lastS = sl; lastT = t;
            while (r < rEnd && (float(r) + xi) * strat < cum)
            {
                s_smpS[r] = sl; s_smpW[r] = Wr / (t * float(Rs));
                ++r;
            }
        }
        // (rounding: the lane's own positions left over go to its last rest triangle)
        for (; r < rEnd && lastS != REGIR_EM_NONE; ++r) { s_smpS[r] = lastS; s_smpW[r] = Wr / (lastT * float(Rs)); }
        s_lgV[lid] = vec4(aggV, aggS);
        s_lgC[lid] = vec4(aggC, 0.0);
        s_lgLast[lid] = lastS;
        s_lgLastT[lid] = lastT;
        barrier();
        if (lid == 0u)
        {   // the aggregate (lane order), the samples left (the last rest triangle in lane-major order), the words
            vec3 V = vec3(0.0), C = vec3(0.0);
            float S = 0.0;
            uint gLast = REGIR_EM_NONE;
            float gLastT = 0.0;
            for (uint l = 0u; l < 64u; ++l)
            {
                V += s_lgV[l].xyz; S += s_lgV[l].w; C += s_lgC[l].xyz;
                if (s_lgLast[l] != REGIR_EM_NONE) { gLast = s_lgLast[l]; gLastT = s_lgLastT[l]; }
            }
            const vec3 Cm = S > 0.0 ? C / S : vec3(0.0);
            const bool ok = rest && S > 0.0 && !any(isnan(V)) && !any(isinf(V)) && !any(isnan(Cm)) && !any(isinf(Cm));
            const vec3 Vo = ok ? V : vec3(0.0), Co = ok ? Cm : vec3(0.0);
            rg_cells[base + REGIR_EM_SLOTS_MAX + 1u] = floatBitsToUint(Vo.xy);
            rg_cells[base + REGIR_EM_SLOTS_MAX + 2u] = floatBitsToUint(vec2(Vo.z, Co.r));
            rg_cells[base + REGIR_EM_SLOTS_MAX + 3u] = floatBitsToUint(Co.gb);
            if (!any_) rg_cells[base] = uvec2(0u);
            else
            {
                for (uint k = 0u; k < Kt; ++k) rg_cells[base + 1u + k] = uvec2(s_gTopS[k], floatBitsToUint(1.0));
                if (exactL) rg_cells[base] = uvec2(Kt | REGIR_CELL_EXACT, floatBitsToUint(gW));
                else if (!rest || gLast == REGIR_EM_NONE || !(gLastT > 0.0))
                    rg_cells[base] = uvec2(Kt | (Kt << 16u), floatBitsToUint(gW));
                else
                {
                    for (uint q = 0u; q < Rs; ++q)
                    {
                        const bool got = s_smpS[q] != REGIR_EM_NONE;
                        rg_cells[base + 1u + Kt + q] = got ? uvec2(s_smpS[q], floatBitsToUint(s_smpW[q]))
                                                           : uvec2(gLast, floatBitsToUint(Wr / (gLastT * float(Rs))));
                    }
                    rg_cells[base] = uvec2((Kt + Rs) | (Kt << 16u), floatBitsToUint(gW));
                }
            }
        }
    }
}
void DEFER_MAIN()
{
    const uint mode = g_draw_push.rtr3.z;
    if (mode == 8u) { occResolve(); return; }
    if (mode == 0u) emEntBuild();
    else if (mode == 1u) emBlockAlloc();
    else if (mode == 2u) emRecBuild();
    else if (mode == 3u) emListWalk(false);
    else if (mode == 4u) emListScan();
    else if (mode == 5u) emListSums();
    else if (mode == 6u) emListWalk(true);
    else if (mode == 7u) emCellBuild();
    else if (mode == 9u) emLongCells();
    else if (mode == 11u) emCellSelect();   // (#1006)
    else if (mode == 12u) emCellShift();    // (#1006)
}
