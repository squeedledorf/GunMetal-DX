        mB = mS = 0.0;
        wB = wS = 1.0;
        if (own.a > 0.0) { hB = own.rgb; hS = own.rgb; } else { mB = 1.0; mS = 1.0; }
    }
    CLK_MARK(SHADE);
    // The splices (exact: see the header), x the receiver distance fade (the mark passes gated at
    // that distance: fd reaches 0 there).
    // (STRENGTH DENSITY) x the strength fade: 0 at the cutoff, where the mark stops (no edge).
    const float fd = rtrDistFade(camd, rttRecvDist()) * rtrStrengthFade(m.w);
    // (#87) the env share each splice LEAVES in its word (1 = none replaced): the GI specular
    // occlusion scales exactly that (deferReflIn, GI_F_SPECOCC_RT_RES) -- written back into the mark
    float remS = 1.0, remE = 1.0;
    // TEMPORAL (rtrTemporal): the spec word's result, else (a legacy sharp env face alone) the env
    // word's; not under #870 raw routing of an own ray (the network accumulates it).
    bool temporal = rtrTemporalOn() && !((rtt_param3.x & 4u) != 0u && ownOk);
    const bool tSurf = aa > 0.02 || rough > 0.25;
    if (k.x > 0.0)
    {
        const bool sharp = specSharp;
        const float w = sharp ? wS : wB;
        if (w > 1e-6)
        {
            vec3 res = sharp ? (hS + mS * envS) / wS : (hB + mB * envS) / wB;
            if (temporal)
            {
                vec3 mu = res, sg = vec3(0.0);
                if (wB > 1e-6)
                {
                    mu = (hB + mB * envS) / wB;
                    sg = sqrt(max((qB + mB * envS * envS) / wB - mu * mu, vec3(0.0)));
                }
                res = rtrTemporal(px, res, mu, 1.25 * sg + 0.02 * max(mu, res) + 1e-4, P, Ng, V, tMean, vz, tSurf);
