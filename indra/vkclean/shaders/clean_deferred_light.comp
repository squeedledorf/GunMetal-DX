void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
    // The light set's source (push constant flags: every branch on them below is uniform -- the
    // barriers inside stay legal):
    //   FROXEL (DEFER_FLAG_LIGHT_FROXEL): the light pass's froxel masks, read per pixel inside
    //     localLights (tileLightBase / tileLightWord). Only the lit-guard cluster scan runs here
    //     (global atomics): no shared mask, no depth reduction, no barrier.
    //   LIGHT GRID (DEFER_FLAG_LIGHT_GRID): the tile's mask from pass 6 -> shared, its load
    //     overlapping the G-buffer fetch, one barrier.
    //   neither: the in-kernel tile test (depth reduction + light test, three barriers).
    const bool froxel = (g_draw_push.flags & DEFER_FLAG_LIGHT_FROXEL) != 0u;
    const bool grid = !froxel && (g_draw_push.flags & DEFER_FLAG_LIGHT_GRID) != 0u;
    const bool tiled = !froxel && !grid;
    const bool stage = lightStaged();   // (#815: implies !froxel)
    if (stage && lid < TILE_LIGHT_WORDS) s_lightProj[lid] = 0u;   // (published by the grid / tile barriers)
    if (grid)
    {
        if (lid < TILE_LIGHT_WORDS) s_tileMask[lid] = light_grid[deferTileIndex() * TILE_LIGHT_WORDS + lid];
    }
    else
    {
        lgClusterScan(lid);
        CLK_MARK(CLUSTER_SCAN);
        if (tiled)
        {
            if (lid < TILE_LIGHT_WORDS) s_tileMask[lid] = 0u;
            if (lid == 0u) { s_zmin = floatBitsToUint(3.0e38); s_zmax = 0u; }
            barrier();
        }
    }

    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const bool inside = px.x < int(g_draw_push.width) && px.y < int(g_draw_push.height);
    g_frag_xy = vec2(px) + 0.5;

    vec4 g2 = vec4(0.0);
    vec3 P = vec3(0.0);
    bool surf = false;
    if (inside)
    {
        g2 = texelFetch(uG2, px, 0);
        surf = deferHasSurface(g2);
    }
    if (surf)
    {
        P = deferPosition(px);
        if (tiled)
        {
            // (> 0: a -0.0 would win the uint atomicMax and empty the tile's depth range)
            const float vz = max(dot(P - pc.u_cam_time.xyz, linfo.cam_fwd.xyz), 1e-4);
            atomicMin(s_zmin, floatBitsToUint(vz));
            atomicMax(s_zmax, floatBitsToUint(vz));
        }
    }
    if (grid)
    {
        barrier();
        if (stage) stageTileLights(lid);   // (charged to GRID)
        CLK_MARK(GRID);
    }
    else if (tiled)
    {
        barrier();
        CLK_MARK(TILE_DEPTH);
        // ---- the tile's light mask ----
        const uint count = min(uint(linfo.cam_pos.w), TILE_LIGHT_WORDS * 32u);
        const float z0 = uintBitsToFloat(s_zmin), z1 = uintBitsToFloat(s_zmax);
        if (count > 0u && z1 >= z0 && !litDbg(LDBG_NO_LOCAL))
        {
            vec3 rays[4], planes[4];
            tileFrustum(rays, planes);
            // A little slack on the depth range (reconstruction / interpolation differences).
            const float zs0 = z0 * 0.999 - 0.01, zs1 = z1 * 1.001 + 0.01;
            for (uint i = lid; i < count; i += TILE * TILE)
                if (tileLightTest(i, rays, planes, zs0, zs1, linfo.cam_fwd.xyz))
                    atomicOr(s_tileMask[i >> 5u], 1u << (i & 31u));
        }
        barrier();
        if (stage) stageTileLights(lid);   // (charged to TILE_LIGHTS)
        CLK_MARK(TILE_LIGHTS);
    }
    // (froxel: the G2 / depth load and the position are charged to GBUF below, with the decode)

    if (!inside) return;
    CLK_INV();
    if (!surf)
    {
        writeLitOutput(px, vec3(0.0), 0.0);   // pass 1's clear; the sky draws over it
        CLK_MARK(STORE);
        return;
    }
    CLK_SURF();
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
#if CLEAN_DEFER_PASS == 3
    g_ds_P = P;
#endif
    CLK_MARK(GBUF);
    const vec4 lit = lightSurface(s, P, 1.0);   // (marks SUNVIS .. HAZE itself)
    CLK_MARK(SHADE);   // (fullbright lanes: their wait for the lit lanes of the subgroup)
    vec3 color = surfacePost(s.model, noFade, lit.rgb, P);
#if CLEAN_DEFER_PASS == 3
    {   // (#85 phase 2) RenderVKDenoiseDebug
        const uint pdbg = (g_draw_push.flags & DEFER_FLAG_PSTOCH) != 0u ? (g_draw_push.flags >> DEFER_PSTOCH_DBG_SHIFT) & 7u : 0u;
        if (pdbg != 0u) color = deferPdnDebug(pdbg, P, color);
    }
    if (giFrameOn() && gi.cfg.w != 0u)   // (#87) RenderVKGIDebug: the GI image itself (7: the sky visibility)
    {
        bool ok;
        float sv;
        color = deferGiFetch(P, s.N, ok, sv);
        if (gi.cfg.w == GI_DBG_SKYVIS) color = vec3(sv);
    }
#endif
    CLK_MARK(HAZE);
    writeLitOutput(px, color, glow);
    CLK_MARK(STORE);
}
#endif

#ifdef CLEAN_SHADER_CLOCK
// ---- SHADER CLOCK FLUSH (RenderVKShaderClockLighting; clean_shader_clock.glsl) ----
// Counters (set 2 binding 7; LLCleanRendererVK mClkCounter): per bucket x kernel x slot one
// 64-bit sum as (lo, hi) uint words -- word ((bucket * CLK_KERNELS + kernel) * CLK_SLOTS +
// slot) * 2. Slots: the stage cycle sums (CLK_S_*), then the invocation / surface counts.
// Buckets spread the atomics of a frame's ~10^5 subgroups over CLK_BUCKETS copies.
layout(std430, set = 2, binding = 7) buffer ShaderClockCounters { uint clk_words[]; };
void clkAdd(uint base, uint slot, uint v)
{
    const uint sum = subgroupAdd(v);   // (one stage's cycles of a subgroup: << 2^32)
    if (sum != 0u && subgroupElect())
    {
        const uint w = base + slot * 2u;
        const uint old = atomicAdd(clk_words[w], sum);
        if (old + sum < old) atomicAdd(clk_words[w + 1u], 1u);   // carry into the high word
    }
}
void main()
{
    g_clk_prev = clkNow();
    deferMain();
    CLK_MARK(TAIL);
    const uint bucket = (gl_WorkGroupID.x + gl_WorkGroupID.y * 5u + gl_SubgroupID) % CLK_BUCKETS;
    const uint base = (bucket * CLK_KERNELS + uint(CLEAN_DEFER_PASS)) * CLK_SLOTS * 2u;
    clkAdd(base, CLK_S_TAIL,         g_clk_TAIL);
    clkAdd(base, CLK_S_CLUSTER_SCAN, g_clk_CLUSTER_SCAN);
    clkAdd(base, CLK_S_TILE_DEPTH,   g_clk_TILE_DEPTH);
    clkAdd(base, CLK_S_TILE_LIGHTS,  g_clk_TILE_LIGHTS);
    clkAdd(base, CLK_S_GBUF,         g_clk_GBUF);
    clkAdd(base, CLK_S_SUNVIS,       g_clk_SUNVIS);
    clkAdd(base, CLK_S_PROJ,         g_clk_PROJ);
    clkAdd(base, CLK_S_ATMOS,        g_clk_ATMOS);
    clkAdd(base, CLK_S_PROBE,        g_clk_PROBE);
    clkAdd(base, CLK_S_SSR,          g_clk_SSR);
    clkAdd(base, CLK_S_MIRROR,       g_clk_MIRROR);
    clkAdd(base, CLK_S_SHADE,        g_clk_SHADE);
    clkAdd(base, CLK_S_LOCAL,        g_clk_LOCAL);
    clkAdd(base, CLK_S_HAZE,         g_clk_HAZE);
    clkAdd(base, CLK_S_STORE,        g_clk_STORE);
    clkAdd(base, CLK_S_GRID,         g_clk_GRID);
    clkAdd(base, CLK_S_FROXEL,       g_clk_FROXEL);
    clkAdd(base, CLK_SLOT_INV,       g_clk_inv ? 1u : 0u);
    clkAdd(base, CLK_SLOT_SURF,      g_clk_surf ? 1u : 0u);
}
#endif
