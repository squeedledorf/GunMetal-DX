        const float thr = rtrRoughThr();
        const float camd = length(pc.u_cam_time.xyz - P);
        const float maxRecv = g_draw_push.rtr.z;   // (the receiver gate: as the split's mark)
        float rough = 1.0;
        bool cand = false;
        if (s.model == SURF_PBR)
        {
            rough = s.rough;
            const float NdotV = clamp(abs(dot(s.N, V)), 0.001, 1.0);
            const vec3 F = EnvBRDFApprox(mix(vec3(0.04), s.albedo, s.metal), s.rough, NdotV) * s.ao;
            cand = rough < thr && max(max(F.r, F.g), F.b) >= 0.004;
        }
        else if (s.model == SURF_LEGACY)
        {
            rough = s.env > 0.0 ? 0.0 : 1.0 - s.gloss;
            cand = s.env >= 0.004 || (s.gloss > 0.0 && rough < thr
                                      && max(max(s.spec.r, s.spec.g), s.spec.b) * s.gloss * 0.25 >= 0.004);
        }
        if (cand && camd < maxRecv)
        {
            const vec3 Ng = dot(s.Ng, V) < 0.0 ? -s.Ng : s.Ng;
            vec3 o, R;
            rtrReceiverRay(s, P, V, Ng, rough, 1.0, o, R);
            const float tmax = max(g_draw_push.rtr.x, 1.0);
            float t;
            const vec3 c = rtrTraceRefl(o, R, tmax, P, vec3(0.0), (rtrOpts() & 1u) != 0u, t);
