// ---- RT FORWARD (#859; see HYBRID RT REFLECTIONS in the header): per 2 x 2 block the front-most
// alpha-blend / water layer's reflection -> uRtFwd (rgb, a = its view depth; 0 = none) ----
void DEFER_MAIN()
{
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 full = ivec2(g_draw_push.width, g_draw_push.height);
    const ivec2 hsz = (full + 1) / 2;
    if (hp.x >= hsz.x || hp.y >= hsz.y) return;
    const ivec2 px = min(hp * 2 + 1, full - 1);   // (the block's centre ray passes its corner pixel)
    const vec2 spx = vec2(hp * 2) + 1.0;
    g_frag_xy = vec2(px) + 0.5;
    const vec3 cam = pc.u_cam_time.xyz;
    const vec3 dir = rtrViewDir(spx);
    // The opaque surface along the ray (the forward layers lie in front of it); sky: far.
    const float d = texelFetch(uDepthG, px, 0).r;
    const float tmaxCam = d > 0.0 ? length(rtrPositionAt(px) - cam) * 0.999 : 4096.0;
    const float pa = rtrPixelAngle(spx) * 2.0;
    rt_cone_width0 = 0.0;
    rt_cone_spread = pa;
    rt_cone_aniso  = max(g_draw_push.rtr.w, 1.0);
    rt_anim_time = pc.u_cam_time.w;
    vec4 outv = vec4(0.0);
    const RtHit h = rtrClosest(cam, dir, 0.0, tmaxCam, RT_MASK_BLEND | RT_MASK_WATER, RTR_FWD_MIN_ALPHA, gl_RayFlagsNoneEXT);
    if (h.hit)
    {
        const RtSurface ls = rtSurfaceEval(h, dir);
        const vec3 V = -dir;
        const vec3 ngf = dot(ls.Ng, V) < 0.0 ? -ls.Ng : ls.Ng;
        const vec3 nf = dot(ls.N, V) < 0.0 ? -ls.N : ls.N;
        const float thr = rtrRoughThr();
        float rough = 1.0;
        bool ok = false;
        vec3 R = reflect(dir, nf);
        if (ls.model == RT_SURF_WATER)
        {
            ok = cam.z >= waterHeight();   // (from below, the water FS shows no reflection)
            rough = 0.0;
            R = rtWaterReflectDir(ls.P, cam, pc.u_cam_time.w);
        }
        else if (ls.model == RT_SURF_PBR)
        {
            rough = ls.rough;
            ok = rough < thr;
        }
        else if (ls.model == RT_SURF_LEGACY)
        {
            rough = ls.env > 0.0 ? 0.0 : 1.0 - ls.gloss;
            ok = ls.env > 0.0 || (ls.gloss > 0.0 && rough < thr);
        }
        if (ok)
        {
            const float rn = dot(R, ngf);
            if (rn < 0.02) R = normalize(R + ngf * (0.02 - rn));
            const vec3 o = offsetRayOrigin(ls.P, ngf);
            rt_cone_width0 = h.dist * pa;
            rt_cone_spread = pa + 0.25 * rough;
            rtrMaskCone(h.dist * pa * 0.5, pa * 0.5);   // (the alpha-mask test: one render pixel, not the 2 x 2 block)
            float t;
            const vec3 c = rtrTraceRefl(o, R, max(g_draw_push.rtr.x, 1.0), ls.P, vec3(0.0), false, t);
            if (t > 0.0) outv = vec4(c, max(dot(ls.P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 1e-3));
        }
    }
    imageStore(uRtFwd, hp, outv);
}

#elif CLEAN_DEFER_PASS == 15
// ---- PROJECTOR STOCHASTIC SAMPLE (#85 phase 2, RenderVKProjStochastic; RT layout, after the
// reflect passes, before BASE / COMBINE): the producer of the diffuse / specular denoiser
// (LLCleanDenoiserVK; clean_pdn_common.glsl). One invocation per DENOISER texel (the render
// extent x RenderVKDenoiseScale), at the render pixel it samples this frame (the RT mask's
// jittered convention):
//   * CANDIDATES: the cluster's leading shadowed run (the same lights the RT mask traced, but
//     every one of them: the exact path's 4-per-pixel cap is gone), the ray-traced records only
//     (projStochEligible -- the lit walk skips exactly those).
//   * RIS (Talbot / Bitterli): per candidate the target p = its unshadowed brightness at P
//     WITH its gobo texel (pdnTargetGobo: one fetch, no BRDF -- a gobo-free target let a blocked
//     projector's crisp gobo take the unblocked lights' visibility); K independent weighted
//     reservoirs (streaming, with replacement) pick K lights in proportion to p.
//   * SHADE + ONE RAY per pick: the full terms (the gobo texel) x one shadow ray (the RT
//     projector core with max 1 disc sample: soft shadows become the noise the denoiser
//     integrates), weighted W / (K p) with W the target sum -- unbiased for the shadowed
//     direct light. A pixel with no more candidates than K traces each of them exactly (no
//     noise at all: most of a scene outside the club).
//   * MERGED (CLEAN_SHADOW_MERGE, the header's MERGED RT SHADOWS): the sun / moon gets its OWN
//     ray(s) per texel -- the RT shadow mask's trace (clean_rt_shadow_mask.comp) on the receiver's
//     FACET normal (pdnFacetNormal -- not the G-buffer's smooth vertex normal): the soft disc (RenderVKRTSunSamples rays, the R2 noise phase), the #841
//     footprint jitter (no TAA / FSR), the view-slope origin offset, the #664 terminator lift, the
//     #211 smooth-terrain re-anchor, the #747 cluster-rig lift, the far fade, the moving-caster bit
//     and the penumbra radius from the blocker distance -- faded toward lit by the host's weak-sun
//     weight (rtr2.x; 0 = no ray: night / a dim moon cost nothing) -> uPdnIn layer 2.
//   * (#869) THE SPLIT (RenderVKProjStochasticSplitK; the generic core only, pdnSplitSelect): the
//     texel's K strongest lights of the lighting set (gobo-free target over the pixel cluster's
//     list, hysteresis) each take ONE ray of their own -> their own visibility (GEOM layers 2 +
//     parity, keyed by the light's split id: clean_pdn_common.glsl SPLIT CHANNEL); the RIS above,
//     the reservoir reuse and the dense evaluation then run over THE REST (the split lights out of
//     candidates, num and den), so layers 0 / 1 below are the rest's ratio. Before it ONE ratio
//     served every light: a projector behind a wall took the visible lamps' ratio (its gobo through
//     the wall) and darkened them with its 0.
//   * DEMODULATED out: diffuse / pdnDiffFactor, specular / pdnSpecFactor; specular a = the
//     pick's apex distance (luminance-weighted: the virtual image depth); diffuse a = the
//     candidate count (confidence). GEOM: view depth, normal + specular roughness, the depth
//     gradient per denoiser texel, W (the reference the temporal pass cuts the history on when
//     the light set changes); MOT: the camera-only previous positions of the surface and of
//     the virtual image + the expected previous view depth.
// Cel surfaces (they keep the exact walk) and pixels without lit surface write 0 / no guide.
uint pdnPcg(uint v)
{
    const uint st = v * 747796405u + 2891336453u;
    const uint w = ((st >> ((st >> 28u) + 4u)) ^ st) * 277803737u;
    return (w >> 22u) ^ w;
}
float pdnRand(inout uint seed) { seed = pdnPcg(seed); return float(seed >> 8u) * (1.0 / 16777216.0); }

// PASS 15 OPTIONS (push rtr2.z, an exact integer; LLCleanRendererVK::recordProjStoch):
// The projector WALL-BLEED fixes (two independent options):
//   PDN_OPT_FACING (RenderVKProjStochFacingGate, default on): a candidate whose VISIBLE facet
//     faces away from the projector beyond normal-map slack (N.l < -0.25 on the camera-facing
//     side; the RT shadow mask's own gate) is shadowed by its own surface: visibility 0, no ray.
//     Without it the ray origin was pushed to the LIGHT side of the receiver's plane -- through
//     a single-plane wall -- and the back of the wall (its normal map leaning toward the light)
//     came out lit. Geometric and deterministic: adds no noise.
//   PDN_OPT_BLEED (RenderVKProjStochBleedFix, default on): NO INFORMATION is flagged, not written
//     as lit. A pick whose terms came out 0 (a black gobo texel; the cutoff fade is now in the
//     target, pdnTarget) leaves num = den = 0, whose ratio defaulted to 1 = UNSHADOWED, and
//     those frames' 1s let every other projector at the texel shine through walls at the
//     fraction of such picks. Layer 0 a = -nCand (diffuse) / layer 1 a = -1 (specular): the
//     denoiser takes such a frame as a WEIGHT-0 SAMPLE of the ratio estimator (Heitz 2018: it
//     adds nothing to num or den) -- the history holds, the 3x3 fills a texel without one, and
//     the texel stays a full tap of every filter (clean_dn_common.glsl DN_F_INFO).
//   PDN_OPT_SUN_ONE (RenderVKShadowSunOneRay, default off): one stochastic sun / moon disc ray
//     per texel (the projectors' rule; the denoiser integrates the disc) -- an outdoor A/B.
//   PDN_OPT_SUN_SKIP: the weak-sun gate traces no sun ray this frame and the denoiser skips the
//     sun channel (the SHADOW kernel reads lit: frame info rt_mask.x = -2) -- no layer-2 store.
#define PDN_OPT_BLEED    1u
#define PDN_OPT_SUN_ONE  2u
#define PDN_OPT_SUN_SKIP 4u
#define PDN_OPT_FACING   8u
// PDN_OPT_DBG_RS (RenderVKDenoiseDebug 7, the ReSTIR view): layer 0 carries a false colour instead of
// the ratio -- the chosen light's hue, brightness = the reservoir's M / the M cap (dim: fresh
// candidates only); grey = the cluster walk (outside the grid / no ReSTIR frame), dark red = no light.
#define PDN_OPT_DBG_RS  16u
// PDN_OPT_SUN_AWAY (RenderVKRTShadowMergeAwayTrace, default on): a texel whose SHADING normal faces
// away from the sun / moon (surfaceSunWant false: the lit pass never reads its sun visibility) is
// still traced -- ONE ray, through the same facet / terminator rules -- instead of being written
// "lit, no ray". Its value is never shown, but it is a tap of every sun filter: the temporal 3x3,
// the a-trous and the consumer's 4-tap upsample (plane-aware depth only, no normal test). Defaulted
// to lit, those taps leaked sunlight into the facing-but-shadowed pixels beside them: thin BRIGHT
// lines along every normal seam (split normals / UV seams) and along mane strands / wing edges of a
// mesh avatar in sun shadow, brightest in a dark room. Traced, the away side carries its real
// visibility (mostly self-shadowed: 0, often without a ray -- the back-face rule).
#define PDN_OPT_SUN_AWAY 32u
uint pdnOpts() { return uint(max(g_draw_push.rtr2.z, 0.0) + 0.5); }   // (push: uniform)
// The sun sample's gate on the shading normal: surfaceSunWant, or (PDN_OPT_SUN_AWAY) any lit surface.
bool pdnSunWant(SurfaceLit s, vec3 L)
{
    return surfaceSunWant(s, L) || ((pdnOpts() & PDN_OPT_SUN_AWAY) != 0u && s.model != SURF_FULLBRIGHT);
}
// Layer 0 / 1 alpha with the no-information flag (PDN_OPT_BLEED): the diffuse a = the candidate
// count, negated where the evaluated picks carried no light (den = 0); the specular a = the hit
// distance, -1 where the specular den is 0 -- WITH OR WITHOUT candidates. (The diffuse a = 0 of a
// texel without candidates is no-information by itself: clean_dn_common.glsl dnInfoD needs a > 0.
// The specular test is a >= 0 (a hit distance of 0 is real), so it needs the -1 here. Before, a
// texel with NO candidate wrote a = 0 and relied on the guide's W = 0 to be left out -- true for
// the cluster walk (W = the candidates' target sum) but not on a ReSTIR grid texel, whose W is 1
// whenever its CELL has a light (RS_F_WCUT off): a texel facing away from every light (the
// underside of a limb) or whose random window missed them all fed its default specular ratio 1 to
// the filters as a real "unshadowed" sample -- bright specular streaks along every light
// terminator of a mesh avatar and flickering specks wherever the window came up empty.)
float pdnInfoA(float nCand, vec3 den, bool fix)
{
    return (fix && nCand > 0.0 && !(pdnLum(den) > 1e-8)) ? -nCand : nCand;
}
float pdnInfoSpecA(float hitDist, float nCand, vec3 den, bool fix)
{
    return (fix && !(pdnLum(den) > 1e-8)) ? -1.0 : hitDist;
}

// View depth at render pixel q (-1: nothing there), as deferPosition rebuilds it.
float pdnViewZ(ivec2 q)
{
    q = clamp(q, ivec2(0), ivec2(int(g_draw_push.width), int(g_draw_push.height)) - 1);
    const float d = texelFetch(uDepthG, q, 0).r;
    if (!(d > 0.0)) return -1.0;   // (reversed-Z: 0 = cleared / far)
    const vec2 ndc = (vec2(q) + 0.5) / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, d, 1.0);
    const vec3 P = pc.u_cam_time.xyz + h.xyz / h.w;
    return dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
}
// d(view depth) per denoiser texel along o (st render px): the side with the smaller step (a
// silhouette neighbour never sets the plane); 0 with no neighbour on a surface.
float pdnGrad(ivec2 rp, ivec2 o, float vz)
{
    const float zp = pdnViewZ(rp + o), zn = pdnViewZ(rp - o);
    const float a = zp > 0.0 ? zp - vz : 1e30, b = zn > 0.0 ? vz - zn : 1e30;
    const float g = abs(a) <= abs(b) ? a : b;
    return abs(g) < 1e29 ? clamp(g, -0.5 * vz, 0.5 * vz) : 0.0;
}
// The light sampler's TARGET for one candidate: > 0 wherever projDirectTerms can be (an
// unbiased sampler), proportional to the light's unshadowed brightness at P, and cheap -- the
// eligibility (shadow record), range + attenuation, the projected frustum and N.L, from four
// record fields (no 160 B record copy, no gobo fetch, no BRDF).
// anyLight (#869 ReSTIR DI): li comes from the grid's population 1, already in pass 15's light set
// (clean_regir.glsl rsEligible: + record-less projectors and point lights) -- no record test; a
// POINT light's target is the same minus the frustum (its terms: projDirectTerms' point branch).
float pdnTargetL(uint li, vec3 P, vec3 N, bool anyLight)
{
    const uvec4 tx = lights[li].tex;
    if (!anyLight)
    {
        if (tx.z == 0u) return 0.0;
        const vec4 sp = pshadow[tx.z - 1u].params;
        if (sp.w < 0.5 || !(sp.z > 1.5)) return 0.0;   // (projStochEligible)
    }
    const vec4 pr = lights[li].pos_radius;
    const vec3 lv = pr.xyz - P;
    const float d2 = dot(lv, lv);
    if (d2 >= pr.w * pr.w) return 0.0;
    const vec4 cf = lights[li].color_falloff;
    const float dist = sqrt(d2);
    float atten = legacyAtten(dist / pr.w, cf.w);
    if (atten <= 0.0) return 0.0;
    // the lights' CUTOFF FADE (projDirectTerms' lightCutoffFade, ALU only): a light faded out
    // here is never picked -- such picks carried no light (num = den = 0, a wasted sample:
    // DN_F_INFO no-information) and are a large share of a club's picks at the light pools' rims
    atten *= lightCutoffFade(atten, cf.rgb);
    if (atten <= 0.0) return 0.0;
    if (lights[li].proj_origin.w < 0.5)
    {
        const float nlp = dot(N, lv / max(dist, 1e-4));
        if (nlp <= 0.0) return 0.0;
        return atten * max(pdnLum(cf.rgb), 1e-4) * (0.25 + nlp);
    }
    vec4 ptc = lights[li].proj_mat * vec4(P, 1.0);
    if (ptc.z < 0.0) return 0.0;
    ptc.xyz /= ptc.w;
    if (ptc.z <= 0.0 || ptc.x <= 0.0 || ptc.x >= 1.0 || ptc.y <= 0.0 || ptc.y >= 1.0) return 0.0;
    const float nl = dot(N, normalize(lights[li].proj_origin.xyz - P));
    if (nl <= 0.0) return 0.0;
    return atten * max(pdnLum(cf.rgb), 1e-4) * (0.25 + nl);   // (a floor on N.L: glints at grazing light)
}
float pdnTarget(uint li, vec3 P, vec3 N) { return pdnTargetL(li, P, N, false); }
// THE PICK TARGET WITH THE GOBO: pdnTarget x the luminance of the projector's texel at P (its
// gobo x the frustum edge fade -- projDiffuse's factor, one fetch). With K picks among more
// candidates the per-frame ratio is the PICKED light's visibility, so what the denoiser
// accumulates is sum p_i v_i / sum p_i: the visibility weighted by the TARGET, not by the light.
// Gobo-free, a projector's crisp gobo spot on a surface it cannot reach (the next room's
// projector, behind the wall) carried the visibility of the unblocked lights' share of the
// targets -- and the lit pass multiplies the exact gobo by it: the crisp gobo through the wall
// (any club pixel with more candidates than picks). With the gobo the target follows the light
// itself, so a blocked spot's ratio is its own. p0: the gobo-free target, summed over the
// candidates into the denoiser's light-set reference W -- so W does not follow the texel's
// brightness, only which candidates have light here (a candidate whose texel is black drops out
// of both: nCand == 0 <=> W == 0, the no-candidate texel the denoiser leaves out). 0: the texel
// is black -- no light to shadow, never picked.
float pdnTargetGoboL(uint li, vec3 P, vec3 N, bool anyLight, out float p0)
{
    // (#91 LIGHT TAKEOVER) a point light its emitting triangles carry this frame has no light here: never
    // a candidate, a reused reservoir of it drops (rsTap) -- the lit kernels leave it out too
    // (deferLightTaken), so the candidate set stays the lighting set
    if (rsFrameOn() && emTaken(li)) { p0 = 0.0; return 0.0; }
    p0 = pdnTargetL(li, P, N, anyLight);
    if (!(p0 > 0.0)) return 0.0;
    if (lights[li].proj_origin.w < 0.5) return p0;   // (a point light: no gobo)
    const uvec4 tx = lights[li].tex;
    vec4 ptc = lights[li].proj_mat * vec4(P, 1.0);
    ptc.xy /= ptc.w;
    const vec4 pp = lights[li].proj_params;
    const float l_dist = -dot(lights[li].pos_radius.xyz - P, lights[li].proj_axis.xyz);
    const float lod = clamp((l_dist - pp.x) / pp.y, 0.0, 1.0) * pp.z;
    vec4 t = vec4(1.0);
    if (tx.y != 0u) t = textureLod(uTextures[nonuniformEXT(tx.x)], ptc.xy, lod);
    const vec2 ed = vec2(0.5) - abs(ptc.xy - vec2(0.5));
    const float det = min(lod / max(pp.z * 0.5, 1e-4), 1.0);
    const float edge = 0.25 * det;
    float g = pdnLum(t.rgb * t.a) * (edge > 0.0 ? clamp(min(ed.x, ed.y) / edge, 0.0, 1.0) : 1.0);
    // SHADOWED AMBIANCE (projAmbShadowed; projDirectTerms carries the PBR ambiance in the
    // diffuse share): the ambiance's soft max-LOD texel reaches past the direct texel's gobo
    // edge, so it keeps the light a candidate there -- else an ambiance-only pixel took the
    // other lights' ratio (or 1 = unshadowed) and the soft gobo copy came through the wall.
    // amb_da <= 3 x ambiance (projAmbianceT), relative to the direct term's 1.
    if (pp.w > 0.0 && projAmbShadowed())
    {
        vec4 a = vec4(1.0);
        if (tx.y != 0u) a = textureLod(uTextures[nonuniformEXT(tx.x)], ptc.xy, pp.z);
        const vec2 dd = ptc.xy - vec2(0.5);
        g += 3.0 * pp.w * pdnLum(a.rgb * a.a) * clamp((0.25 - dot(dd, dd)) / 0.25, 0.0, 1.0);
    }
    return (g > 0.0 && !isnan(g)) ? p0 * g : 0.0;
}
float pdnTargetGobo(uint li, vec3 P, vec3 N, out float p0) { return pdnTargetGoboL(li, P, N, false, p0); }
// Per channel num / den -- the visibility ratio; a channel the light barely has takes the
// luminance ratio (no 0 / 0 noise in a pure-colour light); no light at all: 1 (unshadowed).
vec3 pdnRatio(vec3 num, vec3 den)
{
    const float dl = pdnLum(den);
    if (!(dl > 1e-8)) return vec3(1.0);
    const float rl = clamp(pdnLum(num) / dl, 0.0, 1.0);
    vec3 r;
    for (int c = 0; c < 3; ++c) r[c] = den[c] > 1e-3 * dl ? clamp(num[c] / den[c], 0.0, 1.0) : rl;
    return (any(isnan(r)) || any(isinf(r))) ? vec3(rl) : r;
}
// One shadow ray toward the projector (its soft disc sampled once: npx decorrelates the picks).
vec3 pdnShadow(uint li, vec3 P, vec3 Ng, vec2 npx)
{
    const Light L = lights[li];
    rtSelfBegin(P);
    return projShadowRayCore(L, pshadow[L.tex.z - 1u], P, Ng, pc.u_cam_time.xyz, pc.u_cam_time.w, npx, 1u);
}
// The previous-frame denoiser texel coordinate of world point X (camera-only) - m; w: its view depth then.
vec2 pdnPrevDelta(vec3 X, ivec2 m, vec2 D, out float pw)
{
    const vec4 c = ssr.taa_prev_vp * vec4(X - ssr.cam_origin.xyz, 1.0);
    pw = 0.0;
    if (!(c.w > 1e-4)) return vec2(0.0);
    pw = c.w;
    const vec2 puv = c.xy / c.w * 0.5 + 0.5;
    return clamp(puv * D - 0.5 - vec2(m), vec2(-30000.0), vec2(30000.0));
}

// ---- THE RECEIVER'S GEOMETRIC (FACET) NORMAL for every shadow ray of this pass ----
// The G-buffer's "Ng" (clean_draw.frag: normalize(v_world_normal), flipped by gl_FrontFacing) is
// the INTERPOLATED VERTEX normal -- smooth, no normal map, but NOT the plane of the triangle the
// pixel shows. The RT shadow mask never used it: its receiver normal is the facet's own plane
// (clean_rt_shadow_mask.comp maskTangent / maskProbeNormal), because every rule of the RT shadow
// cores is a rule about THAT plane -- the origin offset (rtReceiverOrigin's depth-error bound +
// the view-slope offset + the #747 lift leave the facet along it), the #841 footprint jitter
// (the origin slides along the receiver's plane), the disc floor (no soft ray below the plane it
// leaves), the #664 terminator band test and the back-face self-shadow gate (the facet facing
// away from the light). Fed the smooth normal, all of them were off by the vertex normals'
// deviation from the facet -- 0 mid-facet, LARGEST ALONG THE TRIANGLE EDGES of a smooth-shaded
// low-poly mesh (an avatar's limb: half the crease angle at an edge) -- so origins dipped under
// their own facet there (the footprint jitter's offset along the tilted plane went |f| sin(dev)
// below it; the micrometre offsets kept only cos(dev) of their clearance) and skimming disc rays
// re-entered it: self-shadow along every polygon edge, the thin lines on a mesh body under the
// sun with RenderVKRTShadowMerge 1 (Merge 0: the mask's facet normal -- clean). The exact facet:
//   1. the PRE-PASS TRIANGLE (clean_term_tri.frag, RenderVKRTTerminatorSource 1: the rasterized
//      triangle's own plane, visible side) where it is bound and holds this pixel,
//   2. else the mask's depth-plane normal (on-plane depth neighbours, second-difference test),
//   3. else (neither neighbour on the plane) the triangle under the pixel by a short camera ray,
//   4. else the G-buffer normal.
// Always on the side the camera sees.
vec3 pdnWorldAtD(vec2 spx, float d)
{
    const vec2 ndc = spx / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, d, 1.0);
    return pc.u_cam_time.xyz + h.xyz / h.w;
}
// clean_rt_shadow_mask.comp maskTangent on the G-buffer depth (same rule, same tolerances).
bool pdnTangent(ivec2 rp, ivec2 o, vec2 cpx, float d, vec3 P, float dtol, ivec2 mx, out vec3 t)
{
    const float dn1 = texelFetch(uDepthG, clamp(rp - o, ivec2(0), mx), 0).r;
    const float dp1 = texelFetch(uDepthG, clamp(rp + o, ivec2(0), mx), 0).r;
    const float dn2 = texelFetch(uDepthG, clamp(rp - 2 * o, ivec2(0), mx), 0).r;
    const float dp2 = texelFetch(uDepthG, clamp(rp + 2 * o, ivec2(0), mx), 0).r;
    const float sp = abs(dp1 - d), sn = abs(d - dn1);
    const float tol = dtol + 0.125 * min(sp, sn);
    const float ep = abs(d - 2.0 * dp1 + dp2), en = abs(d - 2.0 * dn1 + dn2);
    const bool okp = ep <= tol, okn = en <= tol;
    const bool usep = (okp == okn) ? sp < sn : okp;
    const vec2 of = vec2(o);
    t = usep ? pdnWorldAtD(cpx + of, dp1) - P : P - pdnWorldAtD(cpx - of, dn1);
    return okp || okn;
}
// clean_rt_shadow_mask.comp maskProbeNormal (force-opaque camera ray through P, +-w).
bool pdnProbeNormal(vec3 P, vec3 cam, out vec3 n)
{
    n = vec3(0.0);
    vec3 V = P - cam;
    const float camd = length(V);
    if (camd < 1e-4) return false;
    V /= camd;
    const float pm = max(max(abs(P.x), abs(P.y)), abs(P.z));
    const float w = max(4.0 * (camd * RT_DEPTH_REL_ERR + max(RT_OFS_FRAME_ULPS * rtUlp(pm), RT_OFS_FLOAT_SCALE)), 1e-3);
    vec3 qo = P - V * w;
    float qt0 = 0.0, qt1 = 2.0 * w;
    if (!rtRaySane(qo, qt0, V, qt1)) return false;   // (Xid 109: an invalid probe ray)
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTLAS, gl_RayFlagsOpaqueEXT, RT_MASK_SHADOW & 0xFFu, qo, qt0, V, qt1);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return false;
    const uint id = rtHitInstance(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)),
                                  uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true)));
    if (!rtIdIn(id)) return false;
    vec3 p0, p1, p2;
    rtTriPositions(id, RT_HIT_PRIM(rq, true, id), p0, p1, p2);
    const mat3 M = mat3(rayQueryGetIntersectionObjectToWorldEXT(rq, true));
    const vec3 c = cross(M * (p1 - p0), M * (p2 - p0));
    const float l = length(c);
    if (!(l > 1e-20)) return false;
    n = c / l;
    return true;
}
// P: the receiver at render px rp; gb: the G-buffer normal (visible side), the last resort.
// onPlane: the facet is known exactly (pre-pass triangle) or both depth tangents lie on it --
// the mask's condition for the #841 footprint jitter (creases / silhouettes / relief: no slide).
vec3 pdnFacetNormal(ivec2 rp, vec3 P, vec3 cam, vec3 gb, out bool onPlane)
{
    vec3 Ng = vec3(0.0);
    bool have = false;
    onPlane = false;
    if (rtTermTriBound())
    {
        const ivec2 sz = textureSize(uTermTri, 0);
        if (all(lessThan(rp, sz)))
        {
            const uvec2 t = texelFetch(uTermTri, rp, 0).xy;
            if ((t.y & 0x8000u) != 0u) { Ng = rtOctDecode(unpackSnorm2x16(t.x)); have = !any(isnan(Ng)); onPlane = have; }
        }
    }
    if (!have)
    {
        const vec2 cpx = vec2(rp) + 0.5;
        const float d = texelFetch(uDepthG, rp, 0).r;
        const ivec2 mx = ivec2(int(g_draw_push.width), int(g_draw_push.height)) - 1;
        const float vz = max(dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 1e-3);
        const float pm = max(max(abs(P.x), abs(P.y)), abs(P.z));
        const float dtol = 8.0 * rtUlp(d) + d * 2.0 * max(RT_OFS_FRAME_ULPS * rtUlp(pm), RT_OFS_FLOAT_SCALE) / vz;
        vec3 dx, dy;
        const bool okx = pdnTangent(rp, ivec2(1, 0), cpx, d, P, dtol, mx, dx);
        const bool oky = pdnTangent(rp, ivec2(0, 1), cpx, d, P, dtol, mx, dy);
        Ng = normalize(cross(dy, dx));
        have = !any(isnan(Ng)) && dot(Ng, Ng) > 0.5;
        onPlane = have && okx && oky;
        vec3 Np;
        if (!(okx && oky) && pdnProbeNormal(P, cam, Np)) { Ng = Np; have = true; }
    }
    if (!have) return gb;
    return dot(Ng, cam - P) < 0.0 ? -Ng : Ng;   // the visible side
}

#if DEFER_SHADOW_MERGE || defined(CLEAN_SHADOW_CORE)
// ---- MERGED RT SHADOWS: the sun / moon trace (the RT shadow mask's, clean_rt_shadow_mask.comp) ----
// (the generic core, CLEAN_SHADOW_CORE: the receiver helpers serve the projectors too)
// World point of (jittered) render px spx at reversed-Z depth d (deferPosition's mapping).
vec3 pdnWorldAt(vec2 spx, float d)
{
    const vec2 ndc = spx / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, d, 1.0);
    return pc.u_cam_time.xyz + h.xyz / h.w;
}
// Radical inverse of i in base b (Halton; the #841 footprint jitter, i in 1..16).
float pdnHalton(uint i, uint b)
{
    float f = 1.0, r = 0.0;
    while (i > 0u) { f /= float(b); r += f * float(i % b); i /= b; }
    return r;
}
// #211 SMOOTH-TERRAIN RECEIVER RE-ANCHOR (the mask's maskTerrainExit): a receiver rebuilt from a
// drawn terrain surface a few cm UNDER the traced one moves its sun origin up to the traced
// surface right above it (never down). The exit distance along the camera ray, -1 = none.
uint  pdnTerrainBits()   { return uint(max(ssr.terrain_lod.w, 0.0) + 0.5); }
bool  pdnTerrainSnapOn() { const uint b = pdnTerrainBits(); return b != 0u && ((b - 1u) & 1u) != 0u; }
float pdnTerrainExit(vec3 P, vec3 cam, vec3 Ng)
{
    vec3 Vt = cam - P;
    const float camd = length(Vt);
    if (camd < 1e-3) return -1.0;
    Vt /= camd;
    const float cv = max(abs(dot(Ng, Vt)), 0.02);
    const float tmax = min(min(0.10 / cv, 1.5), 0.5 * camd);
    vec3 to = P;
    float tt0 = 0.0, tt1 = tmax;
    if (!rtRaySane(to, tt0, Vt, tt1)) return -1.0;   // (Xid 109: an invalid ray)
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTLAS, gl_RayFlagsOpaqueEXT, RT_MASK_TERRAIN, to, tt0, Vt, tt1);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return -1.0;
    const uint id = rtHitInstance(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)),
                                  uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true)));
    if (!rtIdIn(id)) return -1.0;   // (#874 guard: rtTriPositions indexes the instance tables)
    vec3 p0, p1, p2;
    rtTriPositions(id, RT_HIT_PRIM(rq, true, id), p0, p1, p2);
    const mat3 M = mat3(rayQueryGetIntersectionObjectToWorldEXT(rq, true));
    vec3 n = cross(M * (p1 - p0), M * (p2 - p0));
    const float l = length(n);
    if (!(l > 1e-20)) return -1.0;
    n /= l;
    if (n.z < 0.0) n = -n;
    if (n.z < 0.2) return -1.0;
    if (dot(n, Vt) <= 0.0) return -1.0;
    return rayQueryGetIntersectionTEXT(rq, true);
}
// #747 CLUSTER LOD RECEIVER LIFT (the mask's maskClusterRigLift): a receiver within the cut's
// error of a legacy rigged surface still casting this frame lifts its ray origins by that error.
float pdnClusterRigLift(vec3 P, vec3 cam)
{
    if (ssr.cluster_rt.z < 0.5 || !(ssr.cluster_rt.x > 0.0)) return 0.0;
    if (uint(rt_cl_rig.length()) > 2u && rt_cl_rig[2] == 0x80000000u) return 0.0;
    vec3 V = P - cam;
    const float camd = length(V);
    if (camd < 1e-4) return 0.0;
    V /= camd;
    const float eps = ssr.cluster_rt.x * max(camd, ssr.cluster_rt.y);
    const float w = 2.0 * eps + 1e-3;
    vec3 qo = P - V * w;
    float qt0 = 0.0, qt1 = 2.0 * w;
    if (!rtRaySane(qo, qt0, V, qt1)) return 0.0;   // (Xid 109: an invalid probe ray)
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, uTLAS, gl_RayFlagsNoOpaqueEXT, RT_MASK_RIGGED | RT_MASK_SELF, qo, qt0, V, qt1);
    uint n_cand = 0u;
    bool hit = false;
    while (rayQueryProceedEXT(rq))
    {
        if (rayQueryGetIntersectionTypeEXT(rq, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        if (++n_cand > RT_CANDIDATE_BUDGET) { rayQueryTerminateEXT(rq); break; }
        const uint id = rtHitInstance(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false)),
                                      uint(rayQueryGetIntersectionGeometryIndexEXT(rq, false)));
        if (rtIsClusterRig(id)) { hit = true; rayQueryTerminateEXT(rq); break; }
    }
    return hit ? eps : 0.0;
}
