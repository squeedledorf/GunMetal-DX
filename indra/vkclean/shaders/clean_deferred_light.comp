// kernels have no twin: a debug mask / view selects the uber twin.)
#define CLEAN_DEBUG_CONST
layout(constant_id = 1) const bool kDebugViews = true;
// SETTING SPECIALIZATION (clean_frame_info.glsl, constants 8-17; uber + split passes alike):
// the spec sets' lighting pipelines carry the graphics settings (llcleanspecvk.cpp).
#define CLEAN_SPEC_SETTINGS
#define CLEAN_COMPUTE_LIGHT
#define CLEAN_LIT_GUARD_COUNTERS   // clean_draw_common.glsl lgNote: trips are counted (binding 20)
vec2 g_frag_xy;         // this invocation's pixel centre (render px)
#define CLEAN_FRAG_XY g_frag_xy

// ---- the split's set 3 (LLCleanRendererVK mDslDeferSplit; GENERAL, render extent) ----
// PER-PASS ACCESS: each kernel declares the images it touches with the one access it makes
// (producers writeonly, the combine readonly): a readonly image load is free of the
// aliasing an unqualified one must assume against every store in the kernel (the combine
// writes HDR + glow), so the compiler may keep / reorder / cache those loads.
#if DEFER_SHADOW
#define DS_VIS_ACCESS writeonly
#define DS_REFL_ACCESS
#define DS_HALF_ACCESS
#elif CLEAN_DEFER_PASS == 2 || CLEAN_DEFER_PASS == 5
#define DS_VIS_ACCESS
#define DS_REFL_ACCESS writeonly
#define DS_HALF_ACCESS
#elif CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 13 || CLEAN_DEFER_PASS == 14
#define DS_VIS_ACCESS
#define DS_REFL_ACCESS   // (#859: read-modify-write of the spliced words)
#define DS_HALF_ACCESS
#elif CLEAN_DEFER_PASS == 4
#define DS_VIS_ACCESS
#define DS_REFL_ACCESS
#define DS_HALF_ACCESS writeonly
#else
#define DS_VIS_ACCESS readonly
#define DS_REFL_ACCESS readonly
#define DS_HALF_ACCESS readonly
#endif
#if DEFER_SPLIT_IO
layout(set = 3, binding = 0, rgba8) uniform DS_VIS_ACCESS image2D uVisSun;   // sqrt(rgb sun tint, a visibility)
// Layer 0: the 4 slots' light index + 1 (8 bits each); layers 1..3: the slots' sqrt-encoded
// R / G / B visibility bytes (byte k = slot k; mono frames: layer 1 only).
layout(set = 3, binding = 1, r32ui) uniform DS_VIS_ACCESS uimage2DArray uVisProj;
// RGB9E5 words, one r32ui image each (rgba8 / r32ui: storage formats without
// shaderStorageImageExtendedFormats): irradiance, specular radiance, the legacy sharp env
// (written / read on dsEnvUsed faces only).
layout(set = 3, binding = 2, r32ui) uniform DS_REFL_ACCESS uimage2D uReflIrr;
layout(set = 3, binding = 3, r32ui) uniform DS_REFL_ACCESS uimage2D uReflSpec;
layout(set = 3, binding = 4, r32ui) uniform DS_REFL_ACCESS uimage2D uReflEnv;
// Half-resolution reflections (DEFER_FLAG_REFL_HALF; ceil(w / 2) x ceil(h / 2)): per 2 x 2
// block x irradiance, y soft specular (RGB9E5), z the representative's oct Ng (10 + 10 bits)
// | its index in the block << 20 | DS_HALF_SURF | DS_HALF_SPEC | its specular roughness
// (dsSpecRough) x 255 << 24, w its plane offset
// dot(Ng, P - eye) (float bits). In that mode uReflSpec holds the SHARP pixels' word
// (specular, or the legacy env on env faces) and uReflIrr / uReflEnv are 1 x 1 placeholders.
layout(set = 3, binding = 5, rgba32ui) uniform DS_HALF_ACCESS uimage2D uReflHalf;
// (#859) RT reflections (see HYBRID RT REFLECTIONS in the header). Render extent while they run,
// else 1 x 1 placeholders. MARK (binding 9): x / y = RGB9E5 of k x env for the uReflSpec / the
// uReflEnv word, z = packHalf2x16(k spec, k env); 0 = not a candidate. Written (whole 8 px tiles)
// only in the tiles the RT tile list holds. (#87) The RESOLVE (13) then rewrites x / y with the
// env radiance its splice LEFT in each word (misses, fades: k x env x the unreplaced share; no
// splice: unchanged), which the GI specular occlusion of the combine / BASE scales (deferReflIn).
#if CLEAN_DEFER_PASS == 2 || CLEAN_DEFER_PASS == 5
layout(set = 3, binding = 9, rgba32ui) uniform writeonly uimage2D uReflRtMark;
#elif CLEAN_DEFER_PASS == 13
layout(set = 3, binding = 9, rgba32ui) uniform uimage2D uReflRtMark;
#elif CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 16 || DEFER_RT_DBG || DEFER_RT_OCC
layout(set = 3, binding = 9, rgba32ui) uniform readonly uimage2D uReflRtMark;
#endif
#if DEFER_RT_TILES || DEFER_RT_DBG || DEFER_RT_OCC
// RT TILE LIST (binding 10): rtt_args = the RT kernels' VkDispatchIndirectCommand + n (the tile
// count): x = min(listed, 65535), y = the 65535-wide rows (maxComputeWorkGroupCount's floor; a 4K
// extent has ~130k tiles) -- the host writes (0, 0, 1, n) before the reflect passes;
// rtt_words[0, n) one flag per 8 px tile (1 = listed this frame; the host zeroes them),
// rtt_words[n + i] = the i-th listed tile (row-major over the 8 px grid of the render extent),
// rtt_words[2n] = the listed count (the host zeroes it).
// RAY LIST (#859 perf, RenderVKRTReflectionsRayList; pass 16 SELECT appends, pass 11 -DCLEAN_RT_LIST
// traces): rtt_words[2n + 1] = the rays appended (may exceed the capacity: the excess is dropped
// and counted in rtt_ovf), [2n + 2 .. 2n + 4] = the list trace's VkDispatchIndirectCommand (64 rays
// per workgroup; x = min(groups, 65535), y = the 65535-wide rows; the host writes (0, 0, 1) with the
// count zero every frame), [2n + 5] = the capacity (host, at allocation: n x 64 -- a tile casts at
// most 64 rays, so it never overflows), [2n + 8 + i] = ray i: px.x | px.y << 15 | 1 << 31 for a
// 2 x 2 block's one ray (the level path's cone; the only per-ray state the mark does not hold).
// The HEADER (272 B, LLCleanRendererVK kRtTilesHdrBytes) also carries the RAY DENSITY state:
//   rtt_rays[L]  rays level L would cast this frame (the mark passes; host-zeroed)
//   rtt_cand     candidate pixels (the mark passes; host-zeroed)
//   rtt_cast     rays cast (pass 11; host-zeroed)
//   rtt_level    the chosen level, ping-pong by frame parity (pass 11's entry-0 workgroup writes
//                [parity], every workgroup reads last frame's [parity ^ 1]: the deadband; the host
//                never writes these two words)
//   rtt_hit[5]   pass 11's hit-shading counters (host-zeroed; RTR_STATS): lights in range at
//                hits, RT projector records wanting a shadow ray, projector rays cast, blend
//                candidates shaded, reflection hits shaded
//   rtt_param    host, every frame: x max receiver distance (float bits), y sharp roughness (float
//                bits), z the ray budget (rays; ~0u = none), w the floor level | parity << 8
//   rtt_param2   host, every frame (DENSITY GRADIENT): x options (bit 0 the gradient is on), y the
//                minimum density rho_min, z the curve exponent, w the roughness cutoff (float bits)
//   rtt_scale    the gradient's budget scale (float bits), ping-pong by frame parity as rtt_level
//                (GPU-owned: the host never writes them)
//   rtt_grays    gradient rays at scale 1 (the mark passes; host-zeroed)
//   rtt_rhosum   sum over the candidates of rho x 256 (the mark passes; host-zeroed)
//   rtt_cost[]   pass 11's TRACE COST counters (host-zeroed; RTR_COST_*, flushed only while the
//                host asks for them: rtrOpts bit 7)
//   rtt_param3   host, every frame (STRENGTH DENSITY): x options (bit 0 the strength term is on,
//                bit 1 RenderVKDebugView 28, bit 2 #870 raw routing: the resolve keeps each own ray), y the full-density strength, z the minimum-density
//                strength, w the strength cutoff (float bits)
//   rtt_scand[3] candidates by type (RTR_TYPE_* - 1: PBR, legacy sharp env, legacy glossenv; the
//                mark passes; host-zeroed)
//   rtt_ssum[3]  sum of those candidates' strength x 256 (host-zeroed)
//   rtt_scut     pixels the strength cutoff took out (would be candidates without it; host-zeroed)
//   rtt_curv     host, every frame (CURVATURE DENSITY): the lattice step's normal change limit (rad)
//   rtt_opts4    host, every frame: bit 0 the LOBE FILTER (see the resolve)
#define RTR_LEVELS 3u
#define RTR_COST_WORDS 24
layout(std430, set = 3, binding = 10) buffer RtReflTiles
{
    uint  rtt_args[4];
    uint  rtt_rays[RTR_LEVELS];
    uint  rtt_cand;
    uint  rtt_cast;
    uint  rtt_level[2];
    uint  rtt_hit[5];      // pass 11's hit-shading counters (host-zeroed): RTR_STATS
    uvec4 rtt_param;
    uvec4 rtt_param2;
    uint  rtt_scale[2];
    uint  rtt_grays;
    uint  rtt_rhosum;
    uint  rtt_cost[RTR_COST_WORDS];
    uvec4 rtt_param3;      // (word 52: byte 208, 16-aligned)
    uint  rtt_scand[3];
    uint  rtt_ssum[3];
    uint  rtt_scut;
    uint  rtt_amresc;      // pass 11's AVATAR alpha-mask candidates RESCUED by the coverage rule (host-
                           // zeroed with param3; RTR_COST_AMTEST)
    uint  rtt_tiles;       // (word 64) tiles listed this frame (pass 11 / 16's entry-0 workgroup copies
                           // rtt_words[2n]; host-zeroed with param3): the trace's per-tile cost driver
    uint  rtt_ovf;         // RAY LIST rays past its capacity (pass 16; never with the tiles x 64
                           // sizing -- a guard; host-zeroed with param3)
    uint  rtt_curv;        // (word 66, host) CURVATURE DENSITY: the geometric normal's change per lattice
                           // step the resolve's plane gather resolves (rad, float bits; 0 = off;
                           // RenderVKRTReflectionsCurvatureDensity; rtrCurvRho)
    uint  rtt_opts4;       // (word 67, host) bit 0 the LOBE FILTER (RenderVKRTReflectionsLobeFilter: the
                           // resolve's reflection-direction weights + specular AA, the trace's curvature
                           // cone; rtrLobeOn) -> 68 words: LLCleanRendererVK kRtTilesHdrWords
    uint  rtt_words[];
};
#define RTT_ROW 65535u
float rttRecvDist() { return uintBitsToFloat(rtt_param.x); }
// ---- STRENGTH DENSITY (#859 perf; RenderVKRTReflectionsStrength*, rtt_param3; see the header) ----
// The mark's w word: bits 0-11 the trace roughness (unorm12; rtrMarkRough16 puts it back on the
// unorm16 scale the density code compares), 12-15 the CURVATURE DENSITY code (rtrCurvRho: the
// density the receiver's curvature needs, q / 15; 0 = none), 16-29 the reflection strength s
// (unorm14, clamped to 1), 30-31 the candidate type (RTR_TYPE_*). The roughness is only a density
// input (the trace and the resolve take the surface's own), so 12 bits lose nothing.
#define RTR_TYPE_PBR   1u
#define RTR_TYPE_ENV   2u   // legacy sharp env (shiny / env intensity)
#define RTR_TYPE_GLOSS 3u   // legacy glossenv (specular-mapped / shiny gloss)
uint  rtrMarkW(float rough, float s, uint type, uint curvQ)
{
    return uint(clamp(rough, 0.0, 1.0) * 4095.0 + 0.5) | (min(curvQ, 15u) << 12)
         | (uint(clamp(s, 0.0, 1.0) * 16383.0 + 0.5) << 16) | (type << 30);
}
uint  rtrMarkRough16(uint w) { return (w & 0xFFFu) * 16u + ((w & 0xFFFu) >> 8); }   // (4095 -> 65535)
float rtrMarkCurvRho(uint w) { return float((w >> 12) & 15u) * (1.0 / 15.0); }
bool  rtrLobeOn() { return (rtt_opts4 & 1u) != 0u; }   // (a header word: uniform)
float rtrMarkStrength(uint w) { return float((w >> 16) & 0x3FFFu) * (1.0 / 16383.0); }
uint  rtrMarkType(uint w) { return w >> 30; }
bool  rtrStrengthOn() { return (rtt_param3.x & 1u) != 0u; }   // (a header word: uniform)
float rtrStrengthFull() { return uintBitsToFloat(rtt_param3.y); }
float rtrStrengthMin()  { return uintBitsToFloat(rtt_param3.z); }
float rtrStrengthCut()  { return uintBitsToFloat(rtt_param3.w); }
// The splice's fade over the bottom of the strength range (the roughness fade's pattern): 0 at the
// cutoff (where the mark stops: no edge), 1 from the minimum-density strength up (the host keeps
// cut < min; a degenerate range falls back to a quarter of the cutoff).
float rtrStrengthFade(uint w)
{
    if (!rtrStrengthOn()) return 1.0;
    const float cut = rtrStrengthCut();
    const float top = max(rtrStrengthMin(), cut * 1.25 + 1e-4);
    return smoothstep(cut, top, rtrMarkStrength(w));
}
// ---- DENSITY GRADIENT (#859 perf; RenderVKRTReflectionsDensityGradient, rtt_param2; see the header) ----
bool rtrGradOn() { return (rtt_param2.x & 1u) != 0u; }   // (a header word: uniform)
// The lowest scale the budget may set: a pixel at full density never drops below one ray per
// 2 x 2 -- the level path's sparsest (level 2) -- so a mirror never turns sparse.
#define RTR_GRAD_SCALE_MIN 0.25
// A candidate's ray density before the budget, from its mark roughness (unorm16): rho_max at the
// sharp roughness -- the floor's density there (RenderVKRTReflectionsScale 0: 1; 1 and 2: 1/4, but
// level 1 keeps 1 below the sharp roughness, as its full blocks do) -- falling to rho_min at the
// roughness cutoff, linearly in rho for curve 1 (rho = mix(rho_max, rho_min, t^curve)). Never
// above what the level path gives the same pixel.
float rtrRhoRough(uint rough16)
{
    const uint floorL = min(rtt_param.w & 0xFFu, RTR_LEVELS - 1u);
    const float rough = float(rough16) * (1.0 / 65535.0);
    const float sharp = clamp(uintBitsToFloat(rtt_param.y), 0.0, 1.0);
    if (floorL == 1u && rough < sharp) return 1.0;
    const float rmax = floorL == 0u ? 1.0 : 0.25;
    const float rmin = clamp(uintBitsToFloat(rtt_param2.y), 1.0 / 256.0, rmax);
    const float cut = uintBitsToFloat(rtt_param2.w);
    const float t = clamp((rough - sharp) / max(cut - sharp, 1e-4), 0.0, 1.0);
    const float c = clamp(uintBitsToFloat(rtt_param2.z), 0.1, 10.0);
    return mix(rmax, rmin, pow(t, c));
}
// A candidate's ray density before the budget, from its whole mark word (rtrMarkW): the roughness
// ramp rho_r (rtrRhoRough) x the STRENGTH term -- rho = mix(min(rho_r, rho_min), rho_r, u),
// u = (s - strength min) / (strength full - strength min) clamped to [0, 1]: full roughness
// density from the full strength up, falling linearly in rho to rho_min at the minimum-density
// strength (flat below it, down to the cutoff where the mark stops). Never above rho_r (never
// more rays than the roughness ramp alone); a pixel the roughness already put at rho_min stays
// there. Strength term off: rho_r.
// CURVATURE DENSITY (rtrCurvRho, the mark's code): never below what the receiver's curvature needs,
// whatever the floor, the roughness or the strength gave it.
float rtrRho(uint w)
{
    const float rr = rtrRhoRough(rtrMarkRough16(w));
    const float rc = rtrMarkCurvRho(w);
    if (!rtrStrengthOn()) return max(rr, rc);
    const float rmin = clamp(uintBitsToFloat(rtt_param2.y), 1.0 / 256.0, 1.0);
    const float lo = rtrStrengthMin(), hi = rtrStrengthFull();
    const float u = clamp((rtrMarkStrength(w) - lo) / max(hi - lo, 1e-4), 0.0, 1.0);
    return max(max(mix(min(rr, rmin), rr, u), 1.0 / 256.0), rc);
}
// After the budget scale s: rho x s, but never below rho_min for a pixel the ramp put above it.
float rtrRhoEff(float rho, float s)
{
    const float rmin = clamp(uintBitsToFloat(rtt_param2.y), 1.0 / 256.0, 1.0);
    return max(rho * s, min(rho, rmin));
}
// This frame's budget scale as pass 11 chose it (pass 13, after the trace: rtt_scale[parity]).
float rtrGradScaleNow()
{
    const float s = uintBitsToFloat(rtt_scale[(rtt_param.w >> 8) & 1u]);
    return (s > 0.0 && s <= 1.0) ? s : 1.0;
}
