#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#define CLEAN_SKY_LUT   // (#819) skyColor() reads the sky-view LUT (draw set 0 binding 52) when valid
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_control_flow_attributes : require
// Subgroup OR of the froxel masks (tileLightWord; basic + arithmetic subgroup ops in compute are
// already a baseline: clean_cull.comp requires them) + the shader clock's stage reductions.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#ifdef CLEAN_GI_TRACE
#extension GL_KHR_shader_subgroup_ballot : require   // (the GI trace's cache fill: giCacheAddWave)
#endif
#ifdef CLEAN_SHADER_CLOCK
// RenderVKShaderClockLighting variants only (clean_shader_clock.glsl): VK_KHR_shader_clock
// (shaderSubgroupClock).
#extension GL_ARB_shader_clock : require
#endif
// vkclean — DEFERRED LIGHTING (RenderVKDeferredLighting): lights the pass-1b G-buffer of
// the main view in compute and writes the linear HDR scene + the glow target.
//
// The G-buffer (clean_gbuffer.glsl) holds the decoded material of every opaque / mask /
// rigged pixel (clean_draw.frag -DCLEAN_GBUFFER, EQUAL after the depth pre-pass). This
// pass reconstructs the world position from the pre-pass depth and runs the SAME
// lightSurface() the forward lit FS runs (clean_surface_light.glsl): sun + RT shadow mask
// / cascades, clustered local lights + projectors, reflection probes, SSR, SSAO, planar
// mirror, legacy shiny env, haze, distance fade. RenderVKLitDebugMask bits act here as in
// the forward pass (normal / ORM / emissive maps and the legacy env are dropped by the
// G-buffer decode). Pixels with no G-buffer surface (sky, cleared) get black + no glow;
// the depth-tested sky is drawn over them afterwards, exactly as the forward pass 1b.
//
// Set 0 / 1 = the draw sets (lights, clusters, probes, shadows, mask, AO, frame info, the
// draw-view ring, bindless textures), set 2 = the G-buffer + depth + the two outputs.
//
// TILED LIGHT LISTS: one 16x16 workgroup = one screen tile. The tile's view-depth range
// (its surface pixels' min / max) and its four corner rays bound a frustum section;
// every light (<= 256: one per invocation) is tested against it -- sphere vs. the four
// side planes and the depth range, and projectors additionally by their frustum
// half-spaces (x, y in [0, w], z >= 0 of proj_mat) against the section's 8 corners --
// into a 256-bit shared mask. Each pixel then walks only its tile's lights, in index
// order (deterministic sums), instead of its 16x9x24 cluster's (a 240 x 240 px cell
// at 4K, a whole depth slice deep). The per-pixel tests stay as before.
//
// LIGHT GRID (RenderVKLightCulling 1, DEFER_FLAG_LIGHT_GRID; pass 6 below): the same tile masks
// built ONCE per frame by their own small kernel instead of inside the ~128-register
// lighting kernel, whose 25 %-occupancy SMs spent ~4.5k of ~16k cycles per lit pixel on
// tile_depth + tile_lights (one latency-bound light test per lane between three barriers;
// GTX 1080, 4K, ~370 lights). The build (16x16 per tile, the lit kernels' own tile grid:
// same workgroup ids) runs the old test unchanged and AND-s a 2.5D DEPTH-BIN test: the
// tile's surface depths mark 32 log-spaced bins of its depth range, a light's view-depth
// interval [cz - r, cz + r] (+ slack) covers a run of bins, and a light whose run holds no
// surface is dropped (a near pole in front of the far terrain no longer takes every light
// between them). It also runs the lit-guard cluster scan. The lit kernels then copy their
// tile's 8 words into the shared mask (8 lanes, one barrier, the load overlapping the
// G-buffer fetch) and walk it as before. LOSSLESS + BIT-IDENTICAL: a dropped light cannot
// reach any surface pixel of the tile (|cz - vz| <= |L - P| < r for a pixel it lights;
// the bin map is monotone, so that pixel's bin lies in the light's run), so for every
// pixel the walked lights that pass localLight's range / frustum tests -- and their index
// order -- are exactly the old path's; the skipped ones added an exact 0.
//
// FROXEL MASKS (RenderVKLightCulling 2, the default; DEFER_FLAG_LIGHT_FROXEL): the light pass
// builds a 256-bit mask per froxel -- screen tile (2^n px, ~32 tile rows) x exponential view-
// depth slice -- from the LIGHTS ALONE (clean_light_froxel.comp: per light, its covered cells,
// atomicOr; no pixel depth read; argument for losslessness there). Here each lit pixel finds
// its cell from its pixel and its own view depth (tileLightBase: the build's froxelSlice and
// vz definition) and walks the cell's words OR-ed over the subgroup (tileLightWord: one
// uniform walk, the light records' loads broadcast) in ascending light index. No shared mask,
// no tile depth reduction, no barrier: the workgroup only runs the lit-guard cluster scan
// (global atomics) before shading. BIT-IDENTICAL to both tile paths: every walk is a superset
// of the lights that reach P in index order, and a light outside localLight's range / frustum
// returns an exact 0 before touching glare / the RT-mask taps / the projector slots.
// (RenderVKLightCulling 0 = the in-kernel tile test, 1 = the light grid; same binary, the
// flag is a push constant: every branch on it is uniform.)
//
// SPLIT BUILDS (RenderVKDeferredSplit; CLEAN_DEFER_PASS, one source): the uber kernel
// above is one ~128-register program (2 workgroups / SM on Pascal: 25 % occupancy). The
// split cuts it by the DATA each part reads, into three kernels that each hold only their
// own working set (LLCleanRendererVK::recordDeferredLighting):
//   1 SHADOW   (8x8)  G1 / G2 + depth, the sun cascades (PCF / PCSS) or the RT mask, the
//                     projector atlas / RT mask -> the VISIBILITY buffers (set 3): sun
//                     (tint, vis) rgba8 + up to 4 shadowed projectors per pixel as
//                     (light index + 1, visibility) slots, the RT mask's scheme (r32ui
//                     layers: the ids, then one byte plane per colour channel).
//   2 REFLECT  (8x8)  G0.a / G1 / G2 + depth, the probe blend, SSR (last frame's colour),
//                     the planar mirror, the legacy env -> the REFLECTION buffers (rg32ui:
//                     irradiance + specular radiance; r32ui: the legacy sharp env; RGB9E5).
//   3 COMBINE  (16x16, the tile light mask) the G-buffer once + both buffers + AO: sun /
//                     ambient / BRDF / local lights / emissive / haze / glow -> HDR + glow,
//                     written once. lightSurface() runs with the three external hooks
//                     (CLEAN_SUN_VIS_EXTERNAL, CLEAN_REFL_EXTERNAL, CLEAN_PROJ_VIS_EXTERNAL),
//                     so no shadow filter, probe walk or SSR march is compiled into it.
// 1 and 2 are independent (one barrier before 3). Not bit-identical to the uber kernel:
// the buffers' quantization (below) and the projector slot cap (see SHADOW below).
// HALF-RESOLUTION REFLECTIONS (RenderVKDeferReflectHalfRes, DEFER_FLAG_REFL_HALF): pass 2
// is replaced by two kernels, both independent of 1 (same barrier before 3):
//   4 REFLECT HALF   (8x8 over the 2 x 2 blocks) one invocation per block: the block's
//                    REPRESENTATIVE pixel (a soft surface first: dsHalfRank) gets the
//                    irradiance + the soft specular (probe walk, SSR, mirror) -> uReflHalf
//                    (rgba32ui: irr, spec RGB9E5, its oct Ng + flags, its plane offset).
//   5 REFLECT SHARP  (8x8, full res) only the SHARP pixels (dsSharpKind: PBR roughness /
//                    legacy gloss past RenderVKDeferReflectSharpRough, a strong planar
//                    mirror weight, legacy env faces, fullbright shiny): their specular /
//                    legacy env per pixel -> uReflSpec. Every other invocation leaves after
//                    one G-buffer decode (warps over soft surfaces: no walk at all).
//   COMBINE reads the sharp word at sharp pixels and upsamples the rest from the 4 nearest
//   blocks: bilinear x a plane test (the block's surface plane through this pixel's P) x
//   geometric-normal similarity (dsHalfUpsample), the most similar block where no weight
//   survives. Irradiance is half resolution everywhere (low frequency; the normal map's
//   detail in the ambient term is averaged over the block), so is the soft specular.
// INTERMEDIATE FORMATS (16 B / px; + 8 B mono / 16 B colour projector slots). Each value
// is quantized once, rounded to nearest; 0 and 1 (unshadowed / fully shadowed) are exact:
//   sun rgba8 = sqrt(tint rgb, vis): both live in [0, 1] (shadowTint reads an rgba8
//     layer, the RT mask's sun is an rgba8 image: already 8-bit upstream). Gamma-2
//     steps: abs error <= sqrt(v) / 255 (0.004 at 1, 0.0012 at 0.1, 0.0004 at 0.01), a
//     relative error that tracks an 8-bit display encoding's, so no band finer than the
//     output's own.
//   projector slots: the same sqrt bytes as before, as r32ui planes; frames whose
//     projector visibility can't be coloured (no RT projector, no projector translucency
//     layer: R = G = B) keep the R plane only.
//   reflection RGB9E5 (clean_probe_pack.glsl; the probe arrays' own format under
//     RenderVKProbeFormat 1): 9-bit mantissas under a shared exponent -> <= 0.2 % on the
//     largest channel (fp16: 0.05 %), the others +- largest / 512; range 2^-24 .. 65408 (>= LG_MAX_VALUE,
//     the fp16 range it replaces). Irradiance / radiance are blends of RGB9E5 or fp16 cube
//     texels: one more rounding of the size the source already has.
// These formats hold no NaN / inf (UNORM and RGB9E5 store them as 0): the packs count a
// non-finite value as LG_OUT (dsFiniteNote) -- the trip the uber kernel's output guard
// would have taken -- so the lit guards stay meaningful.
//
// FEATURE SPLIT (#827, RenderVKDeferredFeatureSplit, default on; split frames only): the
// COMBINE above is ~120 registers because of ONE feature -- the local-light walk (the register
// probes: base shading 64, + local lights 128) -- and that walk does nothing on most tiles.
// The combine is replaced by three kernels, the shadow / reflect producers above unchanged:
//   9 TILE CLASSIFY (one 16 px tile per workgroup, pass 6's grid build; #831: or folded into
//                   SHADOW as pass 10, see below) beside SHADOW / REFLECT: the tile's light
//                   mask -> uLightGrid (RenderVKLightCulling 0 / 1: the grid test, lossless + bit-identical per LIGHT GRID above), or under
//                   _FROXEL whether any surface pixel's froxel cell holds a light; a tile with a
//                   light appends its index to the TILE LIST (set 3 binding 8: a
//                   VkDispatchIndirectCommand, then the tile indices).
//   7 BASE     (8x8, no shared state) the combine with no local lights (CLEAN_LOCAL_EXTERNAL:
//                   lightSurface's tail adds an exact 0): sun / ambient / reflections (from
//                   the reflect buffers) / BRDF / emissive / haze / fade -> HDR + glow, final
//                   for every pixel no light reaches; + per lit pixel the LOCAL GAIN (set 3
//                   binding 7, r32f): d(output) / d(local sum) -- see surfaceLocalGain.
//   8 LOCAL    (16x16, vkCmdDispatchIndirect over the tile list) the tile walk exactly as the
//                   combine runs it (grid mask -> shared + #815 staging, or the froxel cells;
//                   projector visibility from the shadow pass's slots) -> HDR += gain x local,
//                   glow rewritten from the new HDR. Pixels whose walk sums to an exact 0 keep
//                   BASE's output untouched.
// WHY ADDITIVE IS EXACT: in lightSurface the local sum enters AFTER every nonlinear step --
// color = atmosClampHDR(c * k1) + local * k2 -- and everything after it is affine in colour
// with a scalar slope (haze lin * atten.r + add, water fog lin * f.a + f.rgb, the distance fade
// mix(lin, target, f)), so output(local) = output(0) + local * k2 * slope. The reflections are
// NOT additive (inside the clamp; legacy's env mix / max(1 - color) are nonlinear in the colour
// before them): they stay a producer whose buffers BASE reads, as the combine does. Same terms,
// same order up to float rounding: BASE's output goes through the RGBA16F target once more
// before LOCAL adds to it (<= 1 fp16 ulp of the pre-local colour on lit pixels), and glow
// (sRGB of the final colour x the face's factor) is recomputed from the stored sum.
// CLASSIFY FOLDED INTO SHADOW (#831, RenderVKDeferClassifyFused, live, default on):
//  10 SHADOW + CLASSIFY (256 x 1 = one 16 px tile per workgroup) the tile classification
//                   (gridTileBuild, the SAME function pass 9 runs: identical light_grid words,
//                   tile list and froxel verdicts) as the prologue of the shadow kernel, which
//                   already fetches every pixel's G2 + depth and reconstructs P -- so the
//                   classification's own full-screen G2 / depth / deferPosition pass is gone.
//                   The prologue's barriers come before any return; the shadow body after it is
//                   pass 1's unchanged (per pixel: no subgroup op, no dependence on the group
//                   shape, so its outputs are bit-identical to the 8x8 kernel's). The tile
//                   state (shared mask + depth range) is dead before the shadow filter runs.
//   Off: pass 9 beside pass 1 as before (same function, same outputs). Both pipelines exist
//   from init: the live toggle switches binds only.
// The tile builds (6 / 9 / 10) reduce their shared-memory atomics per SUBGROUP first (#831:
// every lane used to hit s_zmin / s_zmax / s_zbins -- 3 x 256-long serial chains per tile on
// Pascal): subgroupMin / Max / Or with identities for the lanes without a surface, then one
// atomic per subgroup (subgroupElect). min / max / or are exact and order-free, so the shared
// words are bit-identical to the per-lane atomics', for any subgroup size and any lane ->
// subgroup mapping (nothing assumes full or equal subgroups; the pipelines still request
// REQUIRE_FULL_SUBGROUPS where the device allows it, per the repo rule -- hence the 256 x 1
// workgroup shape: that flag needs local_size_x to be a multiple of the subgroup size).
// The lit-guard cluster scan runs in pass 9 only under DEFER_FLAG_SCAN_ONLY (#831): its own
// small dispatch on sampled frames (the host scales its per-frame averages), not in every
// tile build of every frame.
//
// HYBRID RT REFLECTIONS (#859, RenderVKRTReflections 1; ray tracing on):
// SSR stays the primary reflection. Where it has no confident answer -- a miss, a rejected hit,
// off screen, behind an occluder, or a smooth surface SSR does not even try (PBR roughness in
// (0.1, threshold)) -- the reflect kernels leave the probe / sky radiance in the word; this
// replaces THAT share by a ray traced against the scene TLAS (avatars included), smooth pixels
// only. Each word is
//   word = tapMirror(mix(env, ssr, a)) = (1 - mw)(1 - a) env + (1 - mw) a ssr + mw mirror
// -- linear in env -- so with k = (1 - mw)(1 - a) the traced radiance rt replaces env exactly:
//   word' = word + f (k rt - k env)
// (the SSR and mirror shares untouched; a = 1 pixels never change; the combine's Fresnel / BRDF
// weighting is SSR's). f fades the splice out over the top quarter of the roughness threshold.
// SPLIT FRAMES:
//   MARK (passes 2 / 5, DEFER_FLAG_RT_MARK): per pixel (k env, k) of its uReflSpec word and its
//        uReflEnv word (legacy env faces: both the glossy and the sharp env) -> uReflRtMark
//        (binding 9). Candidates: roughness (legacy 1 - glossiness; the sharp env always) below
//        RenderVKRTReflectionsRough, k x the reflectance >= DS_RT_MIN_STRENGTH, not fullbright,
//        and a RECEIVER closer to the camera than RenderVKRTReflectionsMaxRecvDist (farther ones
//        keep SSR + probe: no mark, so a tile of far pixels is never listed and costs no ray; the
//        resolve fades the RT share out over the last 20 % of that distance: no ring).
//        An 8 px tile (= the 8x8 workgroup) holding a candidate writes all its marks and appends
//        itself to the RT TILE LIST (binding 10); other tiles write nothing (empty-screen floor:
//        one barrier per workgroup, the two RT dispatches below go indirect with 0 groups). The
//        listing tile also adds what each RAY DENSITY level (below) would cast in it to the list
//        header.
//  RAY DENSITY (RenderVKRTReflectionsSharpRough / _Scale / _RayBudget; rtrRayAt): per 2 x 2 block
//        of an 8 px tile (blocks never straddle tiles), from the block's SMOOTHEST candidate --
//          level 0  every candidate traces (full density everywhere);
//          level 1  a block whose smoothest candidate is below the sharp roughness traces every
//                   candidate (a mirror inside the block keeps full rays), any other block one
//                   ray (its first candidate in scan order; the default);
//          level 2  every block one ray.
//        The resolve fills a block's other candidates from the rays on the same plane, as the old
//        half-resolution path did. The FRAME's level: the lowest one at or above the floor
//        (RenderVKRTReflectionsScale) whose ray count fits RenderVKRTReflectionsRayBudget, decided
//        on the GPU by every trace workgroup from the mark passes' per-level counts (a pure function
//        of the header: every workgroup agrees, no extra dispatch, no readback), with a deadband
//        (back to a denser level only below 80 % of the budget: no level toggling at the budget).
//        Over the budget even at level 2 the frame casts level 2 (pixels are never dropped).
//  DENSITY GRADIENT (RenderVKRTReflectionsDensityGradient / _DensityMin / _DensityCurve; rtt_param2):
//        instead of the levels, a continuous per-pixel density rho (rtrRho): the floor's density at
//        the sharp roughness (Scale 0: 1; 1 / 2: 1/4 -- level 1 keeps 1 below the sharp roughness),
//        falling about linearly with the roughness to rho_min at the RT cutoff -- never above what
//        the levels give the pixel. A candidate casts when its EFFECTIVE 16 x 16 ordered-dither rank
//        (rtrRank / rtrGradRank: an aligned cell whose lattice pixel is no candidate hands its rank
//        to its best candidate, so no surface edge or thin feature loses its rays) is below
//        rho_eff x 256: a smooth, spatially even gradient with no block steps. The budget scales every
//        rho uniformly (rtrGradScale: the mark passes' rays at scale 1, the levels' deadband, never
//        below 1/4 -- a full-density pixel never gets sparser than one ray per 2 x 2 -- and never
//        below rho_min for a pixel the ramp kept above it: rtrRhoEff). Rays stay packed into the
//        first lanes; a ray's cone covers its 1 / sqrt(rho) pixels. The resolve's gather follows the
//        sparsity (rtrLattice: the 4 x 4 ray lattice around the pixel at spacing ~1 / sqrt(rho),
//        the filter widened to it; no ray there: the coarser lattices up to 16 before the env).
//  STRENGTH DENSITY (RenderVKRTReflectionsStrength / _StrengthFull / _StrengthMin / _StrengthCut;
//        rtt_param3): the mark also stores how VISIBLE the splice is -- the strength s, the weight
//        the combine gives the replaced env radiance (dsRtMark: PBR k x max(F); legacy sharp env
//        k x 0.5 x e^2 x fresnel; legacy glossenv k x spec x gloss / 4). Below the cutoff no mark
//        (SSR + probe); the gradient's rho falls from the roughness ramp's value at s >= full to
//        rho_min at s <= min (rtrRho), and the resolve fades the splice in from the cutoff to min
//        (rtrStrengthFade: no edge). RenderVKDebugView 28 shows the result (rtrDebugColor).
//  11 RT TRACE (8x8 per listed tile, indirect; RT set 4): the tile's rays (RAY DENSITY) packed
//        into the first lanes (a shared slot list: a half-density tile runs one partly filled warp,
//        not two sparse ones), each along the mirror direction of the shading
//        normal from the depth-rebuilt receiver, up to RenderVKRTReflectionsMaxDist:
//          * closest opaque / alpha-mask hit (cut-outs at the material cutoff, texture LOD from a
//            ray cone matching the reflected pixel footprint and the raster sampler's
//            anisotropy; single-sided back faces skipped -- in hardware where the TLAS instance
//            allows it: rtrReflCullFlags, RenderVKRTReflectionsHWCull), shaded with clean_rt_surface.glsl
//            (interpolated vertex normals -- rigged: the skinned ones -- normal maps, every map at
//            the interpolated UV) and clean_rt_shade.glsl's main-view hooks: sun / moon with one
//            shadow ray, ray-traced projectors with one shadow ray, probe irradiance / radiance AT
//            THE HIT, local lights from the main-view cluster the hit projects into (a hit
//            outside the view: every light of the frame, range-tested), emissive, water with the
//            probes along its reflection, haze from the receiver;
//          * up to RTR_BLEND_LAYERS nearest ALPHA-BLEND surfaces in front of it (a second ray
//            over the blend class), shaded cheaply (texel x factor x tint, sun N.L + ambient,
//            fullbright unlit) and composited front to back over the hit (or over the env).
//          SIZE-CLASS SEGMENTS (RenderVKRTReflectionsSizeClasses; rtrSmallDist): the closest-hit
//          ray runs [0, D] over every class, then (a miss) [D, max] without the small static
//          opaque class (RT_MASK_SMALL), D = where that class's bound falls below
//          RenderVKRTReflectionsSizeFootprintPx reflected pixels of the ray cone; the blend
//          layers skip small instances' candidates past D in the shader.
//        -> uRtTrace (binding 11).
//  13 RT RESOLVE (8x8 per listed tile, indirect; no ray query): per candidate pixel the traced
//        samples of its neighbourhood -- the 3 x 3 always (half resolution: the block's ray),
//        the density gradient's ray lattice where it is sparse (rtrLattice), plus a 12-tap disc
//        scaled to the GLOSSY LOBE's footprint (GGX alpha = roughness^2 x hit
//        distance, projected to pixels) -- weighted by receiver plane + normal similarity; a
//        neighbour whose ray missed contributes this pixel's env. The legacy sharp env takes its
//        own sample. Splices both words, x the receiver distance fade.
//        (#859 noise) LOBE FILTER (RenderVKRTReflectionsLobeFilter): the neighbours weigh by their
//        reflection direction against the pixel's lobe + specular AA (rtrTap). TEMPORAL
//        (RenderVKRTReflectionsTemporal): the rays are mirror rays but sparse and jittered, so the
//        result is accumulated over frames, reprojected by its virtual image (rtrTemporal).
// UBER FRAMES (RenderVKDeferredSplit 0): no SSR knowledge before the kernel, so
//  12 RT PRE-TRACE (8x8 full screen; RT set 3) traces every smooth candidate pixel (no SSR
//        filter, no blend layers over a miss, no glossy filter: the A/B path) -> uRtUber
//        (set 2 binding 11: rgb, a = f on a hit), and the uber kernel's surfaceReflectionsW mixes
//        it into env before SSR (CLEAN_REFL_RT_IN): the same splice. The receiver distance gate +
//        fade apply (push rtr.z); the ray density / budget do not (full density: the A/B path).
// FORWARD SURFACES + WATER (RenderVKRTReflectionsForward):
//  14 RT FORWARD (8x8 over the half-resolution grid; RT set 4): per 2 x 2 block a camera ray over
//        the alpha-blend + water classes up to the opaque depth finds the front-most such layer
//        (alpha >= RTR_FWD_MIN_ALPHA); a smooth one (or water: its wave normal) gets one
//        reflection ray (hit shaded as above) -> uRtFwd (binding 12: rgb, a = the layer's view
//        depth). The forward lit FS and the water FS sample it (draw set 0 binding 48; a texture
//        read, no ray query: #849) and use it as their env where the depth matches.
// Runs between REFLECT and BASE / COMBINE (LLCleanRendererVK::recordDeferredLighting).
#ifndef CLEAN_DEFER_PASS
#define CLEAN_DEFER_PASS 0   // 0 uber, 1 shadow, 2 reflect, 3 combine, 4 reflect half, 5 reflect sharp, 6 light grid,
                             // 7 base, 8 local, 9 tile classify (the feature split, #827),
                             // 10 shadow + tile classify (#831), 11 RT trace, 12 RT pre-trace (uber),
                             // 13 RT resolve, 14 RT forward / water reflections (#859),
                             // 15 projector stochastic sample (#85 phase 2),
                             // 16 RT ray select (the ray list; #859 perf)
#endif
// (#859) the ray-tracing kernels: ray queries + the RT hit shading
#define DEFER_RT_TRACE (CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 12 || CLEAN_DEFER_PASS == 14)
// (#87) RAY-TRACED GI: pass 11 built with -DCLEAN_GI_TRACE is the GI trace (clean_gi_common.glsl):
// the RT trace's layout, hit material + shading, its own DEFER_MAIN (one GI texel per invocation).
#if CLEAN_DEFER_PASS == 11 && defined(CLEAN_GI_TRACE)
#define DEFER_GI_TRACE 1
#else
#define DEFER_GI_TRACE 0
#endif
#if DEFER_RT_TRACE && (!defined(CLEAN_PROJ_SHADOW_RAYQUERY) || !defined(RT_SET))
#error "the RT reflection kernels (11 / 12 / 14) need -DCLEAN_PROJ_SHADOW_RAYQUERY -DRT_SET=4 (12: 3)"
#endif
// (#85 phase 2) PROJECTOR STOCHASTIC SAMPLE: the RT reflection kernels' layout + push (ray
// queries for the shadow rays, no RT hit shading)
#define DEFER_PSTOCH (CLEAN_DEFER_PASS == 15)
#if DEFER_PSTOCH && (!defined(CLEAN_PROJ_SHADOW_RAYQUERY) || !defined(RT_SET))
#error "the projector stochastic sample (15) needs -DCLEAN_PROJ_SHADOW_RAYQUERY -DRT_SET=4"
#endif
#define DEFER_RT_PUSH (DEFER_RT_TRACE || DEFER_PSTOCH || CLEAN_DEFER_PASS == 16)   // the 128 B push (VKRtReflPush)
// MERGED RT SHADOWS (#195 + #85, RenderVKRTShadowMerge; LLCleanRendererVK mPdnMergePipe): pass 15
// built with -DCLEAN_SHADOW_MERGE also traces the SUN / MOON per denoiser texel (its own ray, never
// part of the projector pick) into the denoiser's sun channel (clean_pdn_common.glsl SUN CHANNEL),
// and the SHADOW kernel (1 / 10) reads the denoised sun instead of the RT shadow mask -- one trace
// pass, one denoiser, the lighting stays deferred. Only when the sun / moon AND the projectors are
// ray traced with the stochastic path on; every other combination runs the unchanged kernels.
// The frame says so through the frame info: rt_mask.x = -1 (the RT mask is off for every reader:
// rtMaskUsable needs > 0.5) together with DEFER_FLAG_PSTOCH in the split push.
#if DEFER_PSTOCH && defined(CLEAN_SHADOW_MERGE)
#define DEFER_SHADOW_MERGE 1
#else
#define DEFER_SHADOW_MERGE 0
#endif
// (#859) the reflect kernels export the RT reflection mark (clean_surface_light.glsl)
#if CLEAN_DEFER_PASS == 2 || CLEAN_DEFER_PASS == 5
#define CLEAN_REFL_RT_MARK
#endif
// (#859) the uber kernel splices the pre-traced reflection (pass 12) into its environment term
#if CLEAN_DEFER_PASS == 0
#define CLEAN_REFL_RT_IN deferRtIn
#endif
#if DEFER_RT_TRACE
// (#859) probe lookups at a ray hit: the cluster its position projects into (clean_draw_common.glsl)
#define CLEAN_PROBE_CLUSTER_HOOK(P) mainClusterProject(P)
#endif
// (#859) the split's RT tile list (set 3 binding 10): the reflect passes append, 11 / 13 walk it
#define DEFER_RT_TILES (CLEAN_DEFER_PASS == 2 || CLEAN_DEFER_PASS == 5 || CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 13 \
                        || CLEAN_DEFER_PASS == 16)
