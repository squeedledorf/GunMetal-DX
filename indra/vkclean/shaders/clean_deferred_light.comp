#define CLEAN_TILE_LIGHTS
#define TILE_LIGHT_WORDS 8u          // 256 lights (LLCleanRendererVK::MAX_VK_LIGHTS)
shared uint s_tileMask[TILE_LIGHT_WORDS];
shared uint s_zmin;                  // float bits of the tile's surface view depths (>= 0)
shared uint s_zmax;
// The light-mask hooks of clean_draw_common.glsl localLights: tileLightBase(P) = the pixel's
// froxel cell's first word (DEFER_FLAG_LIGHT_FROXEL; defined below the includes: it reads
// linfo) or TILE_BASE_SHARED (the shared tile mask); tileLightWord(base, w) = word w of it.
#define TILE_BASE_SHARED 0xFFFFFFFFu
#if CLEAN_DEFER_PASS != 6
// FROXEL MASKS (RenderVKLightCulling 2; LLCleanRendererVK mFroxel, written by the light pass's
// clean_light_froxel.comp): FROXEL_WORDS uints per cell. Bound always; read only under the flag
// (the lit kernels' walk, the feature split's tile classification).
layout(std430, set = 2, binding = 9) readonly buffer LightFroxels { uint light_froxel[]; };
#endif
#if DEFER_GRID_BUILD
uint tileLightBase(vec3 P) { return TILE_BASE_SHARED; }   // (no light walk in the grid build)
uint tileLightWord(uint base, uint w) { return s_tileMask[w]; }
#else
uint tileLightBase(vec3 P);
// The froxel word OR-ed over the active lanes (the flag is uniform, so is the branch): the
// subgroup walks one light set -- each lane's own cell's lights among them -- with uniform
// light indices.
uint tileLightWord(uint base, uint w)
{
    if (base == TILE_BASE_SHARED) return s_tileMask[w];   // (a branch, never a select: no load at ~0u)
    return subgroupOr(light_froxel[base + w]);
}
#endif
#else
layout(local_size_x = 8, local_size_y = 8) in;   // (no shared tile state: finer occupancy steps)
#endif

// The draw-view ring index first (its entry: set 2 binding 10, a dynamic-offset UBO --
// clean_draw_view.glsl CLEAN_DRAW_VIEW_UBO, #814), then the eye-relative inverse of the main
// view's (jittered) view-projection.
#define CLEAN_EXTERNAL_DRAW_PUSH
#define CLEAN_DRAW_VIEW_UBO
layout(push_constant) uniform DeferPush {
    uint view;          // main view's draw-view ring entry (pass 1's draw push)
    uint flags;         // split: DEFER_FLAG_PROJ / _RGB (uber: reserved, 0)
    uint width;         // render extent (px)
    uint height;
    mat4 inv_vp_rel;    // VK clip (jittered, reversed-Z) -> world relative to the eye
#if DEFER_RT_PUSH
    vec4 rtr;           // (#859 RT kernels, VKRtReflPush) x max ray distance (m), y the options
                        // (rtrOpts), z the max receiver distance (m; pass 12 -- the split kernels
                        // read the tile list header's), w the sampler anisotropy
                        // (#85 pass 15: x / y the denoiser extent, z the frame index, w = the
                        // sample count K | the GEOM parity << 4 -- exact integers)
    vec4 rtr2;          // (#859 RT kernels) SIZE-CLASS SEGMENTS (rtrSmallDist): x the small class
                        // bound (m; RenderVKRTReflectionsSmallSize, 0 = off), y the footprint
                        // threshold (reflected px; RenderVKRTReflectionsSizeFootprintPx, 0 = fixed
                        // distance), z the fixed distance (m; RenderVKRTReflectionsSmallDist), w 0
    uvec4 rtr3;         // (#771 pass 15) xy the SUN EXPOSURE CERTIFICATE table's device address
                        // (clean_sun_cert.glsl; 0 = SXC off), zw 0
#endif
} g_draw_push;          // 80 B (RT kernels: 128 B)
// The frame has shadowed projector records: the shadow pass resolves their slots (and the
// combine reads them). Off: uVisProj is a placeholder, never touched.
#define DEFER_FLAG_PROJ 1u
// The projector visibility can be coloured (RT-traced projectors, or the #212 projector
// translucency layer): uVisProj has the G / B byte planes too (else R only: R = G = B).
#define DEFER_FLAG_PROJ_RGB 2u
// Half-resolution reflections (passes 4 + 5 instead of 2; see the header): bits 8-15 carry
// the sharp roughness threshold x 255 (RenderVKDeferReflectSharpRough).
#define DEFER_FLAG_REFL_HALF 4u
// Visibility reuse (RenderVKDeferVisReuse): the shadow pass also writes uVisDepth, where the
// main view's forward alpha-blend FS matches its fragments against the opaque surface
// (clean_draw_common.glsl CLEAN_VIS_REUSE; draw set 0 bindings 41-43 alias set 3's images).
#define DEFER_FLAG_VIS_REUSE 8u
// Light grid (RenderVKLightCulling 1; uber + combine): pass 6 built this frame's tile masks into
// uLightGrid (and ran the cluster scan): no in-kernel tile test, no cluster scan.
#define DEFER_FLAG_LIGHT_GRID 16u
// Froxel masks (RenderVKLightCulling 2; uber + combine): the light pass built this frame's
// froxel masks (set 2 binding 9): no in-kernel tile test, no barrier (never set with _GRID).
#define DEFER_FLAG_LIGHT_FROXEL 32u
// LIGHT STAGING (#815, RenderVKLightStage, live; uber + combine, never with _FROXEL): after the
// tile mask is final, lane i copies light i's point part into shared memory if the mask holds
// it (TILE x TILE = 256 lanes = the 256 mask bits: one light per lane, no loop), one barrier;
// the walk (clean_draw_common.glsl localLight) then reads position / radius, colour / falloff
// and the projector bit from there. Shared memory: 256 x 32 B + 32 B = 8224 B per workgroup on
// top of the 40 B tile mask / depth range (the lighting kernels are register-limited to 2
// workgroups / SM on Pascal: 16.4 KB of 96 KB). Lossless: bit copies, same lights, same order.
#define DEFER_FLAG_LIGHT_STAGE 64u
// CLUSTER SCAN ONLY (#831; pass 9): this dispatch is the lit-guard cluster scan alone (a small
// grid on the host's sampled frames) -- no tile build, no grid / tile-list write.
#define DEFER_FLAG_SCAN_ONLY 128u
// RT REFLECTION MARK (#859; reflect passes 2 / 5): write uReflRtMark + the RT tile list this
// frame (the RT passes run after them); bits 24-31 carry the roughness threshold x 255
// (RenderVKRTReflectionsRough; the RT kernels read the same byte). Off: neither is touched.
#define DEFER_FLAG_RT_MARK (1u << 16)
// RT PRE-TRACE IN (#859; the uber kernel): splice uRtUber (pass 12's) into the environment term.
#define DEFER_FLAG_RT_IN (1u << 17)
// (#85 phase 2) PROJECTOR STOCHASTIC + DENOISED (RenderVKProjStochastic; split frames, set 3
// bindings 13-16): the ray-traced projectors' shadowed direct light comes from the diffuse /
// specular denoiser as a VISIBILITY RATIO (pass 15 sampled it; the ratio estimator): localLight
// evaluates their light exactly and multiplies its shadowed shares by the denoised ratios
// (deferPdnVis). Bit 19: the denoiser runs below the render extent (depth-aware
// upsample), bit 20: its final image is IN (binding 13; else OUT, binding 16), bits 21-23:
// the debug view (RenderVKDenoiseDebug, clean_pdn_common.glsl PDN_DBG_*; the combine only).
#define DEFER_FLAG_PSTOCH      (1u << 18)
#define DEFER_FLAG_PSTOCH_HALF (1u << 19)
#define DEFER_FLAG_PSTOCH_IN   (1u << 20)
#define DEFER_PSTOCH_DBG_SHIFT 21u
#if DEFER_LIT
#define CLEAN_LIGHT_STAGE
shared vec4 s_lightPos[TILE_LIGHT_WORDS * 32u];   // lights[i].pos_radius     (valid where s_tileMask has bit i)
shared vec4 s_lightCol[TILE_LIGHT_WORDS * 32u];   // lights[i].color_falloff  (ditto)
shared uint s_lightProj[TILE_LIGHT_WORDS];        // bit i: light i is a projector (proj_origin.w not < 0.5)
// Staged this dispatch (a pure push-constant test: uniform, so the walk's branches on it are
// too). The froxel walk's cells are per pixel -- no workgroup mask to stage -- so _FROXEL wins.
bool lightStaged()
{
    return (g_draw_push.flags & (DEFER_FLAG_LIGHT_STAGE | DEFER_FLAG_LIGHT_FROXEL)) == DEFER_FLAG_LIGHT_STAGE;
}
#endif

// DEBUG SPECIALIZATION (clean_draw_common.glsl kDebugViews, constant 1): the lighting
// pipeline is built with it FALSE (no RenderVKLitDebugMask switches); its true twin
