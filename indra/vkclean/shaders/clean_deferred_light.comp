// ---- RAY DENSITY (#859; see the header): the 8x8 workgroup = one 8 px tile, lane = y * 8 + x ----
#define RTR_NONE 0xFFFFFFFFu
shared uint s_rtd_rough[64];   // the lane's mark roughness (unorm16), RTR_NONE = not a candidate
// The sharp roughness (RenderVKRTReflectionsSharpRough) on the mark's unorm16 scale.
uint rtrSharp16() { return uint(clamp(uintBitsToFloat(rtt_param.y), 0.0, 1.0) * 65535.0 + 0.5); }
// The lane's 2 x 2 block: x = its smoothest candidate's roughness (RTR_NONE: none), y = its first
// candidate lane in scan order (64: none). (s_rtd_rough written, then a barrier.)
uvec2 rtrBlock(uint lid)
{
    const uint b = lid & ~9u;   // the block's top-left lane (x and y even)
    uint mn = RTR_NONE, first = 64u;
    [[unroll]] for (uint k = 0u; k < 4u; ++k)
    {
        const uint q = b + (k & 1u) + (k >> 1) * 8u;
        const uint r = s_rtd_rough[q];
        if (r != RTR_NONE)
        {
            mn = min(mn, r);
            if (first == 64u) first = q;
        }
    }
    return uvec2(mn, first);
}
// The lane's block traces every candidate at level L (level 0; level 1: a sharp block).
bool rtrBlockFull(uint L, uvec2 blk, uint sharp16) { return L == 0u || (L == 1u && blk.x < sharp16); }
// The lane casts a ray at level L: a candidate, and its block full or this its first candidate.
bool rtrRayAt(uint L, uint lid, uvec2 blk, uint sharp16)
{
    if (s_rtd_rough[lid] == RTR_NONE) return false;
    return rtrBlockFull(L, blk, sharp16) || blk.y == lid;
}
// DENSITY GRADIENT selection (see the header). The 16 x 16 ordered-dither (Bayer) rank of render
// pixel p, 0..255: the finest position bits in the HIGH rank bits, so rank < 256 / L^2 is exactly
// the lattice of multiples of L (L = 1, 2, 4, 8, 16) -- the top-left pixel of every aligned L x L
// cell, which is also that cell's lowest rank -- and any threshold spreads its pixels evenly.
uint rtrRank(uvec2 p)
{
    const uint x = p.x & 15u, y = p.y & 15u, v = x ^ y;
    return ((v & 1u) << 7) | ((y & 1u) << 6) | ((v & 2u) << 4) | ((y & 2u) << 3)
         | ((v & 4u) << 1) | (y & 4u) | ((v & 8u) >> 2) | ((y & 8u) >> 3);
}
shared uint s_rtg_rank[64];   // the lane's rank if a candidate, else 0xFFFF
shared uint s_rtg_min2[16];   // per aligned 2 x 2 cell of the tile: its lowest candidate rank
shared uint s_rtg_min4[4];    // per 4 x 4 cell
shared uint s_rtg_min8;       // the tile
// Every invocation of the 8x8 workgroup, uniform control flow (org: the tile's first pixel).
void rtrGradBuild(uint lid, uvec2 org, bool cand)
{
    s_rtg_rank[lid] = cand ? rtrRank(org + uvec2(lid & 7u, lid >> 3)) : 0xFFFFu;
    barrier();
    if (lid < 16u)
    {
        const uint b = (lid >> 2) * 16u + (lid & 3u) * 2u;   // the cell's top-left lane
        s_rtg_min2[lid] = min(min(s_rtg_rank[b], s_rtg_rank[b + 1u]), min(s_rtg_rank[b + 8u], s_rtg_rank[b + 9u]));
    }
    barrier();
    if (lid < 4u)
    {
        const uint c = (lid >> 1) * 8u + (lid & 1u) * 2u;    // the cell's top-left 2 x 2 cell
        s_rtg_min4[lid] = min(min(s_rtg_min2[c], s_rtg_min2[c + 1u]), min(s_rtg_min2[c + 4u], s_rtg_min2[c + 5u]));
    }
    barrier();
    if (lid == 0u) s_rtg_min8 = min(min(s_rtg_min4[0], s_rtg_min4[1]), min(s_rtg_min4[2], s_rtg_min4[3]));
    barrier();
}
// The candidate's EFFECTIVE rank (0xFFFF: not a candidate): its own, or -- for each aligned cell
// (2, 4, 8) whose lowest-ranked CANDIDATE it is -- that cell's top-left rank. A cell whose
// lattice pixel is no candidate (a surface edge, a thin feature) hands its ray to its best
// candidate instead: at density 1 / L^2 every aligned L x L cell holding a candidate casts exactly
// one ray (pixels are never dropped), the others none; between those steps the dither fills in.
uint rtrGradRank(uint lid, uvec2 org)
{
    const uint r = s_rtg_rank[lid];
    if (r == 0xFFFFu) return r;
    const uint x = lid & 7u, y = lid >> 3;
    uint er = r;
    if (s_rtg_min2[(y >> 1) * 4u + (x >> 1)] == r) er = min(er, rtrRank(org + uvec2(x & ~1u, y & ~1u)));
    if (s_rtg_min4[(y >> 2) * 2u + (x >> 2)] == r) er = min(er, rtrRank(org + uvec2(x & ~3u, y & ~3u)));
    if (s_rtg_min8 == r) er = min(er, rtrRank(org));
    return er;
}
// The candidate casts at density rho_eff: its effective rank below rho_eff x 256.
bool rtrGradRay(uint er, float rhoEff) { return er != 0xFFFFu && float(er) < rhoEff * 256.0; }
