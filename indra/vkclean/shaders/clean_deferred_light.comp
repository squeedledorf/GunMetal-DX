    vec3 sunlit = vec3(0.0), amblit = vec3(0.0), additive = vec3(0.0), atten = vec3(1.0);
    atmosLightTerms(P - camPos, s.N, sunlit, amblit, additive, atten);   // (lit: rank < 3)
    CLK_MARK(ATMOS);
    // A sharp representative (rank 2: the whole block is sharp) serves irradiance only.
    const bool specOk = best < 2u;
    const SurfaceRefl r = surfaceReflectionsW(s, P, V, amblit, false, SR_IRR | (specOk ? SR_SPEC : 0u));
    const uvec2 q = uvec2(clamp(gbOctEncode(s.Ng) * 0.5 + 0.5, vec2(0.0), vec2(1.0)) * 1023.0 + 0.5);
