        // cosine is its own direction's (c0, the one its target and pdf took), not the receiver's
        // P -> x_s direction: the ray leaves from the offset origin o, and a contact hit (a crease)
        // seen from P can face it far more than d did -- L x cos(P) / c0 was a crease firefly.
        const float cy = src == 0u ? c0 : max(dot(N, normalize(y.xs - P)), 0.0);
        S = y.L * (cy * (1.0 / 3.14159265)) * W;
        if (any(isnan(S)) || any(isinf(S))) S = vec3(0.0);
