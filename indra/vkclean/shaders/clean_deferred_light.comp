        const uint Rs = exactL ? 0u : (R + 3u) / 4u;
        const uint Kt = exactL ? min(gM, R) : R - Rs;
        float Wt = 0.0;
        for (uint k = 0u; k < Kt; ++k) Wt += s_gTopT[k];
        const float Wr = max(gW - Wt, 0.0);
        const bool rest = any_ && !exactL && Wr > 0.0;
        uint rng = regirHash(cell ^ regirHash(rg.cfg.w + 2u * 0x9E3779B9u));
        const float xi = regirU01(rng);
