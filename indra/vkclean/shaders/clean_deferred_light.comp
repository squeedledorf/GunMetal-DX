    const uint lv = regirLevels() - 1u;
    const vec4 go = rg.origin[min(lv, REGIR_LEVELS_MAX - 1u)];
    const vec3 glo = go.xyz, ghi = go.xyz + vec3(float(REGIR_DIM_X), float(REGIR_DIM_Y), float(REGIR_DIM_Z)) * go.w;
    const bool clOn = emClusterOn();
    const bool statOn = (rg.rs_em_cfg.z & EM_F_GATHER) == 0u;   // (CC_HDR's per-build words: zeroed with the lists)
    const bool skipOn = statOn && (rg.rs_em_cfg.z & EM_F_SKIPSTAT) != 0u;   // (#1009 SKIP DIAGNOSTIC)
    [[dont_unroll]] for (uint id = lin; id < nInst; id += stride)
    {
