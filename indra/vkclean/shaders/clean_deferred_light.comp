                if ((c.x + 64) % L == 0 && (c.y + 64) % L == 0 && c.x >= -L && c.x <= 2 * L && c.y >= -L && c.y <= 2 * L) continue;
            }
            vec4 rt; float g;
            if (!rtrTap(px + o, px, P, Ng, vz, rt, g)) continue;
            const float wb = g * exp(-float(o.x * o.x + o.y * o.y) / (2.0 * sB * sB)) * rtrHitDistW(rt.a, tMean);
