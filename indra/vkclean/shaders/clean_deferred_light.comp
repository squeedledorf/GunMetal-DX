            // a wall, or one a door / avatar now blocks, must not light this pixel) -- blocked: the
            // fresh sample alone stands. A pick a changed light reaches takes the RE-SHADE ray of the
            // loop's second pass instead (it is the visibility ray too).
            const vec3 v = y.xs - o;
            const float dl = length(v);
            const vec3 dv = v / max(dl, 1e-6);
            if (yChg == 2u && y.dist > 0.0)
            {
                rsWant = true;
                rsDir = dv;
                rsDl = dl;
                rsTol = max(0.02, 0.02 * dl);
            }
            else
            {
                if (yChg == 1u) ++chgSkip;   // (#980: kept as stored -- the change is insignificant there)
                const float tm = y.dist > 0.0 ? max(dl - max(0.01, dl * 1e-3), 0.0) : max(g_draw_push.rtr.x, 1.0);
                visOk = (tm > 0.0 ? traceShadowRay(o, dv, 0.0, tm, RT_MASK_SHADOW & ~RT_MASK_BLEND) : 1.0) > 0.5;
