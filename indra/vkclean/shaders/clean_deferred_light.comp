            // LOBE FILTER: + its specular-AA neighbourhood (sAA, direction-weighted) -- a normal-
            // mapped or curved mirror is otherwise one point sample per pixel, which the jitter
            // turns into shimmer
            const float ws = ownOk ? (d2 == 0.0 ? 1.0 : (sAA > 0.05 ? g * exp(-d2 / (2.0 * sAA * sAA)) : 0.0))
