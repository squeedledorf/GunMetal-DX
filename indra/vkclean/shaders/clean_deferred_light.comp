// ---- (#87) THE GI TRACE (clean_gi_common.glsl): one GI texel per invocation ----
// push (VKRtReflPush, LLCleanRendererVK::recordGI): rtr.x the ray length (m), rtr.y the RT hit
// options (rtrOpts: the hit's projector shadow-ray budget, the light grid), rtr.w the sampler
// anisotropy; rtr2.xy the GI extent, z the frame index, w the GI denoiser's GEOM parity.
float giViewZ(ivec2 q)
{
    q = clamp(q, ivec2(0), ivec2(int(g_draw_push.width), int(g_draw_push.height)) - 1);
    const float d = texelFetch(uDepthG, q, 0).r;
    if (!(d > 0.0)) return -1.0;
    const vec2 ndc = (vec2(q) + 0.5) / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, d, 1.0);
    return dot(pc.u_cam_time.xyz + h.xyz / h.w - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
}
float giGrad(ivec2 rp, ivec2 o, float vz)
{
    const float zp = giViewZ(rp + o), zn = giViewZ(rp - o);
    const float a = zp > 0.0 ? zp - vz : 1e30, b = zn > 0.0 ? vz - zn : 1e30;
    const float g = abs(a) <= abs(b) ? a : b;
    return abs(g) < 1e29 ? clamp(g, -0.5 * vz, 0.5 * vz) : 0.0;
}
vec2 giPrevDelta(vec3 X, ivec2 m, vec2 D, out float pw)
{
    const vec4 c = ssr.taa_prev_vp * vec4(X - ssr.cam_origin.xyz, 1.0);
    pw = 0.0;
    if (!(c.w > 1e-4)) return vec2(0.0);
    pw = c.w;
    const vec2 puv = c.xy / c.w * 0.5 + 0.5;
    return clamp(puv * D - 0.5 - vec2(m), vec2(-30000.0), vec2(30000.0));
}
float giRand(inout uint s) { s = giPcg(s); return float(s >> 8u) * (1.0 / 16777216.0); }
// Cosine-weighted direction around N (pdf cos / pi).
vec3 giCosDir(vec3 N, vec2 u)
{
    const vec3 t = normalize(abs(N.z) < 0.999 ? cross(N, vec3(0.0, 0.0, 1.0)) : cross(N, vec3(1.0, 0.0, 0.0)));
    const vec3 b = cross(N, t);
    const float r = sqrt(u.x), phi = 6.2831853 * u.y;
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + N * sqrt(max(1.0 - u.x, 0.0)));
}
// One GI path vertex: the closest hit along d from o (every class but alpha-blend), shaded as the RT
// reflections shade theirs, seen from the receiver P; a miss takes the sky. xs / ns: the vertex and
// its geometric normal toward the ray (a sky sample: P + d x GI_FAR, -d).
#define GI_FAR 1.0e4
bool g_gi_back = false;   // (GI_F_BACK_STOP) the last giTrace stopped at a single-sided back face
vec3 giTrace(vec3 o, vec3 d, float tmax, vec3 P, out vec3 xs, out vec3 ns, out bool hit, out float hdist)
{
    rt_anim_time = pc.u_cam_time.w;
    // (GI_F_CULL_BACK: single-sided back faces culled in traversal -- the shader's own rule
    //  (rtrClosest skips them) without the candidate / re-trace; the reflections' HWCull convention)
    uint rfl = gl_RayFlagsNoneEXT;
    // (GI_F_BACK_STOP) the walk must SEE back faces to stop at them: no hardware culling then
    const bool backStop = (gi.cfg.x & GI_F_BACK_STOP) != 0u;
    if ((gi.cfg.x & GI_F_CULL_BACK) != 0u && !backStop)
        rfl = ((uint(ssr.foliage_rt.x + 0.5) & 4u) != 0u) ? gl_RayFlagsCullFrontFacingTrianglesEXT
                                                          : gl_RayFlagsCullBackFacingTrianglesEXT;
    g_rc_back_stop = backStop;
    const RtHit h = rtrClosest(o, d, 0.0, tmax, RT_MASK_ALL & ~RT_MASK_BLEND, RT_BLEND_CUTOFF, rfl);
    g_rc_back_stop = false;
    g_gi_back = g_rc_back;
    rt_mask_width0 = -1.0; rt_mask_lod_bias = 0.0; rt_mask_lod_max = 64.0; rt_mask_cov_k = 0.0;
    hit = h.hit;
    hdist = h.hit ? h.dist : 0.0;
    if (h.hit && g_gi_back)
    {
        // a single-sided BACK face first: the ray started inside geometry / slipped into a seam --
        // the surface's dark inside (no light), an occluder for the sky visibility; never shaded
        // (its "lit" side faces away from the receiver)
        xs = o + d * h.dist;
        ns = -d;
        return vec3(0.0);
    }
    if (!h.hit)
    {
        xs = P + d * GI_FAR;
        ns = -d;
        vec3 sky = skyColor(d);
        if ((gi.cfg.x & GI_F_MISS_PROBES) != 0u)
        {
            // the far field: the probes along d (what lies past the ray length -- a far building, the
            // terrain beyond -- as the probes captured it; the sky where none covers P)
            vec3 pr, pr2, pirr;
            if (sampleProbesEx(P, d, d, 0.5 * phdr.info.y, 0.0, sky, true, false, false, pr, pr2, pirr)) sky = pr;
        }
        return (any(isnan(sky)) || any(isinf(sky))) ? vec3(0.0) : max(sky, vec3(0.0));
    }
    RtSurface hs = rtSurfaceEval(h, d);
    rtWeatherHit(hs);   // #970: the weather coat at the GI hit (the lying-snow march is the reflections' only)
    // (#91) THE GI SPLIT (clean_regir.glsl EMISSIVE LIGHTS): an emitter ReSTIR DI samples this frame
    // (in the emitter hash: its triangle block was written) lights the receiver through DI -- its emission
    // is not GI's (no double light). Its reflected light stays; an emitter the caps dropped keeps its
    // emission here.
    if (rsFrameOn() && (rg.rs_em_cfg.z & EM_F_GI_SPLIT) != 0u && emLitOn() && emHashFind(h.instance) != REGIR_EM_NONE)
    {
        hs.emissive = vec3(0.0);
        if (hs.model == RT_SURF_FULLBRIGHT) hs.fb = vec3(0.0);
    }
    vec3 c = rtShadeHit(hs, P, 0u, pc.u_cam_time.w).rgb;
    if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
    xs = hs.P;
    ns = dot(hs.Ng, d) > 0.0 ? -hs.Ng : hs.Ng;
    c = clamp(c, vec3(0.0), vec3(LG_MAX_VALUE));
    // FIREFLY CLAMP AT THE SOURCE (RenderVKGIFireflyClamp): a GI ray that hits a small bright
    // emitter (a lamp's lantern glass -- fullbright / emissive -- or a surface right at a light)
    // returns a huge radiance from a tiny solid angle; the reservoirs then PREFER it (p ~ its
    // luminance), carry it for up to the M cap and spread it to neighbours: the blobs that fade in
    // and out around lamp posts. Clamped here, before the reservoirs see it (the sharp direct light
    // of such emitters is the DI / #91 path's job, not a diffuse bounce's).
    const float clampL = gi.prm2.w;
    if (clampL > 0.0)
    {
        const float l = giLum(c);
        if (l > clampL) c *= clampL / l;
    }
    return c;
}
#if defined(CLEAN_GI_RESOLVE)
// ---- (GI-4) THE RADIANCE CACHE'S RESOLVE (kWorldDeferGiResolveSpv; after the GI trace): one slot
//      per invocation -- this frame's accumulation into the cell's mean (an exponential window of
//      up to prm3.z frames), the accumulator cleared, the age; a cell untouched for prm3.w frames is
//      freed (GI_KEY_TOMB: lookups walk past it), one inside a change sphere restarts (its samples
//      dropped: geometry moved there -- never the camera). ----
void DEFER_MAIN()
{
    const uint cap = giCacheSlots();
    const uint s = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationIndex;
    uint live = 0u, evicted = 0u, inval = 0u;
    if (s < cap)
    {
        const uvec4 c0 = gi_data[2u * s];
        if (c0.x != 0u && c0.x != GI_KEY_TOMB)
        {
            const uint a = 2u * cap + s;
            const uvec4 acc = gi_data[a];
            uvec4 c1 = gi_data[2u * s + 1u];
            uint n = c0.y & 0xFFFFu, age = c0.y >> 16u;
            vec3 E = vec3(unpackHalf2x16(c1.y), unpackHalf2x16(c1.z).x);
            // change spheres (the host's, this frame)
            const vec3 cc = vec3(uintBitsToFloat(c0.z), uintBitsToFloat(c0.w), uintBitsToFloat(c1.x));
            const float edge = uintBitsToFloat(c1.w);
            bool hitSph = false;
            for (uint i = 0u; i < min(gi.sph_n.x, GI_SPHERES_MAX); ++i)
            {
                const vec4 sp = gi.sph[i];
                const vec3 dd = cc - sp.xyz;
                const float rr = sp.w + 0.87 * edge;
                if (dot(dd, dd) < rr * rr) { hitSph = true; break; }
            }
            if (hitSph) { n = 0u; E = vec3(0.0); ++inval; }
            if (acc.w > 0u)
            {
                const vec3 mean = vec3(acc.xyz) / (GI_ACC_SCALE * float(acc.w));
                n = min(n + 1u, max(uint(gi.prm3.z + 0.5), 1u));
                E = mix(E, mean, 1.0 / float(n));
                age = 0u;
                gi_data[a] = uvec4(0u);
            }
            else age = min(age + 1u, 0xFFFFu);
            if (float(age) > gi.prm3.w)
            {
                gi_data[2u * s] = uvec4(GI_KEY_TOMB, 0u, 0u, 0u);
                ++evicted;
            }
            else
            {
                gi_data[2u * s].y = n | (age << 16u);
                c1.y = packHalf2x16(E.rg);
                c1.z = packHalf2x16(vec2(E.b, 0.0));
                gi_data[2u * s + 1u] = c1;
                ++live;
            }
        }
    }
    if ((gi.cfg.x & GI_F_STATS) == 0u) return;   // (a header word: uniform)
    const uint sl = subgroupAdd(live), se = subgroupAdd(evicted), si = subgroupAdd(inval);
    if (subgroupElect())
    {
        if (sl != 0u) atomicAdd(gi.stat4.x, sl);
        if (se != 0u) atomicAdd(gi.stat4.y, se);
        if (si != 0u) atomicAdd(gi.stat4.z, si);
    }
}
