    const float rB = (specSharp || tMean <= 0.0) ? 0.0 : clamp(alpha * tMean / max(pa * (camd + tMean), 1e-6), 0.0, 10.0);
    // LOBE FILTER: the specular-AA spread widens the 3 x 3 (sAA: a full 3 x 3 at the cap; flat,
    // un-mapped receivers -- aa 0 -- keep the old spreads); the direction weight's lobe (set above)
    // is sigma^2 = 4 (alpha^2 + alpha_AA^2) + (3 deg)^2: a mirror's reflection turns twice its normal.
    const float sAA = lobe ? 1.2 * sqrt(aa / 0.18) : 0.0;
    const float sB = max(max(max(rB * 0.6, 0.6), sL), sAA);
    const float sS = max(max(0.6, sL), sAA);   // (the sharp filter's spread without an own ray)
    // Sums: hits' radiance, misses' weight (they take the env), total -- glossy (B) and sharp (S).
    vec3 hB = vec3(0.0), hS = vec3(0.0);
    vec3 qB = vec3(0.0);   // (TEMPORAL: the glossy sum's hit radiance second moment -- the history clamp)
    float mB = 0.0, wB = 0.0, mS = 0.0, wS = 0.0;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx)
        {
            vec4 rt; float g;
            if (!rtrTap(px + ivec2(dx, dy), px, P, Ng, vz, rt, g)) continue;
            const float d2 = float(dx * dx + dy * dy);
            const bool hit = rt.a > 0.0;
            const float wb = g * exp(-d2 / (2.0 * sB * sB)) * rtrHitDistW(rt.a, tMean);
            if (hit) { hB += wb * rt.rgb; qB += wb * rt.rgb * rt.rgb; } else mB += wb;
            wB += wb;
