#if CLEAN_DEFER_PASS == 16
// ---- RT RAY SELECT (#859 perf; RenderVKRTReflectionsRayList): one 8x8 workgroup per listed tile ----
// The in-tile trace's selection (rtrSelectTile), then the tile's rays appended to the RAY LIST
// (contiguous per tile: the list trace's warps cover neighbouring tiles) instead of traced here.
shared uint s_rtl_base;   // the tile's first ray list slot
shared uint s_rtl_acc;    // ... its rays the list took (the rest past the capacity: dropped, -1)
void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
    const uint tilesX = (g_draw_push.width + 7u) / 8u;
    const uint entry = rttEntry();
    if (entry == 0xFFFFFFFFu) return;   // (the last row's tail: the whole workgroup)
    const uint tile = rtt_words[rtt_args[3] + entry];
    const uvec2 org = uvec2(tile % tilesX, tile / tilesX) * 8u;
    uvec4 m;
    float gs;
    const uint n = rtrSelectTile(lid, entry, org, m, gs);
    const uint rb = 2u * rtt_args[3] + 1u;   // (RAY LIST: count, args x / y / z, capacity; entries at rb + 7)
    if (lid == 0u)
    {
        uint base = 0u, acc = 0u;
        if (n != 0u)
        {
            const uint cap = rtt_words[rb + 4u];
            base = atomicAdd(rtt_words[rb], n);
            acc = base < cap ? min(n, cap - base) : 0u;
            if (acc != 0u)
            {
                // the list trace's dispatch: 64 rays per workgroup, 65535-wide rows (both monotone in
                // the list's end: the largest append's maxima stand)
                const uint groups = (base + acc + 63u) / 64u;
                atomicMax(rtt_words[rb + 1u], min(groups, RTT_ROW));
                atomicMax(rtt_words[rb + 2u], (groups + RTT_ROW - 1u) / RTT_ROW);
                atomicAdd(rtt_cast, acc);
            }
            if (acc < n) atomicAdd(rtt_ovf, n - acc);
        }
        s_rtl_base = base;
        s_rtl_acc = acc;
    }
    barrier();
    if (lid >= n) return;
    const uint slot = s_rtr_slot[lid];
    const uint q = slot & 63u;
    const uvec2 px = org + uvec2(q & 7u, q >> 3);
    if (lid < s_rtl_acc)
        rtt_words[rb + 7u + s_rtl_base + lid] = px.x | (px.y << 15) | ((slot & 256u) != 0u ? 0x80000000u : 0u);
    else
        imageStore(uRtTrace, ivec2(px), vec4(0.0, 0.0, 0.0, -1.0));   // (dropped: not traced)
}
