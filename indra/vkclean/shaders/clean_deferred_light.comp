        const float ls = giLum(S);
        const float sum = subgroupAdd(noInfo ? 0.0 : ls);
        const float cnt = subgroupAdd(noInfo ? 0.0 : 1.0);
        const float meanO = cnt > 1.0 ? (sum - (noInfo ? 0.0 : ls)) / (cnt - (noInfo ? 0.0 : 1.0)) : ls;
        vec3 c = vec3(clamp(ls, 0.0, 1.0) * 0.25);
        if (!noInfo && ls > 4.0 * meanO && ls > 1e-3)
        {
            if (src == 1u)       c = chgRej != 0u ? vec3(0.0, 1.0, 1.0) : vec3(0.0, 1.0, 0.0);
            else if (src == 2u)  c = chgRej != 0u ? vec3(0.0, 1.0, 1.0) : vec3(0.0, 0.3, 1.0);
            else if (!hit)       c = vec3(1.0, 0.0, 0.0);
            else if (dot(N, d) < 0.2) c = vec3(1.0, 0.5, 0.0);
            else if (reuseTried && keptT == 0u && keptS == 0u) c = vec3(1.0);   // (a disocclusion: no candidate)
            else                 c = vec3(1.0, 1.0, 0.0);
        }
        else if (freshBack) c = vec3(0.3, 0.0, 0.3);   // (not a sparkle: a caught leak is dark; dim so the outliers stand out)
        l0.rgb = c;
    }
    imageStore(uGiIn, ivec3(m, 0), l0);
    // layer 1 (the denoiser's "specular" signal, rough 1: a full-length history and every a-trous
    // iteration): the SKY VISIBILITY -- did this frame's FRESH cosine-weighted ray escape (the
    // reservoir's pick is radiance-weighted, not cosine: never used here). The consumers occlude
    // the probe / SSR / env specular with it (RenderVKGISpecOcclusion): a sealed room reflects no sky.
    imageStore(uGiIn, ivec3(m, 1), traced ? vec4(vec3(hit ? 0.0 : 1.0), 0.0) : vec4(1.0, 1.0, 1.0, -1.0));
    // ---- guides (the denoiser's: clean_pdn_common.glsl; grad: above) ----
    imageStore(uGiGeom, ivec3(m, par), uvec4(floatBitsToUint(vz), pdnPackNR(N, 1.0), packHalf2x16(grad),
                                            pdnPackMeta(0.0, 0.0, 0u, 1.0)));
    float pw;
    const vec2 dS = giPrevDelta(P, m, vec2(D), pw);
    // (w: the changed lights' share x 255 -- clean_dn_temporal.comp's moving-light history cap, read
    //  only when the host gives the GI denoiser a move history: RenderVKGILightChangeHistory)
    imageStore(uGiMot, m, uvec4(packHalf2x16(dS), packHalf2x16(dS), floatBitsToUint(pw),
                                uint(chgShare * 255.0 + 0.5)));
    // ---- stats (one atomic per subgroup; only while the host reads them: GI_F_STATS) ----
    if ((gf & GI_F_STATS) != 0u)   // (a header word: uniform)
    {
        const uint sR = subgroupAdd(traced ? 1u : 0u);
        const uint sH = subgroupAdd(hit ? 1u : 0u);
        const uint sD = subgroupAdd(hit ? uint(min(hdist, 1000.0) * 10.0) : 0u);
        const uint sT = subgroupAdd(keptT), sS = subgroupAdd(keptS), sV = subgroupAdd(visRej);
        const uint sM = subgroupAdd(uint(Mout * 4.0 + 0.5));
        if (subgroupElect())
        {
            atomicAdd(gi.stat.x, sR);
            atomicAdd(gi.stat.y, sH);
            atomicAdd(gi.stat.z, sR - sH);
            atomicAdd(gi.stat.w, sD);
            if (sT != 0u) atomicAdd(gi.stat2.x, sT);
            if (sS != 0u) atomicAdd(gi.stat2.y, sS);
            if (sV != 0u) atomicAdd(gi.stat2.z, sV);
            atomicAdd(gi.stat2.w, sM);
        }
        const uint sL = subgroupAdd(g_gi_lookups), sF = subgroupAdd(g_gi_found);
        const uint sI = subgroupAdd(cInserts), sX = subgroupAdd(cFull);
        if (subgroupElect() && (sL | sI | sX) != 0u)
        {
            atomicAdd(gi.stat3.x, sL);
            atomicAdd(gi.stat3.y, sF);
            atomicAdd(gi.stat3.z, sI);
            atomicAdd(gi.stat3.w, sX);
        }
        const uint sC = subgroupAdd(chgRej), sK = subgroupAdd(chgSkip);
        if (subgroupElect() && sC != 0u) atomicAdd(gi.stat4.w, sC);
        if (subgroupElect() && sK != 0u) atomicAdd(gi.sph_n.z, sK);
    }
}
#endif   // CLEAN_GI_RESOLVE
#elif CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 16
// ---- RT TRACE (#859; see HYBRID RT REFLECTIONS in the header) ----
// Pass 11: one 8x8 workgroup per listed tile selects its rays and traces them in place, or
// (-DCLEAN_RT_LIST, RenderVKRTReflectionsRayList) one lane per ray of the RAY LIST that pass 16
// (RT RAY SELECT, one 8x8 workgroup per listed tile: the same selection, no trace) appended --
// the trace's warps full instead of a few rays per 64-lane tile workgroup. Same rays, same
// per-ray code (rtrTraceRay), same outputs.
// This frame's RAY DENSITY level, from the header alone (every workgroup computes the same): the
// lowest level at or above the floor whose rays fit the budget ("tight"), but no denser than the
// lowest one fitting 80 % of it ("loose") -- last frame's level stays while it lies between them.
uint rtrLevel()
{
    const uint floorL = min(rtt_param.w & 0xFFu, RTR_LEVELS - 1u);
    const uint par = (rtt_param.w >> 8) & 1u;
    const float budget = float(rtt_param.z);
    uint tight = RTR_LEVELS - 1u, loose = RTR_LEVELS - 1u;
    for (uint L = RTR_LEVELS - 1u; L > floorL; )   // (rays fall with the level: scan down)
    {
        --L;
        const float n = float(rtt_rays[L]);
        if (n <= budget) tight = L;
        if (n <= 0.8 * budget) loose = L;
    }
    return clamp(min(rtt_level[par ^ 1u], RTR_LEVELS - 1u), tight, loose);
}
// DENSITY GRADIENT: this frame's budget scale, from the header alone (every workgroup computes
// the same): the mark passes' rays at scale 1 (rtt_grays) against the budget, with the level
// path's deadband -- last frame's scale stays while it lies between the one fitting the budget
// ("tight") and the one fitting 80 % of it ("loose"). Never below RTR_GRAD_SCALE_MIN.
float rtrGradScale()
{
    const float n = float(rtt_grays);
    const float budget = rtt_param.z == 0xFFFFFFFFu ? 3.0e38 : float(rtt_param.z);
    const float tight = n > budget ? budget / n : 1.0;
    const float loose = n > 0.8 * budget ? 0.8 * budget / n : 1.0;
    float last = uintBitsToFloat(rtt_scale[((rtt_param.w >> 8) & 1u) ^ 1u]);
    if (!(last > 0.0 && last <= 1.0)) last = 1.0;
    return clamp(clamp(last, loose, tight), RTR_GRAD_SCALE_MIN, 1.0);
}
shared uint s_rtr_slot[64];   // the tile's rays, packed: the lane of the ray's pixel | 256 = a block's one ray
shared uint s_rtr_n;          // rays in the tile
#if CLEAN_DEFER_PASS == 16 || !defined(CLEAN_RT_LIST)
// RAY SELECTION of a listed tile (every invocation of the 8x8 workgroup, uniform control flow; org:
// the tile's first pixel): the lane's mark (m), the frame's gradient budget scale (gs), s_rtr_slot /
// s_rtr_n filled (after a barrier), the non-ray pixels' trace -1, the deadband words (entry 0).
// Returns the tile's ray count (shared: uniform).
uint rtrSelectTile(uint lid, uint entry, uvec2 org, out uvec4 m, out float gs)
{
    const ivec2 px = ivec2(org + gl_LocalInvocationID.xy);
    const bool inside = px.x < int(g_draw_push.width) && px.y < int(g_draw_push.height);
    m = uvec4(0u);
    if (inside) m = imageLoad(uReflRtMark, px);
    s_rtd_rough[lid] = m.z != 0u ? rtrMarkRough16(m.w) : RTR_NONE;
    if (lid == 0u) s_rtr_n = 0u;
    const uint level = rtrLevel();
    const bool grad = rtrGradOn();   // (a header word: uniform)
    barrier();
    // RAY DENSITY: this lane's pixel casts a ray (it takes a slot), or the resolve skips it (-1).
    // Slots in atomic order: each ray writes only its own pixel, so the order changes no output.
    // DENSITY GRADIENT: the candidate casts if its effective dither rank is below its density x the
    // frame's budget scale (rtrGradRay); else the level path's 2 x 2 blocks.
    bool ray;
    uint slotBits = 0u;
    gs = 1.0;
    if (grad)
    {
        rtrGradBuild(lid, org, m.z != 0u);
        gs = rtrGradScale();
        ray = m.z != 0u && rtrGradRay(rtrGradRank(lid, org), rtrRhoEff(rtrRho(m.w), gs));
    }
    else
    {
        const uvec2 blk = rtrBlock(lid);
        const uint sharp16 = rtrSharp16();
        ray = rtrRayAt(level, lid, blk, sharp16);
        slotBits = rtrBlockFull(level, blk, sharp16) ? 0u : 256u;
    }
    if (ray)
        s_rtr_slot[atomicAdd(s_rtr_n, 1u)] = lid | slotBits;
    else if (inside)
        imageStore(uRtTrace, px, vec4(0.0, 0.0, 0.0, -1.0));   // (not traced this frame)
    barrier();
    if (lid == 0u && entry == 0u)
    {
        rtt_level[(rtt_param.w >> 8) & 1u] = level;                // (the deadband's memory)
        rtt_scale[(rtt_param.w >> 8) & 1u] = floatBitsToUint(gs);  // (the gradient's; pass 13 + the list trace read it)
        rtt_tiles = rtt_words[2u * rtt_args[3]];                   // (the stats: tiles listed this frame)
    }
    return s_rtr_n;
}
#endif
#if CLEAN_DEFER_PASS == 11
