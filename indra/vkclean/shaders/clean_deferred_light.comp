//          its 64-cell box in shared memory, each lane walks the survivors): walk 1 the count M, the target
//          sum W and the R_e strongest, walk 2 (only where M > R_e) the stratified samples and the
//          aggregate of the rest -- except the LONG CELLS:
//   mode 9 LONG CELLS: one workgroup per cell with more than EM_LONG_LIST candidates (mode 11's list),
//          its pairs split over the lanes. ----
shared uint s_emList[64];
shared vec4 s_emCr[64], s_emPl[64], s_emLa[64];
shared vec4 s_emV0[64], s_emE1[64], s_emE2[64], s_emCol[64];   // (walk 2: the rest's aggregate)
shared uint s_emN;
shared uint s_entList[64];   // (the cell build: the record groups near the workgroup)
shared uint s_entN;
shared uint s_emScan[64];
shared uint s_emNeed;
shared uint s_emGLo[3], s_emGHi[3];
// (#91 LIGHT TAKEOVER, clean_regir.glsl) Instance id's row in the takeover table (REGIR_EM_NONE: none);
// li its point light. The rows are sorted by instance: a binary search (only for qualifying emitters).
uint emTakeFind(uint id, out uint li)
{
    li = 0u;
    const uint n = min(rg.rs_em_take_cfg.x, REGIR_EM_TAKE_N);
    uint lo = 0u, hi = n;
    while (lo < hi)
    {
        const uint mid = (lo + hi) >> 1u;
        if (rg_cells[REGIR_EM_TAKE_BASE + 256u + mid].x < id) lo = mid + 1u; else hi = mid;
    }
    if (lo >= n) return REGIR_EM_NONE;
    const uvec2 r = rg_cells[REGIR_EM_TAKE_BASE + 256u + lo];
    if (r.x != id) return REGIR_EM_NONE;
    li = r.y >> 16u;
    return r.y & 0xFFFFu;
}
// The takeover's light test (mode 0): light li of this frame is a POINT light with a finite radius and a
// colour, wholly inside the grid's outermost level [glo, ghi] (every receiver it reaches has a cell, where
// the lit kernels add the emitters' light).
bool emTakeLightOk(uint li, vec3 glo, vec3 ghi)
{
    if (li >= min(uint(linfo.cam_pos.w), 256u)) return false;
    if (lights[li].proj_origin.w >= 0.5) return false;
    const vec4 pr = lights[li].pos_radius;
    const vec4 cf = lights[li].color_falloff;
    if (!(pr.w > 0.0) || !(pr.w < 1e4) || any(isnan(pr.xyz)) || any(isinf(pr.xyz))) return false;
    if (!(pdnLum(max(cf.rgb, vec3(0.0))) > 0.0) || any(isinf(cf)) || any(isnan(cf))) return false;
    return all(greaterThanEqual(pr.xyz - pr.w, glo)) && all(lessThanEqual(pr.xyz + pr.w, ghi));
}
// (#986 RECORD REUSE, clean_regir.glsl) One word into a content signature (two independent 32-bit
// hashes: FNV-1a and a PCG step).
void emSig(inout uvec2 h, uint w)
{
    h.x = (h.x ^ w) * 16777619u;
    h.y = regirHash(h.y ^ (w + 0x9E3779B9u));
}
void emSigV(inout uvec2 h, vec4 v)
{
    const uvec4 u = floatBitsToUint(v);
    emSig(h, u.x); emSig(h, u.y); emSig(h, u.z); emSig(h, u.w);
}
// (#1009) Triangle prim of instance id's emitter geometry row eg (clean_rt_common.glsl rtGeomEmRow: a legacy
// static's rt_geom row, or a CLUSTER STATIC's legacy row): its slot-local vertex indices (vertex vb + i, vb
// = eg.y) -- rtTriIndices' legacy rule on an explicit row, GUARDED the same way (the triangle count, the
// IBO's length; the vertex count where the row is the instance's own -- a cluster static's legacy slot has
// none recorded: rtVW still bounds every vertex read by the VBO). A failing triangle: (0, 0, 0).
uvec3 emTriIndices(uint id, uvec4 eg, uint prim)
{
    const uint cnt = eg.w & 0x7FFFFFFFu;
    if (cnt == 0u || prim >= cnt / 3u) return uvec3(0u);
    const uint b = eg.x + prim * 3u;
    const uint ilen = uint(rt_ibo.length()) * 2u;   // 16-bit indices
    if (!(b < ilen && ilen - b >= 3u)) return uvec3(0u);
    const uvec3 t = uvec3(QV_INDEX16(rt_ibo, b), QV_INDEX16(rt_ibo, b + 1u), QV_INDEX16(rt_ibo, b + 2u));
    const uint vc = (rt_geom[id].z & RT_GEOM_CLUSTER) != 0u ? 0u : rtGeomVc(id);
    if (vc != 0u && max(max(t.x, t.y), t.z) >= vc) return uvec3(0u);
    return t;
}
// ... and its object-space positions
void emTriPositions(uint id, uvec4 eg, uint prim, out vec3 p0, out vec3 p1, out vec3 p2)
{
    const uvec3 t = emTriIndices(id, eg, prim);
    const QvHeader qh = rtHdr(eg.y);
    p0 = rtVertPos(qh, eg.y + t.x); p1 = rtVertPos(qh, eg.y + t.y); p2 = rtVertPos(qh, eg.y + t.z);
}
// The world area of static triangle prim of instance id (object-space positions x the model matrix);
// its object-space positions go into the signature h.
float emTriArea(uint id, uvec4 eg, uint prim, mat3 M, inout uvec2 h)
{
    vec3 p0, p1, p2;
    emTriPositions(id, eg, prim, p0, p1, p2);
    emSigV(h, vec4(p0, p1.x));
    emSigV(h, vec4(p1.yz, p2.xy));
    emSig(h, floatBitsToUint(p2.z));
    const float a = 0.5 * length(cross(M * (p1 - p0), M * (p2 - p0)));
    return (a < 1e8) ? a : 0.0;   // (NaN / inf: 0)
}
// (#1006 INCREMENTAL CELLS, clean_regir.glsl) the side words: an entry's (reach range, geometry key), a
// record's (reach range, pair key), the forward map's entry of last build's slot os, the cache header
uint emEntXWord(uint par, uint e) { return REGIR_EM_ENTX_BASE + par * REGIR_EM_INST_CAP + e; }
uint emRecXWord(uint par, uint slot) { return REGIR_EM_RECX_BASE + par * REGIR_EM_CAP + slot; }
uint emFwdGet(uint os)
{
    if (os >= REGIR_EM_CAP) return REGIR_EM_NONE;
    const uvec2 w = rg_cells[REGIR_EM_FWD_BASE + (os >> 1u)];
    return (os & 1u) != 0u ? w.y : w.x;
}
void emFwdPut(uint os, uint slot)
{
    if ((os & 1u) != 0u) rg_cells[REGIR_EM_FWD_BASE + (os >> 1u)].y = slot;
    else                 rg_cells[REGIR_EM_FWD_BASE + (os >> 1u)].x = slot;
}
uint emCcHdr(uint k) { return REGIR_EM_CC_HDR + k; }
uint emStamp() { return rg_cells[REGIR_EM_CC_HDR].x; }
// The last build's origin of level l (CC_HDR [1 + 2l], [2 + 2l])
vec4 emCcOrigin(uint l)
{
    return vec4(uintBitsToFloat(rg_cells[emCcHdr(1u + 2u * l)]), uintBitsToFloat(rg_cells[emCcHdr(2u + 2u * l)]));
}
// The instance's emission as the build takes it (mode 0; #1009: also the skip diagnostic) -- PBR: the
// emissive factor x its texture (the average: the smallest mip) x the PBR gain (RenderVKReSTIREmissive-
// PbrScale; a takeover's gain normalizes it out again); legacy: FULLBRIGHT + GLOW (SL's de-facto emissive;
// glow alone or fullbright alone never emits) -- its colour x tint x its texture x glow. Returns the
// average radiance luminance (0: none, or a NaN / inf factor).
float emMatEmission(uint id, uint fl, uint mi, out vec3 F, out vec3 Lavg, out uint tex, out uint ef)
{
    const float legacyScale = rg.rs_em_params.y;
    const float pbrScale = max(rg.rs_em_params.z, 0.0);
    const uint mf = rt_materials[mi].flags;
    const float glow = float((mf >> 8u) & 0xFFu) * (1.0 / 255.0);
    F = vec3(0.0); Lavg = vec3(0.0);
    tex = EM_NO_TEX; ef = 0u;
    if ((mf & 64u) != 0u)
    {
        F = rt_materials[mi].emissive_factor.rgb * pbrScale;
        ef = EM_R_PBR;
        Lavg = F;
        if ((mf & 8u) != 0u && any(greaterThan(F, vec3(0.0))))
        {
            tex = rt_materials[mi].emissive_handle.x;
            Lavg *= textureLod(uTextures[nonuniformEXT(tex)], vec2(0.5), 16.0).rgb;
        }
    }
    else if ((fl & 4096u) != 0u && glow > 0.0 && legacyScale > 0.0)
    {
        F = rt_materials[mi].base_color_factor.rgb * rt_instances[id].tint.rgb * (glow * legacyScale);
        Lavg = F;
        if ((mf & 1u) != 0u)
        {
            tex = rt_materials[mi].base_color_handle.x;
            Lavg *= textureLod(uTextures[nonuniformEXT(tex)], vec2(0.5), 16.0).rgb;
        }
    }
    F = max(F, vec3(0.0));
    Lavg = max(Lavg, vec3(0.0));
    if (any(isnan(F)) || any(isinf(F)) || any(isnan(Lavg)) || any(isinf(Lavg))) return 0.0;
    return pdnLum(Lavg);
}
// (#1009 SKIP DIAGNOSTIC, EM_F_SKIPSTAT: RenderVKReSTIREmissiveSkipStats) an instance mode 0 left out whose
// material emits above the threshold, counted by WHY (CC_HDR [42..44], instances -- the triangle count of
// a row-less one is unknown): [42].x rigged (legacy row), .y rigged (cluster RT cut), [43].x a cluster-
// traced static without a legacy emitter row (EM_F_CLUSTER off / no slot), .y a worn / own-avatar
// attachment, [44].x not in the TLAS this frame (no row: out of the RT radius, BLAS not built / evicted,
// faint alpha). HUD, terrain, water: not counted. Costs the material evaluation (one coarse texture fetch)
// of every such instance per build -- off by default.
void emSkipNote(uint id, uint fl, uint nMat, float thr)
{
    if ((fl & (8u | 32u | 2048u)) != 0u) return;   // (HUD / terrain / water: never emitters)
    const uint mi = rt_instances[id].material_id;
    if (mi >= nMat) return;
    vec3 F, Lavg;
    uint tex, ef;
    if (!(emMatEmission(id, fl, mi, F, Lavg, tex, ef) > thr)) return;
    const uvec4 g = rt_geom[id];
    uint w;
    uint c;
    if ((g.z & RT_GEOM_CLUSTER_RIG) != 0u)      { w = 42u; c = 1u; }
    else if ((g.z & 0x80000000u) != 0u)         { w = 42u; c = 0u; }
    else if ((g.z & RT_GEOM_CLUSTER) != 0u)     { w = 43u; c = 0u; }
    else if ((g.w & 0x7FFFFFFFu) == 0u)         { w = 44u; c = 0u; }
    else                                        { w = 43u; c = 1u; }   // (a row, dropped by its flags: worn / own)
    if (c == 0u) atomicAdd(rg_cells[emCcHdr(w)].x, 1u);
    else         atomicAdd(rg_cells[emCcHdr(w)].y, 1u);
}
void emEntBuild()
{
    rt_anim_time = pc.u_cam_time.w;   // (draw time: texture animation, as the raster)
    const uint nInst = min(uint(rt_instances.length()), uint(rt_geom.length()));
    const uint stride = gl_NumWorkGroups.x * gl_NumWorkGroups.y * 64u;
    const uint lin = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationIndex;
    const uint par = g_draw_push.rtr3.w & 1u;
    if (lin == 0u) rg.rs_em.w = par;   // (this build's parity: every reader after the barrier)
    const float thr = max(rg.rs_em_params.x, 1e-4);
    const float cutoff = max(rg.rs_em_params2.x, 1e-5);
    const float rangeMax = max(rg.rs_em_params2.y, 0.1);
    const bool takeOn = (rg.rs_em_cfg.z & EM_F_TAKE) != 0u;
    const uint nMat = uint(rt_materials.length());
