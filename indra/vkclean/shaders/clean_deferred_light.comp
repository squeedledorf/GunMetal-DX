    {
        vec3 res = (hS + mS * envE) / wS;
        if (temporal && k.x <= 0.0)
        {
            vec3 mu = res, sg = vec3(0.0);
            if (wB > 1e-6)
            {
                mu = (hB + mB * envE) / wB;
                sg = sqrt(max((qB + mB * envE * envE) / wB - mu * mu, vec3(0.0)));
            }
            res = rtrTemporal(px, res, mu, 1.25 * sg + 0.02 * max(mu, res) + 1e-4, P, Ng, V, tMean, vz, tSurf);
            temporal = false;
        }
        const vec3 word = max(dsUnpackRGB9E5(imageLoad(uReflEnv, px).x) + fd * (k.y * res - xE), vec3(0.0));
        imageStore(uReflEnv, px, uvec4(dsPackRGB9E5(word)));
