#elif CLEAN_DEFER_PASS == 7
// ---- BASE (feature split, #827; see FEATURE SPLIT in the header): the combine without the local
// lights -- 8x8 (no tile mask, no shared state: finer occupancy steps), every pixel. Its output is
// final wherever LOCAL adds nothing (tiles the classification left out, pixels no light reaches).
void DEFER_MAIN()
{
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(g_draw_push.width) || px.y >= int(g_draw_push.height)) return;
    CLK_INV();
    g_frag_xy = vec2(px) + 0.5;
    const vec4 g2 = texelFetch(uG2, px, 0);
    if (!deferHasSurface(g2))
    {
        writeLitOutput(px, vec3(0.0), 0.0);   // pass 1's clear; the sky draws over it (no gain: LOCAL skips it)
        CLK_MARK(STORE);
        return;
    }
    CLK_SURF();
    const vec3 P = deferPosition(px);
    float glow;
    bool noFade;
    const SurfaceLit s = deferSurface(px, g2, glow, noFade);
    g_ds_P = P;
    CLK_MARK(GBUF);
    const vec4 lit = lightSurface(s, P, 1.0);   // (CLEAN_LOCAL_EXTERNAL: the local sum is an exact 0)
    CLK_MARK(SHADE);
    const vec3 color = surfacePost(s.model, noFade, lit.rgb, P);
    CLK_MARK(HAZE);
    writeLitOutput(px, color, glow);
    // The local gain of the lit models (fullbright takes no local light: LOCAL skips it unread).
    if (s.model != SURF_FULLBRIGHT) imageStore(uLocalGain, px, vec4(surfaceLocalGain(noFade, P), 0.0, 0.0, 0.0));
    CLK_MARK(STORE);
}

#elif CLEAN_DEFER_PASS == 8
// ---- LOCAL (feature split, #827; see FEATURE SPLIT in the header): one 16x16 workgroup per
// LISTED tile (vkCmdDispatchIndirect; workgroup i = tl_tiles[i]). The light set as the combine
// finds it -- the tile's grid mask (pass 9 built it, DEFER_FLAG_LIGHT_GRID) -> shared (+ the #815
// staging copy), or the pixel's froxel cell (_FROXEL) -- and the SAME localLights call with
// lightSurface's own arguments (its common tail: N = s.N, V, the PBR / legacy inputs, g_cel),
// projector visibility from the shadow pass's slots (deferProjVis). Then BASE's output + the
// sum x BASE's gain (FEATURE SPLIT: the affine tail's slope), glow from the new colour.
void DEFER_MAIN()
{
    const uint lid = gl_LocalInvocationIndex;
    const uint tilesX = (g_draw_push.width + TILE - 1u) / TILE;   // (the push width: no workgroup grid to read)
    g_tile = tl_tiles[gl_WorkGroupID.x];
    const bool froxel = (g_draw_push.flags & DEFER_FLAG_LIGHT_FROXEL) != 0u;   // (uniform: push constant)
    const bool stage = lightStaged();   // (#815: implies !froxel)
    if (!froxel)
    {
        if (stage && lid < TILE_LIGHT_WORDS) s_lightProj[lid] = 0u;
        if (lid < TILE_LIGHT_WORDS) s_tileMask[lid] = light_grid[g_tile * TILE_LIGHT_WORDS + lid];
        barrier();
        if (stage) stageTileLights(lid);
        CLK_MARK(GRID);
    }
    const ivec2 px = ivec2(uvec2(g_tile % tilesX, g_tile / tilesX) * TILE + gl_LocalInvocationID.xy);
    if (px.x >= int(g_draw_push.width) || px.y >= int(g_draw_push.height)) return;
    CLK_INV();
    g_frag_xy = vec2(px) + 0.5;
    const vec4 g2 = texelFetch(uG2, px, 0);
    if (!deferHasSurface(g2)) { CLK_MARK(GBUF); return; }   // (sky / cleared: BASE's black stands)
    float glow;
    bool noFade;
    SurfaceLit s = deferSurface(px, g2, glow, noFade);
    if (s.model == SURF_FULLBRIGHT) { CLK_MARK(GBUF); return; }   // (unlit: no local lights)
    CLK_SURF();
    const vec3 P = deferPosition(px);
    const vec3 V = normalize(pc.u_cam_time.xyz - P);
    CLK_MARK(GBUF);
    // lightSurface's common tail inputs (clean_surface_light.glsl): cel as lightSurface sets it,
    // PBR base / metal / rough + no legacy specular, legacy base + metal 0 / rough 1 + its spec.
    s.cel = s.cel && specCelOn();
    g_cel = s.cel;
    const bool pbr = s.model == SURF_PBR;
    LegacySpec ls = legacySpecNone();
    float metal = 0.0, rough = 1.0;
    if (pbr) { metal = s.metal; rough = s.rough; }
    else { ls.spec = s.spec; ls.gloss = s.gloss; ls.env = s.env; }
    float glare;
    const vec3 local = localLights(P, s.N, V, pbr, s.albedo, metal, rough, ls, glare);   // (marks LOCAL / FROXEL)
    CLK_MARK(LOCAL);
    // No light reached this pixel: BASE's output is already this pixel's (an exact + 0).
    if (local.r == 0.0 && local.g == 0.0 && local.b == 0.0) return;
    const float gain = imageLoad(uLocalGain, px).r;
    const vec3 base = imageLoad(uHdrOut, px).rgb;
    writeLitOutput(px, base + local * gain, glow);
    CLK_MARK(STORE);
}

