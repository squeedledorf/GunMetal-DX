// World position of a G-buffer pixel from the pre-pass depth through the same (jittered)
// projection the G-buffer draws used; eye-relative for precision, then + eye.
vec3 deferPosition(ivec2 px)
{
    const float d = texelFetch(uDepthG, px, 0).r;
    const vec2 ndc = g_frag_xy / vec2(float(g_draw_push.width), float(g_draw_push.height)) * 2.0 - 1.0;
    const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, d, 1.0);
    return pc.u_cam_time.xyz + h.xyz / h.w;
}

// The G-buffer surface of a pixel (all four texels: unused fields fold away per kernel).
SurfaceLit deferSurface(ivec2 px, vec4 g2, out float glow, out bool noFade)
{
    return gbufferUnpack(texelFetch(uG0, px, 0), texelFetch(uG1, px, 0), g2, texelFetch(uG3, px, 0), glow, noFade);
}
bool deferHasSurface(vec4 g2) { return (uint(g2.w * 255.0 + 0.5) & 3u) != SURF_NONE; }
#if DEFER_RT_TILES
// (#859 noise) The receiver's NORMAL SPREAD across the screen, from its 4 neighbours ON THE SAME
// SURFACE (the receiver plane within 2 % of the camera distance + 2 cm -- a curved surface's 1 px
// sag is far below that -- and the geometric normals within ~75 deg: a sharper crease is an edge,
// which the lattice's rank hand-off already covers): x = the geometric normal's largest change per
// render pixel (rad; the CURVATURE the ray lattice must resolve: rtrCurvRho), y = the shading
// normal's screen-space variance |dN/dx|^2 + |dN/dy|^2 (each axis the mean of its two sides;
// curvature + normal maps: the specular-AA kernel, rtrAlphaAA). N: the shading normal, Ng the
// geometric one (either orientation), P the receiver, camd its camera distance.
vec2 rtrNormalSpread(ivec2 px, vec3 P, vec3 N, vec3 Ng, float camd)
{
    const ivec2 ext = ivec2(g_draw_push.width, g_draw_push.height);
    const float tol = 0.02 * camd + 0.02;
    float geo = 0.0;
    vec2 var = vec2(0.0), cnt = vec2(0.0);
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        const ivec2 q = px + (k == 0 ? ivec2(1, 0) : k == 1 ? ivec2(-1, 0) : k == 2 ? ivec2(0, 1) : ivec2(0, -1));
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, ext))) continue;
        const float d = texelFetch(uDepthG, q, 0).r;
        const vec2 ndc = (vec2(q) + 0.5) / vec2(ext) * 2.0 - 1.0;
        const vec4 h = g_draw_push.inv_vp_rel * vec4(ndc, d, 1.0);
        const vec3 Pq = pc.u_cam_time.xyz + h.xyz / h.w;
        if (!(abs(dot(Ng, Pq - P)) < tol)) continue;   // (sky / another surface; NaN: no)
        const vec4 g1 = texelFetch(uG1, q, 0);
        const float c = abs(dot(gbOctDecode(g1.zw), Ng));
        if (!(c >= 0.25)) continue;
        geo = max(geo, acos(min(c, 1.0)));
        vec3 nq = gbOctDecode(g1.xy);
        if (dot(nq, N) < 0.0) nq = -nq;
        const vec3 dn = nq - N;
        var[k >> 1] += dot(dn, dn);
        cnt[k >> 1] += 1.0;
    }
    return vec2(geo, (cnt.x > 0.0 ? var.x / cnt.x : 0.0) + (cnt.y > 0.0 ? var.y / cnt.y : 0.0));
}
// CURVATURE DENSITY (RenderVKRTReflectionsCurvatureDensity, rtt_curv): the ray density a receiver
// whose geometric normal turns geo rad per pixel needs so that its ray lattice (spacing
// 1 / sqrt(rho)) keeps neighbouring rays within rtt_curv of its normal -- the resolve's plane +
// normal gather can then fill every pixel between them. Before it a small curved receiver (a
// railing, a chrome trim) got the roughness / strength density of a flat one: one ray per 4 x 4 or
// 8 x 8 pixels, whose lattice neighbours the resolve rejected (another normal), so most of its
// pixels kept the probe next to a few ray-traced ones -- a speckle that crawled with the jitter.
// -> the mark's 4-bit code (rtrMarkW curvQ; 0: off or flat).
uint rtrCurvQ(float geo)
{
    const float lim = uintBitsToFloat(rtt_curv);
    if (!(lim > 0.0) || !(geo > 0.0)) return 0u;
    const float r = min(geo / lim, 1.0);
    return uint(ceil(r * r * 15.0 - 1e-3));
}
// SPECULAR AA (the lobe filter; Kaplanyan / Tokuyoshi 2016-19): the GGX alpha^2 a receiver's
// sub-pixel normal spread adds -- 2 x sigma^2 with sigma^2 = 0.25 x the screen-space variance,
// capped at 0.18 (alpha ~0.42).
float rtrAlphaAA(float var) { return min(0.5 * var, 0.18); }
#endif

#if DEFER_SPLIT_IO
// ---- INTERMEDIATE PACKING (passes 1 / 2 -> pass 3; formats: the header) ----
// A value about to be stored in a format without NaN / inf (rgba8 UNORM, RGB9E5): a
// non-finite one is counted as LG_OUT -- what it would have made of the uber kernel's
// output -- and stored as 0; the finite range is clamped to LG_MAX_VALUE as before.
vec4 dsFiniteNote(vec4 c)
{
    if (any(isnan(c)) || any(isinf(c))) { lgNote(LG_OUT); return vec4(0.0); }
    return min(c, vec4(LG_MAX_VALUE));
}
uint dsPackRGB9E5(vec3 c) { return packRGB9E5(dsFiniteNote(vec4(c, 0.0)).rgb); }
// The legacy sharp env is stored (pass 2) and read (pass 3) only where the combine uses
// it: legacy faces with an env intensity (both passes decode the same G-buffer texel).
bool dsEnvUsed(SurfaceLit s) { return s.model == SURF_LEGACY && s.env > 0.0; }

// ---- HALF-RESOLUTION REFLECTIONS: the per-pixel class (passes 4 / 5 and the combine
// evaluate it on the same G-buffer texel and P: they agree exactly) ----
//   DS_SOFT        irradiance + specular from the half-resolution blocks
//   DS_SHARP_SPEC  specular per pixel (PBR roughness / legacy 1 - gloss below the threshold,
//                  planar mirror weight >= 0.25, fullbright shiny); SSR (PBR roughness
//                  <= 0.1: the threshold is >= 0.11) is always in this class
//   DS_SHARP_ENV   legacy env face: the sharp lod-0 env per pixel, its glossy env (glossenv,
//                  scaled by gloss under the env mix) from the blocks
const uint DS_SOFT = 0u, DS_SHARP_SPEC = 1u, DS_SHARP_ENV = 2u;
const uint DS_HALF_SURF = 1u << 22, DS_HALF_SPEC = 1u << 23;
float dsSharpRough() { return float((g_draw_push.flags >> 8u) & 0xFFu) * (1.0 / 255.0); }
uint dsSharpKind(SurfaceLit s, vec3 P)
{
    if (s.model == SURF_FULLBRIGHT) return s.env > 0.0 ? DS_SHARP_SPEC : DS_SOFT;
    if (s.model == SURF_LEGACY && s.env > 0.0) return DS_SHARP_ENV;
    const float gloss = s.model == SURF_PBR ? 1.0 - s.rough : s.gloss;
    if (gloss <= 0.0) return DS_SOFT;   // (legacy matte: no glossy term at all)
    return (gloss > 1.0 - dsSharpRough() || tapMirrorWeight(P, gloss) >= 0.25) ? DS_SHARP_SPEC : DS_SOFT;
}
// The roughness that sets a surface's specular blur (the probe lod): PBR roughness, legacy
// 1 - glossiness. The upsample only blends specular between similar values of it.
float dsSpecRough(SurfaceLit s) { return s.model == SURF_PBR ? s.rough : 1.0 - s.gloss; }
// The block representative's preference (lower first): a soft lit surface (its irradiance
// AND specular serve the block), a legacy env face (its glossy env is soft), a sharp one
// (irradiance only), fullbright (nothing: unlit, no irradiance).
uint dsHalfRank(SurfaceLit s, uint kind)
{
    return s.model == SURF_FULLBRIGHT ? 3u : (kind == DS_SOFT ? 0u : (kind == DS_SHARP_ENV ? 1u : 2u));
}
#endif

#ifdef CLEAN_REFL_RT_MARK
// ---- RT REFLECTION MARK (#859; see HYBRID RT REFLECTIONS in the header) ----
bool dsRtMarkOn() { return (g_draw_push.flags & DEFER_FLAG_RT_MARK) != 0u; }
float dsRtRough() { return float(g_draw_push.flags >> 24u) * (1.0 / 255.0); }
// A splice must be able to show: k x the surface's reflectance of the word at least this much
// (a dielectric PBR surface seen head on reflects ~0.04: kept).
#define DS_RT_MIN_STRENGTH 0.004
// This pixel's mark after surfaceReflectionsW ran on it (g_rtm_*): x / y = RGB9E5 of k x env of
// the uReflSpec / uReflEnv word, z = packHalf2x16(k spec, k env), w = rtrMarkW: the roughness the
// trace uses (unorm16: PBR roughness, legacy env faces 0, legacy 1 - glossiness; RAY DENSITY's
// input), the reflection STRENGTH and the candidate type; 0 = not a candidate. halfEnv: pass 5's
// DS_SHARP_ENV pixel -- the legacy sharp env IS its uReflSpec word (its glossenv comes from the
// half-resolution blocks and keeps the probe). camd: the receiver's distance from the camera (the
// receiver gate).
// STRENGTH s (#859 perf; RenderVKRTReflectionsStrength*): how much of the pixel's final colour the
// traced radiance can change -- the weight the combine gives the env radiance each splice replaces,
// summed over the pixel's splices (clamped to 1):
//   PBR              k x max(F), F = EnvBRDFApprox(F0, roughness, N.V) x ao (rises at grazing angles)
//   legacy sharp env k x 0.5 x e^2 x min((1 - N.V)^2 + e, 1), e the env intensity: the combine's
//                    color = mix(color, env x e x fresnel x 0.5, e) (clean_surface_light.glsl; its
//                    specular occlusion, <= 1, left out: never under-estimates)
//   legacy glossenv  k x max(spec) x gloss x 0.25 (the candidate gate's expression)
// Below RenderVKRTReflectionsStrengthCut: no mark (SSR + probe, as any non-candidate; g_rtm_cut
// counts it); above it rtrRho thins the ray density and the resolve fades the splice in
// (rtrStrengthFade). The type is the stronger splice's. DS_RT_MIN_STRENGTH stays the per-splice
// gate (the strength term off: exactly the old candidates).
bool g_rtm_cut = false;   // (dsRtMarkTile's stats) the strength cutoff took a would-be candidate out
uvec4 dsRtMark(SurfaceLit s, vec3 V, bool halfEnv, float camd, ivec2 px, vec3 P)
{
    g_rtm_cut = false;
    if (s.model == SURF_FULLBRIGHT) return uvec4(0u);
    if (!(camd < rttRecvDist())) return uvec4(0u);   // (far receiver: SSR + probe, no ray)
    const float thr = dsRtRough();
    vec4 a = vec4(0.0), e = vec4(0.0);   // (k env, k): the uReflSpec word, the uReflEnv word
    float sA = 0.0, sE = 0.0;            // their splices' strengths
    uint tA = 0u;                        // the uReflSpec word's type
    if (s.model == SURF_PBR)
    {
        const float NdotV = clamp(abs(dot(s.N, V)), 0.001, 1.0);
        const vec3 F = EnvBRDFApprox(mix(vec3(0.04), s.albedo, s.metal), s.rough, NdotV) * s.ao;
        const float st = g_rtm_spec.a * max(max(F.r, F.g), F.b);
        if (s.rough < thr && st >= DS_RT_MIN_STRENGTH) { a = g_rtm_spec; sA = st; tA = RTR_TYPE_PBR; }
    }
    else
    {
        // legacy sharp env (lod 0: no roughness gate), mixed in by the env intensity
        if (s.env > 0.0 && g_rtm_env.a * s.env >= DS_RT_MIN_STRENGTH)
        {
            float fr = 1.0 - dot(s.N, V);   // (the combine's 1 + dot(-V, N))
            fr = min(fr * fr + s.env, 1.0);
            const float st = g_rtm_env.a * 0.5 * s.env * s.env * fr;
            if (halfEnv) { a = g_rtm_env; sA = st; tA = RTR_TYPE_ENV; }
            else         { e = g_rtm_env; sE = st; }
        }
        // legacy glossenv: ~ spec x gloss x fresnel / 4
        const float sp = max(max(s.spec.r, s.spec.g), s.spec.b);
        const float stG = g_rtm_spec.a * sp * s.gloss * 0.25;
        if (!halfEnv && s.gloss > 0.0 && 1.0 - s.gloss < thr && stG >= DS_RT_MIN_STRENGTH)
        {
            a = g_rtm_spec; sA = stG; tA = RTR_TYPE_GLOSS;
        }
    }
    const uint kk = packHalf2x16(vec2(a.w, e.w));
    if (kk == 0u) return uvec4(0u);
    const float st = min(sA + sE, 1.0);
    if (rtrStrengthOn() && st < rtrStrengthCut()) { g_rtm_cut = true; return uvec4(0u); }
    const uint type = sE > sA ? RTR_TYPE_ENV : tA;
    // (pass 11's own roughness rule)
    const float rough = s.model == SURF_PBR ? s.rough : (s.env > 0.0 ? 0.0 : 1.0 - s.gloss);
    // CURVATURE DENSITY (rtt_curv > 0: a header word, uniform): the receiver's curvature code
    const uint curvQ = uintBitsToFloat(rtt_curv) > 0.0 ? rtrCurvQ(rtrNormalSpread(px, P, s.N, s.Ng, camd).x) : 0u;
    return uvec4(dsPackRGB9E5(a.rgb), dsPackRGB9E5(e.rgb), kk, rtrMarkW(rough, st, type, curvQ));
}
// The 8 px tile vote (every invocation of the 8x8 workgroup = the tile, in uniform control flow):
// a tile with a candidate writes ALL its marks (the RT kernels read whole tiles), adds its
// candidates and each RAY DENSITY level's rays to the header and appends itself to the RT tile
// list; any other tile writes nothing.
shared uint s_rtm_cnt[RTR_LEVELS + 1u];   // rays per level (gradient: [0] its rays at scale 1), then the candidates
shared uint s_rtm_rho;                    // (gradient) sum of the tile's candidates' rho x 256
shared uint s_rtm_scnt[3];                // (STRENGTH DENSITY stats) candidates by type (RTR_TYPE_* - 1)
shared uint s_rtm_ssum[3];                // ... their strength sums x 256
shared uint s_rtm_scut;                   // ... pixels the strength cutoff took out (g_rtm_cut)
void dsRtMarkTile(ivec2 px, bool inside, uvec4 mark)
{
    const uint lid = gl_LocalInvocationIndex;
    if (lid <= RTR_LEVELS) s_rtm_cnt[lid] = 0u;
    if (lid == 0u) { s_rtm_rho = 0u; s_rtm_scut = 0u; }
    if (lid < 3u) { s_rtm_scnt[lid] = 0u; s_rtm_ssum[lid] = 0u; }
    s_rtd_rough[lid] = mark.z != 0u ? rtrMarkRough16(mark.w) : RTR_NONE;
    barrier();
    if (mark.z != 0u)
    {
        atomicAdd(s_rtm_cnt[RTR_LEVELS], 1u);
        const uint ty = rtrMarkType(mark.w);
        if (ty != 0u)
        {
            atomicAdd(s_rtm_scnt[ty - 1u], 1u);
            atomicAdd(s_rtm_ssum[ty - 1u], uint(rtrMarkStrength(mark.w) * 256.0 + 0.5));
        }
    }
    if (g_rtm_cut) atomicAdd(s_rtm_scut, 1u);
    barrier();
    // (before the empty-tile return: a tile the cutoff emptied counts its cut pixels too)
    if (lid == 0u && s_rtm_scut != 0u) atomicAdd(rtt_scut, s_rtm_scut);
    if (s_rtm_cnt[RTR_LEVELS] == 0u) return;   // (shared, after the barrier: uniform)
    if (lid < 3u && s_rtm_scnt[lid] != 0u)
    {
        atomicAdd(rtt_scand[lid], s_rtm_scnt[lid]);
        atomicAdd(rtt_ssum[lid], s_rtm_ssum[lid]);
    }
    if (inside) imageStore(uReflRtMark, px, mark);
    const bool grad = rtrGradOn();   // (a header word: uniform)
    if (grad)
    {
        // DENSITY GRADIENT: the rays this tile casts at budget scale 1 (pass 11 scales the frame's
        // densities to the budget from their sum) + the candidates' density sum (the stats)
        const uvec2 org = gl_WorkGroupID.xy * 8u;
        rtrGradBuild(lid, org, mark.z != 0u);
        if (mark.z != 0u)
        {
            const float rho = rtrRho(mark.w);
            if (rtrGradRay(rtrGradRank(lid, org), rho)) atomicAdd(s_rtm_cnt[0], 1u);
            atomicAdd(s_rtm_rho, uint(rho * 256.0 + 0.5));
        }
    }
    else
    {
        const uvec2 blk = rtrBlock(lid);
        const uint sharp16 = rtrSharp16();
        [[unroll]] for (uint L = 0u; L < RTR_LEVELS; ++L)
            if (rtrRayAt(L, lid, blk, sharp16)) atomicAdd(s_rtm_cnt[L], 1u);
    }
    barrier();
    if (grad)
    {
        if (lid == 0u)
        {
            atomicAdd(rtt_grays, s_rtm_cnt[0]);
            atomicAdd(rtt_rhosum, s_rtm_rho);
        }
    }
    else if (lid < RTR_LEVELS) atomicAdd(rtt_rays[lid], s_rtm_cnt[lid]);
    if (lid == RTR_LEVELS) atomicAdd(rtt_cand, s_rtm_cnt[RTR_LEVELS]);
    if (lid == 0u)
    {
        const uint tilesX = (g_draw_push.width + 7u) / 8u;
        const uint t = gl_WorkGroupID.y * tilesX + gl_WorkGroupID.x;
        const uint n = rtt_args[3];
        rtt_words[t] = 1u;
        const uint i = atomicAdd(rtt_words[2u * n], 1u);
        // (Xid 109 hardening) never past the tile grid's n slots: rtt_words[2n ..] holds the listed
        // count and the RAY LIST's count / dispatch arguments / capacity
        if (i < n)
        {
            rtt_words[n + i] = t;
            // the dispatch arguments: a new 65535-wide row per RTT_ROW entries, x the widest row
            if (i % RTT_ROW == 0u) atomicAdd(rtt_args[1], 1u);
            atomicMax(rtt_args[0], min(i + 1u, RTT_ROW));
        }
    }
}
#endif

#if DEFER_EXT_SURF || CLEAN_DEFER_PASS == 11 || CLEAN_DEFER_PASS == 13
vec3 dsUnpackRGB9E5(uint v)
{
    const float scale = exp2(float(int(v >> 27) - 15 - 9));
    return vec3(float(v & 0x1FFu), float((v >> 9) & 0x1FFu), float((v >> 18) & 0x1FFu)) * scale;
}
#endif
#if DEFER_EXT_SURF
// Half-resolution upsample at this pixel (see the header): irradiance from every block with
// a lit surface, the soft specular (wantSpec) from the blocks that carry one. Weights:
// bilinear x plane (the block surface's plane offset at this P, within 0.5 % of the view
// depth + 1 cm) x geometric-normal similarity (cos^8), the specular also x roughness
// similarity (zero 0.25 apart: no blur level bleeds across a material edge); none left ->
// the most similar block (this pixel's own block always qualifies: a lit pixel makes its
// block's representative lit, a soft one makes it soft).
void dsHalfUpsample(SurfaceLit s, ivec2 px, bool wantSpec, out vec3 irr, out vec3 spec)
{
    const ivec2 hmax = (ivec2(g_draw_push.width, g_draw_push.height) + 1) / 2 - 1;
    const vec2 f = (vec2(px) + 0.5) * 0.5 - 0.5;
    const ivec2 b = ivec2(floor(f));
    const vec2 fr = f - vec2(b);
    const vec3 rel = g_ds_P - pc.u_cam_time.xyz;
    const float vz = max(dot(g_ds_P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz), 0.0);
    const float itol = 1.0 / (0.005 * vz + 0.01);
    const float srough = dsSpecRough(s);
    vec3 isum = vec3(0.0), ssum = vec3(0.0), ifb = vec3(0.0), sfb = vec3(0.0);
    float iw = 0.0, sw = 0.0, ibest = -1e30, sbest = -1e30;
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const uvec4 h = imageLoad(uReflHalf, clamp(b + o, ivec2(0), hmax));
        if ((h.z & DS_HALF_SURF) == 0u) continue;
        const vec3 n = gbOctDecode(vec2(float(h.z & 1023u), float((h.z >> 10) & 1023u)) * (2.0 / 1023.0) - 1.0);
        const float nd = dot(n, s.Ng);
        const float dz = abs(dot(n, rel) - uintBitsToFloat(h.w)) * itol;
        const float pw = max(0.0, 1.0 - dz);
        float nw = max(nd, 0.0);
        nw *= nw; nw *= nw; nw *= nw;
        const float w = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y) * pw * pw * nw;
        const float score = nd - dz;
        const vec3 ti = dsUnpackRGB9E5(h.x);
        isum += w * ti; iw += w;
        if (score > ibest) { ibest = score; ifb = ti; }
        if (wantSpec && (h.z & DS_HALF_SPEC) != 0u)
        {
            const vec3 ts = dsUnpackRGB9E5(h.y);
            const float rd = abs(float(h.z >> 24) * (1.0 / 255.0) - srough) * 4.0;
            const float ws = w * max(0.0, 1.0 - rd);
            ssum += ws * ts; sw += ws;
            if (score - rd > sbest) { sbest = score - rd; sfb = ts; }
        }
    }
    irr  = iw > 1e-4 ? isum / iw : ifb;
    spec = sw > 1e-4 ? ssum / sw : sfb;
}
SurfaceRefl deferReflInBase(SurfaceLit s)
{
    const ivec2 px = ivec2(CLEAN_FRAG_XY);
    SurfaceRefl r;
    r.prad2 = vec3(0.0); r.have = false;   // (debug view 9: the uber twin)
    if ((g_draw_push.flags & DEFER_FLAG_REFL_HALF) == 0u)
    {
        r.irr = dsUnpackRGB9E5(imageLoad(uReflIrr, px).x);
        r.spec = dsUnpackRGB9E5(imageLoad(uReflSpec, px).x);
        r.env = dsEnvUsed(s) ? dsUnpackRGB9E5(imageLoad(uReflEnv, px).x) : vec3(0.0);
        return r;
    }
    // Half resolution: the sharp word where pass 5 wrote one (same classification, same
    // G-buffer texel and P), the upsample for the rest.
    const uint kind = dsSharpKind(s, g_ds_P);
    const vec3 sharp = kind != DS_SOFT ? dsUnpackRGB9E5(imageLoad(uReflSpec, px).x) : vec3(0.0);
    r.env = kind == DS_SHARP_ENV ? sharp : vec3(0.0);
    if (s.model == SURF_FULLBRIGHT)   // (unlit: no irradiance; spec = the shiny env)
    {
        r.irr = vec3(0.0);
        r.spec = sharp;
        return r;
    }
    dsHalfUpsample(s, px, kind != DS_SHARP_SPEC, r.irr, r.spec);
    if (kind == DS_SHARP_SPEC) r.spec = sharp;
    return r;
}
// (#87) GI: the denoised GI irradiance at this pixel (clean_gi_common.glsl), the final image's own
// texel at the render extent, else the depth-aware 4-tap upsample (deferPdnFetch's rule; alpha =
// the texel's view depth, <= 0 = no surface / unknown). ok: some tap lies on this surface.
// skyVis: the denoised sky visibility (layer 1's red; 1 where unknown).
// ok: some tap has a surface -- the CLOSEST-depth tap stands in where none lies on this surface (a
// silhouette): before, such pixels fell back to the probes' sky ambient -- a bright rim on every
// edge of a dark room (the owner's red rims on the tub).
// EDGE-SAFE (GI_F_UPS_NORMAL, RenderVKGIUpsampleNormal; N: this pixel's shading normal): (1) each tap
// is also weighted by its normal's agreement (the GI GEOM guide, this frame's parity: prm4.w) -- a hair
// strand lying ON its body has the body's depth but not its normal, and the depth stop alone averaged
// the two surfaces' GI; (2) where none of the 4 taps lies on this surface (a strand thinner than a GI
// texel, or one the jittered GI sample missed), the best-matching texel of the 4 x 4 around it (depth,
// then normal) stands in before the closest-depth fallback -- never an average across the silhouette.
// (#978 phase 2, GI_F_LAG: RenderVKGILatencyFrame) ONE FRAME OF LATENCY: the GI images hold LAST frame's
// result. REPROJECTION: P into last frame's unjittered view (ssr.taa_prev_vp, camera-relative to this
// recording's eye as every temporal pass maps it) -- its uv in last frame's GI grid and its view depth
// there (clip w, the images' alpha convention: the GI denoiser's own reprojection compares the same
// pair, clean_deferred_light.comp giPrevDelta). The 4 bilinear taps around it count only on THIS
// surface (depth within 3 %, normal-weighted by last frame's GEOM -- prm4.w names its parity under
// GI_F_LAG); no closest-depth stand-in (under a moving camera that is a disocclusion, not a
// silhouette). DISOCCLUSION (no tap on this surface, off last frame's screen, a history reset --
// teleport / region crossing / camera cut: ssr.taa_params.z --, or GI_F_LAG_STALE): the radiance
// cache's world cell at P (last frame's irradiance there: occlusion-aware, camera-independent), else
// no estimate (the probes' diffuse, as an untraced pixel). skyVis there: 1 (unknown; no specular
// occlusion). Object motion is not followed (camera-only, as the GI hits' cache): a moving avatar's
// GI trails it by a frame. The sub-texel jitter of last frame's GI samples (scale < 1) is ignored.
vec3 deferGiFetchLag(vec3 P, vec3 N, out bool ok, out float skyVis)
{
    ok = false;
    skyVis = 1.0;
    const bool stale = (gi.cfg.x & GI_F_LAG_STALE) != 0u || ssr.taa_params.z > 0.5;
    const vec4 c = ssr.taa_prev_vp * vec4(P - ssr.cam_origin.xyz, 1.0);
    const vec2 puv = c.w > 1e-4 ? c.xy / c.w * 0.5 + 0.5 : vec2(-1.0);
    if (!stale && all(greaterThanEqual(puv, vec2(0.0))) && all(lessThanEqual(puv, vec2(1.0))))
    {
        const bool fin = (gi.cfg.x & GI_F_FINAL_IN) != 0u;
        const ivec2 dims = fin ? imageSize(uGiIn).xy : imageSize(uGiOut).xy;
        const ivec2 mx = dims - 1;
        const vec2 f = puv * vec2(dims) - 0.5;
        const ivec2 b = ivec2(floor(f));
        const vec2 fr = f - vec2(b);
        const float pz = c.w;   // (last frame's view depth of P)
        const float tol = max(pz * 0.03, 0.05);
        const bool nrm = (gi.cfg.x & GI_F_UPS_NORMAL) != 0u;
        const int gpar = int(gi.prm4.w + 0.5) & 1;
        vec4 bw, e, inf;
        vec4 tc[4];
        float tv[4];
        [[unroll]] for (int k = 0; k < 4; ++k)
        {
            const ivec2 o = ivec2(k & 1, k >> 1);
            const ivec2 q = clamp(b + o, ivec2(0), mx);
            bw[k] = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y);
            tc[k] = fin ? imageLoad(uGiIn, ivec3(q, 0)) : imageLoad(uGiOut, ivec3(q, 0));
            tv[k] = (fin ? imageLoad(uGiIn, ivec3(q, 1)) : imageLoad(uGiOut, ivec3(q, 1))).r;
            const float az = abs(tc[k].a);
            e[k] = az > 0.0 ? abs(az - pz) / tol : 1e30;
            inf[k] = tc[k].a < 0.0 ? 0.05 : 1.0;
            if (nrm && az > 0.0)
                inf[k] *= max(pow(clamp(abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, gpar)).y))), 0.0, 1.0), 8.0), 1e-3);
        }
        if (min(min(e.x, e.y), min(e.z, e.w)) < 1.0)
        {
            const vec4 w = upsampleWeights4(bw, e, inf);
            vec3 col = vec3(0.0);
            float v = 0.0;
            [[unroll]] for (int k = 0; k < 4; ++k) { col += w[k] * tc[k].rgb; v += w[k] * tv[k]; }
            ok = true;
            skyVis = clamp(v, 0.0, 1.0);
            return col;
        }
    }
    if ((gi.cfg.x & GI_F_CACHE) != 0u && giCacheSlots() != 0u)
    {
        const vec3 cam = pc.u_cam_time.xyz;
        const vec3 Nv = dot(N, cam - P) < 0.0 ? -N : N;   // (the trace's cell rule: N toward the viewer)
        float edge;
        vec3 E;
        if (giCacheRead(giCacheFind(giCellKey(P, Nv, cam, edge)), E)) { ok = true; return E; }
    }
    return vec3(0.0);
}
vec3 deferGiFetch(vec3 P, vec3 N, out bool ok, out float skyVis)
{
    if ((gi.cfg.x & GI_F_LAG) != 0u) return deferGiFetchLag(P, N, ok, skyVis);   // (a header word: uniform)
    ok = false;
    skyVis = 1.0;
    const bool fin = (gi.cfg.x & GI_F_FINAL_IN) != 0u;
    const ivec2 dims = fin ? imageSize(uGiIn).xy : imageSize(uGiOut).xy;
    const ivec2 mx = dims - 1;
    const vec2 rr = vec2(dims) / vec2(float(g_draw_push.width), float(g_draw_push.height));
    if (dims.x >= int(g_draw_push.width))
    {
        const ivec2 q = clamp(ivec2(CLEAN_FRAG_XY), ivec2(0), mx);
        const vec4 t = fin ? imageLoad(uGiIn, ivec3(q, 0)) : imageLoad(uGiOut, ivec3(q, 0));
        const vec4 t1 = fin ? imageLoad(uGiIn, ivec3(q, 1)) : imageLoad(uGiOut, ivec3(q, 1));
        ok = t.a != 0.0;
        skyVis = clamp(t1.r, 0.0, 1.0);
        return t.rgb;
    }
    const vec2 j = ssr.taa_params.w > 0.5 ? ssr.taa_jitter.xy : vec2(0.0);
    const vec2 f = CLEAN_FRAG_XY * rr - 0.5 - j;
    const ivec2 b = ivec2(floor(f));
    const vec2 fr = f - vec2(b);
    const float vz = dot(P - linfo.cam_pos.xyz, linfo.cam_fwd.xyz);
    const float tol = max(vz * 0.03, 0.05);
    const bool nrm = (gi.cfg.x & GI_F_UPS_NORMAL) != 0u;   // (a header word: uniform)
    const int gpar = int(gi.prm4.w + 0.5) & 1;
    vec4 bw, e, inf;
    vec4 tc[4];
    float tv[4];
    [[unroll]] for (int k = 0; k < 4; ++k)
    {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const ivec2 q = clamp(b + o, ivec2(0), mx);
        bw[k] = (o.x == 1 ? fr.x : 1.0 - fr.x) * (o.y == 1 ? fr.y : 1.0 - fr.y);
        tc[k] = fin ? imageLoad(uGiIn, ivec3(q, 0)) : imageLoad(uGiOut, ivec3(q, 0));
        tv[k] = (fin ? imageLoad(uGiIn, ivec3(q, 1)) : imageLoad(uGiOut, ivec3(q, 1))).r;
        const float az = abs(tc[k].a);
        e[k] = az > 0.0 ? abs(az - vz) / tol : 1e30;
        inf[k] = tc[k].a < 0.0 ? 0.05 : 1.0;
        // (both normals face the viewer: the trace flips its N toward V -- |cos|)
        if (nrm && az > 0.0)
            inf[k] *= max(pow(clamp(abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, gpar)).y))), 0.0, 1.0), 8.0), 1e-3);
    }
    ok = min(min(e.x, e.y), min(e.z, e.w)) < 1e29;   // (a surface in some tap: the closest stands in)
    if (nrm && ok && min(min(e.x, e.y), min(e.z, e.w)) >= 1.0)
    {
        // no tap on this surface: the best of the 4 x 4's outer ring (depth within the tolerance,
        // then the normal), point-sampled
        float best = 1e30;
        ivec2 bq = ivec2(-1);
        [[dont_unroll]] for (int k = 0; k < 16; ++k)
        {
            const ivec2 o = ivec2(k & 3, k >> 2) - 1;
            if (o.x >= 0 && o.x <= 1 && o.y >= 0 && o.y <= 1) continue;   // (the 4 taps above)
            const ivec2 q = b + o;
            if (any(lessThan(q, ivec2(0))) || any(greaterThan(q, mx))) continue;
            const float az = abs((fin ? imageLoad(uGiIn, ivec3(q, 0)) : imageLoad(uGiOut, ivec3(q, 0))).a);
            if (!(az > 0.0)) continue;
            const float eq = abs(az - vz) / tol;
            if (eq >= 1.0) continue;
            const float c = clamp(abs(dot(N, pdnUnpackN(imageLoad(uGiGeom, ivec3(q, gpar)).y))), 0.0, 1.0);
            const float sc = eq + 2.0 * (1.0 - c);
            if (sc < best) { best = sc; bq = q; }
        }
        if (bq.x >= 0)
        {
            skyVis = clamp((fin ? imageLoad(uGiIn, ivec3(bq, 1)) : imageLoad(uGiOut, ivec3(bq, 1))).r, 0.0, 1.0);
            return (fin ? imageLoad(uGiIn, ivec3(bq, 0)) : imageLoad(uGiOut, ivec3(bq, 0))).rgb;
        }
    }
    const vec4 w = upsampleWeights4(bw, e, inf);
    vec3 c = vec3(0.0);
    float v = 0.0;
    [[unroll]] for (int k = 0; k < 4; ++k) { c += w[k] * tc[k].rgb; v += w[k] * tv[k]; }
    skyVis = clamp(v, 0.0, 1.0);
    return c;
}
// THE GI RULE: where GI ran and has an estimate on this surface, it REPLACES the probes' diffuse
// irradiance (x RenderVKGIIntensity), floored by RenderVKGIMinAmbient x the probes' value (0: a
// sealed room goes dark). The specular stays the probes' / SSR's / RT reflections'. Classic
// atmospherics treat the irradiance as sRGB (lightSurface converts it back): so is GI's.
// SPECULAR OCCLUSION (RenderVKGISpecOcclusion, header cfg bits): the probes' / SSR's / legacy env
// specular (refl.spec, refl.env: PBR IBL, legacy glossenv + shiny env -- every material path takes
// them from here) scaled by what GI saw of the sky: 1 = the sky visibility (the fraction of fresh
// cosine rays that escaped, denoised), 2 = max(that, GI irradiance / the probe irradiance it
// replaced). A sealed room then reflects no sky (the owner's grey sheen on a shiny wood floor, the
// lit-looking quilted walls). Pixels the RT reflections trace (RT mark this frame, spec roughness
// under its threshold) keep their specular: their rays are occluded already.
SurfaceRefl deferReflIn(SurfaceLit s)
{
    SurfaceRefl r = deferReflInBase(s);
    if (giFrameOn() && s.model != SURF_FULLBRIGHT && (gi.cfg.x & GI_F_ON) != 0u)
    {
        bool ok;
        float skyVis;
        vec3 E = deferGiFetch(g_ds_P, s.N, ok, skyVis);
        if (ok && !any(isnan(E)) && !any(isinf(E)))
        {
            E = max(E, vec3(0.0)) * max(gi.prm.x, 0.0);
            const vec3 probeIrr = r.irr;
            const vec3 Ec = atmosClassic() ? atmosLinearToSrgb(E) : E;
            r.irr = max(Ec, probeIrr * clamp(gi.prm.y, 0.0, 1.0));
            // (cel shading's sky-ambient reference: clean_surface_light.glsl g_gi_amb_occ)
            if ((gi.cfg.x & GI_F_CEL_OCC) != 0u) g_gi_amb_occ = max(skyVis, clamp(gi.prm.y, 0.0, 1.0));
            // (GI_F_HAZE_OCC) the haze's sky in-scatter x min(1, 2 x sky visibility): a sealed room 0, a
            // wall under open sky (half the hemisphere) 1, open ground 1
            if ((gi.cfg.x & GI_F_HAZE_OCC) != 0u) g_haze_sky_k = clamp(2.0 * skyVis, clamp(gi.prm.y, 0.0, 1.0), 1.0);
            const uint so = (gi.cfg.x >> GI_SPECOCC_SHIFT) & 3u;
            const bool rtFrame = (g_draw_push.flags & DEFER_FLAG_RT_MARK) != 0u;
            const bool rtTraced = rtFrame && dsSpecRough(s) < float(g_draw_push.flags >> 24u) * (1.0 / 255.0);
            // RT RESIDUAL (GI_F_SPECOCC_RT_RES): an RT-marked pixel's words hold the traced radiance
            // (occluded already) PLUS the probe env its splice left -- a neighbour ray that missed, no
            // ray on its plane (thin / curved silhouettes: mane strands, ears), the roughness /
            // distance / strength fades. Only that residual takes the occlusion (the resolve wrote it
            // into the mark: pass 13). A pixel under the roughness threshold the mark passes did NOT
            // take (strength cutoff, far receiver) is plain probe + SSR: fully occluded. Off: the old
            // rule (every pixel under the threshold keeps its specular).
            bool rtRes = false, rtSkip = rtTraced;
            vec3 resS = vec3(0.0), resE = vec3(0.0);
            if ((gi.cfg.x & GI_F_SPECOCC_RT_RES) != 0u && rtFrame)
            {
                rtSkip = false;
                const ivec2 px = ivec2(CLEAN_FRAG_XY);
                const uint tilesX = (g_draw_push.width + 7u) / 8u;
                if (rtt_words[uint(px.y >> 3) * tilesX + uint(px.x >> 3)] != 0u)   // (unlisted: a stale mark)
                {
                    const uvec4 m = imageLoad(uReflRtMark, px);
                    if (m.z != 0u)
                    {
                        rtRes = true;
                        resS = dsUnpackRGB9E5(m.x);
                        resE = dsUnpackRGB9E5(m.y);
                    }
                }
            }
            if (so != 0u && !rtSkip)
            {
                float occ = skyVis;
                if (so == 2u)
                {
                    const float pl = giLum(probeIrr);
                    occ = max(occ, pl > 1e-4 ? clamp(giLum(Ec) / pl, 0.0, 1.0) : 1.0);
                }
                occ = max(occ, clamp(gi.prm.y, 0.0, 1.0));   // (the minimum ambient floors it too)
                if (rtRes)
                {
                    r.spec = max(r.spec - (1.0 - occ) * resS, vec3(0.0));
                    r.env = max(r.env - (1.0 - occ) * resE, vec3(0.0));
                }
                else
                {
                    r.spec *= occ;
                    r.env *= occ;
                }
            }
        }
    }
    return r;
}
