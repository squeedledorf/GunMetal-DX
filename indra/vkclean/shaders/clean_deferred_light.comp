        const int bin = hit ? clamp(int(floor(log2(max(g_rc_hitd, 1e-3) * 0.5))) + 1, 0, 5) : -1;
        [[unroll]] for (int k = 0; k < 6; ++k) v[RTR_COST_HIST + k] = bin == k ? 1u : 0u;
        v[RTR_COST_MISS]      = hit ? 0u : 1u;
        v[RTR_COST_TRAV]      = g_rc_trav;
        v[RTR_COST_RETR]      = g_rc_retr;
        v[RTR_COST_RETRACED]  = (g_rc_flags & RC_RETRACED) != 0u ? 1u : 0u;
        v[RTR_COST_CAND]      = g_rc_cand;
        v[RTR_COST_BUDGET]    = (g_rc_flags & RC_BUDGET) != 0u ? 1u : 0u;
        v[RTR_COST_SEGMENTED] = (g_rc_flags & RC_SEGMENTED) != 0u ? 1u : 0u;
        v[RTR_COST_SEG2]      = (g_rc_flags & RC_SEG2) != 0u ? 1u : 0u;
        v[RTR_COST_HIT1]      = (g_rc_flags & RC_HIT1) != 0u ? 1u : 0u;
        v[RTR_COST_HIT2]      = (g_rc_flags & RC_HIT2) != 0u ? 1u : 0u;
        v[RTR_COST_SEGD]      = (g_rc_flags & RC_SEGMENTED) != 0u ? uint(clamp(g_rc_segd * 4.0, 0.0, 4095.0)) : 0u;
        if (g_rc_rho >= 0.0)
        {
            const float r = g_rc_rho;
            v[RTR_COST_RHO + 0] = r >= 0.5 ? 1u : 0u;
            v[RTR_COST_RHO + 1] = (r < 0.5 && r >= 0.125) ? 1u : 0u;
            v[RTR_COST_RHO + 2] = (r < 0.125 && r >= 1.0 / 32.0) ? 1u : 0u;
            v[RTR_COST_RHO + 3] = r < 1.0 / 32.0 ? 1u : 0u;
            v[RTR_COST_RHOSUM]  = uint(clamp(r, 0.0, 1.0) * 256.0 + 0.5);
        }
        v[RTR_COST_AMTEST] = g_rc_amtest;
        v[RTR_COST_AMREJ]  = g_rc_amrej;
        [[unroll]] for (int k = 0; k < RTR_COST_WORDS; ++k)
        {
            const uint t = subgroupAdd(v[k]);
            if (subgroupElect() && t != 0u) atomicAdd(rtt_cost[k], t);
        }
        {
            const uint t = subgroupAdd(g_rc_amresc);
            if (subgroupElect() && t != 0u) atomicAdd(rtt_amresc, t);
        }
    }
    // (#869) the light grid's hit counters -> its header's stat[3 .. 9] (bytes / halves unpacked
    // first: a subgroup sum would carry across the packed fields)
    if (rtrRegirOn())   // (push constant: uniform)
    {
        const uint a5 = g_rtr_stat[5], a6 = g_rtr_stat[6];
        const uint v[7] = uint[7](a5 & 0xFFu, (a5 >> 8) & 0xFFu, (a5 >> 16) & 0xFFu, a5 >> 24,
                                  a6 & 0xFFFFu, g_rtr_stat[7], a6 >> 16);
        [[unroll]] for (int k = 0; k < 7; ++k)
        {
            const uint t = subgroupAdd(v[k]);
            if (subgroupElect() && t != 0u) atomicAdd(rg.stat[3 + k], t);
        }
    }
    CLK_MARK(STORE);
