        // (#1009 CLUSTER STATICS, clean_regir.glsl) a cluster-traced static's legacy row -- (not in the TLAS /
        // rigged / a cluster row without one: no static triangles to list). Read as `geo` below: every word
        // the records, the signature and the geometry key take from a row is this one's.
        const uvec4 geo = rtGeomEmRow(id, clOn);
        const uint fl = rt_instances[id].flags;
        if ((geo.w & 0x7FFFFFFFu) == 0u) { if (skipOn) emSkipNote(id, fl, nMat, thr); continue; }
        const bool clRow = (rt_geom[id].z & RT_GEOM_CLUSTER) != 0u;
        if ((fl & (512u | 8192u | 32u | 2048u)) != 0u)   // (worn / attached / terrain / water)
        {
            if (skipOn) emSkipNote(id, fl, nMat, thr);
            continue;
        }
        const uint mi = rt_instances[id].material_id;
        if (mi >= nMat) continue;
        vec3 F, Lavg;
        uint tex, ef;
        const float lum = emMatEmission(id, fl, mi, F, Lavg, tex, ef);
        if (!(lum > thr)) continue;
        // ---- the bound: the oriented instance box's centre + radius ----
        const mat4 Wm = rt_instances[id].model_matrix;
        const vec3 lo = rt_instances[id].aabb_min.xyz, hi = rt_instances[id].aabb_max.xyz;
        const vec3 h = 0.5 * abs(hi - lo);
        const vec3 c = (Wm * vec4(0.5 * (lo + hi), 1.0)).xyz;
        const vec3 l = h * vec3(length(Wm[0].xyz), length(Wm[1].xyz), length(Wm[2].xyz));
        const float r = length(l);
        if (any(isnan(c)) || any(isinf(c)) || !(r < 1e4)) continue;
        // ---- the RANGE (one for the whole emitter): a white surface facing it at distance d reflects
        //      ~ lum x area / (pi d^2) -> the cutoff; the area from up to 32 strided triangles ----
        const uint nTri = (geo.w & 0x7FFFFFFFu) / 3u;
        if (nTri == 0u) continue;
        const uint ns = min(nTri, 32u);
        const uint st = nTri / ns;
        const mat3 M = mat3(Wm);
        uvec2 sig = uvec2(2166136261u, 0x51ED27u);
        float area = 0.0;
        for (uint t = 0u; t < ns; ++t) area += emTriArea(id, geo, t * st, M, sig);
        area *= float(nTri) / float(ns);
        const float range = min(sqrt(lum * area / (EM_PI * cutoff)), rangeMax);
        if (!(range > 0.0)) continue;
        // ---- (LIGHT TAKEOVER) a face of an SL point light's prim: its own table row as its entry (the
        //      host cleared rows [0, T) and started the counter at T: no competition, laid out first) ----
        uint e = REGIR_EM_NONE, tli = 0u;
        bool take = false;
        if (takeOn)
        {
            const uint row = emTakeFind(id, tli);
            take = row != REGIR_EM_NONE && row < REGIR_EM_INST_CAP && emTakeLightOk(tli, glo, ghi);
            if (take) e = row;
        }
        if (!take)
        {
            {   // (a takeover light is wholly inside the grid: this test is for the others)
                const vec3 dq = clamp(c, glo, ghi) - c;
                const float rr = range + r;
                if (!(dot(dq, dq) < rr * rr)) continue;   // (its range misses the grid)
            }
            e = atomicAdd(rg.rs_em_cfg.w, 1u);
            if (e >= REGIR_EM_INST_CAP) { atomicAdd(rg.rs_em.y, nTri); continue; }   // (dropped: keeps its GI emission)
        }
        atomicAdd(rg.rs_em_cfg.y, nTri);
        if (clRow && statOn) atomicAdd(rg_cells[emCcHdr(EM_CCH_CLUSTER)].x, 1u);   // (#1009 stats)
        if (clRow && statOn) atomicAdd(rg_cells[emCcHdr(EM_CCH_CLUSTER)].y, nTri);
        const bool two = (fl & 256u) != 0u;
        // (#1006 WEAK OVERLAY, clean_regir.glsl) its POWER (the average radiance luminance x the area: what the
        // range is made of) below the threshold: WEAK -- the overlay instead of level 0 (never a takeover row)
        const float wthr = rg.rs_em_params.w;
        const bool weak = emWeakOn() && !take && wthr > 0.0 && lum * area < wthr;
        if (weak)
        {
            ef |= EM_R_WEAK;
            atomicAdd(rg_cells[emCcHdr(EM_CCH_STAT + 2u)].x, 1u);
        }
        // (#1006 INCREMENTAL CELLS) the GEOMETRY KEY: where its triangles are -- the sampled vertex positions
        // (in sig so far), the model matrix, the geometry row; never its colour (the cells' signature)
        uint gkey;
        {
            uvec2 g = sig;
            emSigV(g, Wm[0]); emSigV(g, Wm[1]); emSigV(g, Wm[2]); emSigV(g, Wm[3]);
            emSig(g, geo.x); emSig(g, geo.y); emSig(g, geo.w);
            gkey = g.x ^ regirHash(g.y);
        }
        // the power weight A c: the face's area x the average over all directions of its projected area
        // per unit area (1/4 one-sided, 1/2 two-sided) -- mode 1's calibration of a takeover
        const float ac = area * (two ? 0.5 : 0.25);
        // (#986 RECORD REUSE) the rest of the content signature: everything else the records are made of
        // (emRecWrite's inputs; the entry's own words below cover the factor, texture, average, range)
        emSigV(sig, Wm[0]); emSigV(sig, Wm[1]); emSigV(sig, Wm[2]); emSigV(sig, Wm[3]);
        {
            const mat4 U = rt_instances[id].uv_matrix;
            emSigV(sig, U[0]); emSigV(sig, U[1]); emSigV(sig, U[2]); emSigV(sig, U[3]);
        }
        emSigV(sig, rt_instances[id].tint);
        emSigV(sig, mat_uv[mi].rows[MAP_EMISSIVE * 2]);
        emSigV(sig, mat_uv[mi].rows[MAP_EMISSIVE * 2 + 1]);
        emSig(sig, geo.x); emSig(sig, geo.y); emSig(sig, geo.w); emSig(sig, fl); emSig(sig, mi);
        emSig(sig, tex); emSig(sig, ef | (two ? EM_R_TWOSIDED : 0u));
        emSigV(sig, vec4(F, range));
        emSigV(sig, vec4(Lavg, thr));
        // (texture-animated: UVs and colour at this frame's draw time; a takeover row: its gain follows the
        // light every frame -- never reused)
        const uint dyn = ((fl & 1024u) != 0u || take) ? EM_E_DYN : 0u;
        const uint b = emEntWordP(par, e);
        rg_cells[b + 0u] = uvec2(id, nTri);
        rg_cells[b + 1u] = uvec2(0u);   // (mode 1: the block)
        rg_cells[b + 2u] = uvec2(1u, 0u);
        rg_cells[b + 3u] = uvec2(floatBitsToUint(F.r), floatBitsToUint(F.g));
        rg_cells[b + 4u] = uvec2(floatBitsToUint(F.b), tex);
        rg_cells[b + 5u] = uvec2(floatBitsToUint(range), ef | (two ? EM_R_TWOSIDED : 0u));
        // (the whole texture's luminance: animation-invariant; the takeover's light + 1)
        rg_cells[b + 6u] = uvec2(floatBitsToUint(lum), take ? tli + 1u : 0u);
        rg_cells[b + 7u] = uvec2(floatBitsToUint(Lavg.r), floatBitsToUint(Lavg.g));
        rg_cells[b + 8u] = uvec2(floatBitsToUint(Lavg.b), floatBitsToUint((ac > 0.0 && ac < 3.0e38) ? ac : 0.0));
        rg_cells[b + 9u] = uvec2(floatBitsToUint(1.0), floatBitsToUint(1.0));   // (mode 1: a taken light's gain)
        rg_cells[b + 10u] = uvec2(floatBitsToUint(1.0), floatBitsToUint(-1.0));   // (... and its falloff; < 0: none)
        rg_cells[b + 11u] = sig;
        rg_cells[b + 12u] = uvec2(REGIR_EM_NONE, dyn);   // (mode 1: the last build's block to copy)
        rg_cells[emEntXWord(par, e)] = uvec2(0u, gkey);   // (#1006; mode 1: the reach range)
    }
}
// mode 1 (ONE workgroup): every emitter's block -- its record count (every s-th triangle from a random
// offset when the emitters' triangles exceed the cap), the blocks laid out in entry order by a prefix sum
// (64 entries per step), the hash entry of each emitter whose block fits, and (#986 RECORD REUSE) the
// last build's block of an unchanged emitter.
void emTakeVerdict(uint lid, uint nTake);
void emBlockAlloc()
{
    const uint lid = gl_LocalInvocationIndex;
    if (gl_WorkGroupID.x != 0u || gl_WorkGroupID.y != 0u) return;   // (the host dispatches one)
    const uint par = emParity();
    const bool reuseOn = (rg.rs_em_cfg.z & EM_F_REUSE) != 0u;
    const uint nEnt = emEntCount();
    const uint cap = min(rg.rs_em.z, REGIR_EM_CAP);
    const uint T = rg.rs_em_cfg.y;
    // the SUBSET stride: 1 while every emitter's triangles fit the cap, else one s for all (keeping a
    // reserve of one record per emitter for each block's rounding up)
    const uint room = max(cap > nEnt ? cap - nEnt : 0u, cap / 2u);
    const uint s = T <= cap ? 1u : (T + room - 1u) / max(room, 1u);
    if (lid == 0u) atomicOr(rg.rs_em.w, nEnt << 1u);   // (stats; bit 0, the parity, unchanged)
    if (lid == 0u) rg_cells[emCcHdr(0u)].x += 1u;      // (#1006: this build's stamp -- every later mode reads it)
    uint run = 0u;   // (uniform) the records of the earlier steps' blocks
    for (uint c = 0u; c < nEnt; c += 64u)
    {
        const uint e = c + lid;
        uvec2 w0 = uvec2(0u);
        uint off = 0u, kept = 0u;
        if (e < nEnt)
        {
            w0 = rg_cells[emEntWord(e)];   // instance, triangles
            off = s > 1u ? regirHash(w0.x ^ 0x51ED27u) % s : 0u;   // (fixed per object: no frame noise)
            kept = w0.y > off ? (w0.y - off + s - 1u) / s : 0u;
        }
        barrier();
        s_emScan[lid] = kept;
        barrier();
        for (uint d = 1u; d < 64u; d <<= 1u)
        {
            const uint v = lid >= d ? s_emScan[lid - d] : 0u;
            barrier();
            s_emScan[lid] += v;
            barrier();
        }
        const uint first = run + s_emScan[lid] - kept;
        // a block past the cap is dropped whole (and so is every later one: the written slots stay
        // [0, rs_em.x))
        const uint k = (first < cap && cap - first >= kept) ? kept : 0u;
        if (e < nEnt)
        {
            const uint eb = emEntWordP(par, e);
            rg_cells[eb + 1u] = uvec2(first, k);
            rg_cells[eb + 2u] = uvec2(s, off);
            if (k > 0u)
            {
                atomicAdd(rg.rs_em.x, k);
                // the hash: instance -> entry (each instance once per build; load <= 0.5 -- a free entry exists)
                uint hs = emHashSlot(w0.x);
                [[dont_unroll]] for (uint i = 0u; i < REGIR_EM_HASH_N; ++i)
                {
                    const uint hw = emHashWord(par, hs);
                    if (atomicCompSwap(rg_cells[hw].x, 0u, w0.x + 1u) == 0u)
                    {
                        rg_cells[hw].y = e;
                        break;
                    }
                    hs = (hs + 1u) & (REGIR_EM_HASH_N - 1u);
                }
                // (#986 RECORD REUSE) the same instance in the LAST build's hash with the same signature,
                // triangle count, subset and block size: mode 2 copies its records from that block. Not a
                // dynamic one, not this build's rolling refresh share (every EM_REFRESH builds per emitter).
                uint reuse = REGIR_EM_NONE;
                const uvec2 w12 = rg_cells[eb + 12u];
                const bool refresh = ((regirHash(w0.x ^ 0xC0FFEEu) + rg.cfg.w) % EM_REFRESH) == 0u;
                if (reuseOn && (w12.y & EM_E_DYN) == 0u && !refresh)
                {
                    const uint pe = emHashFindP(par ^ 1u, w0.x);
                    if (pe != REGIR_EM_NONE)
                    {
                        const uint pb = emEntWordP(par ^ 1u, pe);
                        const uvec2 pk = rg_cells[pb + 1u];
                        if (rg_cells[pb] == w0 && rg_cells[pb + 2u] == uvec2(s, off) && pk.y == k
                            && pk.x < REGIR_EM_CAP && REGIR_EM_CAP - pk.x >= k
                            && rg_cells[pb + 11u] == rg_cells[eb + 11u] && (rg_cells[pb + 12u].y & EM_E_DYN) == 0u)
                            reuse = pk.x;
                    }
                }
                rg_cells[eb + 12u].x = reuse;
            }
            if (w0.y > k) atomicAdd(rg.rs_em.y, w0.y - k);   // (not in this frame's subset, or dropped)
        }
        run += s_emScan[63];
    }
    // ---- (LIGHT TAKEOVER, clean_regir.glsl) per light of the table, over its rows (its faces' entries):
    //      TAKEN when every written row's block was laid out whole -- then its gain G into each row and its
    //      bit in rs_em_take; else every row stays an ordinary emitter and the point light stays ----
    // (a uniform branch: header words)
    const uint nTake = (rg.rs_em_cfg.z & EM_F_TAKE) != 0u ? min(min(rg.rs_em_take_cfg.x, REGIR_EM_TAKE_N), nEnt) : 0u;
    if (nTake != 0u) emTakeVerdict(lid, nTake);
    // ---- (#1006 INCREMENTAL CELLS, clean_regir.glsl REACH RANGE) every emitter with records: its reach range
    //      Rg -- the last build's, while the same instance has the same geometry key and range <= Rg <= 2 x
    //      range; else its range now (the cell lists' candidate test uses it: a brightness change inside that
    //      band moves no list edge) ----
    memoryBarrierBuffer();   // (the blocks and the takeover's words above: written by other lanes)
    barrier();
    const bool last = (rg.rs_em_cfg.z & EM_F_LAST) != 0u;
    for (uint e = lid; e < nEnt; e += 64u)
    {
        const uint eb = emEntWordP(par, e);
        const uvec2 w0 = rg_cells[eb];
        if (w0.y == 0u || rg_cells[eb + 1u].y == 0u) continue;   // (no records this build)
        // the range its records carry (emRecWrite): a taken light's radius, else the emitter's own
        const uvec2 w6 = rg_cells[eb + 6u];
        const bool take = w6.y != 0u && uintBitsToFloat(rg_cells[eb + 10u].y) >= 0.0;
        const float range = take ? lights[w6.y - 1u].pos_radius.w : uintBitsToFloat(rg_cells[eb + 5u].x);
        const uint gk = rg_cells[emEntXWord(par, e)].y;
        float Rg = range;
        if (last)
        {
            const uint pe = emHashFindP(par ^ 1u, w0.x);
            if (pe != REGIR_EM_NONE)
            {
                const uvec2 px = rg_cells[emEntXWord(par ^ 1u, pe)];
                const float pr = uintBitsToFloat(px.x);
                if (px.y == gk && range <= pr && range >= 0.5 * pr && pr < 3.0e38) Rg = pr;
            }
        }
        rg_cells[emEntXWord(par, e)].x = floatBitsToUint((Rg > 0.0 && Rg < 3.0e38) ? Rg : 0.0);
    }
}
// (LIGHT TAKEOVER, mode 1's tail) the verdict and gain per light of the table (lane lid of the workgroup)
void emTakeVerdict(uint lid, uint nTake)
{
    memoryBarrierBuffer();   // (the blocks above: written by other lanes)
    barrier();
    const uint nLights = min(uint(linfo.cam_pos.w), 256u);
    for (uint li = lid; li < nLights; li += 64u)
    {
        const uvec2 rr = rg_cells[REGIR_EM_TAKE_BASE + li];   // (first row, rows)
        const uint r1 = min(rr.x + rr.y, nTake);
        float sa = 0.0;
        vec3 sl = vec3(0.0);
        bool bad = false;
        uint nw = 0u;
        for (uint e = rr.x; e < r1; ++e)
        {
            const uint eb = emEntWord(e);
            const uvec2 w0 = rg_cells[eb];
            if (w0.y == 0u || rg_cells[eb + 6u].y != li + 1u) continue;   // (no emitter this frame / not taken over)
            const uvec2 fk = rg_cells[eb + 1u], so = rg_cells[eb + 2u];
            const uint st = max(so.x, 1u);
            const uint kept = w0.y > so.y ? (w0.y - so.y + st - 1u) / st : 0u;
            if (fk.y < kept) { bad = true; break; }   // (a block past the cap: its light would be missing)
            if (fk.y == 0u) continue;
            const uvec2 w7 = rg_cells[eb + 7u], w8 = rg_cells[eb + 8u];
            const float ac = uintBitsToFloat(w8.y);
            if (!(ac > 0.0)) continue;
            sa += ac;
            sl += uintBitsToFloat(uvec3(w7, w8.x)) * ac;
            ++nw;
        }
        if (nw == 0u && !bad) continue;   // (no face of it emits this frame: nothing to take over)
        // THE GAIN (rgb): sum L' A c / (R/3)^2 = the point light's PBR irradiance 3.25 x 0.96 x atten(1/3) C
        // at R/3 -- the rows' power-weighted average radiance Cw scaled per channel to the light's colour
        // (the floor only bounds a channel the glass barely has)
        const vec4 cf = lights[li].color_falloff;
        const float R = lights[li].pos_radius.w;
        const vec3 Cw = sl / max(sa, 1e-30);
        const float cm = max(max(Cw.r, Cw.g), Cw.b);
        const float dr = R * (1.0 / 3.0);
        const float K = 3.25 * 0.96 * regirAtten(1.0 / 3.0, cf.w) * dr * dr / max(sa, 1e-30);
        const vec3 G = max(cf.rgb, vec3(0.0)) * K / max(Cw, vec3(0.05 * cm + 1e-12));
        const bool ok = !bad && sa > 0.0 && cm > 0.0 && !any(isnan(G)) && !any(isinf(G)) && all(lessThan(G, vec3(1e30)));
        if (!ok) { atomicAdd(rg.rs_em_take_cfg.z, 1u); continue; }
        const float f = max(cf.w, 0.0);
        for (uint e = rr.x; e < r1; ++e)
        {
            const uint eb = emEntWord(e);
            if (rg_cells[eb].y == 0u || rg_cells[eb + 6u].y != li + 1u) continue;
            rg_cells[eb + 9u] = uvec2(floatBitsToUint(G.r), floatBitsToUint(G.g));
            rg_cells[eb + 10u] = uvec2(floatBitsToUint(G.b), floatBitsToUint(f));
        }
        atomicOr(rg.rs_em_take[li >> 5u], 1u << (li & 31u));
        atomicAdd(rg.rs_em_take_cfg.y, 1u);
    }
}
// One record (mode 2): slot's emitter (a binary search over the blocks' first slots), its mesh triangle
// offset + j s, written in world space with the map's UVs and its own average radiance -- or (#986 RECORD
// REUSE: mode 1 found the emitter unchanged) copied from the last build's record of the same triangle.
// True: a light, bnd = the sphere its light reaches (centre, radius + range).
bool emRecWrite(uint slot, uint nEnt, uint par, float thr, out vec4 bnd, out bool copied)
{
    bnd = vec4(0.0);
    copied = false;
    rt_anim_time = pc.u_cam_time.w;   // (draw time: texture animation, as the raster)
    // the last entry whose block starts at or before the slot (blocks are in entry order; an empty
    // block shares its start with the next one, so the last such entry is the one holding the slot)
    uint lo = 0u, hi = nEnt - 1u;
    while (lo < hi)
    {
        const uint mid = (lo + hi + 1u) >> 1u;
        if (rg_cells[emEntWord(mid) + 1u].x <= slot) lo = mid; else hi = mid - 1u;
    }
    const uint eb = emEntWord(lo);
    const uvec2 fk = rg_cells[eb + 1u];
    if (slot < fk.x || slot - fk.x >= fk.y) return false;   // (never: the blocks tile [0, rs_em.x))
    const uvec2 w0 = rg_cells[eb], so = rg_cells[eb + 2u];
    const uint id = w0.x;
    const uint prim = so.y + (slot - fk.x) * so.x;
    {   // (#1006 INCREMENTAL CELLS, clean_regir.glsl) the record's side words -- its emitter's reach range and its
        // PAIR KEY (the cells' signature term: which triangle, where) -- and THE FORWARD MAP: the last build's
        // slot of this very triangle (the same instance in the last hash, its subset holding this mesh
        // triangle, checked against that record's (instance, triangle) word) -> this slot
        const uvec2 ex = rg_cells[emEntXWord(par, lo)];
        rg_cells[emRecXWord(par, slot)] = uvec2(ex.x, regirHash((id * 2654435761u) ^ regirHash(prim ^ ex.y)));
        if ((rg.rs_em_cfg.z & EM_F_LAST) != 0u)
        {
            const uint pe = emHashFindP(par ^ 1u, id);
            if (pe != REGIR_EM_NONE)
            {
                const uint pb = emEntWordP(par ^ 1u, pe);
                const uvec2 pfk = rg_cells[pb + 1u], pso = rg_cells[pb + 2u];
                const uint ps = max(pso.x, 1u);
                if (prim >= pso.y && (prim - pso.y) % ps == 0u)
                {
                    const uint j = (prim - pso.y) / ps;
                    const uint os = pfk.x + j;
                    if (j < pfk.y && os < REGIR_EM_CAP && rg_cells[emRecWord(par ^ 1u, os) + 11u] == uvec2(id, prim))
                        emFwdPut(os, slot);
                }
            }
        }
    }
    {   // (#986 RECORD REUSE) the last build's record of this very triangle (checked: its (instance, triangle))
        const uint ps = rg_cells[eb + 12u].x;
        const uint src = emRecWord(par ^ 1u, min(ps, REGIR_EM_CAP - 1u) + (slot - fk.x));
        if (ps != REGIR_EM_NONE && ps + (slot - fk.x) < REGIR_EM_CAP && rg_cells[src + 11u] == uvec2(id, prim))
        {
            const uint b = emRecWord(par, slot);
            [[unroll]] for (uint k = 0u; k < REGIR_EM_WORDS; ++k) rg_cells[b + k] = rg_cells[src + k];
            copied = true;
            const vec3 v0 = uintBitsToFloat(uvec3(rg_cells[src], rg_cells[src + 1u].x));
            const vec3 e1 = uintBitsToFloat(uvec3(rg_cells[src + 1u].y, rg_cells[src + 2u]));
            const vec3 e2 = uintBitsToFloat(uvec3(rg_cells[src + 3u], rg_cells[src + 4u].x));
            const float lumSel = uintBitsToFloat(rg_cells[src + 4u].y);
            const float range = uintBitsToFloat(rg_cells[src + 6u].y);
            vec3 cen;
            float r;
            emTriBound(e1, e2, cen, r);
            bnd = vec4(v0 + cen, r + range);
            return range > 0.0 && lumSel > 0.0 && !any(isnan(bnd)) && !any(isinf(bnd));
        }
    }
    const uvec2 w3 = rg_cells[eb + 3u], w4 = rg_cells[eb + 4u], w5 = rg_cells[eb + 5u];
    const float lumInst = uintBitsToFloat(rg_cells[eb + 6u].x);
    const uint fl = rt_instances[id].flags;
    const uint mi = rt_instances[id].material_id;
    const mat4 Wm = rt_instances[id].model_matrix;
    const uint tex = w4.y;
    const uint ef = w5.y;
    // (LIGHT TAKEOVER, clean_regir.glsl) a taken light's row: its gain on every radiance of the record,
    // the light's radius as the range and its falloff for the takeover window
    const uvec2 w6 = rg_cells[eb + 6u], w10 = rg_cells[eb + 10u];
    const float tkF = uintBitsToFloat(w10.y);
    const bool take = w6.y != 0u && tkF >= 0.0;
    const vec3 G = take ? vec3(uintBitsToFloat(rg_cells[eb + 9u]), uintBitsToFloat(w10.x)) : vec3(1.0);
    const vec3 F = uintBitsToFloat(uvec3(w3, w4.x)) * G;
    const float range = take ? lights[w6.y - 1u].pos_radius.w : uintBitsToFloat(w5.x);
    // the emitter's geometry row, as mode 0 read it (the same buffers this frame; #1009: a CLUSTER STATIC's
    // legacy row)
    const uvec4 eg = rtGeomEmRow(id, emClusterOn());
    const uint vb = eg.y;
    const QvHeader qh = rtHdr(vb);
    const uvec3 tri = emTriIndices(id, eg, prim);
    vec3 p0, p1, p2;
    emTriPositions(id, eg, prim, p0, p1, p2);
    const vec3 v0 = (Wm * vec4(p0, 1.0)).xyz;
    const vec3 e1 = (Wm * vec4(p1, 1.0)).xyz - v0, e2 = (Wm * vec4(p2, 1.0)).xyz - v0;
    // the sampled map's UV: PBR -- the emissive map's own transform of the raw UV where it has one
    // (clean_rt_surface.glsl rtSurfMapUV's rule); legacy -- the base face UV
    const bool own = (ef & EM_R_PBR) != 0u && (fl & 1024u) == 0u && matMapOwnUV(mi, MAP_EMISSIVE);
    vec2 u[3];
    [[unroll]] for (uint k = 0u; k < 3u; ++k)
    {
        const uint v = vb + tri[k];
        u[k] = rtVertexFaceUV(id, fl, qh, v);
        if (own)
            u[k] = matMapUV(mi, MAP_EMISSIVE,
                            cleanFaceRawUV(fl, rtVertUV(qh, v), rtVertNormal(v), rtVertPos(qh, v), Wm), u[k]);
    }
    // the triangle's own average radiance: its texture at the centroid's UV, at the mip where the
    // triangle is about one texel
    vec3 Lt = F;
    if (tex != EM_NO_TEX)
    {
        const vec2 ts = vec2(textureSize(uTextures[nonuniformEXT(tex)], 0));
        const vec2 du1 = u[1] - u[0], du2 = u[2] - u[0];
        const float texels = 0.5 * abs(du1.x * du2.y - du1.y * du2.x) * ts.x * ts.y;
        const float lod = 0.5 * log2(max(texels, 1.0));
        Lt *= textureLod(uTextures[nonuniformEXT(tex)], (u[0] + u[1] + u[2]) * (1.0 / 3.0),
                         (lod < 64.0) ? lod : 0.0).rgb;
    }
    Lt = max(Lt, vec3(0.0));
    const float lumT = pdnLum(Lt);
    // THE SELECTION LUMINANCE (cell targets, RIS targets): a TEXTURE-ANIMATED face's texture slides over
    // its triangles every frame, so its per-triangle average does too -- it takes the whole texture's
    // (the emitter's; a scroll does not change it) and every triangle is a light; a static face its own
    // (a triangle on a dark part of the texture is no light). The colour (Lt) is this frame's either way.
    const bool anim = (fl & 1024u) != 0u;
    const float lumSel = !anim ? lumT
                       : take ? pdnLum(uintBitsToFloat(uvec3(rg_cells[eb + 7u], rg_cells[eb + 8u].x)) * G) : lumInst;
    const float ar = 0.5 * length(cross(e1, e2));
    bool live = lumSel > 0.02 * thr && ar > 1e-8 && ar < 1e8;
    live = live && !any(isnan(v0)) && !any(isinf(v0)) && !any(isnan(e1)) && !any(isnan(e2));
    const float ws = float(max(so.x, 1u));   // (the subset weight: in with probability 1 / s)
    const vec3 Fw = F * ws;
    const uint b = emRecWord(par, slot);
    rg_cells[b + 0u]  = uvec2(floatBitsToUint(v0.x), floatBitsToUint(v0.y));
    rg_cells[b + 1u]  = uvec2(floatBitsToUint(v0.z), floatBitsToUint(e1.x));
    rg_cells[b + 2u]  = uvec2(floatBitsToUint(e1.y), floatBitsToUint(e1.z));
    rg_cells[b + 3u]  = uvec2(floatBitsToUint(e2.x), floatBitsToUint(e2.y));
    rg_cells[b + 4u]  = uvec2(floatBitsToUint(e2.z), floatBitsToUint(live ? lumSel * ws : 0.0));
    rg_cells[b + 5u]  = uvec2(floatBitsToUint(Fw.r), floatBitsToUint(Fw.g));
    rg_cells[b + 6u]  = uvec2(floatBitsToUint(Fw.b), floatBitsToUint(live ? range : 0.0));
    rg_cells[b + 7u]  = floatBitsToUint(u[0]);
    rg_cells[b + 8u]  = floatBitsToUint(u[1]);
    rg_cells[b + 9u]  = floatBitsToUint(u[2]);
    rg_cells[b + 10u] = uvec2(tex, (ef & (EM_R_TWOSIDED | EM_R_WEAK)) | (take ? EM_R_TAKE : 0u));
    rg_cells[b + 11u] = uvec2(id, prim);
    rg_cells[b + 12u] = uvec2(floatBitsToUint(Lt.r * ws), floatBitsToUint(Lt.g * ws));
    rg_cells[b + 13u] = uvec2(floatBitsToUint(Lt.b * ws), floatBitsToUint(take ? tkF : -1.0));
    // the bounding sphere of its light: the triangle's own + the range
    vec3 cen;
    float r;
    emTriBound(e1, e2, cen, r);
    bnd = vec4(v0 + cen, r + range);
    return live && !any(isnan(bnd)) && !any(isinf(bnd));
}
// mode 2: one workgroup per GROUP of 64 consecutive records (grid-stride) -- each lane writes one record,
// the workgroup the group's box (the union of its lights' reach spheres; empty: lo > hi), the cell build's
// first cull.
uint emOrd(float f) { const uint u = floatBitsToUint(f); return (u & 0x80000000u) != 0u ? ~u : (u | 0x80000000u); }
float emOrdInv(uint u) { return uintBitsToFloat((u & 0x80000000u) != 0u ? (u & 0x7FFFFFFFu) : ~u); }
void emRecBuild()
{
    const uint lid = gl_LocalInvocationIndex;
    const uint nRec = emCount();
    const uint nEnt = emEntCount();
    const uint nGrp = (nRec + 63u) / 64u;
    const uint nWG = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
    const uint par = emParity();
    const float thr = max(rg.rs_em_params.x, 1e-4);
    uint nCopied = 0u, nBuilt = 0u;
    [[dont_unroll]] for (uint g = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x; g < nGrp; g += nWG)
    {
        barrier();
        if (lid < 3u) { s_emGLo[lid] = 0xFFFFFFFFu; s_emGHi[lid] = 0u; }
        barrier();
        const uint slot = g * 64u + lid;
        vec4 bnd;
        bool copied = false;
        if (slot < nRec && nEnt > 0u)
        {
            const bool lit = emRecWrite(slot, nEnt, par, thr, bnd, copied);
            if (copied) ++nCopied; else ++nBuilt;
            if (lit)
            {
                [[unroll]] for (uint i = 0u; i < 3u; ++i)
                {
                    atomicMin(s_emGLo[i], emOrd(bnd[i] - bnd.w));
                    atomicMax(s_emGHi[i], emOrd(bnd[i] + bnd.w));
                }
            }
        }
        barrier();
        if (lid == 0u)
        {
            const bool none = s_emGLo[0] > s_emGHi[0];
            const vec3 lo = none ? vec3(1e30) : vec3(emOrdInv(s_emGLo[0]), emOrdInv(s_emGLo[1]), emOrdInv(s_emGLo[2]));
            const vec3 hi = none ? vec3(-1e30) : vec3(emOrdInv(s_emGHi[0]), emOrdInv(s_emGHi[1]), emOrdInv(s_emGHi[2]));
            const uint b = emGrpWord(g);
            rg_cells[b + 0u] = floatBitsToUint(lo.xy);
            rg_cells[b + 1u] = floatBitsToUint(vec2(lo.z, hi.x));
            rg_cells[b + 2u] = floatBitsToUint(hi.yz);
        }
    }
    {   // (#986 stats: records copied / built, one atomic per subgroup)
        const uint c = subgroupAdd(nCopied), bt = subgroupAdd(nBuilt);
        if (subgroupElect() && c + bt != 0u)
        {
            atomicAdd(rg.rs_em_cache.x, c);
            atomicAdd(rg.rs_em_cache.y, bt);
        }
    }
}

// One step of the cell build's triangle walk: the records of group g that reach the workgroup's box
// [wlo, whi] -> s_emList / the compact copies (s_emN of them). Uniform.
void emChunk(uint par, uint g, uint nRec, vec3 wlo, vec3 whi)
{
    barrier();
    if (gl_LocalInvocationIndex == 0u) s_emN = 0u;
    barrier();
    const uint t = g * 64u + gl_LocalInvocationIndex;
    if (t < nRec)
    {
        vec4 cr, pl, la;
        const EmTri tr = emLoad(par, t);
        emTriCompact(tr, cr, pl, la);
        if (emReachBox(cr, pl, la, wlo, whi))
        {
            const uint i = atomicAdd(s_emN, 1u);
            s_emList[i] = t; s_emCr[i] = cr; s_emPl[i] = pl; s_emLa[i] = la;
            s_emV0[i] = vec4(tr.v0, uintBitsToFloat(tr.flags)); s_emE1[i] = vec4(tr.e1, tr.range);
            s_emE2[i] = vec4(tr.e2, tr.tkF); s_emCol[i] = vec4(tr.Lavg, 0.0);
        }
    }
    barrier();
}
// ---- (#986) CELL LISTS (clean_regir.glsl): the candidate triangles of every cell by a counting sort ----
// (#1006) the list words of any cell id: a clipmap cell's, or an overlay cell's (ids from REGIR_EM_NCELLS; their
// blocks from REGIR_EM_NCELLS / 64 -- cell >> 6 of an overlay id lands there)
uint emLCellWord(uint cell)
{
    return cell < REGIR_EM_NCELLS ? REGIR_EM_LCELL_BASE + cell : REGIR_EM_OV_LCELL_BASE + (cell - REGIR_EM_NCELLS);
}
uint emLBlkWord(uint b)
{
    return b < REGIR_EM_NCELLS / 64u ? REGIR_EM_LBLK_BASE + b : REGIR_EM_OV_LBLK_BASE + (b - REGIR_EM_NCELLS / 64u);
}
uint emPairGet(uint i)
{
    const uvec2 w = rg_cells[REGIR_EM_PAIR_BASE + (i >> 1u)];
    return (i & 1u) != 0u ? w.y : w.x;
}
void emPairPut(uint i, uint slot)
{
    if ((i & 1u) != 0u) rg_cells[REGIR_EM_PAIR_BASE + (i >> 1u)].y = slot;
    else                rg_cells[REGIR_EM_PAIR_BASE + (i >> 1u)].x = slot;
}
// The cell build reads the lists this build (else it gathers: the host's EM_F_GATHER, or mode 5 found the
// pairs past REGIR_EM_PAIR_CAP). Uniform (header words).
bool emListsOn() { return (rg.rs_em_cfg.z & EM_F_GATHER) == 0u && (rg.rs_em_cache.w & EM_C_GATHER) == 0u; }
// One lattice slice of the list walk: the cells of slice z of the lattice (origin o.xyz, edge o.w, dims, cell
// ids idBase + (z dy + y) dx + x) inside the record's reach box -- each whose emCellTarget > 0 counted (+ the
// #1006 SIGNATURE terms h) / given the record's slot r at its next place.
void emListSlice(bool fill, uint r, vec4 cr, vec4 pl, vec4 la, vec4 o, uvec3 dimsU, uint idBase, uint z, uvec2 h,
                 bool ovl)
{
    const vec3 dims = vec3(dimsU);
    const float pad = 2e-3 * o.w + 2e-3;   // (> regirCellBox's pad)
    const float rr = la.z + cr.w + pad;
    const vec3 qlo = (cr.xyz - rr - o.xyz) / o.w, qhi = (cr.xyz + rr - o.xyz) / o.w;
    if (any(isnan(qlo)) || any(isnan(qhi)) || any(greaterThanEqual(qlo, dims)) || any(lessThan(qhi, vec3(0.0))))
        return;
    const uvec3 clo = uvec3(clamp(floor(qlo), vec3(0.0), dims - 1.0));
    const uvec3 chi = uvec3(clamp(floor(qhi), vec3(0.0), dims - 1.0));
    if (z < clo.z || z > chi.z) return;
    [[dont_unroll]] for (uint y = clo.y; y <= chi.y; ++y)
    {
        [[dont_unroll]] for (uint x = clo.x; x <= chi.x; ++x)
        {
            const uint cell = idBase + (z * dimsU.y + y) * dimsU.x + x;
            vec3 lo, hi;
            if (ovl) emOvCellBox(cell - REGIR_EM_NCELLS, lo, hi);
            else     regirCellBox(cell, lo, hi);
            if (!(emCellTarget(cr, pl, la, lo, hi) > 0.0)) continue;
            const uint cw = emLCellWord(cell);
            if (!fill)
            {
                atomicAdd(rg_cells[cw].x, 1u);
                // (#1006) the cell's membership signature: two independent sums of the pair key
                atomicAdd(rg_cells[REGIR_EM_SIG_BASE + cell].x, h.x);
                atomicAdd(rg_cells[REGIR_EM_SIG_BASE + cell].y, h.y);
                continue;
            }
            const uint old = atomicAdd(rg_cells[cw].x, 0x10000u);
            if ((old >> 16u) >= (old & 0xFFFFu)) continue;   // (past the count: never, the same walk)
            const uint i = rg_cells[emLBlkWord(cell >> 6u)].y + rg_cells[cw].y + (old >> 16u);
            if (i < REGIR_EM_PAIR_CAP) emPairPut(i, r);
        }
    }
}
// mode 3 COUNT / mode 6 FILL: one workgroup per record (grid-stride), a lane per (level lid / 16, z slice
// lid % 16) -- the cells of the record's reach box in that slice (<= 32 x 32), each whose emCellTarget > 0
// (exactly population 2's candidate test) counted / given the record's slot at its next place. The two
// walks are the same code over the same records: they find the same pairs (the fill also stops at the
// count, so a cell never writes into its neighbour's places). No barriers.
// (#1006, clean_regir.glsl INCREMENTAL CELLS / WEAK OVERLAY) the reach is the emitter's REACH range (>= its
// light range: a superset; mode 7's targets keep the true range), the count also sums each cell's membership
// signature, and a WEAK record's level-0 lanes walk the overlay's slice z (z < REGIR_EM_OV_Z) instead.
void emListWalk(bool fill)
{
    const uint lid = gl_LocalInvocationIndex;
    const uint l = lid >> 4u, z = lid & 15u;
    if (l >= regirLevels() || z >= REGIR_DIM_Z) return;
    if (fill && !emListsOn()) return;
    const uint nRec = emCount();
    const uint par = emParity();
    const uint nWG = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
    const bool weakOn = emWeakOn();
    const vec4 o = rg.origin[l];
    const vec4 ov = emOvOrigin();
    [[dont_unroll]] for (uint r = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x; r < nRec; r += nWG)
    {
        vec4 cr, pl, la;
        const EmTri t = emLoad(par, r);
        emTriCompact(t, cr, pl, la);
        if (!(la.x > 0.0) || !(la.y > 0.0) || !(la.z > 0.0)) continue;   // (not a light: emReachBox's own test)
        const uvec2 rx = rg_cells[emRecXWord(par, r)];
        la.z = max(la.z, uintBitsToFloat(rx.x));   // (the reach range; NaN-safe: max keeps la.z)
        const uvec2 h = uvec2(rx.y, regirHash(rx.y ^ 0x68E31DA4u));
        if (l == 0u && weakOn && (t.flags & EM_R_WEAK) != 0u)
        {
            if (z < REGIR_EM_OV_Z)
                emListSlice(fill, r, cr, pl, la, ov, uvec3(REGIR_EM_OV_X, REGIR_EM_OV_Y, REGIR_EM_OV_Z),
                            REGIR_EM_NCELLS, z, h, true);
            continue;
        }
        emListSlice(fill, r, cr, pl, la, o, uvec3(REGIR_DIM_X, REGIR_DIM_Y, REGIR_DIM_Z),
                    l * REGIR_CELLS_PER_LEVEL, z, h, false);
    }
}
bool emLongOn() { return (rg.rs_em_cfg.z & EM_F_LONG) != 0u; }
// (LONG CELLS) the long cells' list: entry k (< REGIR_EM_NCELLS)
uint emLongGet(uint k)
{
    const uvec2 w = rg_cells[REGIR_EM_LONG_BASE + 1u + (k >> 1u)];
    return (k & 1u) != 0u ? w.y : w.x;
}
void emLongPut(uint k, uint cell)
{
    if ((k & 1u) != 0u) rg_cells[REGIR_EM_LONG_BASE + 1u + (k >> 1u)].y = cell;
    else                rg_cells[REGIR_EM_LONG_BASE + 1u + (k >> 1u)].x = cell;
}
// ---- (#1006 INCREMENTAL CELLS, clean_regir.glsl) the cell cache ----
uint emCcWord(uint cell) { return REGIR_EM_CC_BASE + 2u * cell; }
// A cell id population 2 builds this frame: a clipmap cell of a level in use, or (EM_F_WEAK) an overlay cell
bool emCellInUse(uint cell)
{
    if (cell < REGIR_EM_NCELLS) return cell < regirLevels() * REGIR_CELLS_PER_LEVEL;
    return emWeakOn() && cell - REGIR_EM_NCELLS < REGIR_EM_OV_N;
}
// The dirty-since word's stamp (+1: 0 is clean; 30 bits: an age stays exact across the stamp's wrap)
uint emSince(uint stamp) { return (stamp & 0x3FFFFFFFu) + 1u; }
uint emAge(uint ds, uint stamp) { return (emSince(stamp) - (ds & 0x3FFFFFFFu)) & 0x3FFFFFFFu; }
// The cell's stagger for the rolling refreshes
uint emCellPhase(uint cell, uint stamp) { return regirHash(cell * 0x9E3779B1u + 0x7F4A7C15u) + stamp; }
// Every cell is re-gathered this build: the host's EM_F_FULL, the cache not VALID (a new buffer, a gather
// build), or a level's origin / edge not the stored build's (unless mode 12 moved the cells: EM_F_SHIFT, the
// same edges). Uniform (header + cache header words). Modes 4 and 5 evaluate it BEFORE mode 5 can clear VALID;
// mode 11 reads mode 5's verdict (CC_HDR [40].x).
bool emFullNow()
{
    if ((rg.rs_em_cfg.z & EM_F_FULL) != 0u || rg_cells[emCcHdr(0u)].y == 0u) return true;
    const bool shifted = (rg.rs_em_cfg.z & EM_F_SHIFT) != 0u;
    for (uint l = 0u; l < REGIR_LEVELS_MAX; ++l)
    {
        const vec4 p = emCcOrigin(l), c = rg.origin[l];
        if (p.w != c.w) return true;
        if (!shifted && any(notEqual(p.xyz, c.xyz))) return true;
    }
    return false;
}
// mode 4 SCAN: one workgroup per 64-cell block -- each cell's first pair within the block (LCELL y) and
// the block's pairs (LBLK x). (#1006) Every block of the clipmap and of the overlay (REGIR_EM_NBLK_ALL); each
// cell in use updates its DIRTY state from this build's signature (clean_regir.glsl INCREMENTAL CELLS) and a
// dirty cell waiting for the budget joins the age histogram; an overlay cell with a candidate sets EM_C_OVL.
// (The LONG CELLS' list is mode 11's: only the cells re-gathered this build.)
void emListScan()
{
    const uint lid = gl_LocalInvocationIndex;
    const uint b = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (b >= REGIR_EM_NBLK_ALL) return;   // (the whole workgroup)
    const uint cell = b * 64u + lid;
    const uint cw = emLCellWord(cell);
    const uint n = rg_cells[cw].x & 0xFFFFu;
    {   // (stats: the longest list, one atomic per subgroup)
        const uint mx = subgroupMax(n);
        if (subgroupElect() && mx != 0u) atomicMax(rg_cells[REGIR_EM_LONG_BASE].y, mx);
    }
    s_emScan[lid] = n;
    barrier();
    for (uint d = 1u; d < 64u; d <<= 1u)
    {
        const uint v = lid >= d ? s_emScan[lid - d] : 0u;
        barrier();
        s_emScan[lid] += v;
        barrier();
    }
    rg_cells[cw].y = s_emScan[lid] - n;
    if (lid == 63u) rg_cells[emLBlkWord(b)].x = s_emScan[63];
    if (!emCellInUse(cell)) return;
    if (cell >= REGIR_EM_NCELLS && n != 0u) atomicOr(rg.rs_em_cache.w, EM_C_OVL);
    if (emFullNow()) return;
    // ---- (#1006) DIRTY: the signature against the one the cell was gathered with ----
    const uint stamp = emStamp();
    const uint ccw = emCcWord(cell);
    const uvec2 sigG = rg_cells[ccw];
    const uvec2 sigN = rg_cells[REGIR_EM_SIG_BASE + cell];
    const uint ds0 = rg_cells[ccw + 1u].x;
    uint ds = ds0;
    const bool changed = any(notEqual(sigN, sigG));
    if (!changed && (ds & EM_CC_FORCE) == 0u) ds = 0u;          // (back to the gathered set: clean again)
    else if (changed && (ds & 0x3FFFFFFFu) == 0u) ds |= emSince(stamp);
    if (changed)
    {   // a cell with a stratified rest: its aggregate holds the changed triangles' light as a VALUE -- forced
        const uint hx = rg_cells[emCellWord(cell)].x;
        if ((hx & REGIR_COUNT_MASK) != 0u && (hx & REGIR_CELL_EXACT) == 0u) ds |= EM_CC_FORCE;
    }
    if (ds != ds0) rg_cells[ccw + 1u].x = ds;
    if (ds != 0u && (ds & EM_CC_FORCE) == 0u)
    {   // the age histogram: 32 bins, two per uvec2 (bin 31 = 31 builds and older)
        const uint bin = min(emAge(ds, stamp), 31u);
        if ((bin & 1u) != 0u) atomicAdd(rg_cells[emCcHdr(24u + (bin >> 1u))].y, 1u);
        else                  atomicAdd(rg_cells[emCcHdr(24u + (bin >> 1u))].x, 1u);
    }
}
// mode 5 (ONE workgroup): the blocks' first pairs (LBLK y; 17 blocks per lane, the overlay's included), the
// pairs this build (rs_em_cache.z) and EM_C_GATHER past REGIR_EM_PAIR_CAP; then (#1006) the build's verdict:
// FULL (CC_HDR [40].x), the budget's threshold age and quota (oldest first: the histogram from the oldest
// bin down), the indirect dispatch of mode 7 (mode 11 counts its groups) -- or, on a gather build, the
// cache made invalid (the next build is FULL) and mode 7's whole grid.
void emListSums()
{
    const uint lid = gl_LocalInvocationIndex;
    if (gl_WorkGroupID.x != 0u || gl_WorkGroupID.y != 0u) return;   // (the host dispatches one)
    const uint per = (REGIR_EM_NBLK_ALL + 63u) / 64u;   // (17)
    uint sum = 0u;
    for (uint j = 0u; j < per; ++j)
    {
        const uint bb = lid * per + j;
        if (bb < REGIR_EM_NBLK_ALL) sum += rg_cells[emLBlkWord(bb)].x;
    }
    s_emScan[lid] = sum;
    barrier();
    for (uint d = 1u; d < 64u; d <<= 1u)
    {
        const uint v = lid >= d ? s_emScan[lid - d] : 0u;
        barrier();
        s_emScan[lid] += v;
        barrier();
    }
    uint run = s_emScan[lid] - sum;
    for (uint j = 0u; j < per; ++j)
    {
        const uint bb = lid * per + j;
        if (bb >= REGIR_EM_NBLK_ALL) break;
        const uint bw = emLBlkWord(bb);
        const uint n = rg_cells[bw].x;
        rg_cells[bw].y = run;
        run += n;
    }
    if (lid == 63u)
    {
        const uint total = s_emScan[63];
        rg.rs_em_cache.z = total;
        const bool gather = total > REGIR_EM_PAIR_CAP;
        if (gather) atomicOr(rg.rs_em_cache.w, EM_C_GATHER);
        // ---- (#1006 INCREMENTAL CELLS) ----
        const bool full = emFullNow();   // (reads VALID before the gather clears it)
        rg_cells[emCcHdr(40u)].x = full ? 1u : 0u;
        if (full) atomicAdd(rg_cells[emCcHdr(EM_CCH_STAT + 3u)].y, 1u);
        if (gather)
        {   // (mode 7 gathers over the whole grid, mode 11 does nothing; the next build starts over)
            rg_cells[emCcHdr(0u)].y = 0u;
            rg_cells[emCcHdr(18u)] = uvec2(regirLevels() * (REGIR_CELLS_PER_LEVEL / 64u), 1u);
            rg_cells[emCcHdr(19u)].x = 1u;
        }
        else
        {
            rg_cells[emCcHdr(18u)] = uvec2(0u, 1u);   // (x: mode 11 raises it to the build list's groups)
            rg_cells[emCcHdr(19u)].x = 1u;
            // the threshold: every dirty cell of an older bin, the quota of bin bt (oldest first)
            const uint budget = uint(clamp(rg.rs_em_params2.z, 0.0, 1.0e9));
            uint bt = REGIR_EM_NONE, quota = 0u;
            if (budget != 0u && !full)
            {
                uint cum = 0u;
                for (int k = 31; k >= 0; --k)
                {
                    const uint hk = rg_cells[emCcHdr(24u + uint(k >> 1))][uint(k & 1)];
                    if (cum + hk >= budget) { bt = uint(k); quota = budget - cum; break; }
                    cum += hk;
                }
            }
            rg_cells[emCcHdr(17u)] = uvec2(bt, quota);
        }
    }
}
// mode 11 SELECT (#1006, clean_regir.glsl INCREMENTAL CELLS): one invocation per cell id (REGIR_EM_NBLK_ALL
// workgroups), after mode 5 -- which cells mode 7 / 9 re-gather this build: all of them on a FULL build; else
// the forced (EM_CC_FORCE), the budget's dirty cells (oldest first), the rolling refreshes; every other cell
// with slots is KEPT -- its slots carried to this build's record slots through the forward map (a slot with
// no forward entry forces it instead). A selected cell joins the build list (mode 7, the indirect dispatch's
// groups counted here) or the long list (mode 9) and its cache records this build's signature.
void emCellSelect()
{
    if (!emListsOn()) return;   // (a gather build: mode 7 walks the whole grid)
    const uint lid = gl_LocalInvocationIndex;
    const uint b = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint cell = b * 64u + lid;
    if (cell == 0u)
    {   // the cache now holds this build at these origins (nothing below reads these words)
        rg_cells[emCcHdr(0u)].y = 1u;
        for (uint l = 0u; l < REGIR_LEVELS_MAX; ++l)
        {
            const vec4 o = rg.origin[l];
            rg_cells[emCcHdr(1u + 2u * l)] = floatBitsToUint(o.xy);
            rg_cells[emCcHdr(2u + 2u * l)] = floatBitsToUint(o.zw);
        }
    }
    if (b >= REGIR_EM_NBLK_ALL || !emCellInUse(cell)) return;
    const bool full = rg_cells[emCcHdr(40u)].x != 0u;
    const uint stamp = emStamp();
    const uint ccw = emCcWord(cell);
    const uvec2 sigN = rg_cells[REGIR_EM_SIG_BASE + cell];
    bool sel = full, forced = false, kept = false, miss = false;
    uint ds = 0u;
    if (!full)
    {
        ds = rg_cells[ccw + 1u].x;
        const uint ecw = emCellWord(cell);
        const uint hx = rg_cells[ecw].x;
        const uint nS = min(hx & REGIR_COUNT_MASK, REGIR_EM_SLOTS_MAX);
        const bool hasRest = nS != 0u && (hx & REGIR_CELL_EXACT) == 0u;
        forced = (ds & EM_CC_FORCE) != 0u;
        if (!forced && ds != 0u)
        {   // the budget: older than the threshold bin, or within that bin's quota
            const uvec2 th = rg_cells[emCcHdr(17u)];
            const uint bin = min(emAge(ds, stamp), 31u);
            if (th.x == REGIR_EM_NONE || bin > th.x) sel = true;
            else if (bin == th.x) sel = atomicAdd(rg_cells[emCcHdr(16u)].y, 1u) < th.y;
        }
        const uint restP = uint(clamp(rg.rs_em_params2.w, 1.0, 4096.0));
        if (hasRest && emCellPhase(cell, stamp) % restP == 0u) forced = true;   // (the rest's draw; 1 = every build)
        if ((nS != 0u || any(notEqual(sigN, uvec2(0u)))) && emCellPhase(cell ^ 0x55AA55u, stamp) % EM_CELL_REFRESH == 0u)
            forced = true;                                 // (the rolling refresh: once per EM_CELL_REFRESH builds)
        if (!sel && !forced && nS != 0u)
        {   // KEPT: every slot to this build's slot of the same triangle -- all or none (else re-gathered)
            uint ns[REGIR_EM_SLOTS_MAX];
            bool ok = true;
            for (uint j = 0u; j < nS; ++j)
            {
                ns[j] = emFwdGet(rg_cells[ecw + 1u + j].x);
                ok = ok && ns[j] != REGIR_EM_NONE;
            }
            if (ok)
            {
                for (uint j = 0u; j < nS; ++j) rg_cells[ecw + 1u + j].x = ns[j];
                kept = true;
            }
            else { forced = true; miss = true; }
        }
        sel = sel || forced;
    }
    // ---- the lists of this build's re-gathered cells: long ones a workgroup each (mode 9), the rest mode 7's ----
    const uint n = rg_cells[emLCellWord(cell)].x & 0xFFFFu;
    const bool isLong = sel && n > EM_LONG_LIST && emLongOn();
    if (isLong)
    {
        const uint k = atomicAdd(rg_cells[REGIR_EM_LONG_BASE].x, 1u);
        if (k < REGIR_EM_NCELLS) emLongPut(k, cell);
    }
    {   // the build list (one atomic per subgroup; the indirect dispatch's x = the groups it fills)
        const bool bl = sel && !isLong;
        const uint cnt = subgroupAdd(bl ? 1u : 0u);
        uint base0 = 0u;
        if (subgroupElect() && cnt != 0u)
        {
            base0 = atomicAdd(rg_cells[emCcHdr(16u)].x, cnt);
            atomicMax(rg_cells[emCcHdr(18u)].x, (min(base0 + cnt, REGIR_EM_NCELLS_ALL) + 63u) / 64u);
        }
        base0 = subgroupMax(base0);
        const uint k = base0 + subgroupExclusiveAdd(bl ? 1u : 0u);
        if (bl && k < REGIR_EM_NCELLS_ALL)
        {
            if ((k & 1u) != 0u) rg_cells[REGIR_EM_BLD_BASE + (k >> 1u)].y = cell;
            else                rg_cells[REGIR_EM_BLD_BASE + (k >> 1u)].x = cell;
        }
    }
    if (sel)
    {
        rg_cells[ccw] = sigN;
        rg_cells[ccw + 1u] = uvec2(0u, stamp);
    }
    {   // stats (one atomic per subgroup): dirty, re-gathered, forced, the stalest cell left dirty, misses, kept
        const uint sd = subgroupAdd(ds != 0u ? 1u : 0u), ss = subgroupAdd(sel ? 1u : 0u);
        const uint sf = subgroupAdd(forced ? 1u : 0u), sm = subgroupAdd(miss ? 1u : 0u);
        const uint sk = subgroupAdd(kept ? 1u : 0u);
        const uint st = subgroupMax(!sel && ds != 0u ? emAge(ds, stamp) : 0u);
        if (subgroupElect())
        {
            if (sd != 0u) atomicAdd(rg_cells[emCcHdr(EM_CCH_STAT)].x, sd);
            if (ss != 0u) atomicAdd(rg_cells[emCcHdr(EM_CCH_STAT)].y, ss);
            if (sf != 0u) atomicAdd(rg_cells[emCcHdr(EM_CCH_STAT + 1u)].x, sf);
            if (st != 0u) atomicMax(rg_cells[emCcHdr(EM_CCH_STAT + 1u)].y, st);
            if (sm != 0u) atomicAdd(rg_cells[emCcHdr(EM_CCH_STAT + 2u)].y, sm);
            if (sk != 0u) atomicAdd(rg_cells[emCcHdr(EM_CCH_STAT + 3u)].x, sk);
        }
    }
}
// The build list's entry k (mode 7)
uint emBldGet(uint k)
{
    const uvec2 w = rg_cells[REGIR_EM_BLD_BASE + (k >> 1u)];
    return (k & 1u) != 0u ? w.y : w.x;
}
// The overlay's origin of a level-0 origin o0 (emOvOrigin's rule)
vec4 emOvOriginOf(vec4 o0)
{
    const float e2 = 2.0 * o0.w;
    return vec4(floor(o0.xyz / e2 + 1e-4) * e2, e2);
}
// mode 12 SHIFT (#1006, clean_regir.glsl ORIGIN SHIFT; EM_F_SHIFT only, after the host's copy to the scratch):
// one invocation per cell id -- its lattice moved by (this build's origin - the stored build's) / edge whole
// cells: the cell's words and cache come from the scratch copy of the cell that held its world box, or (new to
// the clipmap) start empty and FORCED.
void emCellShift()
{
    const uint cell = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationIndex;
    if (cell >= REGIR_EM_NCELLS_ALL) return;
    const bool ovl = cell >= REGIR_EM_NCELLS;
    if (ovl && cell - REGIR_EM_NCELLS >= REGIR_EM_OV_N) return;
    vec4 on, op;
    ivec3 dims;
    uvec3 c;
    uint base;
    if (!ovl)
    {
        const uint l = cell / REGIR_CELLS_PER_LEVEL, i = cell - l * REGIR_CELLS_PER_LEVEL;
        on = rg.origin[l]; op = emCcOrigin(l);
        dims = ivec3(REGIR_DIM_X, REGIR_DIM_Y, REGIR_DIM_Z);
        c = uvec3(i % REGIR_DIM_X, (i / REGIR_DIM_X) % REGIR_DIM_Y, i / (REGIR_DIM_X * REGIR_DIM_Y));
        base = l * REGIR_CELLS_PER_LEVEL;
    }
    else
    {
        const uint i = cell - REGIR_EM_NCELLS;
        on = emOvOriginOf(rg.origin[0]); op = emOvOriginOf(emCcOrigin(0u));
        dims = ivec3(REGIR_EM_OV_X, REGIR_EM_OV_Y, REGIR_EM_OV_Z);
        c = uvec3(i % REGIR_EM_OV_X, (i / REGIR_EM_OV_X) % REGIR_EM_OV_Y, i / (REGIR_EM_OV_X * REGIR_EM_OV_Y));
        base = REGIR_EM_NCELLS;
    }
    const vec3 df = (on.xyz - op.xyz) / max(on.w, 1e-6);
    const ivec3 d = ivec3(clamp(round(df), vec3(-4096.0), vec3(4096.0)));
    const ivec3 s = ivec3(c) + d;
    const uint dst = emCellWord(cell), dcc = emCcWord(cell);
    if (all(greaterThanEqual(s, ivec3(0))) && all(lessThan(s, dims)) && on.w == op.w)
    {
        const uint src = base + uint((s.z * dims.y + s.y) * dims.x + s.x);
        const uint sw = !ovl ? REGIR_EM_SCR_BASE + src * REGIR_EM_CELL_WORDS
                             : REGIR_EM_SCR2_BASE + (src - REGIR_EM_NCELLS) * REGIR_EM_CELL_WORDS;
        const uint scc = REGIR_EM_SCR2_BASE + REGIR_EM_OV_CELLS * REGIR_EM_CELL_WORDS + 2u * src;
        for (uint k = 0u; k < REGIR_EM_CELL_WORDS; ++k) rg_cells[dst + k] = rg_cells[sw + k];
        rg_cells[dcc] = rg_cells[scc];
        rg_cells[dcc + 1u] = rg_cells[scc + 1u];
    }
    else
    {   // new to the clipmap: empty (no slot, no aggregate) and forced -- its signature can never match
        for (uint k = 0u; k < REGIR_EM_CELL_WORDS; ++k) rg_cells[dst + k] = uvec2(0u);
        rg_cells[dcc] = uvec2(0xFFFFFFFFu, 0x5EED5EEDu);
        rg_cells[dcc + 1u] = uvec2(EM_CC_FORCE | emSince(emStamp()), emStamp());
    }
}
// (EXACT TOP, clean_regir.glsl POPULATION 2) Record slot s with target t ranks before slot sq with tq: the
// larger target, equal ones by the smaller (instance, triangle) -- never by the list's atomic order or the
// slots (mode 0's atomic entry order): the exact / aggregate split must not change between two frames.
bool emRanksBefore(float t, uint s, float tq, uint sq, uint par)
{
    if (t != tq) return t > tq;
    const uvec2 a = rg_cells[emRecWord(par, s) + 11u], b = rg_cells[emRecWord(par, sq) + 11u];
    return a.x != b.x ? a.x < b.x : a.y < b.y;
}
// Walk 1's step: candidate (t > 0, slot sl) into the R strongest (sorted, the strongest first).
void emTopInsert(float t, uint sl, uint R, uint par, inout uint nTop,
                 inout uint topS[REGIR_EM_SLOTS_MAX], inout float topT[REGIR_EM_SLOTS_MAX])
{
    if (nTop >= R && !emRanksBefore(t, sl, topT[R - 1u], topS[R - 1u], par)) return;
    uint p = min(nTop, R - 1u);
    while (p > 0u && emRanksBefore(t, sl, topT[p - 1u], topS[p - 1u], par))
    {
        topT[p] = topT[p - 1u]; topS[p] = topS[p - 1u]; --p;
    }
    topT[p] = t; topS[p] = sl;
    nTop = min(nTop + 1u, R);
}
// Walk 2's step: rest triangle tq (slot sl, target t, average colour col) -- its share of the cell's
// deterministic aggregate (the vector form factor at the cell centre) and the stratified samples whose
// positions its target covers.
void emRestStep(uint base, uint Kt, uint Rs, float Wr, float strat, float xi, vec3 ccell,
                float t, uint sl, EmTri tq, vec3 col,
                inout uint r, inout float cum, inout uint lastS, inout float lastT,
                inout vec3 aggV, inout vec3 aggC, inout float aggS)
{
    const vec3 Fv = emTriVecFF(tq, ccell);
    const float fl = length(Fv);
    if (fl > 0.0 && fl < 3.0e38) { aggV += Fv; aggC += col * fl; aggS += fl; }
    cum += t;
    lastS = sl; lastT = t;
    const float inv = Wr / (t * float(Rs));
    while (r < Rs && (float(r) + xi) * strat < cum)
    {
        rg_cells[base + 1u + Kt + r] = uvec2(sl, floatBitsToUint(inv));
        ++r;
    }
}
// mode 7 POPULATION 2: one invocation per cell, 64 per workgroup. Its candidates: the cell's LIST (CELL
// LISTS; a LONG CELL is mode 9's), or on the GATHER path the record groups near the workgroup (emChunk,
// shared memory).
void emCellBuild()
{
    const uint lid = gl_LocalInvocationIndex;
    const uint wg = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const bool lists = emListsOn();   // (uniform: the barriers of the gather path)
    // (#1006 INCREMENTAL CELLS) with the lists, lane k of the dispatch builds entry k of mode 11's BUILD LIST
    // (an indirect dispatch: its groups); the gather path walks the whole grid, 64 contiguous cells a group
    uint cell, cell0;
    vec3 lo, hi, wlo = vec3(0.0), whi = vec3(0.0), tmp;
    if (lists)
    {
        const uint k = wg * 64u + lid;
        if (k >= min(rg_cells[emCcHdr(16u)].x, REGIR_EM_NCELLS_ALL)) return;   // (no barrier on the list path)
        cell = emBldGet(k);
        if (!emCellInUse(cell)) return;
        cell0 = cell;
        emCellBoxAny(cell, lo, hi);
    }
    else
    {
        cell0 = wg * 64u;
        if (cell0 >= regirLevels() * REGIR_CELLS_PER_LEVEL) return;   // (the whole workgroup)
        cell = cell0 + lid;   // (REGIR_CELLS_PER_LEVEL is a multiple of 64: every lane is live)
        regirCellBox(cell, lo, hi);
        // the workgroup's box: cells cell0 .. cell0 + 63 = x 0..31 of two rows (REGIR_DIM_X = 32), one z slab
        regirCellBox(cell0, wlo, tmp);
        regirCellBox(cell0 + 63u, tmp, whi);
    }
    const uint nRec = emCount();
    const uint nGrp = (nRec + 63u) / 64u;
    const uint par = emParity();
    const uint R = emSlots();
    uint ln = 0u, lst = 0u;
    if (lists)
    {
        const uvec2 lc = rg_cells[emLCellWord(cell)];
        lst = rg_cells[emLBlkWord(cell >> 6u)].y + lc.y;
        ln = min(lc.x & 0xFFFFu, lc.x >> 16u);   // (the places the fill wrote)
        ln = lst < REGIR_EM_PAIR_CAP ? min(ln, REGIR_EM_PAIR_CAP - lst) : 0u;
        // (LONG CELLS: mode 9's, a workgroup each -- the same test as mode 4's on the same count; no
        //  barrier below on the list path)
        if ((lc.x & 0xFFFFu) > EM_LONG_LIST && emLongOn()) return;
    }
    // ---- walk 1: M, W and the R strongest (sorted by target, descending; EXACT TOP) ----
    float W = 0.0;
    uint M = 0u, nTop = 0u;
    uint topS[REGIR_EM_SLOTS_MAX];
    float topT[REGIR_EM_SLOTS_MAX];
    [[unroll]] for (uint k = 0u; k < REGIR_EM_SLOTS_MAX; ++k) { topS[k] = 0u; topT[k] = 0.0; }
    if (lists)
    {
        [[dont_unroll]] for (uint i = 0u; i < ln; ++i)
        {
            const uint sl = emPairGet(lst + i);
            if (sl >= nRec) continue;
            vec4 cr, pl, la;
            emTriCompact(emLoad(par, sl), cr, pl, la);
            const float t = emCellTarget(cr, pl, la, lo, hi);
            if (!(t > 0.0)) continue;
            W += t; ++M;
            emTopInsert(t, sl, R, par, nTop, topS, topT);
        }
    }
    else
    {
        for (uint gb = 0u; gb < nGrp; gb += 64u)
        {
            barrier();
            if (lid == 0u) s_entN = 0u;
            barrier();
            if (gb + lid < nGrp && emGrpReach(gb + lid, wlo, whi)) s_entList[atomicAdd(s_entN, 1u)] = gb + lid;
            barrier();
            const uint nG = s_entN;
            for (uint k = 0u; k < nG; ++k)
            {
                emChunk(par, s_entList[k], nRec, wlo, whi);
                const uint cnt = s_emN;
                for (uint j = 0u; j < cnt; ++j)
                {
                    const float t = emCellTarget(s_emCr[j], s_emPl[j], s_emLa[j], lo, hi);
                    if (!(t > 0.0)) continue;
                    W += t; ++M;
                    emTopInsert(t, s_emList[j], R, par, nTop, topS, topT);
                }
            }
        }
    }
    {   // stats (one atomic per subgroup)
        const uint ne = subgroupAdd(M > 0u ? 1u : 0u);
        const uint sm = subgroupAdd(M);
        if (subgroupElect() && ne != 0u)
        {
            atomicAdd(rg.rs_em_stat[0], ne);
            atomicAdd(rg.rs_em_stat[1], sm);
        }
    }
    const uint base = emCellWord(cell);
    const bool any_ = M > 0u && W > 0.0 && W < 3.0e38;
    const bool exactL = M <= R;
    // M > R: the Kt strongest exactly + Rs stratified samples of the rest
    const uint Rs = exactL ? 0u : (R + 3u) / 4u;
    const uint Kt = exactL ? min(M, R) : R - Rs;
    float Wt = 0.0;
    for (uint k = 0u; k < Kt; ++k) Wt += topT[k];
    const float Wr = max(W - Wt, 0.0);
    const bool rest = any_ && !exactL && Wr > 0.0;
    uint rng = regirHash(cell ^ regirHash(rg.cfg.w + 2u * 0x9E3779B9u));
    const float xi = regirU01(rng);
    const float strat = Wr / float(max(Rs, 1u));
    uint r = 0u, lastS = 0u;
    float cum = 0.0, lastT = 0.0;
    // THE REST'S AGGREGATE (the lit kernels' share of the rest): the vector form factor of every rest
    // triangle at the cell centre (V, summed) and their average colour weighted by it (C / S) --
    // DETERMINISTIC: the unshadowed light the lit kernels add is never denoised, so it must not depend on
    // which rest triangles this frame's stratified samples hit (those feed pass 15's visibility only; the
    // list's order moves them, and the sums' rounding only).
    vec3 aggV = vec3(0.0), aggC = vec3(0.0);
    float aggS = 0.0;
    const vec3 ccell = 0.5 * (lo + hi);
    // ---- walk 2 (only where there is a rest to sample) ----
    if (lists)
    {
        [[dont_unroll]] for (uint i = 0u; i < ln && rest; ++i)
        {
            const uint sl = emPairGet(lst + i);
            if (sl >= nRec) continue;
            const EmTri tr = emLoad(par, sl);
            vec4 cr, pl, la;
            emTriCompact(tr, cr, pl, la);
            const float t = emCellTarget(cr, pl, la, lo, hi);
            if (!(t > 0.0)) continue;
            bool top = false;
            for (uint q = 0u; q < Kt; ++q) top = top || topS[q] == sl;
            if (top) continue;
            emRestStep(base, Kt, Rs, Wr, strat, xi, ccell, t, sl, tr, tr.Lavg, r, cum, lastS, lastT, aggV, aggC, aggS);
        }
    }
    else
    {   // (uniform: the barriers; only when a lane of the workgroup has a rest to sample)
        barrier();
        if (lid == 0u) s_emNeed = 0u;
        barrier();
        if (rest) atomicOr(s_emNeed, 1u);
        barrier();
        if (s_emNeed != 0u)
        {
            for (uint gb = 0u; gb < nGrp; gb += 64u)
            {
                barrier();
                if (lid == 0u) s_entN = 0u;
                barrier();
                if (gb + lid < nGrp && emGrpReach(gb + lid, wlo, whi)) s_entList[atomicAdd(s_entN, 1u)] = gb + lid;
                barrier();
                const uint nG = s_entN;
                for (uint k = 0u; k < nG; ++k)
                {
                    emChunk(par, s_entList[k], nRec, wlo, whi);
                    const uint cnt = s_emN;
                    for (uint j = 0u; j < cnt && rest; ++j)
                    {
                        const uint sl = s_emList[j];
                        const float t = emCellTarget(s_emCr[j], s_emPl[j], s_emLa[j], lo, hi);
                        if (!(t > 0.0)) continue;
                        bool top = false;
                        for (uint q = 0u; q < Kt; ++q) top = top || topS[q] == sl;
                        if (top) continue;
                        EmTri tq;
                        tq.v0 = s_emV0[j].xyz; tq.e1 = s_emE1[j].xyz; tq.e2 = s_emE2[j].xyz;
                        tq.range = s_emE1[j].w; tq.flags = floatBitsToUint(s_emV0[j].w); tq.tkF = s_emE2[j].w;
                        emRestStep(base, Kt, Rs, Wr, strat, xi, ccell, t, sl, tq, s_emCol[j].rgb,
                                   r, cum, lastS, lastT, aggV, aggC, aggS);
                    }
                }
            }
        }
    }
    {   // the aggregate (zero: no rest)
        const vec3 Cm = aggS > 0.0 ? aggC / aggS : vec3(0.0);
        const bool ok = rest && aggS > 0.0 && !any(isnan(aggV)) && !any(isinf(aggV)) && !any(isnan(Cm)) && !any(isinf(Cm));
        const vec3 V = ok ? aggV : vec3(0.0), C = ok ? Cm : vec3(0.0);
        rg_cells[base + REGIR_EM_SLOTS_MAX + 1u] = floatBitsToUint(V.xy);
        rg_cells[base + REGIR_EM_SLOTS_MAX + 2u] = floatBitsToUint(vec2(V.z, C.r));
        rg_cells[base + REGIR_EM_SLOTS_MAX + 3u] = floatBitsToUint(C.gb);
    }
    if (!any_) { rg_cells[base] = uvec2(0u); return; }
    for (uint k = 0u; k < Kt; ++k) rg_cells[base + 1u + k] = uvec2(topS[k], floatBitsToUint(1.0));
    if (exactL) { rg_cells[base] = uvec2(Kt | REGIR_CELL_EXACT, floatBitsToUint(W)); return; }
    // (rounding: no rest left -- the strongest alone carry the cell)
    if (!rest || !(lastT > 0.0)) { rg_cells[base] = uvec2(Kt | (Kt << 16u), floatBitsToUint(W)); return; }
    for (; r < Rs; ++r) rg_cells[base + 1u + Kt + r] = uvec2(lastS, floatBitsToUint(Wr / (lastT * float(Rs))));
    rg_cells[base] = uvec2((Kt + Rs) | (Kt << 16u), floatBitsToUint(W));
}
// ---- (#869 OCCLUSION CULL) mode 8 THE RESOLVE (clean_deferred_light.comp OCCLUSION CULL; before pass 15, one
//      invocation per patch, 64 per workgroup): last frame's notes -> the per-light counts, carried to this
//      frame's light indices through rs_remap; re-admission on a visible ray; a patch without a count or
//      without a note for OCC_AGE_MAX frames is freed ----
void occResolve()
{
    const uint c = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    if (c >= OCC_CELLS) return;
    const uint b = occBase(c);
    const uvec2 h = rg_cells[b];
    if (h.x == 0u) return;
    uint B[8], V[8], nw[32];
    bool noted = false;
    for (uint k = 0u; k < 8u; ++k)
    {
        B[k] = occLoad(occWord(c, OCC_W_B + k));
        V[k] = occLoad(occWord(c, OCC_W_V + k));
        noted = noted || (B[k] | V[k]) != 0u;
    }
    for (uint k = 0u; k < 32u; ++k) nw[k] = 0u;
    uint nCull = 0u, readmit = 0u, newCull = 0u, gone = 0u;
    for (uint k = 0u; k < 32u; ++k)
    {
        const uint cw = occLoad(occWord(c, OCC_W_CNT + k));
        const uint bb = (B[k >> 2u] >> ((k & 3u) * 8u)) & 0xFFu;
        const uint vv = (V[k >> 2u] >> ((k & 3u) * 8u)) & 0xFFu;
        if ((cw | bb) == 0u) continue;
        for (uint q = 0u; q < 8u; ++q)
        {
            const uint old = (cw >> (q * 4u)) & 15u;
            const bool isB = ((bb >> q) & 1u) != 0u, isV = ((vv >> q) & 1u) != 0u;
            if (old == 0u && !isB) continue;
            const uint j = rsRemap(k * 8u + q);   // (this frame's index of that light)
            if (j >= 256u) { if (old != 0u) ++gone; continue; }
            uint n = old;
            if (isV) { if (old >= OCC_N) ++readmit; n = 0u; }   // a visible ray: re-admitted
            else if (isB) { n = min(n + 1u, 15u); if (n == OCC_N) ++newCull; }
            if (n == 0u) continue;
            nw[j >> 3u] |= n << ((j & 7u) * 4u);
            if (n >= OCC_N) ++nCull;
        }
    }
    bool live = false;
    for (uint k = 0u; k < 32u; ++k) live = live || nw[k] != 0u;
    const uint age = noted ? 0u : min((h.y & 0xFFFFu) + 1u, 0xFFFFu);
    occStatAdd(12u, gone);
    occStatAdd(7u, readmit);
    occStatAdd(8u, newCull);
    if (!live || age >= OCC_AGE_MAX)
    {   // (freed: every word zero -- the tag last)
        for (uint k = 1u; k < OCC_CELL_U2; ++k) rg_cells[b + k] = uvec2(0u);
        rg_cells[b] = uvec2(0u);
        occStatAdd(11u, 1u);
        return;
    }
    for (uint k = 0u; k < 16u; ++k) rg_cells[b + (OCC_W_CNT >> 1u) + k] = uvec2(nw[2u * k], nw[2u * k + 1u]);
    for (uint k = 0u; k < 8u; ++k) rg_cells[b + (OCC_W_B >> 1u) + k] = uvec2(0u);   // (B and V: words 2-17)
    rg_cells[b] = uvec2(h.x, age | (min(nCull, 0xFFFFu) << 16u));
    occStatAdd(0u, 1u);
    if (nCull != 0u)
    {
        occStatAdd(1u, 1u);
        occStatAdd(2u, nCull);
        occStatAdd(nCull < 4u ? 3u : (nCull < 16u ? 4u : (nCull < 64u ? 5u : 6u)), 1u);
    }
}
// ---- (#986) LONG CELLS (clean_regir.glsl): mode 9, one workgroup per long cell (grid-stride over mode
//      4's list) -- emCellBuild's result for that cell with its pairs split over the 64 lanes ----
shared float s_lgT[64u * REGIR_EM_SLOTS_MAX];   // each lane's R strongest (walk 1)
shared uint  s_lgS[64u * REGIR_EM_SLOTS_MAX];
shared uint  s_lgN[64];
shared float s_lgW[64];                         // walk 1: each lane's W; then its rest target
shared uint  s_lgM[64];
shared vec4  s_lgV[64], s_lgC[64];              // walk 2: each lane's aggregate (V, S; C)
shared uint  s_lgLast[64];                      // walk 2: each lane's last rest pair (slot; NONE: none)
shared float s_lgLastT[64];
shared float s_lgOff[64];                       // each lane's first stratified position
shared uint  s_gTopS[REGIR_EM_SLOTS_MAX];       // the cell's R strongest (lane 0's merge)
shared float s_gTopT[REGIR_EM_SLOTS_MAX];
shared uint  s_gM;
shared float s_gW;
