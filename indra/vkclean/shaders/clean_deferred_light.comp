// ---- RT MIRROR (#860, RenderVKRTMirrors): the planar hero mirror's image, ray traced ----
// Pass 12's build (uber sets + RT set 3, the 112 B push) with -DCLEAN_RT_MIRROR: instead of the
// reflected-view scene render (LLCleanRendererVK::recordMirror) this kernel fills the mirror image
// (draw set 0 binding 17, uMirror; here set 4 binding 0) at the RENDER extent, one perfect-specular
// ray per pixel tapMirror can sample. Every consumer (forward lit / water FS, the uber and split
// reflect kernels, legacy / fullbright env) keeps its tapMirror call unchanged. The image is traced
// at this frame's JITTERED pixel centres (the G-buffer's own), so tapMirror reads it at CLEAN_FRAG_XY
// without the jitter shift (frame info mirror_params.w = 1).
// A pixel is traced when tapMirror can reach it:
//   * its opaque G-buffer surface lies in the mirror box on the viewer side with a non-zero
//     tapMirrorWeight: the ray leaves the depth-rebuilt receiver along the mirror direction of its
//     SHADING normal, roughness forced to 0 (a flat mirror: the plane's direction; a normal-mapped or
//     curved face inside the box reflects its own surface instead of the plane's reprojected view);
//   * else the camera ray meets the mirror PLANE inside the box in front of the opaque depth (an
//     alpha-blended or water mirror face drawn forward over the G-buffer): the ray leaves that plane
//     point along the plane's mirror direction -- what the planar capture shows there.
// Every other pixel is left alone (tapMirrorWeight is 0 there: never sampled). Hits: the RT
// reflection trace (rtrTraceRefl: closest opaque / alpha-mask hit -- static, terrain, water, avatars
// + worn attachments when the mirror is Dynamic -- lit by clean_rt_shade.glsl's main-view path: sun /
// moon shadow ray, local lights from the main-view clusters (every light for hits outside the view),
// projector shadow rays (push budget), probes at the hit; then the alpha-blend layers in front of it).
// A miss within rtr.x metres takes the sky along R (the planar capture's sky pass). One ray per
// pixel, deterministic: no denoiser (perfect specular).
layout(set = 4, binding = 0, rgba16f) uniform writeonly image2D uRtMirror;
void DEFER_MAIN()
{
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(g_draw_push.width) || px.y >= int(g_draw_push.height)) return;
    g_frag_xy = vec2(px) + 0.5;
    if (!specMirrorOn()) return;   // (frame info: no mirror this frame)
    const vec3 E = pc.u_cam_time.xyz;
    const float nl = length(ssr.mirror_plane.xyz);
    if (!(nl > 1e-6)) return;
    const vec3 n = ssr.mirror_plane.xyz / nl;
    const float s = dot(n, E) + ssr.mirror_plane.w / nl;   // the eye's height over the plane (> 0: viewer side)
    const vec3 d = rtrViewDir(g_frag_xy);                 // the eye ray through this (jittered) pixel
    const float dn = dot(n, d);
    const float tQ = (s > 0.0 && dn < -1e-4) ? -s / dn : -1.0;
    // the opaque surface (G-buffer)
    const vec4 g2 = texelFetch(uG2, px, 0);
    SurfaceLit sf;
    vec3 P = E;
    float tP = 3.0e38;
    bool pin = false;
    if (deferHasSurface(g2))
    {
        float glow;
        bool noFade;
        sf = deferSurface(px, g2, glow, noFade);
        P = deferPosition(px);
        tP = length(P - E);
        // tapMirror's own weight (box, viewer side, smoothness): PBR fades with 1 - roughness; legacy /
        // fullbright faces tap with up to glossiness 1 (the sharp env word)
        pin = tapMirrorWeight(P, sf.model == SURF_PBR ? 1.0 - sf.rough : 1.0) > 0.0;
    }
    bool qin = false;
    vec3 Q = E;
    if (!pin && tQ > 0.0 && tQ <= tP * 1.001 + 0.05)
    {
        Q = E + d * tQ;
        const vec3 ls = (ssr.mirror_box * vec4(Q, 1.0)).xyz;
        qin = max(max(abs(ls.x), abs(ls.y)), abs(ls.z)) < 1.0;
    }
    if (!pin && !qin) return;
    // a mirror without its Dynamic flag shows no avatars (push rtr2.w bit 0), as the planar capture
    g_rtr_mask_drop = ((uint(g_draw_push.rtr2.w + 0.5) & 1u) != 0u) ? (RT_MASK_RIGGED | RT_MASK_ATTACH) : 0u;
    vec3 o, R, recv;
    if (pin)
    {
        const vec3 V = -d;
        const vec3 Ng = dot(sf.Ng, V) < 0.0 ? -sf.Ng : sf.Ng;
        rtrReceiverRay(sf, P, V, Ng, 0.0, 1.0, o, R);   // (+ the ray cone: one render pixel, the pixel angle)
        recv = P;
    }
    else
    {
        R = reflect(d, n);
        o = rtReceiverOrigin(Q, n, tQ, 0.0);
        recv = Q;
        const float pa1 = rtrPixelAngle(g_frag_xy);
        rt_cone_width0 = tQ * pa1;
        rt_cone_spread = pa1;
        rt_cone_aniso  = max(g_draw_push.rtr.w, 1.0);
        rtrMaskCone(tQ * pa1, pa1);
    }
    const float tmax = max(g_draw_push.rtr.x, 1.0);
    float t;
    vec3 c = rtrTraceRefl(o, R, tmax, recv, skyColor(R), (rtrOpts() & 1u) != 0u, t);
    if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
    imageStore(uRtMirror, px, vec4(clamp(c, vec3(0.0), vec3(LG_MAX_VALUE)), 1.0));
}

