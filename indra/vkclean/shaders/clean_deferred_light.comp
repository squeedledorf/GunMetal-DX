//      setup, a list of light samples (the sun / moon first, then the projector picks -- Phase 5:
//      ReSTIR's final sample), ONE visibility routine (clean_shadow_core.glsl) ----
#include "clean_shadow_core.glsl"

// The ray-traced projector li as a light sample: its apex, soft radius, axis + near plane, the
// record's origin bias, ONE disc sample (the denoiser integrates the disc) at noise pixel npx --
// pdnShadow's projShadowRayCore exactly. (The receiver rules -- the #664 terminator lift, the
// #747 rig lift and the slope offset the mask always gave projectors -- come from the sample
// loop's one shadowRecvLight call.)
// (#869 ReSTIR DI, RenderVKReSTIRLights 1) the extended light set's lights without a record:
//   * a PROJECTOR the record cap left out: its apex, the frame's disc radius / bias (rs_params.zw),
//     the near plane where the host's records put it (the fixture face + 1 %, >= 1 cm);
//   * a POINT LIGHT (#439): its centre, a disc of rs_params.x metres facing the receiver, every ray
//     stopping at its own prim's bounding sphere (proj_axis.x, SH_SPHERE) and the own-fixture rule
//     (SH_FIXTURE: clean_shadow_core.glsl rt_fix_*).
void pdnProjSample(uint li, vec2 npx, out ShadowSample S)
{
    const bool point = lights[li].proj_origin.w < 0.5;
    const uint rec = lights[li].tex.z;
    float soft;
    if (point)
    {
        soft = rg.rs_params.x;
        S.pos = lights[li].pos_radius.xyz;
        S.axis = vec3(0.0);
        S.nearClip = clamp(lights[li].proj_axis.x, 0.0, 0.5 * lights[li].pos_radius.w);
        S.bias = rg.rs_params.w;
        S.flags = SH_POSITIONAL | SH_SPHERE | SH_FIXTURE | (rtSplitOn() ? SH_SPLIT : 0u);
    }
    else if (rec == 0u || pshadow[rec - 1u].params.z < 1.5)
    {
        const float nearD = lights[li].proj_axis.w;
        soft = rg.rs_params.z;
        S.pos = lights[li].proj_origin.xyz;
        S.axis = lights[li].proj_axis.xyz;
        S.nearClip = nearD + max(0.01, nearD * 0.01);
        S.bias = rg.rs_params.w;
        S.flags = SH_POSITIONAL | (rtSplitOn() ? SH_SPLIT : 0u);
    }
    else
    {
        const ProjShadow ps = pshadow[rec - 1u];
        soft = ps.texel.x;
        S.pos = lights[li].proj_origin.xyz;
        S.axis = lights[li].proj_axis.xyz;
        S.nearClip = ps.params.y;
        S.bias = ps.texel.y;
        S.flags = SH_POSITIONAL | (rtSplitOn() ? SH_SPLIT : 0u);
    }
    S.radius = soft;
    S.tmax = 0.0;
    S.nRays = 1u;   // (projShadowRayCore max_n = 1)
    S.noise = soft > 0.0 ? vec2(fract(projIGN(npx) + rt_noise_shift.x),
                                6.2831853 * fract(projIGN(npx.yx + vec2(17.0, 59.0)) + rt_noise_shift.y))
                         : vec2(0.0);
}

#if DEFER_SHADOW_MERGE
// The sun / moon as a light sample: pdnSunTrace's rules (the RT shadow mask's) on the generic
// core's data. d: the reversed-Z depth at R.rp. False = no ray, lit (weak sun, sun shadows off,
// past the shadowed range, the lit test's facing); true = the sample S from origin point Psun
// (the #841 footprint jitter + the #211 terrain re-anchor), fade: the far fade. (The terminator /
// rig / slope rules and the turned-away gate come from the sample loop's shadowRecvLight.)
// The sun sample's gates (false: no ray, lit) and its far fade -- ahead of any ray, so the sun
// exposure certificates (#771 SXC) decide before the terrain re-anchor's ray.
bool pdnSunGate(SurfaceLit s, float vz, float sw, vec3 L, out float fade)
{
    fade = 0.0;
    if (!(sw > 0.0) || !specSunOn() || litDbg(LDBG_NO_SUN_SHADOW) || ssr.shadow_params.w < 1.5
        || vz >= ssr.shadow_clip.w || !pdnSunWant(s, L))
        return false;
    fade = clamp((vz - ssr.shadow_clip.w * 0.8) / max(ssr.shadow_clip.w * 0.2, 1e-3), 0.0, 1.0);
    return true;
}
bool pdnSunSample(SurfaceLit s, ShadowRecv R, float d, float vz, uint frame, float sw, float texPerPx, bool oneRay,
                  bool onPlane, out ShadowSample S, out vec3 Psun, out float fade)
{
    S = ShadowSample(vec3(0.0), 0.0, vec3(0.0), 0.0, 0.0, 0.0, 0u, 1u, vec2(0.0));
    Psun = R.P;
    const vec3 L = atmosLightDir();
    if (!pdnSunGate(s, vz, sw, L, fade)) return false;
    const vec3 P = R.P, Ng = R.Ng, cam = R.cam;
    const ivec2 rp = R.rp;
    const vec2 cpx = vec2(rp) + 0.5;
    const float pxw = R.pxw;
    // #841 FOOTPRINT JITTER (no TAA / FSR): the sun origin slides over the texel's footprint along
    // the receiver's plane, where the render pixel under the offset point lies on the same plane.
    vec3 sun_foot = vec3(0.0);
    if (ssr.taa_params.w < 0.5 && onPlane)   // (the mask: both tangents on the facet)
    {
        const uint hk = (frame & 15u) + 1u;
        const vec2 o = (vec2(pdnHalton(hk, 2u), pdnHalton(hk, 3u)) - 0.5) / texPerPx;
        const ivec2 mx = ivec2(int(g_draw_push.width), int(g_draw_push.height)) - 1;
        const ivec2 q = clamp(ivec2(floor(cpx + o)), ivec2(0), mx);
        const float camd = length(P - cam);
        bool on = true;
        if (q != rp)
        {
            const float dq = texelFetch(uDepthG, q, 0).r;
            on = dq > 0.0 && abs(dot(pdnWorldAt(vec2(q) + 0.5, dq) - P, Ng)) <= 0.1 * pxw + 1e-4 * camd;
        }
        if (on)
        {
            const vec3 dir = normalize(pdnWorldAt(cpx + o, d) - cam);
            const float dn = dot(dir, Ng);
            if (abs(dn) > 1e-3)
            {
                const vec3 f = cam + dir * (dot(P - cam, Ng) / dn) - P;
                if (dot(f, f) < 4.0 * pxw * pxw * (1.0 + dot(o, o))) sun_foot = f;
            }
        }
    }
    // #211 smooth-terrain re-anchor (the sun origin only)
    const float terr_t = pdnTerrainSnapOn() ? pdnTerrainExit(P, cam, Ng) : -1.0;
    Psun = (terr_t > 0.0 ? P + normalize(cam - P) * terr_t : P) + sun_foot;
    const bool opaque_only = ssr.taa_scale.z > 0.0 && length(P - cam) > ssr.taa_scale.z;
    const float ang = ssr.sun_rt.x;
    S.pos = L;
    S.radius = ang > 0.0 ? tan(ang) : 0.0;
    S.axis = vec3(0.0);
    S.nearClip = 0.0;
    S.bias = ssr.sun_rt.z;
    S.tmax = max(ssr.sun_rt.w, 1.0);
    S.flags = SH_FOLIAGE | (opaque_only ? SH_OPAQUE_ONLY : (rtSplitOn() ? SH_SPLIT : 0u));
    S.nRays = ang > 0.0 ? clamp(uint(ssr.sun_rt.y + 0.5), 1u, oneRay ? 1u : 16u) : 1u;
    S.noise = vec2(fract(projIGN(cpx + vec2(31.0, 7.0)) + rt_noise_shift.x),
                   6.2831853 * fract(projIGN(cpx.yx + vec2(3.0, 91.0)) + rt_noise_shift.y));
    return true;
}
