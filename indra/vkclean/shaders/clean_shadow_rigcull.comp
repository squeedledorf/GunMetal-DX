#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "clean_av_slots.glsl"
// vkclean -- per-SHADOW-VIEW rigged caster culling (#564).
//
// The sun cascades and the projector shadow tiles draw rigged casters from the main
// cull's pre-skinned lists (buckets 3 4 5 8 9, their leading shadowCounterSlot casters)
// plus the pass's off-screen region (#517). Drawn whole, that was EVERY avatar's rigged
// geometry into EVERY rendered cascade and every projector tile holding any avatar: a
// stage light whose cone holds two avatars redrew all seventy (measured: ~70 ms of
// shadow maps at a 70-avatar venue). This pass keeps, per view, only the draws whose
// wearer's padded box (computeAvatarVis -> av_vis box tail) touches the view's
// frustum -- and, for a cascade, the caster planes / minimum caster size the static
// casters already get (clean_cull.comp casterOk). LOSSLESS: a culled draw could not
// have written a texel of that view. Unknown wearer / no box -> kept.
//
// ONE dispatch per frame: workgroup (L, v) = rigged list L of view v.
//   L: 0 r_opaque (3), 1 r_mask (4), 2 r_alpha (5), 3 ds_r_opaque (8), 4 ds_r_mask (9)
//      (= clean_cull.comp rigIndex, the off-screen region index k).
//   v: the views of this frame (binding 10): cascades (info.x 0..3, off region SUN) and
//      projector tiles (info.x 4, off region PROJ).
// Input list L = the main list's casters (n0 = counts[shadowSlot]) FOLLOWED BY the
// off-screen region (n1); stable compaction in chunks of 256.
// SHADOW-CASTER LOD (u_flags bit 2; LLCleanRigShadowLod, binding 13): a kept draw whose
// slot has #561 decimated steps renumbered onto its own vertices takes the coarsest step
// whose geometric error (bind space x the skin's bind-shape scale) stays under
// u_lod_tol x this view's shadow-texel footprint at the wearer -- below what the map can
// resolve, so a near / fine cascade keeps the full mesh. Same skinned vertices (vertexOffset),
// the step's indices in the shadow-LOD index buffer: those draws go to half 1.
// Output: out_cmds[((v * 5 + L) * 2 + h) * stride], h 0 = main index buffer, h 1 = the
// shadow-LOD index buffer, counts at out_counts[(v * 5 + L) * 4]:
//   [0] kept draws (h 0), [1] kept draws (h 1), [2] / [3] FALLBACK counts: when the kept
//   draws do not fit the stride, [0] / [1] are 0 and [2] / [3] are the uncull'd main / off
//   counts, so the caller's two fallback draws (the old path) draw everything.
layout(local_size_x = 256) in;

struct DrawCmd { uint indexCount; uint instanceCount; uint firstIndex; int vertexOffset; uint firstInstance; };
struct Instance {
    mat4 model_matrix;
    vec4 aabb_min;
    vec4 aabb_max;
    vec4 tint;
    mat4 uv_matrix;
    uint lod_group_id;
    uint material_id;
    uint flags;
    uint skin_id;
    vec4 spin_axis;
    vec4 spin_pivot;
};
struct RigView {
    vec4  planes[6];   // ax+by+cz+d >= 0 inside (agent space, = the view's static cull)
    vec4  lod;         // shadow caster LOD: cascade .x world texel (m); projector .xyz apex, .w texel per unit distance
    uvec4 info;        // .x cascade index 0..3, 4 = projector tile; .y off-screen region
};

layout(std430, binding = 0) readonly buffer Instances { Instance instances[]; };
layout(std430, binding = 1) readonly buffer AvatarVis { uint av_vis[]; };
layout(std430, binding = 2) readonly buffer SkinMetaW { uint skin_meta_w[]; };
layout(std430, binding = 3) readonly buffer Counts    { uint counts[]; };   // the main cull's counters
layout(std430, binding = 4) readonly buffer L0 { DrawCmd l0[]; };
layout(std430, binding = 5) readonly buffer L1 { DrawCmd l1[]; };
layout(std430, binding = 6) readonly buffer L2 { DrawCmd l2[]; };
layout(std430, binding = 7) readonly buffer L3 { DrawCmd l3[]; };
layout(std430, binding = 8) readonly buffer L4 { DrawCmd l4[]; };
layout(std430, binding = 9) readonly buffer RigOff { uint rig_off_count[32]; DrawCmd rig_off_cmd[]; };
layout(std430, binding = 10) readonly buffer Views { RigView views[]; };
layout(std430, binding = 11) writeonly buffer OutCmds   { DrawCmd out_cmds[]; };
layout(std430, binding = 12) writeonly buffer OutCounts { uint out_counts[]; };
// LLCleanRigShadowLod's table: 12 words per entry (see its header), keyed by the drawn
// slot's first index.
layout(std430, binding = 13) readonly buffer ShadowLod { uint slod[]; };
#define SLOD_WORDS  12u
#define SLOD_CAP    8192u
#define SLOD_PROBES 16u
#define SLOD_EMPTY  0xFFFFFFFFu

layout(push_constant) uniform Push {
    uint u_views;        // views this frame
    uint u_stride;       // output capacity per (view, list, half)
    uint u_skin_count;   // valid skin_id < this
    uint u_cap;          // main bucket capacity (counts are clamped to it)
    uint u_off_cap;      // draws per off-screen region (0 = none)
    uint u_flags;        // bit 0: no culling (keep every draw; diagnostics), bit 1: list 2's snapshot
                         // is missing this frame (that list takes the fallback: uncull'd),
                         // bit 2: shadow-caster LOD on (binding 13 valid), bit 8: the subgroup scan
                         // may run (full subgroups; clean_wg_scan.glsl)
    float u_lod_tol;     // RenderVKShadowRigLodTexels: step error allowed, in shadow texels
    uint u_pad1;
} pc;

// = clean_cull.comp / LLCleanRendererVK::kAv* layout.
#define AV_VIS_SLOTS AV_SLOT_CAP
#define SKIN_META_WORDS 1892u
#define CASTER_BASE (AV_VIS_SLOTS + 4u)
#define AV_DEM_BASE (CASTER_BASE + 102u)
#define AV_BOX_BASE (AV_DEM_BASE + 2u * AV_VIS_SLOTS)
#define OFF_REGIONS 4u

uint shadowSlot(uint L) { return L == 0u ? 12u : L == 1u ? 13u : L == 2u ? 14u : L == 3u ? 15u : 16u; }

DrawCmd loadCmd(uint L, uint i)
{
    if (L == 0u) return l0[i];
    if (L == 1u) return l1[i];
    if (L == 2u) return l2[i];
    if (L == 3u) return l3[i];
    return l4[i];
}

bool boxInPlanes(uint v, vec3 mn, vec3 mx)
{
    for (uint i = 0u; i < 6u; ++i)
    {
        const vec4 p = views[v].planes[i];
        const vec3 q = vec3(p.x >= 0.0 ? mx.x : mn.x, p.y >= 0.0 ? mx.y : mn.y, p.z >= 0.0 ? mx.z : mn.z);
        if (dot(p.xyz, q) + p.w < 0.0) return false;
    }
    return true;
}

// = clean_cull.comp casterOk (cascades): the view-slice caster planes a shadow can't
// cross, and the minimum caster size in cascade texels.
bool casterOk(uint c, vec3 wmin, vec3 wmax)
{
    if (c >= 4u) return true;
    if (uint(av_vis.length()) <= CASTER_BASE + 101u || av_vis[CASTER_BASE + 101u] == 0u) return true;
    for (uint i = 0u; i < 6u; ++i)
    {
        const uint b = CASTER_BASE + (c * 6u + i) * 4u;
        const vec4 p = vec4(uintBitsToFloat(av_vis[b]), uintBitsToFloat(av_vis[b + 1u]),
                            uintBitsToFloat(av_vis[b + 2u]), uintBitsToFloat(av_vis[b + 3u]));
        const vec3 q = vec3(p.x >= 0.0 ? wmax.x : wmin.x, p.y >= 0.0 ? wmax.y : wmin.y, p.z >= 0.0 ? wmax.z : wmin.z);
        if (dot(p.xyz, q) + p.w < 0.0) return false;
    }
    const float texel = uintBitsToFloat(av_vis[CASTER_BASE + 96u + c]);
    const float mint  = uintBitsToFloat(av_vis[CASTER_BASE + 100u]);
    const vec3 e = wmax - wmin;
    return max(e.x, max(e.y, e.z)) >= texel * mint;
}

// The wearer's padded box of the draw keepDraw last tested; g_box false = unknown.
bool g_box = false;
vec3 g_mn, g_mx;
uint g_sid = 0xFFFFFFFFu;

bool keepDraw(uint id, uint v)
{
    g_box = false;
    g_sid = 0xFFFFFFFFu;
    if (id >= uint(instances.length())) return true;
    const uint sid = instances[id].skin_id;
    if (av_vis[AV_VIS_SLOTS] == 0u || sid >= pc.u_skin_count
        || sid * SKIN_META_WORDS >= uint(skin_meta_w.length()))
        return true;
    const uint av = skin_meta_w[sid * SKIN_META_WORDS];
    if (av >= AV_VIS_SLOTS || AV_BOX_BASE + 6u * av + 5u >= uint(av_vis.length())) return true;
    const uint b = AV_BOX_BASE + 6u * av;
    const vec3 mn = vec3(uintBitsToFloat(av_vis[b]), uintBitsToFloat(av_vis[b + 1u]), uintBitsToFloat(av_vis[b + 2u]));
    const vec3 mx = vec3(uintBitsToFloat(av_vis[b + 3u]), uintBitsToFloat(av_vis[b + 4u]), uintBitsToFloat(av_vis[b + 5u]));
    if (!(mn.x <= mx.x)) return true;   // unknown box (or NaN): always drawn
    g_box = true; g_mn = mn; g_mx = mx; g_sid = sid;
    return boxInPlanes(v, mn, mx) && casterOk(views[v].info.x, mn, mx);
}

// = clean_cull.comp rigBindScale: the largest column of the skin's bind shape (the
// SkinMeta record's last 16 words), 1 when unknown / absurd.
float rigBindScale(uint sid)
{
    const uint b = sid * SKIN_META_WORDS + SKIN_META_WORDS - 16u;
    if (av_vis[AV_VIS_SLOTS] == 0u || sid >= pc.u_skin_count || b + 11u >= uint(skin_meta_w.length())) return 1.0;
    const vec3 c0 = vec3(uintBitsToFloat(skin_meta_w[b + 0u]), uintBitsToFloat(skin_meta_w[b + 1u]), uintBitsToFloat(skin_meta_w[b + 2u]));
    const vec3 c1 = vec3(uintBitsToFloat(skin_meta_w[b + 4u]), uintBitsToFloat(skin_meta_w[b + 5u]), uintBitsToFloat(skin_meta_w[b + 6u]));
    const vec3 c2 = vec3(uintBitsToFloat(skin_meta_w[b + 8u]), uintBitsToFloat(skin_meta_w[b + 9u]), uintBitsToFloat(skin_meta_w[b + 10u]));
    const float sc = max(length(c0), max(length(c1), length(c2)));
    return (sc > 1.0e-4 && sc < 1.0e4) ? sc : 1.0;
}

// LLCleanRigShadowLod::tableInsert's probe chain (a deleted entry continues it, an empty one ends it).
uint slodFind(uint key)
{
    if (uint(slod.length()) < SLOD_CAP * SLOD_WORDS) return SLOD_EMPTY;
    const uint h = (key * 2654435761u) >> (32u - 13u);   // top log2(SLOD_CAP) bits
    for (uint k = 0u; k < SLOD_PROBES; ++k)
    {
        const uint e = (h + k) & (SLOD_CAP - 1u);
        const uint w = slod[e * SLOD_WORDS];
        if (w == key) return e;
        if (w == SLOD_EMPTY) break;
    }
    return SLOD_EMPTY;
}

// Shadow-caster LOD of kept draw c in view v (right after keepDraw: g_box / g_sid are its
// wearer's): true = c now draws a coarser step from the shadow-LOD index buffer.
bool shadowLod(inout DrawCmd c, uint v)
{
    if ((pc.u_flags & 4u) == 0u || !g_box || !(pc.u_lod_tol > 0.0)) return false;
    const uint e = slodFind(c.firstIndex);
    if (e == SLOD_EMPTY) return false;
    const uint b = e * SLOD_WORDS;
    if (slod[b + 1u] != c.indexCount) return false;   // not the slot the entry was built for
    const uint ns = min(slod[b + 3u] & 0xFFFFu, 3u);
    if (ns == 0u) return false;
    // The view's world-space texel at the wearer: a cascade's is constant; a projector's
    // grows with the distance from its apex (the box's NEAREST point: conservative).
    const vec4 L = views[v].lod;
    float texel;
    if (views[v].info.x < 4u) texel = L.x;
    else
    {
        const vec3 q = clamp(L.xyz, g_mn, g_mx);
        texel = L.w * max(length(L.xyz - q), 0.05);
    }
    const float lim = pc.u_lod_tol * texel / rigBindScale(g_sid);   // err (bind space) <= lim
    if (!(lim > 0.0)) return false;
    const vec2 e12 = unpackHalf2x16(slod[b + 11u]);
    const float err[3] = float[3](e12.x, e12.y, unpackHalf2x16(slod[b + 3u] >> 16u).x);
    for (int k = int(ns) - 1; k >= 0; --k)
    {
        const uint cnt = slod[b + 8u + uint(k)];
        if (cnt != 0u && err[k] <= lim)
        {
            c.firstIndex = slod[b + 4u + uint(k)];
            c.indexCount = cnt;
            return true;
        }
    }
    return false;
}

shared uint s_scan[256];
shared uint s_base;
#include "clean_wg_scan.glsl"

void main()
{
    const uint L = gl_WorkGroupID.x;
    const uint v = gl_WorkGroupID.y;
    if (L >= 5u || v >= pc.u_views) return;
    const uint lid = gl_LocalInvocationID.x;
    const uint ob = ((v * 5u + L) * 2u) * pc.u_stride;
    const uint cb = (v * 5u + L) * 4u;
    const uint r = views[v].info.y;
    const uint n0 = min(counts[shadowSlot(L)], pc.u_cap);
    const uint offc = pc.u_off_cap;
    const uint n1 = (offc == 0u || r >= OFF_REGIONS) ? 0u : min(rig_off_count[L * OFF_REGIONS + r], offc);
    const uint ob1 = (L * OFF_REGIONS + r) * offc;
    const uint n = n0 + n1;
    // List 2's caster snapshot (mShadowRigAlpha) not taken this frame: the old path.
    if (L == 2u && (pc.u_flags & 2u) != 0u)
    {
        if (lid == 0u)
        {
            out_counts[cb + 0u] = 0u; out_counts[cb + 1u] = 0u;
            out_counts[cb + 2u] = n0; out_counts[cb + 3u] = n1;
        }
        return;
    }
    // Subgroup scan (clean_wg_scan.glsl): one barrier per 256-draw chunk instead of 18.
    // Same packed prefix sums -> the same compacted halves, entry for entry (element
    // order = wgLinearId(), a bijection); the overflow test sees the same totals.
    if (wgScanUsable(256u, (pc.u_flags & 256u) != 0u))
    {
        const uint lin = wgLinearId();
        uint base = 0u;
        bool overS = false;
        for (uint c0 = 0u; c0 < n; c0 += 256u)
        {
            const uint i = c0 + lin;
            DrawCmd c;
            uint keep = 0u;
            if (i < n)
            {
                c = i < n0 ? loadCmd(L, i) : rig_off_cmd[ob1 + (i - n0)];
                const bool k0 = c.indexCount != 0u && c.instanceCount != 0u
                             && (keepDraw(c.firstInstance, v) || (pc.u_flags & 1u) != 0u);
                keep = !k0 ? 0u : (shadowLod(c, v) ? 0x10000u : 1u);
            }
            uint chunk;
            const uint incl = wgInclusiveScan(keep, chunk);
            const uint total = base + chunk;
            if ((total & 0xFFFFu) > pc.u_stride || (total >> 16u) > pc.u_stride)
            { overS = true; break; }   // uniform: every lane sees the same total
            // (bounded by the overflow test above; the index checks never trust the scan)
            const uint o0 = (base & 0xFFFFu) + (incl & 0xFFFFu) - 1u;
            const uint o1 = (base >> 16u) + (incl >> 16u) - 1u;
            if (keep == 1u && (incl & 0xFFFFu) != 0u && o0 < pc.u_stride) out_cmds[ob + o0] = c;
            else if (keep > 1u && (incl >> 16u) != 0u && o1 < pc.u_stride) out_cmds[ob + pc.u_stride + o1] = c;
            base = total;
        }
        if (lid == 0u)
        {
            out_counts[cb + 0u] = overS ? 0u : (base & 0xFFFFu);
            out_counts[cb + 1u] = overS ? 0u : (base >> 16u);
            out_counts[cb + 2u] = overS ? n0 : 0u;
            out_counts[cb + 3u] = overS ? n1 : 0u;
        }
        return;
    }
    if (lid == 0u) s_base = 0u;
    barrier();
    bool over = false;
    for (uint c0 = 0u; c0 < n; c0 += 256u)
    {
        const uint i = c0 + lid;
        DrawCmd c;
        uint keep = 0u;
        if (i < n)
        {
            c = i < n0 ? loadCmd(L, i) : rig_off_cmd[ob1 + (i - n0)];
            // (a capacity-dropped draw is empty: nothing to keep)
            const bool k0 = c.indexCount != 0u && c.instanceCount != 0u
                         && (keepDraw(c.firstInstance, v) || (pc.u_flags & 1u) != 0u);
            // half 0 (low 16 bits) or, drawn coarser, half 1 (high 16 bits)
            keep = !k0 ? 0u : (shadowLod(c, v) ? 0x10000u : 1u);
        }
        s_scan[lid] = keep;
        barrier();
        // Hillis-Steele inclusive scan of the keep flags.
        for (uint off = 1u; off < 256u; off <<= 1u)
        {
            const uint a = lid >= off ? s_scan[lid - off] : 0u;
            barrier();
            s_scan[lid] += a;
            barrier();
        }
        // packed counts: half 0 in the low 16 bits, half 1 in the high (the stride is
        // <= 32768, so neither half carries into the other before the overflow test)
        const uint base = s_base;
        const uint total = base + s_scan[255];
        if ((total & 0xFFFFu) > pc.u_stride || (total >> 16u) > pc.u_stride)
        { over = true; break; }   // uniform: every lane sees the same total
        if (keep == 1u) out_cmds[ob + (base & 0xFFFFu) + (s_scan[lid] & 0xFFFFu) - 1u] = c;
        else if (keep != 0u) out_cmds[ob + pc.u_stride + (base >> 16u) + (s_scan[lid] >> 16u) - 1u] = c;
        barrier();   // every lane has read s_base / s_scan
        if (lid == 0u) s_base = total;
        barrier();
    }
    if (lid == 0u)
    {
        out_counts[cb + 0u] = over ? 0u : (s_base & 0xFFFFu);
        out_counts[cb + 1u] = over ? 0u : (s_base >> 16u);
        out_counts[cb + 2u] = over ? n0 : 0u;
        out_counts[cb + 3u] = over ? n1 : 0u;
    }
}
