#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
// vkclean -- #1033: derive the slim vertex-shader instance records (clean_vs_inst.glsl) from the
// Instance SSBO (current) and the previous-instance SSBO. One thread per row, dense and
// coalesced: the vertex stage then loads 112 B instead of 224 B per instance. Runs after the
// frame's instance stream + previous-row copies, so it is always in sync with whatever wrote
// Instance. Buffers by device address (no descriptor set), as clean_inst_shift.comp.

layout(local_size_x = 64) in;

#include "clean_vs_inst.glsl"

struct Instance {
    mat4 model_matrix;
    vec4 aabb_min;
    vec4 aabb_max;
    vec4 tint;
    mat4 uv_matrix;
    uint lod_group_id;
    uint material_id;
    uint flags;
    uint skin_id;
    vec4 spin_axis;
    vec4 spin_pivot;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer InstRows { Instance r[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer VsRows { VsInst r[]; };

layout(push_constant) uniform VsInstPush {
    uvec2 in_cur;
    uvec2 out_cur;
    uvec2 in_prev;    // (unused when n_prev = 0)
    uvec2 out_prev;
    uint  n_cur;
    uint  n_prev;
    uint  pad0;
    uint  pad1;
} sp;                 // 48 B

void derive(uvec2 src, uvec2 dst, uint i)
{
    const Instance s = InstRows(src).r[i];
    VsInst o;
    o.m0 = vec4(s.model_matrix[0].x, s.model_matrix[1].x, s.model_matrix[2].x, s.model_matrix[3].x);
    o.m1 = vec4(s.model_matrix[0].y, s.model_matrix[1].y, s.model_matrix[2].y, s.model_matrix[3].y);
    o.m2 = vec4(s.model_matrix[0].z, s.model_matrix[1].z, s.model_matrix[2].z, s.model_matrix[3].z);
    o.tint = s.tint;
    o.uvlin = vec4(s.uv_matrix[0].xy, s.uv_matrix[1].xy);
    o.uvoff = s.uv_matrix[3].xy;
    o.bound_r = length(0.5 * (s.aabb_min.xyz + s.aabb_max.xyz)) + length(0.5 * abs(s.aabb_max.xyz - s.aabb_min.xyz));
    const uint bone = min(uint(max(s.aabb_max.w, 0.0) + 0.5), 255u);
    o.aux = bone | (dot(s.spin_axis.xyz, s.spin_axis.xyz) > 0.0 ? VSI_SPIN : 0u);
    o.material_id = s.material_id;
    o.flags = s.flags;
    o.skin_id = s.skin_id;
    o.pad0 = 0u;
    VsRows(dst).r[i] = o;
}

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i < sp.n_cur) derive(sp.in_cur, sp.out_cur, i);
    if (i < sp.n_prev) derive(sp.in_prev, sp.out_prev, i);
}
