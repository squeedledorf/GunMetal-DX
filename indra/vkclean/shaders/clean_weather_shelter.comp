#elif defined(WX_SH_MESH)
layout(local_size_x = 8, local_size_y = 8) in;

uint shOctPack(vec3 n)
{
    n /= max(abs(n.x) + abs(n.y) + abs(n.z), 1e-20);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    const ivec2 q = ivec2(round(clamp(e, vec2(-1.0), vec2(1.0)) * 2047.0));
    return (uint(q.x) & 0xFFFu) | ((uint(q.y) & 0xFFFu) << 12u);   // band byte 0 (clean_weather_snowmesh.vert)
}

// The published texel t of the current atlas image (x height, y depth); false: no surface.
bool shAt(uint dst, ivec2 t, out vec2 hd)
{
    hd = imageLoad(uShS[dst], t).xy;
    return hd.x > kShNoneTest;
}

void main()
{
    // vertex (i, j) = atlas texel (2i, 2j); the grid is (W / 2) wide
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 sz = imageSize(uShH);
    const ivec2 t = 2 * g;
    if (any(greaterThanEqual(t, sz))) return;
    const uint L = wxShLayerAt(t);
    if (L == 0xFFFFFFFFu) return;
    const uint dst = sh_cfg.y & 1u;
    const int res = int(sh_info[L].y);
    const ivec2 o = ivec2(int(sh_info[L].z & 0xFFFFu), int(sh_info[L].z >> 16u));
    const float e = sh_ext[L].x;
    const float w = e / float(res);
    const uint vid = uint(g.y) * uint(sz.x / 2) + uint(g.x);
    vec2 hd;
    const bool has = shAt(dst, t, hd);
    const float lift = sp.e.z, least = sp.e.w;
    // the snow top (its surface + lift where there is none) in the layer's frame -> world
    const vec2 q = ((vec2(t - o) + 0.5) / float(res) - 0.5) * e;
    const float top = has ? hd.x + max(hd.y, 0.0) + lift : 0.0;
    // normal: the snow top's gradient over the neighbouring vertices (one-sided at the tile edge / a gap)
    vec2 grad = vec2(0.0);
    if (has)
    {
        vec2 a, b;
        const ivec2 tx0 = t - ivec2(2, 0), tx1 = t + ivec2(2, 0), ty0 = t - ivec2(0, 2), ty1 = t + ivec2(0, 2);
        const bool ax = tx0.x >= o.x && shAt(dst, tx0, a), bx = tx1.x < o.x + res && shAt(dst, tx1, b);
        const float hx0 = ax ? a.x + max(a.y, 0.0) : top - lift, hx1 = bx ? b.x + max(b.y, 0.0) : top - lift;
        grad.x = (hx1 - hx0) / (((ax ? 2.0 : 0.0) + (bx ? 2.0 : 0.0)) * w + 1e-6);
        const bool ay = ty0.y >= o.y && shAt(dst, ty0, a), by = ty1.y < o.y + res && shAt(dst, ty1, b);
        const float hy0 = ay ? a.x + max(a.y, 0.0) : top - lift, hy1 = by ? b.x + max(b.y, 0.0) : top - lift;
        grad.y = (hy1 - hy0) / (((ay ? 2.0 : 0.0) + (by ? 2.0 : 0.0)) * w + 1e-6);
    }
    const vec3 nl = normalize(vec3(-grad, 1.0));
    const vec2 cs = vec2(cos(sh_frame[L].w), sin(sh_frame[L].w));
    const vec3 nw = vec3(cs.x * nl.x - cs.y * nl.y, cs.y * nl.x + cs.x * nl.y, nl.z);
    const vec3 P = wxShWorld(L, vec3(q, top));
    sh_mv[vid] = WxShMeshVert(P.x, P.y, P.z, shOctPack(nw));
    // the cell (i, j) .. (i + 1, j + 1): inside the tile, every corner a surface, joined, some snow
    const ivec2 lt = t - o;
    if (!has || lt.x + 2 >= res || lt.y + 2 >= res) return;
    vec2 c1, c2, c3;
    if (!shAt(dst, t + ivec2(2, 0), c1) || !shAt(dst, t + ivec2(0, 2), c2) || !shAt(dst, t + ivec2(2, 2), c3)) return;
    const float hmin = min(min(hd.x, c1.x), min(c2.x, c3.x)), hmax = max(max(hd.x, c1.x), max(c2.x, c3.x));
    if (hmax - hmin > 0.06 + 1.4 * w) return;   // (a step: a shoulder's edge over an arm far below)
    if (max(max(hd.y, c1.y), max(c2.y, c3.y)) < least) return;
    const uint n = atomicAdd(sh_ma[0], 6u);
    if (n + 6u > sh_ma[5]) return;
    const uint gw = uint(sz.x / 2);
    const uint v00 = vid, v10 = vid + 1u, v01 = vid + gw, v11 = vid + gw + 1u;
    sh_mi[n] = v00; sh_mi[n + 1u] = v10; sh_mi[n + 2u] = v11;
    sh_mi[n + 3u] = v00; sh_mi[n + 4u] = v11; sh_mi[n + 5u] = v01;
}

#else   // WX_SH_PUBLISH
layout(local_size_x = 8, local_size_y = 8) in;
// The model at avatar scale (clean_weather_snow.comp's constants).
const float kShSlide = 0.7;        // base slope (dz / dx) where the level starts to fall (~35 degrees; 0 at 2 x)
const float kShRepose = 0.7;       // tan 35
const float kShCohesion = 0.015;   // m (wet snow stands a little proud of the repose on a small support)
const float kShStep = 0.04;        // m: a drop this steep (+ the snow there) ends a support
const int   kShEdgeSearch = 10;    // texels searched for a support's edge, per direction
const float kShMoved = 0.12;       // m: the surface under a texel moved this much -> its snow fell off

// The rasterized height at tile texel t (false: nothing there / outside the tile).
bool shH(ivec2 t, ivec2 o, int res, out float h)
{
    h = kShNone;
    if (any(lessThan(t, o)) || any(greaterThanEqual(t, o + ivec2(res)))) return false;
    const uint hz = imageLoad(uShH, t).r;
    if (hz == 0u) return false;
    h = wxShDec(hz);
    return true;
}

void main()
{
    const ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(t, ivec2(imageSize(uShH))))) return;
    const uint L = wxShLayerAt(t);
    if (L == 0xFFFFFFFFu) return;
    const uint dst = sh_cfg.y & 1u;
    const int res = int(sh_info[L].y);
    const ivec2 o = ivec2(int(sh_info[L].z & 0xFFFFu), int(sh_info[L].z >> 16u));
    float h;
    const bool has = shH(t, o, res, h);
    float D = 0.0;
    const bool snowOn = (sp.a.y & kShFlagSnow) != 0u;
    if (has && snowOn && sh_ext[L].z < 0.5 && sp.f.x > -0.5)
    {
        const float e = sh_ext[L].x, ePrev = sh_ext[L].y;
        const float w = e / float(res);
        const uint src = uint(sp.f.x + 0.5) & 1u;
        // the previous step's depth at this texel's point (resampled when the extent changed)
        ivec2 tp = t;
        const vec2 q = ((vec2(t - o) + 0.5) / float(res) - 0.5) * e;
        if (abs(ePrev - e) > 1e-3 && ePrev > 0.0)
            tp = o + clamp(ivec2((q / ePrev + 0.5) * float(res)), ivec2(0), ivec2(res - 1));
        const vec2 prev = imageLoad(uShS[src], tp).xy;
        D = (prev.x > kShNoneTest && abs(prev.x - h) < kShMoved) ? max(prev.y, 0.0) : 0.0;
        // the surface's slope and the level the snowfall fills toward
        float hn[4];
        bool on[4];
        const ivec2 kN[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        for (int i = 0; i < 4; ++i)
            on[i] = shH(t + kN[i], o, res, hn[i]) && abs(hn[i] - h) <= 0.03 + kShRepose * w;
        const float gx = (on[0] && on[1]) ? (hn[1] - hn[0]) / (2.0 * w) : on[1] ? (hn[1] - h) / w : on[0] ? (h - hn[0]) / w : 0.0;
        const float gy = (on[2] && on[3]) ? (hn[3] - hn[2]) / (2.0 * w) : on[3] ? (hn[3] - h) / w : on[2] ? (h - hn[2]) / w : 0.0;
        const float slope = length(vec2(gx, gy));
        const float level = sp.d.x * (1.0 - smoothstep(kShSlide, 2.0 * kShSlide, slope));
        // the sky over it (the static roof maps: a porch, a room)
        const float sky = shSkyAt(wxShWorld(L, vec3(q, h + 0.05)));
        // REPOSE between joined neighbours (the previous step's snow tops)
        for (int i = 0; i < 4; ++i)
        {
            if (!on[i]) continue;
            const vec2 pn = imageLoad(uShS[src], clamp(tp + kN[i], o, o + ivec2(res - 1))).xy;
            if (!(pn.x > kShNoneTest)) continue;
            const float dn = max(pn.y, 0.0);
            const float dS = (hn[i] + dn) - (h + D);
            const float ex = abs(dS) - kShRepose * w;
            if (ex <= 0.0) continue;
            const float f = 0.1 * ex;
            D += dS > 0.0 ? min(f, 0.2 * dn) : -min(f, 0.2 * D);
        }
        // the snowfall fills it toward its level where the sky is open (never above: piles come
        // from the repose alone); the world's melt; #903 under cover it melts, snowing or not
        if (D < level) D = min(D + sp.d.y * sky, level);
        D -= sp.d.z;
        D -= sp.d.w * clamp(1.0 - 2.0 * sky, 0.0, 1.0);
        // SUPPORT CAP: the nearest edge (a drop of the surface, or nothing) in 8 directions
        float edge = float(kShEdgeSearch) * w;
        for (int k = 0; k < 8; ++k)
        {
            const ivec2 dir = ivec2(k < 3 ? k - 1 : k < 5 ? (k == 3 ? -1 : 1) : k - 6, k < 3 ? -1 : k < 5 ? 0 : 1);
            const float stepLen = w * length(vec2(dir));
            for (int r = 1; r <= kShEdgeSearch; ++r)
            {
                if (float(r) * stepLen >= edge) break;
                float hr;
                if (!shH(t + dir * r, o, res, hr) || hr < h - kShStep - float(r) * stepLen * kShRepose)
                {
                    edge = min(edge, (float(r) - 0.5) * stepLen);
                    break;
                }
            }
        }
        D = min(D, kShCohesion + kShRepose * edge);
        if (slope > kShSlide) D = min(D, level + kShCohesion);   // slides off steep surfaces
        // SHED: running / flying / jumping
        if ((sp.a.y & kShFlagMotion) != 0u)
        {
            const uint slot = sh_info[L].x;
            if (2u * slot + 1u < uint(av_state.length()))
            {
                const vec4 v = av_state[2u * slot + 1u];
                if (v.x > sp.e.x || v.y > sp.e.y) D *= exp(-sp.b.w * 2.5);
            }
        }
        D = clamp(D, 0.0, max(sp.d.x, 0.0));
    }
    imageStore(uShS[dst], t, vec4(has ? h : kShNone, D, 0.0, 0.0));
}
#endif
