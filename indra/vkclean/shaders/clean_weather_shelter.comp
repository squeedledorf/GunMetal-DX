// Vertex `v` of the draw (index buffer value + vertexOffset) in world space.
vec3 wxShVertex(uint id, bool rigged, bool local, mat4 Mp, mat4 Mi, QvHeader qh, uint v)
{
    if (rigged)
    {
        if (v * SV_WORDS + 2u >= uint(skin_v.length())) return Mp[3].xyz;
        const vec3 p = SV_POS(skin_v, v);
        // A skin-cache range is pelvis-local (rotation normalized); a per-frame one eye-relative.
        if (local)
            return normalize(Mp[0].xyz) * p.x + normalize(Mp[1].xyz) * p.y + normalize(Mp[2].xyz) * p.z + Mp[3].xyz;
        return sp.b.xyz + p;
    }
    if (v * QV_WORDS + 1u >= uint(qv_words.length())) return Mi[3].xyz;
    return (Mi * vec4(qvPos(qh, qv_words[v * QV_WORDS], qv_words[v * QV_WORDS + 1u]), 1.0)).xyz;
}

void main()
{
    const uint k = gl_WorkGroupID.x;
    const uint lid = gl_LocalInvocationIndex;
    if (lid == 0u) sReach = 0u;
    barrier();
    if (k >= min(sh_head.x, sh_head.y)) return;   // (uniform per workgroup)
    const uvec2 item = sh_items[k];
    if ((item.y & 0x100u) == 0u) return;   // (#901: an accumulation-only item)
    const uint id = item.x, L = item.y & 0xFFu;
    const WxShDraw dc = cand[id];
    const bool rigged = (instances[id].flags & 1u) != 0u;
    if (lid == 0u && !rigged) atomicAdd(sh_attach[L], 1u);   // (a worn rigid attachment: the log; PREP zeroed it)
    const uint st = (rigged && id * RC_WORDS + RC_STATE < uint(rig_cache.length())) ? rig_cache[id * RC_WORDS + RC_STATE] : 0u;
    const bool local = rigged && (st & RC_ST_LOCAL) != 0u;
    const uint pslot = st & RC_ST_SLOT;
    const mat4 Mp = (local && pslot < uint(avatar_joints.length())) ? jointWorld(avatar_joints[pslot].world[0]) : mat4(1.0);
    // A WORN rigid attachment's model matrix is its constant offset from the joint it rides on
    // (clean_draw.vert ATTACHMENT SKINNING: the joint in aabb_max.w, the wearer's slot in skin_id):
    // its world pose is that joint's world matrix x it. (Using the offset alone put every worn
    // umbrella / hat near the region's origin, off the tile: #901 "the umbrella does nothing".)
    mat4 Mi = instances[id].model_matrix;
    if (!rigged && (instances[id].flags & 512u) != 0u && instances[id].skin_id < uint(avatar_joints.length()))
    {
        const uint bone = min(uint(instances[id].aabb_max.w + 0.5), 215u);
        Mi = jointWorld(avatar_joints[instances[id].skin_id].world[bone]) * Mi;
    }
    const uint vb = uint(max(dc.vertexOffset, 0));
    QvHeader qh;
    qh.pos_c = vec3(0.0); qh.pos_s = vec3(0.0); qh.uv_c = vec2(0.0); qh.uv_s = vec2(0.0);
    if (!rigged) qh = QV_LOAD_HEADER(qv_words, max(vb, QV_HEADER_VERTS));
    const float e = sh_ext[L].x;
    const int res = int(sh_info[L].y);
    const ivec2 o = ivec2(int(sh_info[L].z & 0xFFFFu), int(sh_info[L].z >> 16u));
    // #783 BODY CONTACT: the BOTTOM map (the lowest surface per texel, atomicMax of the encoded
    // -height) th rows under the top map (clean_weather_shelter.glsl WX_SH_BODY_ROWS).
    const int th = int(sp.a.z);
    const bool body = imageSize(uShH).y >= 2 * th + WX_SH_BODY_ROWS;
    float reach = 0.0;
    const uint nTri = dc.indexCount / 3u;
    const uint nIdx = uint(ibo.length()) * 2u;
    if (e > 0.0 && res > 0)
        for (uint tri = lid; tri < nTri; tri += 64u)
        {
            const uint i0 = dc.firstIndex + 3u * tri;
            if (i0 + 2u >= nIdx) break;
            vec3 q[3];
            for (uint j = 0u; j < 3u; ++j)
            {
                const uint v = vb + QV_INDEX16(ibo, i0 + j);
                q[j] = wxShLocal(L, wxShVertex(id, rigged, local, Mp, Mi, qh, v));
                reach = max(reach, max(abs(q[j].x), abs(q[j].y)));
            }
            shRasterTri(q, e, res, o, th, body);
        }
    atomicMax(sReach, floatBitsToUint(min(reach, 0.5 * sp.c.y)));
    barrier();
    if (lid == 0u && sReach != 0u) atomicMax(sh_reach[L], sReach);
}
