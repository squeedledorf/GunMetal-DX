#version 460
#extension GL_GOOGLE_include_directive : require
// vkclean — PER-AVATAR SHELTER MAPS (#901; vkgfx/llcleanweathervk_shelter.cpp recordShelter): a
// small top-down height map per avatar near the camera, of the avatar itself and what it wears,
// in the avatar's own frame (clean_weather_shelter.glsl has the record and the atlas). One
// GPU-driven chain per recording, right after the MAIN cull (its per-instance candidates cand[]
// hold the drawn LOD's index range and, for rigged draws, this frame's pre-skinned vertex range)
// and before the G-buffer, which reads the result the same recording:
//
//   -DWX_SH_PREP     one invocation per joint-table slot: a slot that owns a layer computes the
//                    layer's frame from its pelvis (centre, heading), its extent (the last
//                    raster's reach + a margin, from the minimum up to the cap; sticky: grows at
//                    once, shrinks only by a clear margin, in 25 cm steps), a teleport / new
//                    assignment reset; and every slot writes its four PER-SLOT ROWS at the bottom
//                    of BOTH atlas images (the lit FS finds an avatar's tile by its slot there):
//                    (centre x, y), (centre z, yaw), (extent, tile resolution -- 0: no layer),
//                    (tile corner x, y), and #901 the PER-AVATAR WETNESS (top, body) it integrates
//                    from the slot's exposure (the roof maps over a few joints x the avatar's own
//                    cover in its previous map, traced along the fall) and the exposure itself,
//                    and the layer directory (row + 6, columns 0..15).
//   -DWX_SH_FILTER   one invocation per instance id: a visible (main cull) rigged draw (its
//                    avatar's slot from the skin meta; not the cluster path -- -DWX_SH_CL_FILTER --,
//                    not a flexi chain)
//                    or worn rigid attachment (bit9: skin_id = the wearer's slot) of an avatar
//                    whose layer is DUE this step, not HUD, not invisible (tint alpha) -> the
//                    work list (bounded; the raster's indirect dispatch counts it). An item's y:
//                    the layer | 0x100 raster due | 0x200 its avatar's REST-POSE GRID is due (#901:
//                    clean_weather_accum.comp -DWX_AC_ACCUM runs over the same list).
//   -DWX_SH_CL_FILTER (#901 / #909 follow-up, with RenderVKClusterLOD) one invocation per selected
//                    entry of the cluster pre-skin's view (its indirect grid): an avatar's skinned
//                    cluster whose layer is due for the raster counts as work for it (CLEAR clears
//                    and frames it; an avatar drawn wholly by the cluster path had no work at all).
//   -DWX_SH_CLEAR    one invocation per atlas texel: the due layers that found work are cleared
//                    (a due layer with nothing drawn -- the own avatar hidden in mouselook --
//                    keeps its last map).
//                    #783 BODY CONTACT: with the bottom map, its texels too, and each layer's
//                    raster-time frame rows (clean_weather_shelter.glsl WX_SH_BODY_ROWS).
//   -DWX_SH_RASTER   one workgroup per work item (indirect): every triangle of the draw (the
//                    mega index buffer; rigged: the skinned vertices -- eye-relative, or pelvis-
//                    local for a skin-cache range --, static: the quantized vertices x the model
//                    matrix) into the layer's frame, rasterized top-down onto the tile (texel
//                    centres inside the triangle, either winding): atomicMax of the encoded
//                    height. Big triangles (an umbrella's canopy panels) are walked in blocks past
//                    kShTriTexels. Also the farthest horizontal reach (the next extent).
//                    #901 / #909 follow-up -DWX_SH_CL_RASTER: the same for the CLUSTER LOD parts, one
//                    workgroup per selected entry (clean_weather_cluster.glsl: the skinned arena's
//                    vertices, the cluster's triangles) -- the body, its clothes, wings, tail drawn
//                    by the cluster path are in the top and the bottom map like any other draw.
//                    #783 BODY CONTACT: the same texels' LOWEST surface into the bottom map
//                    (atomicMax of the encoded -height, under the top map in the same image):
//                    the snow passes press the snow down to the body's real underside.
//   -DWX_SH_PUBLISH  one invocation per atlas texel of a layer: the rasterized height (relative
//                    to the pelvis; kShNone where nothing) into the written atlas image, with the
//                    PER-AVATAR SNOW integrated on it (the world snow's model at avatar scale, in
//                    the avatar's frame: it rides along): the snowfall fills a texel toward its
//                    level (the global depth x the slope factor, only as far as the sky over it is
//                    open), the SUPPORT CAP (cohesion + tan 35 x the distance to where the surface
//                    drops away: domes on shoulders, a cone on a hat, the full depth only on wide
//                    tops), the REPOSE between joined neighbours, slide-off on steep surfaces; it
//                    MELTS with the world's snow and -- #903 -- under cover whether or not it still
//                    snows (the sky over the texel), is SHED by running / flying / jumping (the
//                    avatar's speed), dropped where its surface moved away, and cleared on a
//                    teleport / new layer. The previous step's depth is resampled when the extent
//                    changed.
//   -DWX_SH_MESH     one invocation per mesh vertex (every second texel of the atlas): the snow
//                    top in the world (the layer's current frame), its normal; and per cell whose
//                    corners all have a surface, are joined (no 6 cm step) and hold some snow, two
//                    triangles appended to the AVATAR SNOW MESH (drawn with the world snow mesh's
//                    pipelines: the G-buffer, the sun cascades, the forward pass).
//
// Set 0 = draw set 0 (0 the instances, 2 the joint table, 9 the frame info, 35 the rigged
// state words, 39 the mega-VBO's words, 49 the weather maps). Set 1 (own): 0 the raster target
// (r32ui; #783 2 x the tiles' rows + WX_SH_BODY_ROWS: the top map, the bottom map, the layers' raster-time
// frames), 1 the two atlas images (rg32f), 2 the record, 3 / 4 the main cull's candidates and
// their meta, 5 the skinned vertices, 6 the mega index buffer (words), 7 the skin meta words,
// 8 the avatars' motion state (clean_weather_snow.comp -DWX_SNOW_AVATAR; a stand-in without it),
// 9 / 10 / 11 the avatar snow mesh's vertices, indices and indexed indirect arguments.
#include "clean_frame_info.glsl"
#include "clean_joint_table.glsl"
#include "clean_skinvert.glsl"   // (+ clean_qvertex.glsl, clean_av_slots.glsl)

#define WX_SH_SET 1
#define WX_SH_BINDING 2
#define WX_SH_ACCESS
#include "clean_weather_shelter.glsl"
#if defined(WX_SH_CL_FILTER) || defined(WX_SH_CL_RASTER)
#include "clean_weather_cluster.glsl"   // (set 2: the cluster set; the pipelines' own layout)
#endif

struct WxShInstance
{
    mat4 model_matrix;
    vec4 aabb_min;
    vec4 aabb_max;
    vec4 tint;
    mat4 uv_matrix;
    uint lod_group_id;
    uint material_id;
    uint flags;
    uint skin_id;
    vec4 spin_axis;
    vec4 spin_pivot;
};
layout(std430, set = 0, binding = 0) readonly buffer WxShInstances { WxShInstance instances[]; };
layout(std430, set = 0, binding = 2) readonly buffer WxShJoints { AvatarJoints avatar_joints[]; };
layout(std430, set = 0, binding = 35) readonly buffer WxShRigCache { uint rig_cache[]; };
layout(std430, set = 0, binding = 39) readonly buffer WxShQv { uint qv_words[]; };

struct WxShDraw { uint indexCount; uint instanceCount; uint firstIndex; int vertexOffset; uint firstInstance; };
layout(set = 1, binding = 0, r32ui) uniform uimage2D uShH;
layout(set = 1, binding = 1, rg32f) uniform image2D uShS[2];
layout(std430, set = 1, binding = 3) readonly buffer WxShCand { WxShDraw cand[]; };
layout(std430, set = 1, binding = 4) readonly buffer WxShCandMeta { uint cand_meta[]; };
layout(std430, set = 1, binding = 5) readonly buffer WxShSkinV { uint skin_v[]; };
layout(std430, set = 1, binding = 6) readonly buffer WxShIbo { uint ibo[]; };
layout(std430, set = 1, binding = 7) readonly buffer WxShSkinMeta { uint skin_meta[]; };
layout(std430, set = 1, binding = 8) readonly buffer WxShAvState { vec4 av_state[]; };   // per slot 2 x vec4: [1] x / y smoothed speed (m/s)
struct WxShMeshVert { float x, y, z; uint n; };   // (clean_weather_snowmesh.vert: world xyz + the octahedral normal word)
layout(std430, set = 1, binding = 9) writeonly buffer WxShMeshV { WxShMeshVert sh_mv[]; };
layout(std430, set = 1, binding = 10) writeonly buffer WxShMeshI { uint sh_mi[]; };
layout(std430, set = 1, binding = 11) buffer WxShMeshA { uint sh_ma[8]; };   // VkDrawIndexedIndirectCommand (index count appended), [5] the index capacity

layout(push_constant) uniform ShPush
{
    uvec4 a;   // x instance count, y flags (1 skinned vertices bound, 2 skin meta bound, 4 snow, 8 mesh), z the per-slot rows' first row, w unused
    vec4  b;   // xyz the palettes' eye (the skinned vertices' origin, world), w dt (s)
    vec4  c;   // x extent minimum (m), y extent cap (m), z teleport distance (m), w unused
    vec4  d;   // snow: x the global depth (m), y the depth build this step (m), z the global melt this step (m), w the cover melt this step (m)
    vec4  e;   // x shed speed horizontal, y vertical (m/s), z the mesh lift (m), w the mesh's least depth (m)
    vec4  f;   // x the publish's previous atlas image (0 / 1; < 0 none)
    vec4  g;   // PER-AVATAR WETNESS (PREP): x the rain falling 0..1, y wetting per s (full rain, fully
               // exposed: 1 / the soak time), z drying per s (fully dry air: the conditions' boost /
               // the drying time), w the global surface wetness 0..1 (a first-seen avatar's guess)
    vec4  h;   // xy the precipitation's mean fall shear (m drift per m of fall), z 1 = wetness on, w unused
} sp;

const uint kShFlagSkinV = 1u, kShFlagSkinMeta = 2u, kShFlagSnow = 4u, kShFlagMesh = 8u, kShFlagMotion = 16u;
const uint kSkinMetaWords = 1892u;   // LLCleanSkinStore::SkinMeta / 4 (word 0 = the avatar's slot)
const uint kShTriTexels = 4096u;     // a triangle's texel budget before it is walked in blocks

uint wxShLayerOf(uint slot)
{
    const uint n = min(sh_cfg.x, WX_SH_LAYERS);
    for (uint L = 0u; L < n; ++L)
        if (sh_info[L].x == slot) return L;
    return 0xFFFFFFFFu;
}
// The layer whose tile holds atlas texel t (0xFFFFFFFF: none).
uint wxShLayerAt(ivec2 t)
{
    const uint n = min(sh_cfg.x, WX_SH_LAYERS);
    for (uint L = 0u; L < n; ++L)
    {
        if (sh_info[L].x == 0xFFFFFFFFu) continue;
        const ivec2 o = ivec2(int(sh_info[L].z & 0xFFFFu), int(sh_info[L].z >> 16u));
        const int r = int(sh_info[L].y);
        if (all(greaterThanEqual(t, o)) && all(lessThan(t, o + ivec2(r)))) return L;
    }
    return 0xFFFFFFFFu;
}

#if defined(WX_SH_PREP) || defined(WX_SH_PUBLISH)   // (the roof maps: the avatars' exposure, the snow's sky)
layout(set = 0, binding = 49) uniform sampler2D uWeatherOccl[10];

// The roof maps' openness at P (as clean_weather_snow.comp wxSkyAt: one tap per cascade).
float shOpenAt(vec4 fr, vec4 fz, vec2 s, uint base, vec3 P)
{
    const vec2 uv = (P.xy - (fz.x - P.z) * s - fr.xy) * fr.z;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return -1.0;
    const uint m = base + uint(fr.w + 0.5) - 1u;
    vec4 d;
    if (m == 0u) d = textureGather(uWeatherOccl[0], uv, 0);
    else if (m == 1u) d = textureGather(uWeatherOccl[1], uv, 0);
    else if (m == 2u) d = textureGather(uWeatherOccl[2], uv, 0);
    else d = textureGather(uWeatherOccl[3], uv, 0);
    const vec4 top = fz.x - d * fz.y;
    return dot(clamp((vec4(P.z) - (top - 1.5 * fz.z)) / fz.z, 0.0, 1.0), vec4(0.25));
}
float shSkyAt(vec3 P)
{
    float o = -1.0;
    if (ssr.weather[3].w > 0.5) o = shOpenAt(ssr.weather[3], ssr.weather[4], ssr.weather[7].xy, 2u, P);
    if (o < 0.0 && ssr.weather[1].w > 0.5) o = shOpenAt(ssr.weather[1], ssr.weather[2], ssr.weather[6].xy, 0u, P);
    return o < 0.0 ? 1.0 : o;
}

#endif

#if defined(WX_SH_PREP)
layout(local_size_x = 64) in;

// ---- PER-AVATAR WETNESS (#901; LLCleanWeatherVK::planShelter has the settings) ----
// Every joint-table slot carries its own wetness in its per-slot rows (row + 4: top, body; both
// images, so the next step reads it from either): it WETS while rain falls on it -- at the rain's
// intensity x how exposed it is, a full soak in the soak time at full rain fully exposed -- and
// DRIES otherwise (slower; faster in wind / sun: the CPU's boost). Two states: the TOP (whatever is
// the avatar's highest surface: its head, its shoulders, an umbrella's canopy -- open unless a
// roof is over it) and the BODY (what the rain reaches past the avatar's own cover: an umbrella
// over it keeps it dry). The lit FS blends them per fragment (a column's top takes the top state,
// a part under the avatar's own cover the body's) and wets upward surfaces first.
// EXPOSURE from a few joints of the skeleton (LL joint numbers, as clean_weather_snow.comp): the
// roof maps' openness over each (shSkyAt: a porch, a club's ceiling) x, with a shelter layer, the
// avatar's own cover there -- the previous step's map traced back along the fall (the mean wind's
// shear): a surface well above the head (an umbrella, not a hat) over the drop's path.
const int kWxJoints = 7;
const int kWxJoint[kWxJoints] = int[kWxJoints](8, 6, 0, 59, 78, 112, 107);   // head, chest, pelvis, shoulders, hips
const float kWxCoverAbove = 0.45;   // m above the head joint: a surface higher than this is cover (an umbrella)
const float kWxDz[5] = float[5](0.0, 0.3, 0.7, 1.2, 1.9);   // m up the drop's path, sampled

vec3 shJointPos(uint slot, int j) { return jointWorld(avatar_joints[slot].world[j])[3].xyz; }
bool shFinite(vec3 v) { return !any(isnan(v)) && !any(isinf(v)) && all(lessThan(abs(v), vec3(1.0e6))); }

// The previous step's map of layer L (image `src`, its frame fr / extent e): the world top over
// xy (-1e9: nothing / off the tile).
float shPrevTop(uint L, uint src, vec4 fr, float e, vec2 xy)
{
    const int res = int(sh_info[L].y);
    if (!(e > 0.0) || res <= 0) return -1.0e9;
    const vec2 cs = vec2(cos(fr.w), sin(fr.w));
    const vec2 d = xy - fr.xy;
    const vec2 q = vec2(cs.x * d.x + cs.y * d.y, cs.x * d.y - cs.y * d.x);
    const vec2 uv = q / e + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0)))) return -1.0e9;
    const ivec2 t = ivec2(int(sh_info[L].z & 0xFFFFu), int(sh_info[L].z >> 16u)) + ivec2(uv * float(res));
    const float h = imageLoad(uShS[src], t).x;
    return h > kShNoneTest ? fr.z + h : -1.0e9;
}

void main()
{
    const uint slot = gl_GlobalInvocationID.x;
    if (slot >= AV_SLOT_CAP) return;
    const int row = int(sp.a.z);
    const uint L = wxShLayerOf(slot);
    vec4 r0 = vec4(0.0), r1 = vec4(0.0), r2 = vec4(0.0), r3 = vec4(0.0);
    // (the layer's frame the previous step's map was built in: the own-cover test below)
    const vec4 oldFr = L != 0xFFFFFFFFu ? sh_frame[L] : vec4(0.0);
    const float oldE = L != 0xFFFFFFFFu ? sh_ext[L].x : 0.0;
    bool histOk = false;
    if (L != 0xFFFFFFFFu && slot < uint(avatar_joints.length()))
    {
        const mat4 M = jointWorld(avatar_joints[slot].world[0]);
        const vec3 c = M[3].xyz;
        // The heading: the pelvis's forward (+X) projected flat; lying / tumbling, its left axis.
        const vec3 X = M[0].xyz, Y = M[1].xyz;
        const float yaw = length(X.xy) > 0.3 * length(X) ? atan(X.y, X.x) : atan(-Y.x, Y.y);
        const vec4 pv = sh_prev[L];
        const bool reset = (sh_info[L].w & 2u) != 0u || pv.w < 0.5 || distance(c, pv.xyz) > sp.c.z;
        histOk = !reset && sp.f.x > -0.5;
        const float reach = uintBitsToFloat(sh_reach[L]);
        const float prevE = reset ? 0.0 : sh_ext[L].x;
        const float want = clamp(2.0 * reach + 0.3, sp.c.x, sp.c.y);
        float e = prevE;
        if (!(e > 0.0)) e = reach > 0.0 ? want : sp.c.x;
        else if (reach > 0.0 && (want > e + 0.1 || want < e - 0.75)) e = want;
        e = clamp(ceil(e * 4.0) * 0.25, sp.c.x, sp.c.y);
        sh_frame[L] = vec4(c, yaw);
        sh_ext[L] = vec4(e, prevE > 0.0 ? prevE : e, reset ? 1.0 : 0.0, 0.0);
        sh_prev[L] = vec4(c, 1.0);
        if ((sh_info[L].w & 1u) != 0u) { sh_reach[L] = 0u; sh_attach[L] = 0u; }   // (the raster this step measures them again)
        r0 = vec4(c.xy, 0.0, 0.0);
        r1 = vec4(c.z, yaw, 0.0, 0.0);
        r2 = vec4(e, float(sh_info[L].y), 0.0, 0.0);
        r3 = vec4(float(sh_info[L].z & 0xFFFFu), float(sh_info[L].z >> 16u), 0.0, 0.0);
    }
    // ---- PER-AVATAR WETNESS (every slot; a slot no avatar uses computes nothing anyone reads) ----
    vec2 wet = imageLoad(uShS[0], ivec2(int(slot), row + 4)).xy;
    vec2 expo = vec2(0.0);
    if (sp.h.z > 0.5 && slot < uint(avatar_joints.length()))
    {
        const vec3 head = shJointPos(slot, 8);
        if (shFinite(head))
        {
            const uint src = histOk ? (uint(sp.f.x + 0.5) & 1u) : 0u;   // (histOk: sp.f.x >= 0)
            const vec2 sh = sp.h.xy;   // a drop now at P was at P.xy - sh * dz, dz above it
            float body = 0.0, n = 0.0;
            for (int k = 0; k < kWxJoints; ++k)
            {
                const vec3 P = shJointPos(slot, kWxJoint[k]);
                if (!shFinite(P) || distance(P, head) > 4.0) continue;   // (an unposed / garbage joint)
                const float sky = shSkyAt(P + vec3(0.0, 0.0, 0.15));
                float cov = 0.0;
                if (histOk)
                    for (int i = 0; i < 5; ++i)
                    {
                        const vec3 Q = vec3(P.xy - sh * kWxDz[i], P.z + kWxDz[i]);
                        const float top = shPrevTop(L, src, oldFr, oldE, Q.xy);
                        if (top >= Q.z - 0.02 && top > head.z + kWxCoverAbove) { cov = 1.0; break; }
                    }
                body += sky * (1.0 - cov);
                n += 1.0;
                if (k == 0) expo.x = shSkyAt(head + vec3(0.0, 0.0, 0.35));   // the top: the sky over the head
            }
            expo.y = n > 0.0 ? body / n : 0.0;
        }
        // resets: a new avatar in the slot (the guess), a re-created atlas (the CPU's last value)
        bool init = !(wet.x > kShNoneTest);
        float seedBits = -1.0;
        const uint nr = min(sh_rhead.x, 8u);
        for (uint i = 0u; i < nr; ++i)
            if (sh_rst[i].x == slot)
            {
                init = true;
                if (sh_rst[i].y != 0xFFFFFFFFu) { wet = clamp(unpackHalf2x16(sh_rst[i].y), 0.0, 1.0); seedBits = 1.0; }
                atomicAdd(sh_stat.z, 1u);
            }
        if (init && seedBits < 0.0) wet = clamp(sp.g.w * expo, 0.0, 1.0);   // (standing in the rain a while: already wet)
        // wet while rain falls on it, dry otherwise (partly exposed: both, in proportion)
        const float dt = sp.b.w;
        const vec2 hit = sp.g.x * expo;
        wet += dt * (hit * sp.g.y - (1.0 - clamp(hit * 4.0, 0.0, 1.0)) * sp.g.z);
        wet = clamp(wet, 0.0, 1.0);
    }
    else
        wet = vec2(kShNone, 0.0);   // (off / no joints: none -- the lit FS keeps the world's wetness)
    if (L != 0xFFFFFFFFu) sh_wet[L] = vec4(wet, expo);
    for (int k = 0; k < 2; ++k)
    {
        imageStore(uShS[k], ivec2(int(slot), row), r0);
        imageStore(uShS[k], ivec2(int(slot), row + 1), r1);
        imageStore(uShS[k], ivec2(int(slot), row + 2), r2);
        imageStore(uShS[k], ivec2(int(slot), row + 3), r3);
        imageStore(uShS[k], ivec2(int(slot), row + 4), vec4(wet, 0.0, 0.0));
        imageStore(uShS[k], ivec2(int(slot), row + 5), vec4(expo, 0.0, 0.0));
        // the layer directory (the debug overlay over the scene): column L = layer L's slot
        if (slot < WX_SH_LAYERS)
        {
            const bool used = slot < min(sh_cfg.x, WX_SH_LAYERS) && sh_info[slot].x != 0xFFFFFFFFu;
            imageStore(uShS[k], ivec2(int(slot), row + 6), vec4(used ? float(sh_info[slot].x) : -1.0, 0.0, 0.0, 0.0));
        }
    }
}

#elif defined(WX_SH_FILTER)
layout(local_size_x = 64) in;
void main()
{
    const uint id = gl_GlobalInvocationID.x;
    if (id >= sp.a.x || id >= uint(cand_meta.length()) || id >= uint(instances.length())) return;
    if (cand_meta[id] == 0xFFFFFFFFu) return;          // not drawn by the main view
    if (cand[id].indexCount < 3u) return;              // (a capacity drop's empty draw)
    const uint fl = instances[id].flags;
    // rigged (bit0) or a worn rigid attachment (bit9); never HUD (bit3) or a flexi chain (bit19)
    if ((fl & (1u | 512u)) == 0u || (fl & 8u) != 0u || (fl & 524288u) != 0u) return;
    if (instances[id].tint.a < 0.05) return;           // invisible prims shelter nothing
    uint slot = 0xFFFFFFFFu;
    if ((fl & 1u) != 0u)
    {
        if ((sp.a.y & (kShFlagSkinV | kShFlagSkinMeta)) != (kShFlagSkinV | kShFlagSkinMeta)) return;
        if (id * RC_WORDS + RC_STATE < uint(rig_cache.length())
            && (rig_cache[id * RC_WORDS + RC_STATE] & RC_ST_CLUSTER) != 0u) return;   // (cluster LOD draws it: -DWX_SH_CL_RASTER from the arena)
        const uint sid = instances[id].skin_id;
        if (sid >= 0x100000u || sid * kSkinMetaWords >= uint(skin_meta.length())) return;
        slot = skin_meta[sid * kSkinMetaWords];
    }
    else
        slot = instances[id].skin_id;
    if (slot >= AV_SLOT_CAP) return;
    const uint L = wxShLayerOf(slot);
    if (L == 0xFFFFFFFFu) return;
    // due for the raster (bit 0) and / or -- #901 rest-pose accumulation -- for its avatar's grid
    // update (bit 2: clean_weather_accum.comp -DWX_AC_ACCUM reads the same list); the item says which
    const uint due = sh_info[L].w & 5u;
    if (due == 0u) return;
    const uint n = atomicAdd(sh_head.x, 1u);
    if (n >= sh_head.y) return;   // full (the readback counts the overflow)
    sh_items[n] = uvec2(id, L | ((due & 1u) != 0u ? 0x100u : 0u) | ((due & 4u) != 0u ? 0x200u : 0u));
    if ((due & 1u) != 0u) atomicAdd(sh_count[L], 1u);
    atomicAdd(sh_disp.x, 1u);
}

#elif defined(WX_SH_CL_FILTER)
layout(local_size_x = 1) in;
// (#901 / #909 follow-up) A CLUSTER LOD avatar's skinned cluster: work for its layer when the layer
// is due for the raster (CLEAR clears / frames only the layers that found work). The filter's other
// tests on the renderer row (visible, not HUD / a flexi chain); one count per cluster (the log's
// "draws" counts clusters for these).
void main()
{
    WxClEntry x;
    if (!wxClEntry(x) || x.ri >= uint(instances.length())) return;
    const uint fl = instances[x.ri].flags;
    if ((fl & 1u) == 0u || (fl & 8u) != 0u || (fl & 524288u) != 0u || instances[x.ri].tint.a < 0.05) return;
    const uint L = wxShLayerOf(x.slot);
    if (L == 0xFFFFFFFFu || (sh_info[L].w & 1u) == 0u) return;
    atomicAdd(sh_count[L], 1u);
}

