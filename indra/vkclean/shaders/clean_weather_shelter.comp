layout(local_size_x = 8, local_size_y = 8) in;
void main()
{
    const ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    // #783 BODY CONTACT: the raster target is 2 x the tiles' rows + WX_SH_BODY_ROWS (the bottom
    // map under the top map, then each layer's raster-time frame); without them, the top alone.
    const int th = int(sp.a.z);
    const bool body = imageSize(uShH).y >= 2 * th + WX_SH_BODY_ROWS;
    if (body && t.y == 0 && t.x < int(WX_SH_LAYERS))
    {
        // Layer t.x's raster-time frame (the snow passes read the bottom map in it): rewritten
        // when the layer is rasterized this step; its slot word zeroed when the layer is free or
        // went to another avatar (the old map is not that avatar's).
        const uint L = uint(t.x);
        const bool used = L < min(sh_cfg.x, WX_SH_LAYERS) && sh_info[L].x != 0xFFFFFFFFu;
        const int r0 = 2 * th;
        if (used && (sh_info[L].w & 1u) != 0u && sh_count[L] != 0u)
        {
            const vec4 fr = sh_frame[L];
            imageStore(uShH, ivec2(t.x, r0), uvec4(sh_info[L].x + 1u));
            imageStore(uShH, ivec2(t.x, r0 + 1), uvec4(floatBitsToUint(fr.x)));
            imageStore(uShH, ivec2(t.x, r0 + 2), uvec4(floatBitsToUint(fr.y)));
            imageStore(uShH, ivec2(t.x, r0 + 3), uvec4(floatBitsToUint(fr.z)));
            imageStore(uShH, ivec2(t.x, r0 + 4), uvec4(floatBitsToUint(fr.w)));
            imageStore(uShH, ivec2(t.x, r0 + 5), uvec4(floatBitsToUint(sh_ext[L].x)));
            imageStore(uShH, ivec2(t.x, r0 + 6), uvec4(sh_info[L].y));
            imageStore(uShH, ivec2(t.x, r0 + 7), uvec4(sh_info[L].z));
        }
        else if (!used || imageLoad(uShH, ivec2(t.x, r0)).r != sh_info[L].x + 1u)
            imageStore(uShH, ivec2(t.x, r0), uvec4(0u));
    }
    if (t.y >= th || any(greaterThanEqual(t, ivec2(imageSize(uShH))))) return;
    const uint L = wxShLayerAt(t);
    if (L == 0xFFFFFFFFu || (sh_info[L].w & 1u) == 0u || sh_count[L] == 0u) return;
    imageStore(uShH, t, uvec4(0u));
    if (body) imageStore(uShH, t + ivec2(0, th), uvec4(0u));   // (#783 the bottom map)
}

#elif defined(WX_SH_RASTER) || defined(WX_SH_CL_RASTER)
layout(local_size_x = 64) in;
shared uint sReach;

// One triangle q (the layer's frame) onto layer tile o (res texels over extent e): every texel centre
// inside it (either winding) takes the atomicMax of its encoded height; #783 body: the bottom map
// (th rows under the top map) the encoded -height.
void shRasterTri(vec3 q[3], float e, int res, ivec2 o, int th, bool body)
{
    // texel coordinates (texel centres at + 0.5)
    const vec2 a = (q[0].xy / e + 0.5) * float(res), b = (q[1].xy / e + 0.5) * float(res), c = (q[2].xy / e + 0.5) * float(res);
    const float area = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
    if (abs(area) < 1e-6) return;   // (seen edge-on from above: its neighbours hold the top)
    const ivec2 lo = max(ivec2(floor(min(a, min(b, c)))), ivec2(0));
    const ivec2 hi = min(ivec2(ceil(max(a, max(b, c)))), ivec2(res - 1));
    if (any(greaterThan(lo, hi))) return;
    const uint span = uint(hi.x - lo.x + 1) * uint(hi.y - lo.y + 1);
    const int stp = span > kShTriTexels ? int(ceil(sqrt(float(span) / float(kShTriTexels)))) : 1;
    const float inv = 1.0 / area;
    for (int y = lo.y; y <= hi.y; y += stp)
        for (int x = lo.x; x <= hi.x; x += stp)
        {
            const vec2 p = vec2(x, y) + 0.5 * float(stp);
            // barycentrics (either winding)
            const float w0 = ((b.x - p.x) * (c.y - p.y) - (b.y - p.y) * (c.x - p.x)) * inv;
            const float w1 = ((c.x - p.x) * (a.y - p.y) - (c.y - p.y) * (a.x - p.x)) * inv;
            const float w2 = 1.0 - w0 - w1;
            if (w0 < -1e-4 || w1 < -1e-4 || w2 < -1e-4) continue;
            const float zi = w0 * q[0].z + w1 * q[1].z + w2 * q[2].z;
            const uint z = wxShEnc(zi), zb = wxShEnc(-zi);   // (#783 zb: the bottom map's -height)
            for (int by = 0; by < stp; ++by)
                for (int bx = 0; bx < stp; ++bx)
                {
                    const ivec2 t = ivec2(x + bx, y + by);
                    if (t.x > hi.x || t.y > hi.y) continue;
                    imageAtomicMax(uShH, o + t, z);
                    if (body) imageAtomicMax(uShH, o + t + ivec2(0, th), zb);
                }
        }
}

#if defined(WX_SH_CL_RASTER)
// (#901 / #909 follow-up) A CLUSTER LOD avatar's skinned cluster into its layer (due for the raster):
// its triangles from the skinned arena (world: the character's frame + the palettes' eye), exactly as
// a legacy rigged draw's skinned vertices. Every return before the barrier is workgroup-uniform.
void main()
{
    const uint lid = gl_LocalInvocationIndex;
    if (lid == 0u) sReach = 0u;
    barrier();
    WxClEntry x;
    if (!wxClEntry(x) || x.ri >= uint(instances.length())) return;
    const uint fl = instances[x.ri].flags;
    if ((fl & 1u) == 0u || (fl & 8u) != 0u || (fl & 524288u) != 0u || instances[x.ri].tint.a < 0.05) return;
    const uint L = wxShLayerOf(x.slot);
    if (L == 0xFFFFFFFFu || (sh_info[L].w & 1u) == 0u || sh_count[L] == 0u) return;
    const float e = sh_ext[L].x;
    const int res = int(sh_info[L].y);
    if (!(e > 0.0) || res <= 0) return;
    const ivec2 o = ivec2(int(sh_info[L].z & 0xFFFFu), int(sh_info[L].z >> 16u));
    const int th = int(sp.a.z);
    const bool body = imageSize(uShH).y >= 2 * th + WX_SH_BODY_ROWS;
    float reach = 0.0;
    for (uint k = lid; k < x.tc; k += 64u)
    {
        vec3 q[3];
        for (uint j = 0u; j < 3u; ++j)
        {
            q[j] = wxShLocal(L, wxClPos(x, wxClCorner(x, k, j)));
            reach = max(reach, max(abs(q[j].x), abs(q[j].y)));
        }
        shRasterTri(q, e, res, o, th, body);
    }
    atomicMax(sReach, floatBitsToUint(min(reach, 0.5 * sp.c.y)));
    barrier();
    if (lid == 0u && sReach != 0u) atomicMax(sh_reach[L], sReach);
}
