// Persistent bookkeeping (device, kept across frames; header zeroed with each new heap epoch):
//   [0] bump (units), [1] the last frame any CLAS page was freed, [2..3] 0, [4 + c] class c's
//   free-stack top, [SB_PEND + 2i] this frame's pending frees {block, class} (mode 21 pushes them),
//   [scpu[SC_OFF_BUILT] + cs] the frame CLAS page cs was (re)built, [scpu[SC_OFF_STACKS] + c *
//   stack_cap + i] class c's free blocks.
layout(std430, set = 1, binding = 34) coherent buffer RtClStaticHeap { uint sb[]; };
// ---- SPATIAL PTLAS PARTITIONS (tier 2, RenderVKClusterPTLASPartition 1; host mPtlasPart) ----
// [0, P) instances in regular partition p, [P] instances in the GLOBAL partition, then per instance
// id (the dense TLAS record id) its partition [P + 1 + id] (P = global, CL_NONE = never written since
// the PTLAS was created). Host-filled (0 / CL_NONE) whenever the PTLAS is (re)created (full write).
layout(std430, set = 1, binding = 35) coherent buffer RtClPtlasPart { uint ppart[]; };
