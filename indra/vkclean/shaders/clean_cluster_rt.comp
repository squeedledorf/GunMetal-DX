#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "clean_av_slots.glsl"
// vkclean -- CLUSTER LOD ray tracing (#748, OWNER: 2b; vkgfx/llcleanclusterrtvk.cpp).
//
// The RT cut of every cluster-drawn instance and the GPU side of the cluster acceleration
// structures. Set 0 = the cluster set (clean_cluster_common.glsl, read only here except the
// page-usage stamps); set 1 = this module's set (bindings below). One pipeline, modes
// (push .mode), dispatched in this order by LLCleanClusterRTVK::record with barriers between:
//
//   0 SELECT       one 64-lane workgroup per ClusterInstance (1b's list of this frame). The
//                  instance takes part only when the cluster raster draws it for real
//                  (1b's CLI1B_DRAW). STATIC: its RT cut is THE cut rule (clCutRenders) at
//                  RenderVKClusterRTTolerancePx, evaluated from a per-instance REFERENCE
//                  CAMERA (hysteresis, below), never frustum- or occlusion-culled (off-screen
//                  casters), cone test off. RIGGED (an avatar 2a switched; RIGGED below): the
//                  cut rule with the MAIN VIEW's projection (its ClusterView: LOD camera,
//                  px_scale, tolerance) and the posed-bound margin, un-culled. The cut is
//                  written to the cut arena (contiguous per instance) with an
//                  order-independent hash; CLAS tiers also ask for the CLAS of every page
//                  whose clusters have none yet (static) / add the cut to its AVATAR's demand
//                  for the RT skinned arena (rigged: modes 13 / 14 hand out the slots).
//                  STATIC ADMISSION (RP_STATIC / RP_STATIC_MIN): only static instances whose
//                  importance (world sphere radius / distance) passes the CPU's threshold take
//                  part (an admitted one keeps its place down to 0.7 x it); the threshold rises
//                  while the CLAS pages the admitted cuts use do not fit the arena, so an
//                  instance that could not become ready pays no selection (legacy BLAS).
//                  STATIC CUT REUSE (pc.rt_flags): an admitted instance whose reference camera
//                  did not move and whose previous-frame cut (the other cut arena, binding 32)
//                  is still resident page for page copies that cut instead of walking its pages
//                  (the same cut by construction: the same projection, the same residency);
//                  every 32nd frame per instance it walks anyway (pages of finer children that
//                  became resident since).
//   1 CLAS_SCAN    (CLAS tiers) one lane per pool slot: a CLAS page whose pool slot now holds
//                  another page (header mesh_key / page_index) or that no RT cut used for
//                  pc.idle_frames is freed (its CLAS slot back on the free stack).
//   2 CLAS_ALLOC   (CLAS tiers) one lane per wanted pool slot (<= pc.clas_pages_max): pop a CLAS
//                  slot, write one VkClusterAccelerationStructureBuildTriangleClusterInfoNV per
//                  cluster of the page (+ its explicit destination and size).
//   3 CLAS_DECODE  (CLAS tiers) one workgroup per build arg: the cluster's quantized vertices
//                  (pool QVertex, clean_qvertex.glsl) -> fp32 mesh-space positions, the CLAS
//                  build's vertex input (CLAS have no build transform, so the BLAS space is the
//                  mesh space and the TLAS record keeps the instance's own transform).
//   4 BLAS_ARGS    (CLAS tiers) one workgroup per ClusterInstance: the CLAS addresses of its cut
//                  (all must exist) -> one VkClusterAccelerationStructureBuildClustersBottomLevelInfoNV
//                  (rigged: this frame's implicit build). STATIC (SC_SB_ON): its PERSISTENT BLAS
//                  is kept while the cut and its CLAS are unchanged, else rebuilt into a heap block
//                  (explicit destinations; blasArgs below).
//   5 OVERRIDE     one workgroup per ClusterInstance (CLAS tiers: its BLAS built / kept) or
//                  per CPU row (tier 0: newest / previous per-cut BLAS, each valid only while
//                  every page of its cut is resident): the per-instance-id override row that
//                  TLAS pass A (clean_rt_instances.comp binding 22) swaps in for the legacy BLAS.
//   6 T0_EXPAND    (tier 0) one workgroup per CPU job (= one cluster of a per-cut BLAS build):
//                  fp32 positions + uint16 indices (KHR builds take no uint8 indices) into the
//                  transient build input, validated against the page table (a page evicted
//                  since the cut was read back -> degenerate triangles, the build flagged invalid).
//   7 PTLAS_DIFF   (tier 2) one lane per PTLAS instance (= TLAS record id): records that changed
//                  since the last write -> VkPartitionedAccelerationStructureWriteInstanceDataNV ops
//                  (also built alone, -DCL_RT_PTLAS_ONLY, for sessions whose TLAS is partitioned).
//   8 INIT_STACK   (CLAS tiers) the CLAS slot free stack after (re)allocation.
//  20 CLAS_GROW    (CLAS tiers) the CLAS pages of the arena chunks added this frame -> the free
//                  stack (the arena grows chunk by chunk; nothing already built moves).
//  21 SB_FREE      (CLAS tiers) the persistent static BLAS blocks freed this frame -> their class
//                  stacks (after mode 4's allocations: a pop never races a push).
//  22 SB_SWEEP     (CLAS tiers, every 16 frames, before mode 4) blocks of instances that neither
//                  built nor traced them for 120 frames -> freed (free on liveness).
//   9 RIG_SKIN     one workgroup per slot of the RT SKINNED ARENA (CLAS tiers: the slots mode 0
//                  handed out this frame; tier 0: the CPU's job list over every live per-cut
//                  BLAS): the cluster's vertices skinned EXACTLY as 2a's cluster pre-skin
//                  (clean_cluster_preskin.comp; the legacy pre-skin's math) from this frame's
//                  palettes, eye-relative, into the arena (position + skinned normal); CLAS
//                  tiers write the slot's CLAS build argument (vertex stride 16, the pool's
//                  uint8 indices, geometry index = the entry k within the instance's cut);
//                  tier 0 validates the slot's page (evicted: the slot collapses to one point,
//                  the row is not used this frame) and, on a build frame, writes its uint16
//                  indices.
//  10 RIG_OVR_T0   (tier 0) one lane per CPU rig row: the override row of a rigged instance
//                  whose per-cut BLAS is valid this frame.
//  13 RIG_ADMIT    (CLAS tiers) one lane: the RT skinned arena handed out PER AVATAR, whole or
//                  not at all (last frame's admitted avatars first, then joint-table slot order;
//                  mode 0's per-avatar demand): an avatar
//                  that does not fit gets no slot -- its switched groups keep the legacy BLAS
//                  and no CLAS is built for them -- while every avatar that fits is covered
//                  completely (LLCleanRTVK::clusterRigCovered: the legacy-skin skip is per avatar).
//  14 RIG_PLACE    (CLAS tiers) one workgroup per ClusterInstance: a rigged instance of an
//                  admitted avatar takes its contiguous slot range within the avatar's, decides
//                  the shared skinned cut (mode 11's count + hash) and writes its own-skinning
//                  slot headers from the cut arena.
//
// #748 perf pass 2 (rigged):
//  * DERIVED RT CUT: a rigged instance whose avatar is in a rig list (1b's main selection took its
//    whole un-culled cut at the main view's projection -- THE rule mode 0 would evaluate) with no
//    overflow anywhere (main slice, 2a's skinned arena / map) takes that cut as its RT cut: mode
//    11's count, hashes and triangles; mode 12 writes its cut entries. No page walk (the walk was
//    ~0.6 ms for 39 avatars repeating the main selection). Anything else walks as before.
//  * PERSISTENT RIGGED CLAS (explicit destinations, one per arena slot): an avatar is KEPT --
//    no skinning copy, no CLAS build, its slots / headers / vertices / CLAS untouched -- when the
//    CPU proved its skinned WORLD positions unchanged since the last RT frame (RP_STILL: the GPU
//    pose held and the root still, LLCleanAnimStore::slotWorldClean, skin meta clean), its
//    per-avatar signature (each instance's ri, cut size + hashes, shared flag) equals the one its
//    slots were built with, it was admitted last frame at the same range, and the host's keep
//    flag holds (RP_KEEP: arenas not re-created, RT origin unchanged, no frame gap). Positions are
//    relative to the RT ORIGIN (RP_ORIGIN, moved only when the eye gets kRigOriginMove away), not
//    the per-frame eye, so a camera move alone never forces a rebuild; the TLAS record translates
//    by that origin (clean_rt_instances.comp, group map words 4..7). Shared slots now COPY 2a's
//    SKIN_OUT vertices into the RT arena (+ eye - origin): hits always read the RT arena.
//
// #1008 RIGGED RT CADENCE (RP_SCHED bit 0; RenderVKClusterRTRigCadence, 0 = everything above as
// it was). The RT cut of an avatar and its CLAS are decoupled from the raster's per-frame cut --
// ONLY for an avatar that never self-shadows in RT (RP_NOSELF: LLCleanRTVK::classifyNoSelf's
// tag, with its hysteresis and dwell; its TLAS records carry the owner tag, so its receivers skip
// its own geometry -- clean_rt_common.glsl rtSelfCandidate -- on every frame). Every other avatar
// (and every rigged instance without a joint-table slot: animesh, row 256) stays in the near band
// on the exact path, every frame. (The first cut let untagged avatars go coarse / stale: their
// receivers met their own stale or coarser copy on kept frames and the exact one on rebuild
// frames -- self-shadow patches flickering with the period. The tag makes the self-shadow state
// constant while the geometry ages.) The coarse cut's error is also capped at RIG_COARSE_MAX_M
// past the raster's, inside the receiver-identity probe's window (RT_SELF_PROBE_W), so a tagged
// receiver still finds its own (coarse) surface and skips it:
//  * BANDS: mode 0 folds each rigged instance's distance into its avatar's row (RIGAV_DIST, the
//    nearest), mode 13 turns it into the avatar's distance BAND (near / mid / far, RP_BAND_M, a
//    10 % dead band) for the next frame. Per band: a selection PERIOD (RP_PERIOD) and an RT
//    tolerance MULTIPLIER (RP_TOLMUL) over the main view's tolerance -- near = 1 by default: the
//    near band is the path above exactly (derived cut, shared welded skinning, caster =
//    receiver); mid / far trace a coarser cut (fewer clusters, own skinning, unwelded) whose
//    self-shadow mismatch is the multiplier x the raster's error -- small on screen at those
//    distances, and not covered by the #747 receiver lift.
//  * DUE (rigDue, the same answer in modes 0 and 13: last frame's band, admission and selection
//    frame): an avatar re-selects its cut on its band's period, staggered by joint-table slot,
//    and always on arrival (not covered last frame), with no joint-table slot, on a forced frame
//    (RP_SCHED bit 1: the RT origin moved -- teleport / region crossing --, an arena re-created,
//    a frame gap) and when its period elapsed. A NOT-DUE instance copies its previous cut
//    forward from the other cut arena (st[ri][5], validated page for page as the static reuse;
//    a page gone, a new instance or mesh -> it walks). Its avatar's signature is then unchanged,
//    so mode 13 KEEPS it (RP_KEEP bit 1): no headers, no skinning, no CLAS build -- the RT pose
//    lags by at most the period (<= RP_MAX_STALE frames).
//  * REFRESH (mode 13, RIGAV_KEEP 2): a DUE mid / far avatar whose new cut is the same set
//    (signature) at the same arena range keeps its slots and headers (mode 14 only rewrites the
//    slot's ClusterInstance and stamps it with bit 31); mode 9 skins the slot, compares with the
//    positions its CLAS was built from (the arena's) and rebuilds it only when a vertex moved
//    more than RP_POSE_EPS x the cut's own error at that distance, or the slot's CLAS is
//    RP_MAX_STALE frames old (per-slot build frame: rig_addr[cap * 4 + s]). Skipped slots keep
//    their CLAS, vertices and header -- a CLAS and the arena words hits read are only ever
//    written together (mode 9, the same record), so a hit always shades the geometry it hit.
//
// #1011 RT BOOKKEEPING + CLAS REUSE (RP_RANK / RP_REUSE; RenderVKClusterRTRigRank / RigReuse, live
// A/Bs, 0 = everything above as it was). Measured at an 87-avatar party: every rigged RT cut was
// already DERIVED (no page walk), yet c_cl_rt_select was 2.4 ms -- plumbing, not selection -- and
// ~90k rigged CLAS (7.6M triangles) were rebuilt per frame (c_cl_rig_clas 2.2 ms):
//  * RANKED SHARED CUT (RP_RANK bit 0): the main view's selection writes each shared instance's
//    count / hashes / triangles (CL_B_INST_CUT) and ranks its entries (aux word,
//    clean_cluster_select_common.glsl RT CUT SUMMARY). While that summary is valid (rigRankOk: the
//    main slice and 2a's map complete -- no entry without a skinned slot) mode 11 only marks an
//    instance with an unskinned entry anyway (a plain store, no atomics: per-instance insurance);
//    mode 12 scatters by RANK instead of an atomic per entry, so an unchanged cut lands in the same
//    slots every frame. 2a's overflow frames fall back to mode 11's gather and the atomic order.
//    Mode 13 runs on the whole workgroup (rigAdmitPar: per-avatar reads / writes in parallel, the
//    first fit on shared memory), not one lane over 257 rows of global memory.
//  * CLAS REUSE (RP_REUSE bit 0, RP_KEEP bit 2): a due avatar whose cut set and range are its last
//    frame's is REFRESHED (RIGAV_KEEP 2; before, only #1008's tagged mid / far avatars): its slots
//    stay, and with the ranked cut its instances keep the SHARED skinned cut (skin once -- the
//    refresh no longer forces own skinning). Mode 12 stamps a slot that holds the same cluster at
//    the same entry as the CLAS it already has (RIG_STAMP_REFRESH); mode 9 copies 2a's vertices,
//    compares them with the ones that CLAS was built from (the arena's) and rebuilds it only past
//    the avatar's tolerance (rigRefreshBuild): a SELF-SHADOWING avatar RP_REUSE_EPS (default 20 um:
//    float noise -- below the raster-vs-RT mismatch the eye-relative paths already have, so its
//    receivers never see a stale hull of their own); a NO-SELF-SHADOW avatar (RP_NOSELF) RP_REUSE_LAG
//    x the cut's error at its distance, capped at RIG_COARSE_MAX_M, at most RP_MAX_STALE frames old.
//    A skipped slot writes nothing (its CLAS, vertices and header ref stay one snapshot).
//
// RIGGED (#747 + #748 integration: avatars 2a switched to the cluster raster). The RT cut of a
// rigged instance uses the MAIN VIEW's projection (cl_views[main view]: its lagged LOD camera,
// held px_scale and post-controller tolerance -- RP_MAIN_VIEW) and the same posed-bound margin
// (clRigMargin) as 1b's main selection, but no frustum / cone / Hi-Z test: over the clusters the
// raster draws it is the SAME cut (the cut rule is per group and culling never changes it), and
// off-screen limbs get the cut the same rule gives them. Skinned with the same math and palettes,
// the traced surface is the rasterized one (no self-shadowing between two LODs of one avatar;
// the #747 interim receiver lift then finds no flagged face and stays off). Positions are
// eye-relative (the palettes' eye): the TLAS record of such an instance is a pure translation by
// that eye (clean_rt_instances.comp pass B).
//
// HYSTERESIS (RenderVKClusterRTHysteresis): the RT cut of an instance is a function of one
// reference camera position, kept per renderer instance id relative to the instance's
// translation (moving prims re-evaluate as their distance changes). It moves to the live
// camera only when the live camera is farther than hyst * (distance to the mesh sphere) from
// it, or the mesh changed. One reference per instance for every group keeps the cut watertight
// (one consistent projection per instance), and the projected error it evaluates is within a
// factor 1 / (1 - hyst) of the live one -- the RT cut changes far less often than the raster
// cut (which follows the live camera every frame).
//
// Method: published material only -- the cut rule of the SIGGRAPH 2021 Nanite talk (through
// the shared clean_cluster_common.glsl), the VK_NV_cluster_acceleration_structure /
// VK_NV_partitioned_acceleration_structure specifications (indirect build argument layouts).
layout(local_size_x = 64) in;

#define CLUSTER_SET 0
#define CL_DECLARE_POOL
#define CL_DECLARE_PAGE_TABLE
#define CL_DECLARE_MESHES
#define CL_DECLARE_GROUPS
#define CL_DECLARE_PAGE_USAGE
#define CL_DECLARE_INSTANCES
#define CL_DECLARE_STATS
#define CL_DECLARE_JOINT_STRETCH
#include "clean_cluster_common.glsl"
// 1b's views (+ the selection tail: the shared rig cut), the main view's selected slice and its
// counters (read only: the shared skinned cut, RIGGED below).
#define CL_DECLARE_INST_CUT   // (#1011: the main view's per-instance cut summary)
#include "clean_cluster_select_common.glsl"
#include "clean_qvertex.glsl"
// 2a (#747): the rigged instances' posed-bound margins (clRigMargin), as 1b's main selection.
#define CL_DECLARE_SKIN_SCRATCH
#include "clean_cluster_skin_common.glsl"
#include "clean_skinvert.glsl"   // svPackNormal

// = LLCleanClusterSelectVK::kInstDraw (1b-private ClusterInstance flag: drawn for real).
#define CLI1B_DRAW_RT 1024u

// ---- set 1: this module (LLCleanClusterRTVK, the same binding numbers) ----------------------
// Per renderer instance id (ST_STRIDE uvec4): hysteresis state. [0] reference camera relative to
// the instance translation, mesh; [1] mesh generation (0 = none), frame last selected, last hash
// (2 words); [2] STATIC CUT REUSE: its last cut's base in that frame's cut arena, its count
// (CL_NONE = none), the cut epoch it was written in, the frame it was last admitted.
// [3] / [4] PERSISTENT STATIC BLAS (mode 4): [3] the cut hash it was built from, mesh, mesh
// generation, 0; [4] the frame it was built, heap epoch (0 = none), block | class << 24, the
// frame its override row was last written (flip stats). [5] #1008 RIGGED CUT REUSE: its last
// cut's base in that frame's cut arena, its count (CL_NONE = none), the cut epoch it was written
// in, 0 (rigged instances only; [3] / [4] stay the static heap's).
layout(std430, set = 1, binding = 0) buffer RtClState { uvec4 st[]; };
#define ST_STRIDE 6u
// Per ClusterInstance (this frame): ri, cut base, cut count (kNone = none), tris, hash a, hash b,
// mesh, mesh generation.
layout(std430, set = 1, binding = 1) buffer RtClInst { uvec4 clinst[]; };       // 2 per row
// Cut arena: {cluster ref, virtual page, tris, 0}.
layout(std430, set = 1, binding = 2) buffer RtClCut { uvec4 cut[]; };
// Override rows per renderer instance id (pass A binding 22): BLAS address lo, hi, cut base,
// first vertex of the cut's first cluster | 0x80000000 when the geometry index IS the ref.
layout(std430, set = 1, binding = 3) buffer RtClOvr { uvec4 ovr[]; };
// Counters (zeroed every frame; offsets = LLCleanClusterRTVK::kCnt*).
layout(std430, set = 1, binding = 4) coherent buffer RtClCnt { uint cnt[]; };
// CLAS page per pool slot: {CLAS slot (kNone), header mesh_key, header page_index, last use}.
layout(std430, set = 1, binding = 5) buffer RtClasOfSlot { uvec4 clas_of_slot[]; };
// Free stack of CLAS slots: [0] top, [1 + i] entries.
layout(std430, set = 1, binding = 6) coherent buffer RtClasFree { uint clas_free[]; };
// Pool slots wanting a CLAS page this frame: [0..] slots (count = cnt[CNT_WANT]); + a stamp per
// pool slot at clas_want_stamp.
layout(std430, set = 1, binding = 7) buffer RtClasWant { uint clas_want[]; };
layout(std430, set = 1, binding = 8) buffer RtClasStamp { uint clas_want_stamp[]; };
// CLAS build: args (16 words each), explicit destination addresses (uvec2), sizes (uint).
layout(std430, set = 1, binding = 9) buffer RtClasArgs { uint clas_args[]; };
layout(std430, set = 1, binding = 10) buffer RtClasDst { uvec2 clas_dst[]; };
layout(std430, set = 1, binding = 11) buffer RtClasSize { uint clas_size[]; };
// Decoded positions: 64 x vec3 per build arg (CLAS) / per tier-0 job vertex range.
layout(std430, set = 1, binding = 12) buffer RtClDecode { float dec[]; };
// Cluster BLAS: per cut-arena entry its CLAS address (uvec2); infos (4 words); per info the
// built address (implicit destinations, written by the build); per ClusterInstance its info.
// Three regions of blas_max each in blas_info / blas_addr: this frame's implicit build, the
// persistent static build's (explicit destinations: blas_addr = the heap block), and (blas_addr
// only) the static build's sizes {bytes, 0}.
layout(std430, set = 1, binding = 13) buffer RtClClasRefs { uvec2 clas_refs[]; };
layout(std430, set = 1, binding = 14) buffer RtClBlasInfo { uint blas_info[]; };
layout(std430, set = 1, binding = 15) buffer RtClBlasAddr { uvec2 blas_addr[]; };
layout(std430, set = 1, binding = 16) buffer RtClBlasOf { uint blas_of[]; };
// Tier 0: jobs (8 words), rows (16 words), uint16 index output, persistent hit cut table
// ({ref, vpage, 0, 0} per entry of every live per-cut BLAS), validity words per build.
layout(std430, set = 1, binding = 17) readonly buffer RtClT0Jobs { uvec4 t0_jobs[]; };   // 2 per job
layout(std430, set = 1, binding = 18) readonly buffer RtClT0Rows { uvec4 t0_rows[]; };   // 4 per row
layout(std430, set = 1, binding = 19) buffer RtClT0Idx { uint t0_idx[]; };
layout(std430, set = 1, binding = 20) readonly buffer RtClHitCut { uvec4 hit_cut[]; };
layout(std430, set = 1, binding = 21) coherent buffer RtClT0Valid { uint t0_valid[]; };
// Tier 2: the TLAS records (pass A / B output, 16 words each), their last written copy, the
// write-instance ops (26 words each) and the indirect command {opType, argCount, addr lo, hi,
// stride lo, hi}.
layout(std430, set = 1, binding = 22) readonly buffer RtClTlas { uvec4 tlas_rec[]; };     // 4 per record
layout(std430, set = 1, binding = 23) buffer RtClTlasPrev { uvec4 tlas_prev[]; };         // 4 per record
layout(std430, set = 1, binding = 24) buffer RtClPtlasOps { uint ptlas_ops[]; };
layout(std430, set = 1, binding = 25) coherent buffer RtClPtlasCmd { uint ptlas_cmd[]; };
// ---- RIGGED (bindings 26..31; LLCleanClusterRTVK "RIGGED") ----
// The RT SKINNED ARENA (also the RT consumer set's binding 13, clean_rt_common.glsl):
//   [0] first word of the vertex region, [1] first word of the index region (tier 0), [2..15] 0;
//   [RIG_HDR_BASE + s*4, +4) slot s: {cluster ref, virtual page, k | tris << 16, ClusterInstance}
//                            (k = the entry within its instance's cut = the geometry index);
//   [vertex region + (s*64 + l)*4, +4) vertex l of slot s: eye-relative skinned position (fp32
//                            bits, the AS build input, stride 16) + the skinned normal (octahedral);
//   [index region + s*192, +192) tier 0: the slot's uint16 local indices (KHR builds take no
//                            uint8; written on its BLAS's build frame, kept for the refits).
layout(std430, set = 1, binding = 26) coherent buffer RtClRig { uint rig[]; };
// Per ClusterInstance (CLAS tiers), 8 words (zeroed every frame): its first arena slot this
// frame (CL_NONE = none), the main slice's skinned entries of it (mode 11), the scatter counter
// (mode 12), 1 = its slots take the SHARED skinned cut, the entries' order-independent ref hash
// (mode 11; = mode 0's cut hash s_ha when the sets are equal), the second hash (= s_hb), their
// triangles, 1 = its RT cut was DERIVED from the shared cut (mode 12 writes its cut entries).
layout(std430, set = 1, binding = 27) coherent buffer RtClRigOf { uint rig_of[]; };
#define RIGOF_S0      0u
#define RIGOF_GATHER  1u
#define RIGOF_FILL    2u
#define RIGOF_SHARED  3u
#define RIGOF_HASH    4u
#define RIGOF_HASHB   5u
#define RIGOF_TRIS    6u
#define RIGOF_DERIVED 7u
#define RIG_HDR_SHARED 0x80000000u   // header word 3: the slot's vertices are 2a's SKIN_OUT slot (word 1)
// The renderer's skin palettes (= clean_preskin.comp / clean_cluster_preskin.comp SkinBlock).
#define MAX_JOINTS 110
struct SkinBlock {
    mat3x4 matrices[MAX_JOINTS];   // 48 B each
    mat4   bind_shape;             // 64 B
};
layout(std430, set = 1, binding = 28) readonly buffer RtClPal { SkinBlock skins[]; };
// CLAS tiers: the rigged CLAS build arguments (16 words per BUILT slot, compacted: CNT_RIG_ARGS)
// and (binding 30, RP_RIG_CAP = cap) per argument its explicit destination (2 words at a * 2), its
// built size (cap * 2 + a, written by the build), then per SLOT its build stamp (cap * 3 + s: the
// RP_STAMP of the frame that last wrote its header; = this frame's -> build it; bit 31 = #1008
// REFRESH: build it only if its pose moved), then per SLOT the frame its CLAS was last built
// (cap * 4 + s; 0 = none). A slot's CLAS lives at RP_CLAS_BASE + s * RP_CLAS_STRIDE for as long
// as its avatar keeps the range.
layout(std430, set = 1, binding = 29) buffer RtClRigArgs { uint rig_args[]; };
layout(std430, set = 1, binding = 30) buffer RtClRigAddr { uint rig_addr[]; };
// 2a's SKIN_OUT (RP_SKIN_ADDR, the shared slots' vertex source: SkinVertex, 5 words).
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer SkinOutRef { uint w[]; };
// Host-written per frame slot (GPU writes the rows' validity words): parameters (RP_*), then the
// tier-0 rig rows (8 words: ri, ClusterInstance, first slot, slots, flags (1 = build frame), BLAS
// lo, hi, valid (host 1, GPU clears)), then the tier-0 skin jobs (2 words: row, k).
layout(std430, set = 1, binding = 31) coherent buffer RtClRigCpu { uint rcpu[]; };
// The PREVIOUS frame's cut arena (static cut reuse; the two arenas alternate per cut epoch).
layout(std430, set = 1, binding = 32) readonly buffer RtClCutPrev { uvec4 cut_prev[]; };
// ---- STATIC (#748 static pass; LLCleanClusterRTVK "STATIC") ----
// Host-written per frame slot: the CLAS arena's CHUNK TABLE (the arena grows chunk by chunk:
// no re-creation, no CLAS lost when it grows) and the persistent static cluster BLAS heap's
// parameters (SC_*; = LLCleanClusterRTVK::kSc*).
layout(std430, set = 1, binding = 33) readonly buffer RtClStaticCpu { uint scpu[]; };
#define SC_CHUNK_PAGES  0u    // CLAS pages per chunk
#define SC_CHUNKS       1u    // chunks (their bases at SC_CHUNK_BASE)
#define SC_SB_ON        2u    // 1 = static instances keep PERSISTENT cluster BLAS (explicit destinations)
#define SC_SB_EPOCH     3u    // heap epoch (a BLAS of another epoch is gone: rebuilt)
#define SC_SB_ADDR      4u    // 2 words: device address of the heap's first unit
#define SC_SB_UNITS     6u    // heap capacity (units)
#define SC_SB_UNIT      7u    // bytes per unit
