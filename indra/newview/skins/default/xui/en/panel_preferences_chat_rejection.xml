<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
    control_name="SlipstreamIgnoreAdHocSessions"
    height="408"
    layout="topleft"
    name="autoresponse_rejection_settings"
    top="0"
    left="13"
    width="517">
    <text
        top_pad="20"
        follows="left|top"
        height="18"
        type="string"
        length="1"
        layout="topleft"
        left="15"
        name="autorespond_reject_friends_response_label"
        width="500">
        Automatic response to all avatars when in REJECT FRIENDSHIP REQUESTS mode
        </text>
        <text_editor
          control_name="SlipstreamRejectFriendshipRequestsResponse"
          use_ellipses="false"
          commit_on_focus_lost="true"
          follows="left|top"
          height="55"
          layout="topleft"
          left="15"
          top_pad="5"
          name="autorespond_reject_friends_response"
          width="475"
          word_wrap="true">
          log_in_to_change
        </text_editor>
    <text
        top_pad="15"
        follows="left|top"
        height="18"
        type="string"
        length="1"
        layout="topleft"
        left="15"
        name="autorespond_rto_response_label"
        mouse_opaque="false"
        width="500">
        Automatic response to all avatars when in REJECT TELEPORT OFFERS mode:
    </text>
    <text_editor
        control_name="SlipstreamRejectTeleportOffersResponse"
        use_ellipses="false"
        commit_on_focus_lost = "true"
        follows="left|top"
        height="45"
        layout="topleft"
        left="15"
        name="autorespond_rto_response"
        width="475"
        word_wrap="true">
          log_in_to_change
    </text_editor>
    <check_box
          top_pad="5"
          left="15"
          follows="left|top"
          height="16"
          label="Don't reject teleport offers (and send response) from people on friends list"
          name="SlipstreamDontRejectTeleportOffersFromFriends"
          width="500"
          control_name="SlipstreamDontRejectTeleportOffersFromFriends" />
    <check_box
          top_pad="10"
          left="15"
          follows="left|top"
          height="16"
          label="Reject all group invitations (silently, no notification)"
          name="FSRejectAllGroupInvitesMode"
          width="500"
          control_name="FSRejectAllGroupInvitesMode" />
    <check_box
        top_pad="15"
        follows="left|top"
        height="18"
        layout="topleft"
        left="15"
        name="adhoc_ignore_check"
        label="Automatically ignore and leave all conference (ad-hoc) chats"
        width="500" />
    <check_box
      layout="topleft"
      follows="left|top"
      left="35"
      top_pad="5"
      height="18"
      name="SlipstreamReportIgnoredAdHocSession"
      control_name="SlipstreamReportIgnoredAdHocSession"
      label="Report ignored conference chats in nearby chat"
      width="470"/>
    <check_box
      layout="topleft"
      follows="left|top"
      left="35"
      top_pad="5"
      height="18"
      name="adhoc_friends_check"
      label="Don't ignore conference chat invitations from my friends"
      width="470"/>
</panel>
