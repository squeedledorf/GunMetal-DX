<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Photo Studio's undo stack as a list: every step by name, the present
     marked. Double-click a step (or select it and press Go to) to go back or
     forward to it. Owned by the Photo Studio floater and closed with it. -->
<floater
 width="340"
 height="300"
 min_width="260"
 min_height="160"
 layout="topleft"
 name="floater_photo_studio_history"
 positioning="cascading"
 title="Photo Studio: History"
 save_rect="true"
 can_resize="true">
	<floater.string
	 name="current_marker">
		(now)
	</floater.string>
	<scroll_list
	 follows="all"
	 layout="topleft"
	 left="6"
	 top="20"
	 right="-6"
	 height="240"
	 column_padding="4"
	 draw_heading="true"
	 multi_select="false"
	 name="history_list"
	 tool_tip="Double-click a step to go back or forward to it.">
		<scroll_list.columns
		 label="Step"
		 name="what"
		 relative_width="0.55" />
		<scroll_list.columns
		 label="Section"
		 name="where"
		 relative_width="0.30" />
		<scroll_list.columns
		 label=""
		 name="now"
		 relative_width="0.15" />
	</scroll_list>
	<text
	 follows="left|bottom|right"
	 layout="topleft"
	 left="8"
	 top_pad="10"
	 right="-100"
	 height="16"
	 font="SansSerifSmall"
	 name="history_empty"
	 value="Each change to the grade is listed here as you make it." />
	<button
	 follows="right|bottom"
	 layout="topleft"
	 right="-6"
	 top_delta="-4"
	 width="84"
	 height="22"
	 label="Go to"
	 name="history_go"
	 tool_tip="Go back or forward to the selected step" />
</floater>
