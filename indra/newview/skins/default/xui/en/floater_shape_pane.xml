<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- A shape editor panel popped out into a window of its own. The panel
     (panel_shape_editor_slot.xml) is created in C++ and fills "pane_body".
     Closing the window puts the panel back in the shape editor. The title
     follows the panel's group. -->
<floater
 width="340"
 height="480"
 min_width="324"
 min_height="240"
 layout="topleft"
 name="floater_shape_pane"
 positioning="cascading"
 title="Shape"
 single_instance="false"
 save_rect="false"
 can_resize="true">
	<floater.string
	 name="title_format">
		Shape: [SECTION]
	</floater.string>
	<panel
	 follows="all"
	 layout="topleft"
	 left="2"
	 top="18"
	 width="336"
	 height="460"
	 background_visible="false"
	 name="pane_body" />
</floater>
