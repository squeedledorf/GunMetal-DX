<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 height="408"
 label="Controls"
 layout="topleft"
 left="102"
 name="controls_panel"
 top="1"
 width="517">
  <combo_box
   follows="top|left"
   layout="topleft"
   top="6"
   left="10"
   height="23"
   width="232"
   name="key_mode">
    <combo_box.item
     label="When in third person"
     name="third_person"
     value="1"/>
    <combo_box.item
     label="When in first person mode (Mouselook)"
     name="first_person"
     value="0"/>
    <combo_box.item
     label="When editing avatar"
     name="edit_avatar"
     value="2"/>
    <combo_box.item
     label="When sitting"
     name="sitting"
     value="3"/>
    <combo_box.item
     label="When using flycam"
     name="flycam"
     value="4"/>
    <combo_box.item
     label="Menu and other shortcuts"
     name="commands"
     value="5"/>
  </combo_box>

  <combo_box
   follows="top|left"
   layout="topleft"
   top="31"
   left="10"
   height="23"
   width="232"
   visible="false"
   tool_tip="Shows the shortcuts of one menu or group"
   name="command_group"/>

  <button
   follows="top|left"
   layout="topleft"
   top="31"
   left="250"
   height="23"
   width="140"
   visible="false"
   label="Reset this group"
   tool_tip="Restores the default shortcuts of the group shown."
   name="reset_group"/>

  <panel.string name="all_groups">All groups</panel.string>
  <panel.string name="no_shortcut">no shortcut</panel.string>

  <button
   follows="top|left"
   layout="topleft"
   top="6"
   right="-10"
   height="23"
   width="140"
   label="Restore Defaults"
   tool_tip="Restores default values for all control modes."
   name="restore_defaults"/>

  <scroll_list
   draw_heading="true"
   follows="all"
   layout="topleft"
   column_padding="0"
   selection_type="header"
   top="31"
   left="3"
   bottom="-26"
   right="-3"
   can_sort="false"
   multi_select="false"
   name="controls_list"
   fg_disable_color="ScrollUnselectedColor"/>

  <check_box
   control_name="SlipstreamAltShiftRelocate"
   follows="left|bottom"
   layout="topleft"
   top="-24"
   left="10"
   height="20"
   width="497"
   label="Move Alt+Shift shortcuts to Ctrl+Alt+Shift (for keyboards that use Alt+Shift to switch input language)"
   tool_tip="Changes only the default shortcuts, e.g. Alt+Shift+H (hide HUDs) becomes Ctrl+Alt+Shift+H. Shortcuts you set yourself are never changed. Reopen Preferences to see the new defaults in the list."
   name="alt_shift_relocate"/>
</panel>
