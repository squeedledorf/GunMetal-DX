        can_edit_text="true"
        top_pad="5"
        name="SlipstreamChatCommandRezPlatSize"
        control_name="SlipstreamChatCommandRezPlatSize"
        enabled_control="SlipstreamChatCommandEnable"
        decimal_digits="0"
        follows="left|top"
        height="18"
        increment="1"
        label="Width"
        label_width="35"
        max_val="64"
        min_val="1"
