    height="20"
    max_length_chars="256"
    text_pad_left="5"
    name="SlipstreamChatCommandDrawDistance"
    control_name="SlipstreamChatCommandDrawDistance"
    enabled_control="SlipstreamChatCommandEnable"
    width="240"/>
