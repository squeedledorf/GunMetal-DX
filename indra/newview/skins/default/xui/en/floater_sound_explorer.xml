<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 name="sound_explorer"
 title="Sound Explorer"
 min_width="560"
 min_height="300"
 width="760"
 height="420"
 save_rect="true"
 single_instance="true"
 reuse_instance="false"
 can_resize="true"
 can_minimize="true"
 can_close="true">
	<floater.string name="SoundName">
		Sound [ID]
	</floater.string>
	<floater.string name="Unknown">
		Unknown
	</floater.string>
	<floater.string name="SourceUnknown">
		(unknown source)
	</floater.string>
	<floater.string name="TypeAttached">
		Attached
	</floater.string>
	<floater.string name="TypeTriggered">
		Triggered
	</floater.string>
	<floater.string name="TypeCollision">
		Collision
	</floater.string>
	<floater.string name="StatusPlaying">
		Playing
	</floater.string>
	<floater.string name="StatusBlocked">
		Blocked
	</floater.string>
	<floater.string name="StatusIdle">
		-
	</floater.string>
	<floater.string name="AgoSeconds">
		[N]s ago
	</floater.string>
	<floater.string name="AgoMinutes">
		[N]m ago
	</floater.string>
	<floater.string name="AgoHours">
		[N]h ago
	</floater.string>
	<floater.string name="Counter">
		[SHOWN] shown / [TOTAL] logged
	</floater.string>
	<floater.string name="ObjectFilter">
		Only sounds from: [NAME]
	</floater.string>
	<check_box
	 name="show_attached"
	 label="Attached"
	 tool_tip="Looped and attached object sounds"
	 control_name="SoundExplorerShowAttached"
	 follows="left|top"
	 height="16"
	 width="80"
	 left="10"
	 top="4"/>
	<check_box
	 name="show_triggered"
	 label="Triggered"
	 tool_tip="One-shot sounds from scripts and gestures"
	 control_name="SoundExplorerShowTriggered"
	 follows="left|top"
	 height="16"
	 width="80"
	 left_pad="6"
	 top_delta="0"/>
	<check_box
	 name="show_collision"
	 label="Collision"
	 tool_tip="Collision and footstep sounds"
	 control_name="SoundExplorerShowCollision"
	 follows="left|top"
	 height="16"
	 width="80"
	 left_pad="6"
	 top_delta="0"/>
	<check_box
	 name="playing_only"
	 label="Playing only"
	 tool_tip="Hide sounds that are not playing right now"
	 control_name="SoundExplorerPlayingOnly"
	 follows="left|top"
	 height="16"
	 width="100"
	 left_pad="14"
	 top_delta="0"/>
	<text
	 name="counter"
	 follows="right|top"
	 height="16"
	 width="170"
	 right="-10"
	 top_delta="0"
	 halign="right"/>
	<text
	 name="object_filter_label"
	 follows="left|top|right"
	 height="16"
	 left="10"
	 right="-100"
	 top_pad="4"
	 visible="false"/>
	<button
	 name="clear_object_filter"
	 label="Show all"
	 follows="right|top"
	 height="18"
	 width="84"
	 right="-10"
	 top_delta="-1"
	 visible="false"/>
	<scroll_list
	 name="sound_list"
	 follows="all"
	 left="6"
	 right="-6"
	 top="42"
	 bottom="-62"
	 column_padding="0"
	 draw_heading="true"
	 multi_select="true"
	 search_column="1">
		<scroll_list.columns
		 name="name"
		 label="Sound"
		 width="110"/>
		<scroll_list.columns
		 name="owner"
		 label="Owner"
		 width="130"/>
		<scroll_list.columns
		 name="source"
		 label="Source"
		 width="130"/>
		<scroll_list.columns
		 name="distance"
		 label="Dist"
		 width="45"/>
		<scroll_list.columns
		 name="type"
		 label="Type"
		 width="65"/>
		<scroll_list.columns
		 name="status"
		 label="State"
		 width="60"/>
		<scroll_list.columns
		 name="last"
		 label="Last played"
		 width="70"/>
	</scroll_list>
	<button
	 name="play_btn"
	 label="Play locally"
	 tool_tip="Preview the selected sound for yourself only"
	 follows="left|bottom"
	 height="20"
	 width="88"
	 left="10"
	 bottom="-34"/>
	<button
	 name="look_btn"
	 label="Look at"
	 tool_tip="Point the camera at the source of the selected sound"
	 follows="left|bottom"
	 height="20"
	 width="70"
	 left_pad="6"/>
	<button
	 name="beacon_btn"
	 label="Beacon"
	 tool_tip="Track the source of the selected sound"
	 follows="left|bottom"
	 height="20"
	 width="70"
	 left_pad="6"/>
	<button
	 name="copy_uuid_btn"
	 label="Copy UUID"
	 tool_tip="Copy the sound asset ID(s) to the clipboard"
	 follows="left|bottom"
	 height="20"
	 width="86"
	 left_pad="6"/>
	<button
	 name="filter_object_btn"
	 label="Only this source"
	 tool_tip="Show only sounds from the selected sound's source"
	 follows="left|bottom"
	 height="20"
	 width="110"
	 left_pad="6"/>
	<button
	 name="clear_log_btn"
	 label="Clear log"
	 follows="right|bottom"
	 height="20"
	 width="80"
	 right="-10"
	 bottom="-34"/>
	<button
	 name="block_sound_btn"
	 label="Block sound"
	 tool_tip="Never play the selected sound asset(s), no matter who plays them"
	 follows="left|bottom"
	 height="20"
	 width="96"
	 left="10"
	 bottom="-8"/>
	<button
	 name="unblock_sound_btn"
	 label="Unblock sound"
	 tool_tip="Allow the selected sound asset(s) again"
	 follows="left|bottom"
	 height="20"
	 width="104"
	 left_pad="6"/>
	<button
	 name="block_source_btn"
	 label="Block source"
	 tool_tip="Mute the object (or silence the avatar) that plays the selected sound"
	 follows="left|bottom"
	 height="20"
	 width="96"
	 left_pad="6"/>
	<button
	 name="block_owner_btn"
	 label="Block owner"
	 tool_tip="Silence the object sounds of the owner of the selected sound"
	 follows="left|bottom"
	 height="20"
	 width="96"
	 left_pad="6"/>
	<button
	 name="blocklist_btn"
	 label="Blocked list..."
	 tool_tip="Open the blocked assets list"
	 follows="right|bottom"
	 height="20"
	 width="100"
	 right="-10"
	 bottom="-8"/>
</floater>
