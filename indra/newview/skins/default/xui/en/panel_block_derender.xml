<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 follows="all"
 height="300"
 label="DERENDERED LIST"
 layout="topleft"
 width="350">
    <panel.string name="type_object">Object</panel.string>
    <panel.string name="type_avatar">Avatar</panel.string>
    <panel.string name="type_attachment">Attachment</panel.string>
    <panel.string name="type_attachment_once">Attachment (until re-worn)</panel.string>
    <panel.string name="attachment_location">[WEARER] ([POINT])</panel.string>
    <scroll_list
     draw_border="false"
     draw_heading="true"
     draw_stripes="true"
     follows="all"
     height="275"
     layout="topleft"
     left="1"
     multi_select="true"
     name="derender_list"
     right="-1"
     tool_tip="Derendered objects, avatars and attachments. Permanent entries stay derendered across sessions (attachments for as long as the same item is worn; &quot;until re-worn&quot; when the sim didn't say which item it is). Session entries come back after relog."
     top="0" >
        <scroll_list.columns
         label="Name"
         name="object_name" />
        <scroll_list.columns
         label="Type"
         name="entry_kind"
         width="80" />
        <scroll_list.columns
         label="Location / Wearer"
         name="location"
         width="140" />
        <scroll_list.columns
         label="Date"
         name="date"
         width="80" />
        <scroll_list.columns
         label="Duration"
         name="derender_type"
         width="70" />
    </scroll_list>
    <panel
     follows="left|right|bottom"
     height="25"
     left="1"
     layout="topleft"
     name="bottom_panel"
     right="-1"
     top_pad="0" >
        <icon  
         follows="bottom|left|right"
         height="25"
         image_name="Toolbar_Left_Off"
         width="472"
         left="1"
         name="derender_spacer_icon"
         right="-160"
         top="0" />
        <button
         enabled="false"
         follows="bottom|right"
         height="25"
         image_hover_unselected="Toolbar_Middle_Over"
         image_selected="Toolbar_Middle_Selected"
         image_unselected="Toolbar_Middle_Off"
         label="Make Permanent"
         left_pad="1"
         name="derender_persist_btn"
         tool_tip="Keep the selected session entries derendered across sessions."
         width="79" />
        <button 
         enabled="false"
         follows="bottom|right"
         height="25"
         image_hover_unselected="Toolbar_Right_Over"
         image_overlay="TrashItem_Off"
         image_overlay_alignment="left"
         image_selected="Toolbar_Right_Selected"
         image_unselected="Toolbar_Right_Off"
         label="Restore"
         left_pad="1"
         name="derender_trash_btn"
         tool_tip="Remove the selected entries and render them again (no relog needed)."
         width="79" />
    </panel>
</panel>
