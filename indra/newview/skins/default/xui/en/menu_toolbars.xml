                  layout="topleft"
                  name="gmdx_pin_wear">
    <menu_item_call.on_click function="GMDX.ToolbarPin.Menu"
                             parameter="wear" />
    <menu_item_call.on_visible function="GMDX.ToolbarPin.MenuVisible"
                               parameter="wear" />
  </menu_item_call>
  <menu_item_call label="Wear (Add)"
