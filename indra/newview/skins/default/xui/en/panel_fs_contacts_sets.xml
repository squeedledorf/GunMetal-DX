<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 height="300"
 layout="topleft"
 mouse_opaque="true"
 name="contact_sets_panel"
 width="355">
    <panel.string
     name="empty_list">
    This contact set is empty.
    </panel.string>
    <panel.string
     name="no_sets">
    No sets
    </panel.string>
    <panel.string
     name="all_sets">
    All sets
    </panel.string>
    <panel.string
     name="pseudonyms">
    Aliases
    </panel.string>
    <panel.string
     name="non_friends">
    Non-Friends
    </panel.string>
    <combo_box
     follows="left|top|right"
     layout="topleft"
     height="23"
     left="4"
     top="3"
     name="combo_sets"
     right="-58" />
    <menu_button
     follows="top|right"
     height="23"
     image_hover_unselected="Toolbar_Middle_Over"
     image_overlay="AddItem_Off"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     layout="topleft"
     menu_filename="menu_fs_contacts_sets_add.xml"
     menu_position="bottomleft"
     name="contact_sets_plus_btn"
     right="-29"
     tool_tip="Add a set or contact, set an alias, configure the set"
     top="3"
     width="27" />
    <menu_button
     follows="top|right"
     height="23"
     image_hover_unselected="Toolbar_Middle_Over"
     image_overlay="TrashItem_Off"
     image_selected="Toolbar_Middle_Selected"
     image_unselected="Toolbar_Middle_Off"
     layout="topleft"
     menu_filename="menu_people_contact_sets_remove.xml"
     menu_position="bottomleft"
     name="contact_sets_remove_btn"
     right="-1"
     tool_tip="Remove a group or resident"
     top="3"
     width="27" />
    <filter_editor
     follows="left|top|right"
     height="23"
     layout="topleft"
     left="4"
     label="Filter People"
     max_length_chars="300"
     name="contact_sets_filter_input"
     right="-1"
     top="29" />
    <avatar_list
     left="4"
     right="-4"
     top="55"
     bottom="-20"
     follows="all"
     layout="topleft"
     show_profile_btn="true"
     show_speaking_indicator="false"
     show_permissions_granted="true"
     allow_select="true"
     multi_select="true"
     keep_one_selected="false"
     name="contact_list" />
    <text
     bottom="-4"
     left="6"
     follows="bottom|left"
     layout="topleft"
     height="14"
     name="member_count"
     width="255">
    Members: [COUNT]
    </text>
</panel>
