<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 positioning="specified"
 left="5"
 bottom="-1"
 follows="left|bottom"
 legacy_header_height="20"
 height="27"
 can_minimize="false"
 can_collapse="false"
 can_resize="true"
 can_resize_height="false"
 can_close="false"
 layout="topleft"
 min_width="12"
 min_height="27"
 name="chatbar"
 chrome="true"
 title=""
 width="560"
 single_instance="true"
 save_rect="true"
 background_visible="false">
   <!-- <GMDX> no skin box: SLChatBar::draw fills it in the chat log panel's colours (gmdxchatlog.cpp), the
        bar its bottom row; the editor draws no background or border of its own -->
   <chat_editor
    follows="left|bottom|right"
    font="SansSerifLarge"
    height="25"
    layout="topleft"
    top="0"
    left="1"
    right="-35"
    name="Chat Editor"
    bg_visible="false"
    border_visible="false"
    bg_writeable_color="GMDXChatBarBackground"
    bg_focus_color="GMDXChatBarBackground"
    text_color="GMDXChatBarText"
    text_tentative_color="GMDXChatBarLabel"
    cursor_color="GMDXChatBarCursor"
    bg_selected_color="GMDXChatBarSelection"
    text_selected_color="GMDXChatBarText"
    spellcheck="true" />
   <menu_button
    follows="right"
    height="25"
    image_overlay="OptionsMenu_Off"
    layout="topleft"
    left_pad="2"
    name="chatbar_gear_menu"
    menu_filename="menu_sl_chatbar_gear.xml"
    tool_tip="Chatbar options"
    top="0"
    width="25" />
   <icon
    follows="right"
    layout="topleft"
    left_pad="0"
    width="6"
    name="drag"
    image_name="Dragbar"
    top="0"
    bottom="-1" />
   <!-- Channel spinner goes LAST: the gear and drag icon chain off the editor via
        left_pad, so a sibling placed between them pulls the gear to the left edge.
        SLChatBar::updateChannelSelector() positions the spinner at runtime. -->
   <spinner
    name="ChatChannel"
    control_name="SlipstreamNearbyChatChannel"
    follows="right"
    layout="topleft"
    top="1"
    left="0"
    width="66"
    height="23"
    visible="false"
    decimal_digits="0"
    increment="1"
    initial_value="0"
    label=""
    label_width="0"
    max_val="2147483647"
    min_val="-2147483647"
    text_enabled_color="GMDXChatBarText"
    tool_tip="Channel nearby chat is sent on when the message has no /channel prefix (same as /setchannel)." >
    <!-- <GMDX> Phosphor carets in the log's muted icon colour, no stepper boxes (its number box: SLChatBar::postBuild) -->
    <spinner.up_button
     image_unselected="Arrow_Small_Up"
     image_selected="Arrow_Small_Up"
     image_hover_unselected="Arrow_Small_Up"
     image_hover_selected="Arrow_Small_Up"
     image_pressed="Arrow_Small_Up"
     image_pressed_selected="Arrow_Small_Up"
     image_disabled="Arrow_Small_Up"
     image_disabled_selected="Arrow_Small_Up"
     image_color="GMDXChatBarLabel"
     image_color_disabled="GMDXChatBarEdge" />
    <spinner.down_button
     image_unselected="Arrow_Small_Down"
     image_selected="Arrow_Small_Down"
     image_hover_unselected="Arrow_Small_Down"
     image_hover_selected="Arrow_Small_Down"
     image_pressed="Arrow_Small_Down"
     image_pressed_selected="Arrow_Small_Down"
     image_disabled="Arrow_Small_Down"
     image_disabled_selected="Arrow_Small_Down"
     image_color="GMDXChatBarLabel"
     image_color_disabled="GMDXChatBarEdge" />
   </spinner>
   <!-- <GMDX> IM mode (a name clicked in the chat log): back to nearby chat. Placed at runtime
        (SLChatBar::updateChannelSelector), a Phosphor x in the log's muted icon colour, no box. -->
   <button
    name="im_cancel"
    follows="right"
    layout="topleft"
    top="0"
    left="0"
    width="22"
    height="25"
    visible="false"
    tab_stop="false"
    image_unselected="transparent.j2c"
    image_selected="transparent.j2c"
    image_hover_unselected="transparent.j2c"
    image_hover_selected="transparent.j2c"
    image_pressed="transparent.j2c"
    image_pressed_selected="transparent.j2c"
    image_overlay="Conv_toolbar_close"
    image_overlay_color="GMDXChatBarLabel"
    tool_tip="Back to nearby chat (Esc)" />
</floater>
