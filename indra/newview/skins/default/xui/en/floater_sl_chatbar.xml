<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 positioning="specified"
 left="5"
 bottom="-1"
 follows="left|bottom"
 legacy_header_height="20"
 height="27"
 can_minimize="false"
 can_collapse="false"
 can_resize="true"
 can_resize_height="false"
 can_close="false"
 layout="topleft"
 min_width="12"
 min_height="27"
 name="chatbar"
 chrome="true"
 title=""
 width="560"
 single_instance="true"
 save_rect="true">
   <chat_editor
    follows="left|bottom|right"
    font="SansSerifLarge"
    height="25"
    layout="topleft"
    top="0"
    left="1"
    right="-35"
    name="Chat Editor"
    bg_visible="true"
    bg_writeable_color="GMDXChatBarBackground"
    bg_focus_color="GMDXChatBarBackground"
    text_color="GMDXChatBarText"
    text_tentative_color="GMDXChatBarLabel"
    cursor_color="GMDXChatBarCursor"
    spellcheck="true" />
   <menu_button
    follows="right"
    height="25"
    image_overlay="OptionsMenu_Off"
    layout="topleft"
    left_pad="2"
    name="chatbar_gear_menu"
    menu_filename="menu_sl_chatbar_gear.xml"
    tool_tip="Chatbar options"
    top="0"
    width="25" />
   <icon
    follows="right"
    layout="topleft"
    left_pad="0"
    width="6"
    name="drag"
    image_name="Dragbar"
    top="0"
    bottom="-1" />
   <!-- Channel spinner goes LAST: the gear and drag icon chain off the editor via
        left_pad, so a sibling placed between them pulls the gear to the left edge.
        SLChatBar::updateChannelSelector() positions the spinner at runtime. -->
   <spinner
    name="ChatChannel"
    control_name="SlipstreamNearbyChatChannel"
    follows="right"
    layout="topleft"
    top="1"
    left="0"
    width="66"
    height="23"
    visible="false"
    decimal_digits="0"
    increment="1"
    initial_value="0"
    label=""
    label_width="0"
    max_val="2147483647"
    min_val="-2147483647"
    tool_tip="Channel nearby chat is sent on when the message has no /channel prefix (same as /setchannel)." />
</floater>
