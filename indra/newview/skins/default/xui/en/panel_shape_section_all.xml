<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
Every group of shape sliders in one panel, in an accordion: what the Shape page
always was (SLPanelShapeSection). The tab and list names are "shape_<id>_tab"
and "shape_<id>_param_list" for the section ids in SECTIONS
(slpanelshapeeditor.cpp); the lists are filled from the wearable.
-->
<panel
 name="panel_shape_section_all"
 layout="topleft"
 width="309"
 height="356"
 follows="all"
 border="false"
 bg_alpha_color="DkGray2"
 bg_opaque_color="DkGray2"
 background_visible="true"
 background_opaque="true">
	<accordion
	 layout="topleft"
	 follows="all"
	 height="356"
	 left="0"
	 name="wearable_accordion"
	 top="0"
	 single_expansion="true"
	 fit_parent="true"
	 width="309">
		<accordion_tab
		 layout="topleft"
		 min_height="150"
		 name="shape_body_tab"
		 fit_panel="false"
		 title="Body">
			<scrolling_panel_list
			 layout="topleft"
			 follows="all"
			 left="0"
			 height="300"
			 name="shape_body_param_list"
			 top="0"
			 width="299" />
		</accordion_tab>
		<accordion_tab
		 layout="topleft"
		 min_height="150"
		 fit_panel="false"
		 name="shape_head_tab"
		 title="Head">
			<scrolling_panel_list
			 layout="topleft"
			 follows="all"
			 left="0"
			 name="shape_head_param_list"
			 top="0"
			 width="299" />
		</accordion_tab>
		<accordion_tab
		 layout="topleft"
		 min_height="150"
		 fit_panel="false"
		 name="shape_eyes_tab"
		 title="Eyes">
			<scrolling_panel_list
			 layout="topleft"
			 follows="all"
			 left="0"
			 name="shape_eyes_param_list"
			 top="0"
			 width="299" />
		</accordion_tab>
		<accordion_tab
		 layout="topleft"
		 min_height="150"
		 fit_panel="false"
		 name="shape_ears_tab"
		 title="Ears">
			<scrolling_panel_list
			 layout="topleft"
			 follows="all"
			 left="0"
			 name="shape_ears_param_list"
			 top="0"
			 width="299" />
		</accordion_tab>
		<accordion_tab
		 layout="topleft"
		 min_height="150"
		 name="shape_nose_tab"
		 fit_panel="false"
		 title="Nose">
			<scrolling_panel_list
			 layout="topleft"
			 follows="all"
			 left="0"
			 name="shape_nose_param_list"
