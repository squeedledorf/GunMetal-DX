<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- <GMDX> Mini-map right-click menu: only what fits the spot clicked (LLNetMap::handleRightMouseDown
     shows / hides the groups): an avatar's dot, my mark, my zone, someone's shared item, or the map
     itself. Colours are one row of swatches (gmdxmenuswatchrow.h). The display settings and the
     Region Map tools are in Map Settings (gmdxfloaterminimapsettings.h). -->
<menu
 height="101"
 layout="topleft"
 left="100"
 mouse_opaque="false"
 name="Popup"
 top="724"
 visible="false"
 width="128">
    <!-- what the menu is for: the avatar's name, the mark's, the zone's, who shared it (set on right-click) -->
    <menu_item_call
     enabled="false"
     label="Header"
     name="Context Header" />

    <!-- an avatar's dot (the closest under the cursor) -->
    <menu_item_call
     label="View Profile"
     name="Avatar Profile">
        <menu_item_call.on_click
         function="Minimap.Avatar.Profile" />
    </menu_item_call>
    <menu_item_call
     label="Camera to Avatar"
     name="Cam To Avatar">
        <menu_item_call.on_click
         function="Minimap.CamToAvatar" />
    </menu_item_call>
    <menu
     label="Camera to Avatar"
     name="Cam To Avatars"
     tear_off="false" />
    <gmdx_swatch_row
     label="Dot Colour"
     name="Avatar Dot Colour">
        <gmdx_swatch_row.on_click
         function="Minimap.Avatar.Color" />
    </gmdx_swatch_row>
    <menu_item_call
     label="Custom Colour..."
     name="Avatar Dot Colour Custom">
        <menu_item_call.on_click
         function="Minimap.Avatar.Color"
         parameter="custom" />
    </menu_item_call>
    <menu_item_call
     label="Default Colour"
     name="Avatar Dot Colour Default">
        <menu_item_call.on_click
         function="Minimap.Avatar.Color"
         parameter="clear" />
        <menu_item_call.on_enable
         function="Minimap.Avatar.HasColor" />
    </menu_item_call>

    <!-- my mark / my zone (llminimapmarks.h) -->
    <menu_item_call
     label="Track"
     name="Track Mark">
        <menu_item_call.on_click
         function="Minimap.Mark.Track" />
    </menu_item_call>
    <menu_item_call
     label="Rename..."
     name="Rename Mark">
        <menu_item_call.on_click
         function="Minimap.Mark.Rename" />
    </menu_item_call>
    <gmdx_swatch_row
     label="Colour"
     name="Mark Colour">
        <gmdx_swatch_row.on_click
         function="Minimap.Mark.Color" />
    </gmdx_swatch_row>
    <menu
     label="Line"
     name="Zone Line"
     tear_off="false">
        <menu_item_call
         label="Solid"
         name="Zone Line Solid">
            <menu_item_call.on_click
             function="Minimap.Zone.Line"
             parameter="solid" />
        </menu_item_call>
        <menu_item_call
         label="Dotted"
         name="Zone Line Dotted">
            <menu_item_call.on_click
             function="Minimap.Zone.Line"
             parameter="dotted" />
        </menu_item_call>
    </menu>
    <menu
     label="Fill"
     name="Zone Fill"
     tear_off="false">
        <menu_item_call
         label="None"
         name="Zone Fill None">
            <menu_item_call.on_click
             function="Minimap.Zone.Fill"
             parameter="0" />
        </menu_item_call>
        <menu_item_call
         label="Colour"
         name="Zone Fill Colour">
            <menu_item_call.on_click
             function="Minimap.Zone.Fill"
             parameter="1" />
        </menu_item_call>
        <menu_item_call
         label="Caution Stripes"
         name="Zone Fill Caution Stripes">
            <menu_item_call.on_click
             function="Minimap.Zone.Fill"
             parameter="2" />
        </menu_item_call>
    </menu>
    <gmdx_swatch_row
     label="Colour"
     name="Zone Colour">
        <gmdx_swatch_row.on_click
         function="Minimap.Zone.Color" />
    </gmdx_swatch_row>
    <menu_item_call
     label="Rename..."
     name="Rename Zone">
        <menu_item_call.on_click
         function="Minimap.Zone.Rename" />
    </menu_item_call>
    <!-- sharing (gmdxmapshare.h, GMDXMapShare::fillShareMenus fills these by name on right-click):
         my mark / zone goes out as a readable line, through my helper, to the members in this region
         of the group whose tag I wear (Share Group), or to my Send To list. Nothing ever goes to
         everyone in the region. -->
    <menu
     label="Share"
     name="Share With"
     tear_off="false">
        <menu_item_call
         label="Share to Group"
         name="Share Group">
            <menu_item_call.on_click
             function="Minimap.Share"
             parameter="group" />
        </menu_item_call>
        <menu_item_call
         label="Share to My List"
         name="Share List"
         tool_tip="Your group (when ticked in Send To) and the groups and people ticked in Send To, those of them in this region.">
            <menu_item_call.on_click
             function="Minimap.Share"
             parameter="list" />
        </menu_item_call>
        <menu_item_separator />
        <menu
         label="Send To"
         name="Share Send To"
         tear_off="false" />
    </menu>
    <menu_item_call
     label="Remove"
     name="Remove Mark">
        <menu_item_call.on_click
         function="Minimap.Mark.Remove" />
    </menu_item_call>
    <menu_item_call
     label="Remove"
     name="Remove Zone">
        <menu_item_call.on_click
         function="Minimap.Zone.Remove" />
    </menu_item_call>

    <!-- someone's shared mark, zone or ping: kept as mine or removed (the sender's name set on right-click) -->
    <menu_item_call
     label="Keep as Mine"
     name="Keep Shared">
        <menu_item_call.on_click
         function="Minimap.Shared.Keep" />
    </menu_item_call>
    <menu_item_call
     label="Remove"
     name="Remove Shared">
        <menu_item_call.on_click
         function="Minimap.Shared.Remove" />
    </menu_item_call>
    <menu_item_call
     label="Remove All From Sender"
     name="Remove Shared Sender">
        <menu_item_call.on_click
         function="Minimap.Shared.RemoveSender" />
    </menu_item_call>
    <menu_item_call
     label="Block Map Shares From Sender"
     name="Block Shared Sender">
        <menu_item_call.on_click
         function="Minimap.Shared.BlockSender" />
    </menu_item_call>
    <menu_item_separator
     name="Item Separator" />

    <!-- the spot (a mark: its own position) -->
    <menu_item_call
     label="Copy Coordinates"
     name="Copy Coordinates">
        <menu_item_call.on_click
         function="Minimap.CopyPosition"
         parameter="text" />
    </menu_item_call>
    <menu_item_call
     label="Copy SLURL"
     name="Copy SLURL">
        <menu_item_call.on_click
         function="Minimap.CopyPosition"
         parameter="slurl" />
        <menu_item_call.on_enable
         function="Minimap.CanShowLocation" />
    </menu_item_call>
    <menu_item_separator
     name="Spot Separator" />
    <gmdx_swatch_row
     label="Add Mark"
     name="Add Mark Here">
        <gmdx_swatch_row.on_click
         function="Minimap.Mark.Add" />
    </gmdx_swatch_row>
    <menu
     label="Draw Zone"
     name="Draw Zone"
     tear_off="false">
        <menu_item_call
         label="Rectangle"
         name="Draw Zone Rectangle">
            <menu_item_call.on_click
             function="Minimap.Zone.Draw"
             parameter="0" />
        </menu_item_call>
        <menu_item_call
         label="Circle"
         name="Draw Zone Circle">
            <menu_item_call.on_click
             function="Minimap.Zone.Draw"
             parameter="1" />
        </menu_item_call>
        <menu_item_call
         label="Polygon"
         name="Draw Zone Polygon">
            <menu_item_call.on_click
             function="Minimap.Zone.Draw"
             parameter="2" />
        </menu_item_call>
        <menu_item_separator />
        <menu_item_check
         label="Dotted Lines"
         name="Draw Zone Dotted">
            <menu_item_check.on_check
             control="SLMiniMapZoneDotted" />
            <menu_item_check.on_click
             function="ToggleControl"
             parameter="SLMiniMapZoneDotted" />
        </menu_item_check>
    </menu>
    <!-- a ping here (on an avatar's dot too) to my Send To list (filled in on right-click) -->
    <menu
     label="Ping"
     name="Ping"
     tear_off="false">
        <menu_item_call
         label="Ping Here"
         name="Ping Here">
            <menu_item_call.on_click
             function="Minimap.Ping"
             parameter="0" />
        </menu_item_call>
        <menu_item_call
         label="Enemy Here"
         name="Ping Enemy Here">
            <menu_item_call.on_click
             function="Minimap.Ping"
             parameter="1" />
        </menu_item_call>
        <menu_item_call
         label="Rally Here"
         name="Ping Rally Here">
            <menu_item_call.on_click
             function="Minimap.Ping"
             parameter="2" />
        </menu_item_call>
        <menu_item_separator />
        <menu
         label="Send To"
         name="Ping Send To"
         tear_off="false" />
    </menu>

    <!-- the land and the world map (the map itself only) -->
    <menu_item_separator
     name="Land Separator" />
    <menu_item_call
     label="Stop Tracking"
     name="Stop tracking">
        <menu_item_call.on_click
         function="Minimap.Tracker"
         parameter="task_properties" />
    </menu_item_call>
    <menu_item_call
     label="About Land"
     name="About Land">
        <menu_item_call.on_click
         function="Minimap.AboutLand" />
    </menu_item_call>
    <menu_item_call
     label="World Map"
     name="World Map">
        <menu_item_call.on_click
         function="Floater.Show"
         parameter="world_map" />
    </menu_item_call>

    <!-- always -->
    <menu_item_separator
     name="Tools Separator" />
    <menu_item_call
     label="Sharing..."
     name="Map Sharing">
        <menu_item_call.on_click
         function="Floater.Show"
         parameter="gmdx_map_sharing" />
    </menu_item_call>
    <menu_item_call
     label="Map Settings..."
     name="Map Settings">
        <menu_item_call.on_click
         function="Minimap.Settings" />
    </menu_item_call>
</menu>
