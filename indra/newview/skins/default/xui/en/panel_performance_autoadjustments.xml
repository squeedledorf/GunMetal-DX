<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- #422: the Vulkan auto-tuner (LLVKAutoTune). "Tune once" writes settings (summary + Undo);
     "Keep my FPS" (AutoTuneLock) only holds detail back temporarily and never changes a setting. -->
<panel
 bevel_style="none"
 follows="left|top"
 height="580"
 width="580"
 name="panel_performance_autoadjustments"
 layout="topleft"
 left="0"
 top="0">
  <button
    height="16"
    width="16"
    layout="topleft"
    mouse_opaque="true"
    follows="left|top"
    name="back_btn"
    top="7"
    image_selected="Arrow_Left_Off"
    image_pressed="Arrow_Left_Off"
    image_unselected="Arrow_Left_Off"
    left="15"
    is_toggle="true">
  </button>
  <text
   follows="left|top"
   height="18"
   layout="topleft"
   left_pad="0"
   valign="center"
   halign="center"
   top="6"
   name="back_lbl"
   width="32">
    Back
  </text>
  <text
   follows="left|top"
   font="SansSerifLarge"
   text_color="white"
   height="20"
   layout="topleft"
   left="20"
   top_pad="12"
   name="settings_title"
   width="300">
    Auto-adjust settings
  </text>
  <button
   follows="top|left"
   height="23"
   label="Reset to recommended settings"
   layout="topleft"
   left="360"
   name="defaults_btn"
   top_delta="0"
   width="200"/>
  <view_border
   bevel_style="in"
   height="0"
   layout="topleft"
   name="border0"
   top_pad="10"
   left="20"
   width="540"/>
  <text
   follows="left|top"
   font="SansSerif"
   text_color="White"
   height="20"
   layout="topleft"
   left="20"
   name="targetfps_desc"
   wrap="true"
   width="115"
   top_pad="12">
    Desired frame rate
  </text>
  <spinner
   name="target_fps"
   control_name="TargetFPS"
   font="SansSerifLarge"
   tool_tip="The frame rate the viewer works to. While vsync is on it can't go above your display's refresh rate."
   layout="topleft"
   follows="left|top"
   left_pad="25"
   top_delta="0"
   height="25"
   visible="true"
   decimal_digits="0"
   increment="1"
   initial_value="60"
   max_val="500"
   min_val="10"
   width="52"
   label_width="0" />
 <text
   follows="left|top"
   text_color="White"
   height="20"
   layout="topleft"
   name="display_desc"
   top_delta="5"
   left_pad="15"
   wrap="true"
   width="300">
  Your display supports up to [FPS_LIMIT] fps.
  </text>
  <text
   follows="left|top"
   font="SansSerif"
   text_color="White"
   height="20"
   layout="topleft"
   left="20"
   name="settings_desc"
   top_pad="6"
   wrap="true"
   width="115">
    Settings affect
  </text>
  <combo_box
   follows="top|left"
   font="SansSerif"
   height="20"
   layout="topleft"
   left_pad="25"
   control_name="TuningFPSStrategy"
   name="TuningFPSStrategy"
   tool_tip="Which settings the viewer may change (Tune once) or hold back (Keep my FPS)."
   width="160">
    <combo_box.item
     label="Avatars Only"
     name="av_only"
     value="0" />
    <combo_box.item
     label="Avatars and World"
     name="av_and_scene"
     value="1" />
	<combo_box.item
     label="World Only"
     name="scene_only"
     value="2" />
  </combo_box>
  <button
   follows="top|left"
   height="22"
   image_pressed="PushButton_Press"
   image_pressed_selected="PushButton_Selected_Press"
   image_selected="PushButton_Selected_Press"
   label="Tune once"
   layout="topleft"
   top_pad="10"
   left="20"
   name="start_autotune"
   tool_tip="Measure this place for a few seconds at a time and change your graphics settings, cheapest-looking first, until the desired frame rate is reached. Nothing changes if you already reach it."
   width="110"/>
  <button
   follows="top|left"
   height="22"
   image_pressed="PushButton_Press"
   image_pressed_selected="PushButton_Selected_Press"
   image_selected="PushButton_Selected_Press"
   label="Cancel"
   layout="topleft"
   left_pad="10"
   name="stop_autotune"
   tool_tip="Stop tuning (the changes made so far stay; Undo restores them)."
   width="80"/>
  <button
   follows="top|left"
   height="22"
   image_pressed="PushButton_Press"
   image_pressed_selected="PushButton_Selected_Press"
   image_selected="PushButton_Selected_Press"
   label="Undo"
   layout="topleft"
   left_pad="10"
   name="undo_autotune"
   tool_tip="Put back exactly the settings the last Tune once changed."
   width="80"/>
  <text
   follows="left|top"
   text_color="Yellow"
   height="20"
   layout="topleft"
   name="wip_desc"
   top_delta="4"
   left_pad="15"
   wrap="true"
   width="200">
  Working on it... keep the camera on this place.
  </text>
  <text
   follows="left|top"
   font="SansSerifSmall"
   text_color="White"
   height="64"
   layout="topleft"
   left="20"
   top_pad="6"
   name="tuner_summary"
   wrap="true"
   width="540" />
  <check_box
   control_name="AutoTuneLock"
   follows="top|left"
   height="20"
   initial_value="false"
   label="Keep my FPS (holds detail back only while needed; your settings are not changed)"
   layout="topleft"
   left="17"
   top_pad="4"
   name="AutoTuneContinuous"
   tool_tip="While the frame rate is below the desired one, temporarily lower reflections, mirrors, far shadows, render resolution, projector shadows, fully rendered avatars, object detail and draw distance, and bring them back when there is headroom. Works with the window closed."
   width="540">
  </check_box>
  <radio_group
   control_name="KeepAutoTuneLock"
   enabled_control="AutoTuneLock"
   height="36"
   layout="topleft"
   follows="top|left"
   name="autotune_lock_type"
   top_pad="2"
   left_delta="15"
   width="200">
    <radio_item
     height="16"
     label="This login session only"
     layout="topleft"
     name="one_session_lock"
     value="0"
     width="200" />
    <radio_item
     height="16"
     label="Future login sessions"
     layout="topleft"
     name="next_session_lock"
     value="1"
     width="200" />
  </radio_group>
  <text
   follows="left|top"
   font="SansSerifSmall"
   text_color="LtGray"
   height="30"
   layout="topleft"
   left="20"
   top_pad="2"
   name="tuner_status"
   wrap="true"
   width="540" />
  <view_border
   bevel_style="in"
   height="0"
   layout="topleft"
   name="border_vsync"
   top_pad="4"
   left="20"
   width="540"/>
  <check_box
   control_name="RenderVSyncEnable"
   height="16"
   left="17"
   initial_value="true"
   label="Enable VSync"
   label_text.text_color="White"
   layout="topleft"
   top_pad="8"
   name="vsync"
   tool_tip="Enable Vertical synchronization to reduce screen tearing and stuttering."
   width="315" />
  <text
   follows="left|top"
   font="SansSerifSmall"
   text_color="White"
   height="16"
   layout="topleft"
   left="20"
   top_pad="4"
   name="vsync_desc"
   width="540">
    Matches monitor refresh rate with frame rate.
  </text>
  <text
   follows="left|top"
   font="SansSerifSmall"
   text_color="White"
   height="16"
   layout="topleft"
   top_pad="0"
   left="20"
   name="vsync_desc_limit"
   width="540">
    Note: Turning on VSync limits frame rate to [FPS_LIMIT] fps.
  </text>
  <view_border
   bevel_style="in"
   height="0"
   layout="topleft"
   name="border1"
   top_pad="6"
   left="20"
   width="540"/>
  <check_box
   control_name="AutoTuneImpostorByDistEnabled"
   height="19"
   label="Simplify avatars beyond"
   label_text.text_color="White"
   layout="topleft"
   follows="top|left"
   left="17"
   name="AutoTuneImpostorByDistEnabled"
   tool_tip="Only the avatars within this distance of the camera are fully rendered; the others are simplified. Reducing detail shown on avatars that are far away improves graphics speed."
   top_pad="8"
   width="190" />
  <spinner
   control_name="AutoTuneImpostorFarAwayDistance"
   height="20"
   layout="topleft"
   follows="top|left"
   name="ffa_autotune"
   left_pad="20"
   decimal_digits="0"
   min_val="16"
   max_val="256"
   width="60" >
  </spinner>
  <text
   follows="left|top"
   font="SansSerifSmall"
   text_color="White"
   height="18"
   layout="topleft"
   left_pad="10"
   name="dist_meters"
   width="70">
    meters
  </text>
  <text
   follows="left|top"
   font="SansSerifSmall"
   text_color="White"
   height="18"
   layout="topleft"
   top_pad="8"
   left="20"
   name="min_dist_lbl"
   tool_tip="Tune once never sets a shorter draw distance than this."
   width="200">
    Shortest draw distance to tune to
  </text>
  <spinner
   control_name="AutoTuneRenderFarClipMin"
   height="20"
   layout="topleft"
   left_pad="15"
   follows="top|left"
   name="min_dd_autotune"
   decimal_digits="0"
   min_val="64"
   max_val="4096"
   tool_tip="Tune once never sets a shorter draw distance than this."
   width="60">
  </spinner>
  <view_border
   bevel_style="in"
   height="0"
   layout="topleft"
   name="border2"
   top_pad="6"
   left="20"
   width="540"/>
  <text
   follows="left|top"
   font="SansSerifSmall"
   text_color="White"
   height="92"
   layout="topleft"
   left="20"
   top_pad="6"
   name="frame_breakdown"
   wrap="true"
   width="540">
    Measuring...
  </text>
</panel>
