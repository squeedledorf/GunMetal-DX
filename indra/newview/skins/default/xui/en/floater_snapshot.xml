         label="L$ Balance"
         layout="topleft"
         left_pad="16"
         height="16"
         top_delta="0"
         width="80"
         control_name="RenderBalanceInSnapshot"
         enabled_control="RenderUIInSnapshot"
         name="balance_check" />
