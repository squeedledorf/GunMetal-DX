             label="Avatars: All"
             name="AvatarsAll"
             value="2" />
            <combo_box.item
             label="Avatars: Self + Selected"
             name="AvatarsSelected"
             value="1" />
            <combo_box.item
             label="Avatars: Self only"
             name="AvatarsSelf"
             value="0" />
        </combo_box>
