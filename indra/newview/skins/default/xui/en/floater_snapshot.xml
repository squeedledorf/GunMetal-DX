             label="Colors"
             name="Colors"
             value="colors" />
            <combo_box.item
             label="Depth"
             name="Depth"
             value="depth" />
            <!-- avatar layers (SoapStorm, via GunMetal-DX v0.3.0 cf5f1f4; llsnapshotavatars.h) -->
            <combo_box.item
             label="Avatar (Transparent)"
             name="AvatarTransparent"
             value="avatar_transparent" />
            <combo_box.item
             label="Avatar Matte (Black on White)"
             name="AvatarMaskBlack"
             value="avatar_mask_black" />
            <combo_box.item
             label="Avatar Matte (White on Black)"
             name="AvatarMaskWhite"
             value="avatar_mask_white" />
        </combo_box>
        <!-- which avatars snapshots include (SLSnapshotAvatarScope) + the picker -->
        <combo_box
         control_name="SLSnapshotAvatarScope"
         follows="left|top|right"
         height="23"
         layout="topleft"
         left="30"
         name="avatar_scope_combo"
         top_pad="4"
         right="-29"
         tool_tip="Which avatars snapshots and the avatar layers include. Your own avatar, attachments and animesh are always in. Snapshots with the interface show everyone.">
