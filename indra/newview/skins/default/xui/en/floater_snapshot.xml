        <combo_box.item label="Timer: Off" name="timer_off" value="0" />
        <combo_box.item label="Timer: 3 s" name="timer_3" value="3" />
        <combo_box.item label="Timer: 5 s" name="timer_5" value="5" />
        <combo_box.item label="Timer: 10 s" name="timer_10" value="10" />
