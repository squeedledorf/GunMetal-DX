				 enabled_control="JoystickEnabled"
				 control_name="FlycamAxisScale4" />
				<button
				 follows="top|right"
				 layout="topleft"
				 right="-8"
				 top_delta="0"
				 width="18"
				 height="18"
				 label=""
				 scale_image="true"
				 image_overlay="Refresh_Off"
				 image_overlay_alignment="center"
				 name="cam_axis_pitch_rst"
				 tool_tip="Reset to default"
				 enabled_control="JoystickEnabled">
					<button.commit_callback
					 function="PhotoStudio.ResetControlDefault"
					 parameter="FlycamAxisScale4" />
				</button>
				<slider
				 follows="left|top|right"
				 layout="topleft"
				 left="8"
				 top_pad="8"
				 right="-32"
				 height="18"
				 label="Yaw"
				 label_width="140"
				 decimal_digits="3"
				 increment="0.001"
				 min_val="0"
				 max_val="2"
				 can_edit_text="true"
				 name="cam_axis_yaw"
				 tool_tip="How fast the camera turns left and right. Lower slows the turn, for precise framing."
				 enabled_control="JoystickEnabled"
				 control_name="FlycamAxisScale5" />
				<button
				 follows="top|right"
				 layout="topleft"
				 right="-8"
				 top_delta="0"
				 width="18"
				 height="18"
				 label=""
