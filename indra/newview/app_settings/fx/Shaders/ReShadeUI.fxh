/*
 * ReShadeUI.fxh -- Slipstream's own implementation (#543).
 *
 * Written from scratch for the Slipstream viewer; NOT a copy of the reshade-shaders
 * file of the same name (which carries no licence). It provides the same public macro
 * names effects use: __UNIFORM_<KIND>_<TYPE><N> and __UNIFORM_<KIND>_ANY, each
 * expanding to the ui_type annotation of that kind. Slipstream's FX runtime reports a
 * ReShade 6 language level, so every kind maps to its own ui_type.
 *
 * SPDX-License-Identifier: CC0-1.0
 */

#pragma once

#if !defined(__RESHADE__) || __RESHADE__ < 30000
#error "ReShadeUI.fxh needs a ReShade FX compatible runtime (__RESHADE__ >= 30000)"
#endif

#define RESHADE_VERSION(major, minor, build) (10000 * (major) + 100 * (minor) + (build))
#define SUPPORTED_VERSION(major, minor, build) (__RESHADE__ >= RESHADE_VERSION(major, minor, build))

#define __UNIFORM_INPUT_ANY ui_type = "input";
#define __UNIFORM_INPUT_BOOL1 __UNIFORM_INPUT_ANY
#define __UNIFORM_INPUT_BOOL2 __UNIFORM_INPUT_ANY
