# Maintainer: Slipstream Viewer <https://git.slipstreamviewer.org/sky_line/Slipstream>
#
# Repackages the official Slipstream Linux release tarball. This file is
# generated by scripts/packaging/aur/gen.sh in the Slipstream repository: edit
# it there, not in the AUR checkout. gen.sh rewrites only the pkgver, pkgrel,
# _tag and sha256sums lines.

pkgname=slipstream-bin
pkgver=0.14.0beta1
pkgrel=1
_tag=v0.14.0-beta.1
pkgdesc='Vulkan viewer for Second Life (official binary release)'
arch=('x86_64')
url='https://slipstreamviewer.org'
license=('LGPL-2.1-only' 'LicenseRef-bundled')
# Derived from the direct NEEDED entries of every 64-bit ELF in the release
# tree (ldd / readelf + pacman -Qo, bundled lib/ excluded), plus the libraries
# the bundled SDL3 / OpenAL / WebRTC load with dlopen. See README.md.
depends=(
  'glibc' 'gcc-libs' 'glib2' 'fontconfig' 'hicolor-icon-theme'
  # windowing and audio (dlopen'd by the bundled SDL3, OpenAL and WebRTC)
  'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libxfixes' 'libxext'
  'libxkbcommon' 'wayland' 'libpulse'
  # built-in web browser and media on a prim (CEF, #245)
  'nss' 'nspr' 'at-spi2-core' 'libcups' 'libdrm' 'mesa' 'libxcb'
  'libxcomposite' 'libxdamage' 'alsa-lib' 'pango' 'cairo' 'dbus' 'expat'
  'systemd-libs'
  # parcel music and in-world media (the GStreamer plugin): base for the plugin
  # itself, good for HTTP streams (souphttpsrc), MP3 and the PulseAudio sink
  'gst-plugins-base-libs' 'gst-plugins-good'
)
optdepends=(
  'vulkan-radeon: Vulkan driver for AMD GPUs (one Vulkan driver is required)'
  'vulkan-intel: Vulkan driver for Intel GPUs (one Vulkan driver is required)'
  'nvidia-utils: Vulkan driver for NVIDIA GPUs (one Vulkan driver is required)'
  'gst-plugins-bad: more GStreamer media formats'
  'gst-libav: more GStreamer media formats (H.264, AAC, ...)'
  'libvlc: in-world media through the VLC plugin'
  'libdecor: window decorations on GNOME Wayland'
  'xdg-utils: open web links in the system browser'
  'libnotify: desktop notifications from the launcher'
  'gamemode: Feral GameMode support'
  'switcheroo-control: automatic GPU selection on hybrid-graphics laptops'
)
provides=('slipstream')
conflicts=('slipstream')
# The tarball is already stripped; re-stripping the 400 MB libcef.so is slow
# and buys nothing, and there are no debug symbols to split.
options=('!strip' '!debug')
_label=${_tag#v}
_dir=Slipstream_${_label}_x86_64
source=("https://git.slipstreamviewer.org/sky_line/Slipstream/releases/download/${_tag}/${_dir}.tar.xz")
sha256sums=('e8bf6a78a5195c0f91b57d21218525f662632e582a72b61c5ad0c4c7a0c6a01c')

package() {
  local opt="$pkgdir/opt/slipstream"
  install -d "$opt"
  cp -a --no-preserve=ownership "$srcdir/$_dir/." "$opt/"

  # Marks a package install: the wrapper then skips the per-user desktop entry
  # and secondlife:// registration (this package installs both system-wide)
  # and the #245 missing-library check (pacman guarantees the libraries).
  printf '%s\n' "$pkgname" > "$opt/.packaged-by"
  # Wrappers older than the marker run those two scripts unconditionally;
  # guard them. A no-op on wrappers that already check the marker.
  sed -i -E 's@^(\./etc/(register_secondlifeprotocol|refresh_desktop_app_entry)\.sh)$@[ -f .packaged-by ] || \1@' \
    "$opt/slipstream"

  # CEF's sandbox helper stays as shipped: 0755, NOT setuid root. See README.md.
  chmod 0755 "$opt/bin/chrome-sandbox"

  # Launcher. Not a symlink: the wrapper locates build_data.json from its own
  # path, so it has to be run from /opt/slipstream.
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/slipstream" <<'EOF'
#!/bin/sh
# slipstream-bin launcher: pacman provides the system libraries, so the
# wrapper's missing-library check is skipped. User data: ~/.slipstreamviewer
export SLIPSTREAM_SKIP_MEDIA_CHECK=1
exec /opt/slipstream/slipstream "$@"
EOF
  chmod 0755 "$pkgdir/usr/bin/slipstream"

  # The wrapper sets the window class to the channel name ("Slipstream Beta").
  local channel
  channel=$(sed -n 's/.*"Channel"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$opt/build_data.json")
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/slipstream.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Slipstream Viewer
GenericName=Second Life Viewer
Comment=Vulkan viewer for Second Life
Exec=slipstream %u
Icon=slipstream
Terminal=false
Categories=Game;Simulation;
MimeType=x-scheme-handler/secondlife;
StartupNotify=true
StartupWMClass=${channel:-Slipstream}
EOF

  # Icons: the hicolor set when the tarball ships one, else the 256 px icon.
  if [ -d "$opt/share/icons/hicolor" ]; then
    install -d "$pkgdir/usr/share/icons"
    cp -a --no-preserve=ownership "$opt/share/icons/hicolor" "$pkgdir/usr/share/icons/"
  else
    install -Dm644 "$opt/slipstream_icon.png" \
      "$pkgdir/usr/share/icons/hicolor/256x256/apps/slipstream.png"
  fi

  # Licenses: the viewer is LGPL-2.1 (common license, not copied); bundled
  # third-party components and fonts carry their own.
  local lic="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$opt/licenses.txt" "$lic/licenses.txt"
  local f
  for f in "$opt"/fonts/*[Ll][Ii][Cc][Ee][Nn][CcSs][Ee]*; do
    install -Dm644 "$f" "$lic/fonts/${f##*/}"
  done
}
