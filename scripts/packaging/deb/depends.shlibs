# dpkg-shlibdeps output for the release tree, used by build_deb.sh when a fresh
# computation isn't possible (dpkg-dev or a runtime library missing on the
# builder). Made in a clean ubuntu:24.04 with dpkg-dev and the depends.extra
# Depends installed, from Slipstream_1.0.0-beta.5_x86_64.tar.xz:
#   build_deb.sh --shlibs <tarball> > out; (header) + out > depends.shlibs
# Refresh it when the viewer's linked libraries change (see README.md).
shlibs:Depends=libasound2t64 (>= 1.0.17), libatk-bridge2.0-0t64 (>= 2.5.3), libatk1.0-0t64 (>= 2.32.0), libatspi2.0-0t64 (>= 2.9.90), libc6 (>= 2.38), libcairo2 (>= 1.6.0), libcups2t64 (>= 1.7.0), libdbus-1-3 (>= 1.9.14), libexpat1 (>= 2.1~beta3), libfontconfig1 (>= 2.12.6), libgbm1 (>= 17.1.0~rc2), libgcc-s1 (>= 4.3), libglib2.0-0t64 (>= 2.79.0), libnspr4 (>= 2:4.9-2~), libnss3 (>= 2:3.30), libpango-1.0-0 (>= 1.14.0), libstdc++6 (>= 14), libudev1 (>= 183), libx11-6 (>= 2:1.4.99.1), libxcb1 (>= 1.9.2), libxcomposite1 (>= 1:0.4.5), libxdamage1 (>= 1:1.1), libxext6, libxfixes3, libxkbcommon0 (>= 0.5.0), libxrandr2
