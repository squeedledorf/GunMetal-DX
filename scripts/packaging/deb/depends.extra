# Relations dpkg-shlibdeps can't see, merged into DEBIAN/control by build_deb.sh
# (#278). A relation whose packages the computed list already names is skipped,
# so these never weaken a versioned computed dependency. Package names are the
# Ubuntu 24.04 / Debian 13 ones; build_deb.sh adds the pre-t64 name as an
# alternative to every *t64 package. See README.md for where each comes from.

# Vulkan loader: the tarball bundles one, but the system loader is what finds
# the GPU driver's ICD (and keeps a working loader if the bundled one is ever
# dropped).
Depends: libvulkan1
# Loaded with dlopen by the bundled SDL3 (windowing, input) and OpenAL / WebRTC
# (audio). libpulse0 also talks to PipeWire's pulse server.
Depends: libx11-6, libxext6, libxcursor1, libxi6, libxrandr2, libxfixes3, libxss1, libxkbcommon0, libwayland-client0, libwayland-cursor0, libwayland-egl1, libdrm2, libgbm1, libpulse0
# Window decorations on GNOME Wayland (#196 / #197): SDL3 dlopens libdecor and
# libdecor loads a plugin; without one the window has no title bar.
Depends: libdecor-0-0, libdecor-0-plugin-1-gtk | libdecor-0-plugin-1-cairo
# Built-in browser and media on a prim (CEF, #245 / #264). libcef.so links most
# of these directly (dpkg-shlibdeps then finds them with versions); listed here
# so the set from README-linux.txt is guaranteed even if CEF moves one to dlopen.
Depends: libnss3, libnspr4, libatk1.0-0t64, libatk-bridge2.0-0t64, libatspi2.0-0t64, libcups2t64, libxcomposite1, libxdamage1, libxshmfence1, libasound2t64, libpango-1.0-0, libcairo2, libdbus-1-3, libexpat1, libudev1, libglib2.0-0t64, libfontconfig1
# Menu icon theme.
Depends: hicolor-icon-theme

# A Vulkan driver is required in practice; nvidia's packages provide vulkan-icd.
Recommends: mesa-vulkan-drivers | vulkan-icd
# PipeWire client library (SDL3 audio backend; PulseAudio works without it).
Recommends: libpipewire-0.3-0t64
# Parcel music and in-world media through the GStreamer plugin. plugins-good is
# required in practice: without it streams fail silently (no HTTP source, MP3
# decoder or PulseAudio sink).
Depends: gstreamer1.0-plugins-base, gstreamer1.0-plugins-good
# Open web links in the system browser.
Recommends: xdg-utils
# The apt repository's key package (#288): installed with the viewer from the
# repo, so the key stays current. A direct `apt install ./file.deb` simply
# skips it (it isn't in the distribution archives), so it must never be a Depends.
Recommends: slipstream-archive-keyring

Suggests: gstreamer1.0-plugins-bad, gstreamer1.0-libav, libvlc5, libnotify-bin, gamemode, switcheroo-control
