* text eol=lf

# Images
*.bmp binary
*.BMP binary
*.gif binary
*.icns binary
*.ico binary
*.j2c binary
*.j2k binary
*.jpg binary
*.png binary
*.tga binary
*.tif binary

# Viewer resources
*.db2 binary
*.llm binary
*.nib binary
*.rtf binary
# Chrome CRLSet (binary revocation data, scripts/revocation/fetch_crlset.py)
crl-set binary
*.ttf binary

# Audio
*.ogg binary
*.wav binary

# Executables
*.dll binary
*.exe binary

# Files with Windows line endings
FILES_ARE_UNICODE_UTF-16LE.txt text eol=crlf

# Windows Manifest files
*.manifest text eol=crlf

# Windows Installer Script files (normalization disabled)
*.nsi -text
